static HICON g_hBalloonIconDrone = nullptr;   // Fix 120: Drohne (904)
static void SetTrayBalloonIcon(NOTIFYICONDATAW& nid, int kind) {   // kind: 0 = Dig, 1 = Lucky Gift, 2 = Feuerwerk (Fix 41), 3 = Ei (Fix 44), 4 = Drohne (Fix 120)
    HICON& ic = kind == 4 ? g_hBalloonIconDrone : kind == 3 ? g_hBalloonIconEgg : kind == 2 ? g_hBalloonIconFirework : (kind == 1 ? g_hBalloonIconLucky : g_hBalloonIconDig);
    if (!ic) {
        int cx = GetSystemMetrics(SM_CXICON), cy = GetSystemMetrics(SM_CYICON);
        if (cx <= 0) cx = 32;
        if (cy <= 0) cy = 32;
        ic = (HICON)LoadImageW(GetModuleHandleW(nullptr), MAKEINTRESOURCEW(kind == 4 ? IDI_TEST_DRONE : kind == 3 ? IDI_GOLDEN_EGG : (kind == 2 ? IDI_FIREWORK : (kind == 1 ? IDI_LUCKY_GIFT : DigIconId()))), IMAGE_ICON, cx, cy, LR_DEFAULTCOLOR);
        if (!ic && kind == 4) ic = (HICON)LoadImageW(GetModuleHandleW(nullptr), MAKEINTRESOURCEW(DigIconId()), IMAGE_ICON, cx, cy, LR_DEFAULTCOLOR);   // Fix 120: ohne 904 -> Bagger
    }
    if (ic) { nid.dwInfoFlags = NIIF_USER | NIIF_LARGE_ICON; nid.hBalloonIcon = ic; }
    else nid.dwInfoFlags = NIIF_INFO;
}
// Layout Hauptfenster: obere Trennlinie, Zählerzeile, untere Trennlinie und Log-Beginn (y in Pixeln, wie die übrigen festen Positionen)
static const int MAIN_TOPSEP_Y = 37;
static const int MAIN_COUNT_Y = 41;
static const int MAIN_COUNT_H = 17;
static const int MAIN_SEP_Y = 59;
static const int MAIN_LOG_Y = 62;
// Speicherbereiche mit Treffern (Hot-Regions)
static std::unordered_set<uintptr_t> g_hotRegions;

// Duplikatschutz je Chat-Nachricht (ersetzt den alten Schutz „gleiche Koordinaten je Dig-Art nur einmal“):
// Jede geteilte Dig-Nachricht ist im Spielspeicher eine Lua-Tabelle mit u. a.
//   fulltext     = "Grabe einen Schatz aus (Kriegszone #1036 X:488 Y:436)"     (eigener Lua-String, ohne <u>)
//   attachmentId = {"worldType":0,"y":436,"treasureId":"25193","uuid":1432630056425098334,"worldId":0,"x":488,"sid":1036,"shareType":27,"oname":"801325"}
// Die uuid ist je Post eindeutig (steigt mit der Post-Reihenfolge) und bleibt bei Neuzeichnen, Failsafe-Reset und
// Spiel-Neustart gleich; treasureId gehört zum Schatz, nicht zum Post.
// Die Anzeige-Kopien des Texts (mit <u>…</u>) entstehen beim Zeichnen immer wieder neu; der Klartext-fulltext (ohne <u>)
// existiert je Post genau einmal, an fester Adresse, solange die Nachricht geladen ist („Slot“).
// Paarung 1:1: eine uuid bekommt höchstens einen Slot, ein Slot höchstens eine uuid. Gemeldet wird nur, wenn eine NEUE
// uuid einen FREIEN Slot mit derselben Dig-Art und denselben X/Y bekommt – Text und Koordinaten der Meldung stammen aus
// genau diesem Slot. Das JSON liegt oft Sekunden bis Minuten VOR dem fulltext im Speicher (fulltext entsteht erst beim
// Anzeigen) -> ungemeldete uuids warten bis zu 30 min auf ihren eigenen fulltext und gelten nie „bekannt“, nur weil sie
// warten. „Bekannt“ sind nur gemeldete uuids und uuids aus der Start-Verzögerung. Share-JSONs ohne eigenen fulltext
// (z. B. „Der Schatz von … wurde ausgegraben!“, Weiterleitungen) warten harmlos, denn jede Meldung braucht einen
// frischen, unverbrauchten Slot. Freie Slots ohne wartende uuid derselben Art/Koordinaten (neu geladene Kopie eines
// gemeldeten Posts, Post ohne JSON) werden still verbraucht. Ohne passendes JSON wird nichts gemeldet.
// Zwei Posts mit gleichen Koordinaten haben zwei fulltexts und zwei uuids und werden beide gemeldet.
static const size_t SEEN_MSG_CAP = 20000;          // gemeldete/bekannte uuids (FIFO, ca. 1 MB)
static const size_t PENDING_MSG_CAP = 4096;        // neue uuids, die noch auf ihren eigenen fulltext warten
static const ULONGLONG DIG_PENDING_TTL_MS = 30ULL * 60 * 1000;   // so lange wartet eine ungemeldete uuid auf ihren fulltext
static const size_t DIG_SLOT_CAP = 2048;           // Klartext-fulltexts geprüfter Digs im Speicher
static const size_t LIVE_SEEN_CAP = 4096;          // bekannte uuids je Durchlauf
static const unsigned DIG_GRACE_FULL_SCANS = 3;    // Wartezeit (volle Scans) für uuid ohne Slot bzw. Slot ohne uuid
static std::unordered_set<unsigned long long> g_seenMsgIds;
static std::deque<unsigned long long> g_seenMsgOrder;
struct DigSlot {
    char type = '?'; int x = 0, y = 0;
    int sid = 0;                           // Fix 43: Warzone-Nummer aus dem Dig-Text (Anzeige + Paarung)
    std::string pattern, xs, ys, zoneWord, text;
    bool zoneWordOk = false;
    bool consumed = false;                 // gehört schon zu einer uuid oder still verbraucht
    unsigned long long boundUuid = 0;      // gemeldete uuid (0 = keine)
    unsigned firstFull = 0;                // Zähler voller Scans beim ersten Fund
    unsigned long long firstPass = 0;      // Durchlauf Nr. beim ersten Fund
    unsigned long long lastPass = 0;       // zuletzt gefunden in Durchlauf Nr.
};
static std::unordered_map<uintptr_t, DigSlot> g_digSlots;            // Adresse des fulltext -> Slot
struct PendingMsg { int x = 0, y = 0, sid = 0; char type = '?'; unsigned firstFull = 0; unsigned long long firstPass = 0; ULONGLONG firstTick = 0; };
static std::unordered_map<unsigned long long, PendingMsg> g_pendingMsgs;
struct LiveSeenMsg { unsigned long long uuid; char type; int x, y, sid; };   // Fix 43: + sid
static std::vector<LiveSeenMsg> g_liveSeen;                          // bekannte uuids dieses Durchlaufs
static unsigned long long g_digPass = 0;
static unsigned g_fullScans = 0;

// uuid als bekannt merken (begrenzte Größe, älteste zuerst verworfen)
static void MarkMsgSeen(unsigned long long id) {
    if (!g_seenMsgIds.insert(id).second) return;
    g_seenMsgOrder.push_back(id);
    while (g_seenMsgOrder.size() > SEEN_MSG_CAP) {
        g_seenMsgIds.erase(g_seenMsgOrder.front());
        g_seenMsgOrder.pop_front();
    }
}
// Nur Ziffern (1..maxLen) -> Zahl; false bei Überlauf/leer
static bool DigJsonDigits(std::string_view v, size_t maxLen, unsigned long long& out) {
    if (v.empty() || v.size() > maxLen) return false;
    unsigned long long r = 0;
    for (char c : v) {
        if (c < '0' || c > '9') return false;
        unsigned d = (unsigned)(c - '0');
        if (r > (~0ULL - d) / 10) return false;
        r = r * 10 + d;
    }
    out = r;
    return true;
}
struct DigJsonInfo { unsigned long long uuid = 0; int x = 0, y = 0, sid = 0; char type = '?'; };
// Prüft ein flaches JSON-Objekt {"k":v,...} (keine Verschachtelung, keine Escapes, keine doppelten Schlüssel)
// und liest die Dig-Felder unabhängig von der Reihenfolge
static bool ParseDigJson(std::string_view j, DigJsonInfo& out) {
    std::string_view vUuid, vTid, vX, vY, vSid, vShare, vOname;
    bool hasOname = false;
    size_t i = 0, n = j.size();
    auto ws = [&]() { while (i < n && (j[i] == ' ' || j[i] == '\t')) ++i; };
    if (n < 2 || j[0] != '{' || j[n - 1] != '}') return false;
    i = 1; ws();
    if (i < n && j[i] == '}') return false;
    int fields = 0;
    while (i < n) {
        if (j[i] != '"') return false;
        size_t ks = ++i;
        while (i < n && j[i] != '"') { if (j[i] == '\\' || (unsigned char)j[i] < 0x20) return false; ++i; }
        if (i >= n) return false;
        std::string_view key = j.substr(ks, i - ks);
        ++i; ws();
        if (i >= n || j[i] != ':') return false;
        ++i; ws();
        if (i >= n) return false;
        std::string_view val;
        bool isStr = false;
        if (j[i] == '"') {
            size_t vs = ++i;
            while (i < n && j[i] != '"') { if (j[i] == '\\' || (unsigned char)j[i] < 0x20) return false; ++i; }
            if (i >= n) return false;
            val = j.substr(vs, i - vs); isStr = true; ++i;
        }
        else {
            size_t vs = i;
            while (i < n && j[i] != ',' && j[i] != '}' && j[i] != ' ' && j[i] != '\t') {
                char c = j[i];
                if (!((c >= '0' && c <= '9') || c == '-' || c == '.' || (c >= 'a' && c <= 'z') || c == 'E' || c == '+')) return false;
                ++i;
            }
            val = j.substr(vs, i - vs);
            if (val.empty()) return false;
        }
        if (++fields > 32) return false;
        auto take = [&](std::string_view& dst) -> bool { if (!dst.data()) { dst = val; return true; } return false; };
        bool ok = true;
        if (key == "uuid") ok = take(vUuid);
        else if (key == "treasureId") ok = take(vTid);
        else if (key == "x") ok = !isStr && take(vX);
        else if (key == "y") ok = !isStr && take(vY);
        else if (key == "sid") ok = !isStr && take(vSid);
        else if (key == "shareType") ok = !isStr && take(vShare);
        else if (key == "oname") { ok = isStr && !hasOname; hasOname = true; vOname = val; }
        if (!ok) return false;
        ws();
        if (i >= n) return false;
        if (j[i] == ',') { ++i; ws(); continue; }
        if (j[i] == '}' && i == n - 1) break;
        return false;
    }
    if (vShare != "27") return false;
    unsigned long long uuid = 0, tid = 0, x = 0, y = 0, sid = 0;
    if (!DigJsonDigits(vUuid, 20, uuid) || uuid == 0) return false;
    if (!DigJsonDigits(vTid, 20, tid)) return false;
    if (!DigJsonDigits(vX, 4, x) || !DigJsonDigits(vY, 4, y) || !DigJsonDigits(vSid, 6, sid) || sid == 0) return false;   // Fix 43: Warzone 1–6 Ziffern
    out.uuid = uuid; out.x = (int)x; out.y = (int)y; out.sid = (int)sid;
    // Dig-Art aus „oname“ nur bei bekannten Werten; sonst über die Koordinaten des geprüften Dig-Texts
    out.type = (vOname == "801325") ? 'T' : (vOname == "detect_event_typename_1901") ? 'F' : '?';
    return true;
}
// Sucht ab Position q (Treffer von "shareType":27) das umschließende JSON im Puffer:
// '{' höchstens 512 Bytes davor, '}' danach, Länge <= 512, direkt danach '\0' (Ende des Lua-Strings)
static bool ExtractDigJson(std::string_view mem, size_t q, std::string_view& json) {
    const size_t MAXJ = 512;
    size_t lo = (q > MAXJ) ? q - MAXJ : 0;
    size_t b = std::string_view::npos;
    for (size_t k = q; k > lo; ) {
        --k;
        char c = mem[k];
        if (c == '{') { b = k; break; }
        if (c == '}' || c == '\0') return false;
    }
    if (b == std::string_view::npos) return false;
    size_t hi = std::min(mem.size(), b + MAXJ);
    for (size_t k = q; k < hi; ++k) {
        char c = mem[k];
        if (c == '}') {
            if (k + 1 >= mem.size() || mem[k + 1] != '\0') return false;
            json = mem.substr(b, k - b + 1);
            return true;
        }
        if (c == '{' || c == '\0') return false;
    }
    return false;
}

// Checkbox „auto refresh game“ (Name historisch: StartGameCopy)
static HWND g_hCheckStartGameCopy = nullptr;
static std::atomic<bool> g_autoRefreshEnabled{ false };
// Fix 69: „auto refresh game“ gibt es nur mit Discord. Ohne Discord (Standard-START) immer aus; der gespeicherte Wert bleibt erhalten
static bool AutoRefreshActive() { return g_autoRefreshEnabled.load() && !g_notiOnlyMode.load(); }
static bool g_hoverAutoRefresh = false;

// ===== Hilfsfunktionen: Fenster und Hover =====
// Prüft, ob LastWar.exe gerade das Vordergrundfenster ist
// (Ergebnis wird pro Fenster/Prozess zwischengespeichert und spätestens alle 250 ms neu ermittelt,
//  damit nicht bei jedem 16-ms-Tick ein Prozess-Handle geöffnet wird)
static bool IsLastWarForeground() {
    static HWND s_lastFg = nullptr;
    static DWORD s_lastPid = 0;
    static bool s_lastResult = false;
    static ULONGLONG s_lastCheck = 0;
    HWND fg = GetForegroundWindow();
    if (!fg) return false;
    DWORD pid = 0;
    GetWindowThreadProcessId(fg, &pid);
    if (!pid) return false;
    ULONGLONG nowTick = GetTickCount64();
    if (fg == s_lastFg && pid == s_lastPid && nowTick - s_lastCheck < 250) return s_lastResult;
    s_lastFg = fg;
    s_lastPid = pid;
    s_lastCheck = nowTick;
    s_lastResult = false;
    HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
    if (!h) return false;
    wchar_t path[MAX_PATH] = {};
    DWORD size = MAX_PATH;
    bool result = false;
    if (QueryFullProcessImageNameW(h, 0, path, &size)) {
        std::wstring p = path;
        result = (p.find(L"LastWar.exe") != std::wstring::npos);
    }
    CloseHandle(h);
    s_lastResult = result;
    return result;
}

// Meldet WM_MOUSELEAVE/WM_MOUSEHOVER für ein Steuerelement an
static void TrackHover(HWND hwnd) {
    TRACKMOUSEEVENT tme = { sizeof(tme) };
    tme.dwFlags = TME_LEAVE | TME_HOVER;
    tme.hwndTrack = hwnd;
    tme.dwHoverTime = 1;
    TrackMouseEvent(&tme);
}

// Subclass für Buttons und Checkboxen: Hover-Effekt, transparenter Hintergrund
static LRESULT CALLBACK ButtonHoverSubclass(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam, UINT_PTR, DWORD_PTR) {
    switch (msg) {
    case WM_LBUTTONDBLCLK:
    case WM_LBUTTONDOWN:
        // Klick auf einen Button schließt offene Dropdowns
        if (g_hComboWait) SendMessageW(g_hComboWait, CB_SHOWDROPDOWN, FALSE, 0);
        if (g_hComboRefresh) SendMessageW(g_hComboRefresh, CB_SHOWDROPDOWN, FALSE, 0);
        // Fix 122: Ein Owner-draw-Button meldet den 2. schnellen Klick (WM_LBUTTONDBLCLK) sofort beim Drücken als BN_DOUBLECLICKED,
        // ohne Capture und ohne BN_CLICKED beim Loslassen. Darum hier als normales Drücken weitergeben: der Button nimmt die Maus
        // (Capture), zeigt „gedrückt“ und meldet BN_CLICKED erst beim Loslassen über dem Häkchen (Herausziehen bricht ab).
        if (msg == WM_LBUTTONDBLCLK && (hwnd == g_hCheckSave || hwnd == g_hCheckStartGame || hwnd == g_hCheckStartGameCopy || hwnd == g_hCheckDiscord))
            return DefSubclassProc(hwnd, WM_LBUTTONDOWN, wParam, lParam);
        break;
    case WM_ERASEBKGND:
        // Checkboxen ohne eigenen Hintergrund zeichnen (transparent)
        if (hwnd == g_hCheckSave || hwnd == g_hCheckStartGame || hwnd == g_hCheckStartGameCopy || hwnd == g_hCheckDiscord || hwnd == g_hBtnOk)
            return TRUE;
        break;
    case WM_MOUSEMOVE:
        // Hover beginnt: Zustand merken und neu zeichnen
        if (hwnd == g_hBtnOk && !g_hoverOk) {
            g_hoverOk = true;
            TrackHover(hwnd);
            InvalidateRect(hwnd, nullptr, TRUE);
        }
        else if (hwnd == g_hCheckSave && !g_hoverSave) {
            g_hoverSave = true;
            TrackHover(hwnd);
            InvalidateRect(hwnd, nullptr, TRUE);
        }
        else if (hwnd == g_hCheckStartGame && !g_hoverStartGame) {
            g_hoverStartGame = true;
            TrackHover(hwnd);
            InvalidateRect(hwnd, nullptr, TRUE);
        }
        else if (hwnd == g_hCheckStartGameCopy && !g_hoverAutoRefresh) {
            g_hoverAutoRefresh = true;
            TrackHover(hwnd);
            InvalidateRect(hwnd, nullptr, TRUE);
        }
        else if (hwnd == g_hCheckDiscord && !g_hoverDiscord) {
            g_hoverDiscord = true;
            TrackHover(hwnd);
            InvalidateRect(hwnd, nullptr, TRUE);
        }
        break;
    case WM_MOUSELEAVE:
        // Hover endet
        if (hwnd == g_hBtnOk) { g_hoverOk = false; InvalidateRect(hwnd, nullptr, TRUE); }
        else if (hwnd == g_hCheckSave) { g_hoverSave = false; InvalidateRect(hwnd, nullptr, TRUE); }
        else if (hwnd == g_hCheckStartGame) { g_hoverStartGame = false; InvalidateRect(hwnd, nullptr, TRUE); }
        else if (hwnd == g_hCheckStartGameCopy) { g_hoverAutoRefresh = false; InvalidateRect(hwnd, nullptr, TRUE); }
        else if (hwnd == g_hCheckDiscord) { g_hoverDiscord = false; InvalidateRect(hwnd, nullptr, TRUE); }
        break;
    }
    return DefSubclassProc(hwnd, msg, wParam, lParam);
}

// ===== Fix 34: Texte der Benachrichtigungen (Blase + Windows-Hinweis) wie die Log-Zeile =====
// Dig: Zeile 1 = Dig-Text in der Spielsprache (grün), Zeile 2 = „[Kriegszone #1036 X:522 Y:418]“ (weiß, unterstrichen).
// Lucky Gift: Zeile 1 = Log-Wort (Goldgelb) + „:“ (weiß, nur mit Absender), Zeile 2 = Absender (#D46BFF).
// BiDi-Marken (U+200E usw.) werden für die Anzeige entfernt. Windows-Hinweis: Titel = Zeile 1, Text = Zeile 2.
struct NotifyLines { std::wstring line1, line2; bool colon = false; };
static std::wstring NotifyStripBidi(const std::wstring& s) {
    std::wstring o;
    o.reserve(s.size());
    for (wchar_t c : s) {
        if (c == 0x200E || c == 0x200F || c == 0x061C || (c >= 0x202A && c <= 0x202E) || (c >= 0x2066 && c <= 0x2069)) continue;
        o += c;
    }
    return o;
}
static NotifyLines DigNotifyLines(const std::wstring& digText, const std::wstring& zoneText, bool hasZoneText, int server,
    const std::wstring& x, const std::wstring& y, bool drone = false) {
    NotifyLines t;   // wie WriteDigLogLine: leerer Dig-Text -> „DIG FOUND !“ (Fix 120: Drohne „Test Flight Failure“), ohne Warzone-Wort -> „Warzone “
    t.line1 = NotifyStripBidi(digText.empty() ? std::wstring(drone ? L"Test Flight Failure" : L"DIG FOUND !") : digText);
    t.line2 = L"[" + NotifyStripBidi(hasZoneText ? zoneText : std::wstring(L"Warzone ")) + L"#" + std::to_wstring(server) +
        L" X:" + NotifyStripBidi(x) + L" Y:" + NotifyStripBidi(y) + L"]";
    return t;
}
static NotifyLines LuckyNotifyLines(const std::wstring& label, const std::wstring& sender) {
    NotifyLines t;   // wie WriteLuckyLogLine: „Wort: Name“, ohne Absender nur das Wort (einzeilig)
    t.line1 = NotifyStripBidi(label.empty() ? std::wstring(L"Lucky Gift") : label);
    t.line2 = NotifyStripBidi(sender);
    t.colon = !sender.empty();
    return t;
}
// Fix 41/42: Feuerwerk: nur eine Zeile = Wort der Spielsprache (blau); nie ein Absender (keine Zeile 2, kein „:“)
static NotifyLines FireworkNotifyLines(const std::wstring& label) {
    NotifyLines t;
    t.line1 = NotifyStripBidi(label.empty() ? std::wstring(L"Firework") : label);
    return t;
}
// Fix 44: Ei wie Lucky Gift – Zeile 1 = Ei-Wort (gelb) + „:“ (weiß, nur mit Absender), Zeile 2 = Absender (#D46BFF)
static NotifyLines EggNotifyLines(const std::wstring& label, const std::wstring& sender) {
    NotifyLines t;
    t.line1 = NotifyStripBidi(label.empty() ? std::wstring(L"Egg") : label);
    t.line2 = NotifyStripBidi(sender);
    t.colon = !sender.empty();
    return t;
}
static std::wstring NotifyTitle(const NotifyLines& t) { return t.line1 + (t.colon ? L":" : L""); }
static std::wstring NotifyBody(const NotifyLines& t) { return t.line2.empty() ? std::wstring(L" ") : t.line2; }
// Auf max Zeichen kürzen (Windows-Hinweis: Titel 63, Text 255) mit „…“, ohne ein Surrogat-Paar zu trennen
static std::wstring NotifyFit(const std::wstring& s, size_t maxChars) {
    if (s.size() <= maxChars || maxChars < 2) return s.substr(0, std::min(s.size(), maxChars));
    size_t n = maxChars - 1;
    if (s[n - 1] >= 0xD800 && s[n - 1] <= 0xDBFF) --n;
    return s.substr(0, n) + L"\u2026";
}
// ===== Fix 36: reine Hilfen (Icon-Bild wählen, Nachschärfen, Blasenbreite, Hover) =====
struct IconFrameInfo { int w = 0, h = 0, bpp = 0; unsigned id = 0; bool png = false; };
// Index des größten Bilds einer Icon-Gruppe (Breite, bei Gleichstand mehr Bit/Pixel, dann PNG); -1 = keins
static int IconPickLargest(const std::vector<IconFrameInfo>& f) {
    int best = -1;
    for (int i = 0; i < (int)f.size(); ++i) {
        if (f[i].w <= 0) continue;
        if (best < 0) { best = i; continue; }
        const IconFrameInfo& a = f[i];
        const IconFrameInfo& b = f[best];
        if (a.w > b.w || (a.w == b.w && (a.bpp > b.bpp || (a.bpp == b.bpp && a.png && !b.png)))) best = i;
    }
    return best;
}
// Leichtes Nachschärfen (Unscharf-Maske, 3x3-Weichzeichner 1-2-1, Stärke pct %) auf vormultipliziertem BGRA (n x n);
// Farbanteile bleiben <= Alpha (gültig vormultipliziert), gleichmäßige Flächen bleiben unverändert
static void IconSharpenPBGRA(std::vector<unsigned>& px, int n, int pct) {
    if (n < 3 || pct <= 0 || px.size() < (size_t)n * n) return;
    const std::vector<unsigned> src(px.begin(), px.begin() + (size_t)n * n);
    static const int k[3] = { 1, 2, 1 };
    for (int y = 0; y < n; ++y) {
        for (int x = 0; x < n; ++x) {
            int v[4];
            for (int c = 0; c < 4; ++c) {
                int blur = 0;
                for (int dy = -1; dy <= 1; ++dy) {
                    const int sy = std::min(n - 1, std::max(0, y + dy));
                    for (int dx = -1; dx <= 1; ++dx) {
                        const int sx = std::min(n - 1, std::max(0, x + dx));
                        blur += k[dy + 1] * k[dx + 1] * (int)((src[(size_t)sy * n + sx] >> (8 * c)) & 255);
                    }
                }
                const int s = (int)((src[(size_t)y * n + x] >> (8 * c)) & 255);
                const int d = (s * 16 - blur) * pct;   // (Original − Weichzeichner) * 16 * pct
                v[c] = std::min(255, std::max(0, s + (d >= 0 ? (d + 800) / 1600 : -((-d + 800) / 1600))));
            }
            for (int c = 0; c < 3; ++c) v[c] = std::min(v[c], v[3]);
            px[(size_t)y * n + x] = ((unsigned)v[3] << 24) | ((unsigned)v[2] << 16) | ((unsigned)v[1] << 8) | (unsigned)v[0];
        }
    }
}
// Fund-Blase: Breite = breitere der zwei Zeilen + Icon + Abstand + Ränder; min. 170, max. 60 % der Arbeitsfläche
// (darüber „…“); rechts verankert (wächst nach links). Icon 28 px (aus dem 256er-Bild), Höhe bleibt 52.
static const int BUBBLE_MIN_W = 170, BUBBLE_ICON_PX = 28, BUBBLE_ICON_GAP = 7, BUBBLE_PAD_W = 42;
static int BubbleMaxWidth(int workW) { return workW > 0 ? std::max(BUBBLE_MIN_W, workW * 60 / 100) : 600; }
static int BubbleNeededWidth(int textW) { return std::max(0, textW) + BUBBLE_ICON_PX + BUBBLE_ICON_GAP + BUBBLE_PAD_W; }
static int BubbleWidthFor(int textW, int workW) { return std::max(BUBBLE_MIN_W, std::min(BubbleMaxWidth(workW), BubbleNeededWidth(textW))); }
static int BubbleMaxTextW(int bubbleW) { return std::max(20, bubbleW - BUBBLE_PAD_W - BUBBLE_ICON_PX - BUBBLE_ICON_GAP); }
// Fix 38/39: Icon 5 px weiter links als der Block-Anfang; Text bleibt bei startX + Icon + Abstand (Breite/Textfläche gleich)
static const int BUBBLE_ICON_SHIFT = 5;   // Fix 39: 3 -> 5
static int BubbleIconX(int startX) { return std::max(0, startX - BUBBLE_ICON_SHIFT); }
// Anzeigedauer in 400-ms-Ticks (12 = ~4,8 s). Maus über der Blase: Zählung pausiert; nach dem Verlassen bleiben
// mindestens BUBBLE_LEAVE_TICKS (~1,6 s), sonst die Restzeit.
static const int BUBBLE_HIDE_TICKS = 12, BUBBLE_LEAVE_TICKS = 4;
static int BubbleTicksAfterLeave(int ticks) { return std::min(ticks, BUBBLE_HIDE_TICKS - BUBBLE_LEAVE_TICKS); }
static int BubbleNextTick(int ticks, bool hover) { return hover ? ticks : ticks + 1; }
static bool BubbleShouldHide(int ticks, bool hover, bool closing) { return !hover && !closing && ticks >= BUBBLE_HIDE_TICKS; }
// Inhalt der aktuellen Fund-Blase und ihre Schriftgröße (18 px, passt es nicht in 170 px: 17 px und Blase breiter)
static NotifyLines g_bubbleText;
static int g_bubbleFontPx = 18;
static const int BUBBLE_H = 52;   // Fix 36: Breite siehe BubbleWidthFor (min. 170, max. 60 % der Arbeitsfläche)
// ===== Fix 36: Icons scharf – größtes Bild der .ico per WIC hochwertig verkleinern =====
// Ursache der verwaschenen Icons (Fix 34): gewählt wurde das kleinste Bild >= Zielgröße, also für 18 px das 24er-Bild
// der .ico – das ist selbst schon unscharf. Jetzt: RT_GROUP_ICON zur Laufzeit lesen, das GRÖSSTE Bild nehmen (256,
// PNG oder BMP), per WIC (IWICBitmapScaler, HighQualityCubic, sonst Fant) vormultipliziert auf genau die Zielgröße
// skalieren, leicht nachschärfen und 1:1 zeichnen (Blase: AlphaBlend; Zähler/Log-Nadeln: als HICON per DrawIconEx).
// Fallback ohne WIC: größtes Bild per Flächenmittel (IconDownscale), zuletzt LoadImageW wie früher.
#pragma pack(push, 2)
struct IconGrpEntry { BYTE w, h, colors, reserved; WORD planes, bpp; DWORD bytes; WORD id; };
#pragma pack(pop)
static const int ICON_SHARPEN_PCT = 80;                  // leichtes Nachschärfen nach dem Verkleinern (Vorschau: am klarsten)
// Rohdaten eines RT_ICON-Bilds (BITMAPINFOHEADER… oder PNG)
static const BYTE* IconFrameData(unsigned id, DWORD& len) {
    len = 0;
    HMODULE mod = GetModuleHandleW(nullptr);
    HRSRC r = FindResourceW(mod, MAKEINTRESOURCEW(id), RT_ICON);
    HGLOBAL g = r ? LoadResource(mod, r) : nullptr;
    const BYTE* d = g ? (const BYTE*)LockResource(g) : nullptr;
    if (d) len = SizeofResource(mod, r);
    return len ? d : nullptr;
}
// Alle Bilder der Icon-Gruppe resId: Größe, Bit/Pixel, PNG oder BMP, RT_ICON-Id
static std::vector<IconFrameInfo> IconReadFrames(int resId) {
    std::vector<IconFrameInfo> out;
    HMODULE mod = GetModuleHandleW(nullptr);
    HRSRC r = FindResourceW(mod, MAKEINTRESOURCEW(resId), RT_GROUP_ICON);
    HGLOBAL g = r ? LoadResource(mod, r) : nullptr;
    const BYTE* d = g ? (const BYTE*)LockResource(g) : nullptr;
    const DWORD sz = r ? SizeofResource(mod, r) : 0;
    if (!d || sz < 6) return out;
    const int n = std::min<int>(*(const WORD*)(d + 4), (int)((sz - 6) / sizeof(IconGrpEntry)));
    for (int i = 0; i < n; ++i) {
        const IconGrpEntry* e = (const IconGrpEntry*)(d + 6 + i * sizeof(IconGrpEntry));
        IconFrameInfo f;
        f.w = e->w ? e->w : 256;
        f.h = e->h ? e->h : 256;
        f.bpp = e->bpp;
        f.id = e->id;
        DWORD len = 0;
        const BYTE* p = IconFrameData(f.id, len);
        if (p && len >= 8 && p[0] == 0x89 && p[1] == 'P' && p[2] == 'N' && p[3] == 'G') f.png = true;
        else if (p && len >= sizeof(BITMAPINFOHEADER) && !f.bpp) f.bpp = ((const BITMAPINFOHEADER*)p)->biBitCount;
        if (f.png && !f.bpp) f.bpp = 32;
        out.push_back(f);
    }
    return out;
}
// Eigene GUID-Konstanten (CLSID_WICImagingFactory / GUID_WICPixelFormat32bppPBGRA), damit kein Import aus einer
// UUID-Bibliothek nötig ist; WICBitmapInterpolationModeHighQualityCubic (= 4, ab Windows 10) steht nicht in jedem SDK.
static const GUID kClsidWICImagingFactory = { 0xcacaf262, 0x9370, 0x4615,{ 0xa1, 0x3b, 0x9f, 0x55, 0x39, 0xda, 0x4c, 0x0a } };
static const GUID kWICPixelFormat32bppPBGRA = { 0x6fddc324, 0x4e03, 0x4bfe,{ 0xb1, 0x85, 0x3d, 0x77, 0x76, 0x8d, 0xc9, 0x10 } };
static const WICBitmapInterpolationMode kWICHighQualityCubic = (WICBitmapInterpolationMode)4;
template <class T> static void IconComRelease(T*& p) { if (p) { p->Release(); p = nullptr; } }
// Ein RT_ICON-Bild (BMP oder PNG) per WIC auf size x size vormultipliziertes BGRA bringen; how = verwendeter Filter
static bool IconScaleWIC(const BYTE* data, DWORD len, const IconFrameInfo& f, int size, std::vector<unsigned>& out, const char*& how) {
    how = "-";
    if (!data || !len || size <= 0 || size > 256) return false;
    // Einzelbild-.ico im Speicher (ICONDIR + 1 Eintrag + Bilddaten) -> der ICO-Decoder von WIC liest BMP- und PNG-Bilder
    std::vector<BYTE> ico(22 + (size_t)len, 0);
    ico[2] = 1; ico[4] = 1;
    ico[6] = (BYTE)(f.w >= 256 ? 0 : f.w); ico[7] = (BYTE)(f.h >= 256 ? 0 : f.h);
    ico[10] = 1; ico[12] = (BYTE)(f.bpp & 255); ico[13] = (BYTE)(f.bpp >> 8);
    const DWORD off = 22;
    memcpy(&ico[14], &len, 4);
    memcpy(&ico[18], &off, 4);
    memcpy(&ico[22], data, len);
    const HRESULT hrCo = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
    bool ok = false;
    IWICImagingFactory* fac = nullptr;
    IWICStream* st = nullptr;
    IWICBitmapDecoder* dec = nullptr;
    IWICBitmapFrameDecode* fr = nullptr;
    IWICFormatConverter* cv = nullptr;
    IWICBitmapScaler* sc = nullptr;
    if (SUCCEEDED(CoCreateInstance(kClsidWICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, __uuidof(IWICImagingFactory), (void**)&fac)) && fac &&
        SUCCEEDED(fac->CreateStream(&st)) && st && SUCCEEDED(st->InitializeFromMemory(ico.data(), (DWORD)ico.size())) &&
        SUCCEEDED(fac->CreateDecoderFromStream(st, nullptr, WICDecodeMetadataCacheOnLoad, &dec)) && dec &&
        SUCCEEDED(dec->GetFrame(0, &fr)) && fr && SUCCEEDED(fac->CreateFormatConverter(&cv)) && cv &&
        SUCCEEDED(cv->Initialize(fr, kWICPixelFormat32bppPBGRA, WICBitmapDitherTypeNone, nullptr, 0.0, WICBitmapPaletteTypeCustom))) {
        UINT sw = 0, sh = 0;
        cv->GetSize(&sw, &sh);
        IWICBitmapSource* src = nullptr;
        if ((int)sw == size && (int)sh == size) { src = cv; how = "WIC 1:1"; }
        else {
            const WICBitmapInterpolationMode modes[2] = { kWICHighQualityCubic, WICBitmapInterpolationModeFant };
            const char* names[2] = { "WIC HighQualityCubic", "WIC Fant" };
            for (int m = 0; m < 2 && !src; ++m) {
                IconComRelease(sc);
                if (SUCCEEDED(fac->CreateBitmapScaler(&sc)) && sc && SUCCEEDED(sc->Initialize(cv, (UINT)size, (UINT)size, modes[m]))) {
                    src = sc;
                    how = names[m];
                }
            }
        }
        if (src) {
            out.assign((size_t)size * size, 0);
            ok = SUCCEEDED(src->CopyPixels(nullptr, (UINT)size * 4, (UINT)(out.size() * 4), (BYTE*)out.data()));
        }
    }
    IconComRelease(sc);
    IconComRelease(cv);
    IconComRelease(fr);
    IconComRelease(dec);
    IconComRelease(st);
    IconComRelease(fac);
    if (SUCCEEDED(hrCo)) CoUninitialize();
    return ok;
}
// 32-Bit-DIB (oben beginnend) mit vormultipliziertem BGRA – für AlphaBlend (AC_SRC_ALPHA) 1:1
static HBITMAP IconMakePBGRABitmap(const std::vector<unsigned>& px, int size) {
    if (size <= 0 || px.size() < (size_t)size * size) return nullptr;
    BITMAPINFO bi = {};
    bi.bmiHeader.biSize = sizeof(bi.bmiHeader);
    bi.bmiHeader.biWidth = size;
    bi.bmiHeader.biHeight = -size;
    bi.bmiHeader.biPlanes = 1;
    bi.bmiHeader.biBitCount = 32;
    bi.bmiHeader.biCompression = BI_RGB;
    void* bits = nullptr;
    HBITMAP bmp = CreateDIBSection(nullptr, &bi, DIB_RGB_COLORS, &bits, nullptr, 0);
    if (bmp && bits) memcpy(bits, px.data(), (size_t)size * size * 4);
    else if (bmp) { DeleteObject(bmp); bmp = nullptr; }
    return bmp;
}
// HICON aus vormultipliziertem BGRA (Icons erwarten nicht vormultipliziertes Alpha -> zurückrechnen)
static HICON IconFromPBGRA(const std::vector<unsigned>& px, int size) {
    if (size <= 0 || px.size() < (size_t)size * size) return nullptr;
    std::vector<unsigned> straight((size_t)size * size, 0);
    for (size_t i = 0; i < straight.size(); ++i) {
        const unsigned p = px[i], a = p >> 24;
        if (!a) continue;
        auto un = [a](unsigned c) { return std::min(255u, (c * 255 + a / 2) / a); };
        straight[i] = (a << 24) | (un((p >> 16) & 255) << 16) | (un((p >> 8) & 255) << 8) | un(p & 255);
    }
    HBITMAP color = IconMakePBGRABitmap(straight, size);
    std::vector<BYTE> maskBits((size_t)((size + 15) / 16) * 2 * size, 0);   // Maske 0 = deckend, Alpha entscheidet
    HBITMAP mask = CreateBitmap(size, size, 1, 1, maskBits.data());
    HICON out = nullptr;
    if (color && mask) {
        ICONINFO ni = {};
        ni.fIcon = TRUE;
        ni.hbmMask = mask;
        ni.hbmColor = color;
        out = CreateIconIndirect(&ni);
    }
    if (color) DeleteObject(color);
    if (mask) DeleteObject(mask);
    return out;
}
// 32-Bit-Icon (mit Alpha) per Flächenmittel von from auf to Pixel verkleinern; nullptr, wenn nicht möglich
static HICON IconDownscale(HICON src, int from, int to) {
    ICONINFO ii = {};
    if (!src || from <= to || to <= 0 || !GetIconInfo(src, &ii)) return nullptr;
    HICON out = nullptr;
    HDC dc = GetDC(nullptr);
    std::vector<unsigned> px((size_t)from * from, 0);
    BITMAPINFO bi = {};
    bi.bmiHeader.biSize = sizeof(bi.bmiHeader);
    bi.bmiHeader.biWidth = from;
    bi.bmiHeader.biHeight = -from;
    bi.bmiHeader.biPlanes = 1;
    bi.bmiHeader.biBitCount = 32;
    bi.bmiHeader.biCompression = BI_RGB;
    bool ok = dc && ii.hbmColor && GetDIBits(dc, ii.hbmColor, 0, from, px.data(), &bi, DIB_RGB_COLORS) == from;
    if (ok) { ok = false; for (unsigned p : px) if (p >> 24) { ok = true; break; } }   // ohne Alpha-Kanal: normaler Weg
    if (ok) {
        BITMAPINFO bo = bi;
        bo.bmiHeader.biWidth = to;
        bo.bmiHeader.biHeight = -to;
        void* bits = nullptr;
        HBITMAP color = CreateDIBSection(dc, &bo, DIB_RGB_COLORS, &bits, nullptr, 0);
        std::vector<BYTE> maskBits((size_t)((to + 15) / 16) * 2 * to, 0);   // Maske 0 = deckend, Alpha entscheidet
        HBITMAP mask = CreateBitmap(to, to, 1, 1, maskBits.data());
        if (color && mask && bits) {
            unsigned* o = (unsigned*)bits;
            const double f = (double)from / to;
            for (int y = 0; y < to; ++y) {
                const double y0 = y * f, y1 = (y + 1) * f;
                for (int x = 0; x < to; ++x) {
                    const double x0 = x * f, x1 = (x + 1) * f;
                    double a = 0, r = 0, gr = 0, b = 0, area = 0;
                    for (int sy = (int)y0; sy < from && sy < y1; ++sy) {
                        const double wy = std::min(y1, sy + 1.0) - std::max(y0, (double)sy);
                        for (int sx = (int)x0; sx < from && sx < x1; ++sx) {
                            const double w = wy * (std::min(x1, sx + 1.0) - std::max(x0, (double)sx));
                            const unsigned p = px[(size_t)sy * from + sx];
                            const double pa = (p >> 24) * w;
                            a += pa; r += ((p >> 16) & 255) * pa; gr += ((p >> 8) & 255) * pa; b += (p & 255) * pa;
                            area += w;
                        }
                    }
                    unsigned A = 0, R = 0, G = 0, B = 0;
                    if (area > 0 && a > 0) {
                        A = (unsigned)std::min(255.0, a / area + 0.5);
                        R = (unsigned)std::min(255.0, r / a + 0.5); G = (unsigned)std::min(255.0, gr / a + 0.5); B = (unsigned)std::min(255.0, b / a + 0.5);
                    }
                    o[(size_t)y * to + x] = (A << 24) | (R << 16) | (G << 8) | B;
                }
            }
            ICONINFO ni = {};
            ni.fIcon = TRUE;
            ni.hbmMask = mask;
            ni.hbmColor = color;
            out = CreateIconIndirect(&ni);
        }
        if (color) DeleteObject(color);
        if (mask) DeleteObject(mask);
    }
    if (dc) ReleaseDC(nullptr, dc);
    if (ii.hbmColor) DeleteObject(ii.hbmColor);
    if (ii.hbmMask) DeleteObject(ii.hbmMask);
    return out;
}
// Icon resId in genau size x size Pixel: größtes Bild -> WIC (HighQualityCubic) -> leicht nachschärfen.
// wantBitmap: zusätzlich ein vormultipliziertes 32-Bit-Bild für AlphaBlend (Blase).
struct SharpIcon { HICON icon = nullptr; HBITMAP pbgra = nullptr; int size = 0; };
static SharpIcon LoadSharpIcon(int resId, int size, bool wantBitmap) {
    SharpIcon r;
    r.size = size;
    HINSTANCE inst = GetModuleHandleW(nullptr);
    const std::vector<IconFrameInfo> frames = IconReadFrames(resId);
    const int bi = IconPickLargest(frames);
    const char* how = "-";
    if (bi >= 0) {
        DWORD len = 0;
        const BYTE* d = IconFrameData(frames[bi].id, len);
        std::vector<unsigned> px;
        if (IconScaleWIC(d, len, frames[bi], size, px, how)) {
            if (frames[bi].w != size) IconSharpenPBGRA(px, size, ICON_SHARPEN_PCT);
            if (wantBitmap) r.pbgra = IconMakePBGRABitmap(px, size);
            r.icon = IconFromPBGRA(px, size);
        }
    }
    if (!r.icon && bi >= 0 && frames[bi].w > size) {   // ohne WIC: größtes Bild selbst per Flächenmittel verkleinern
        HICON big = (HICON)LoadImageW(inst, MAKEINTRESOURCEW(resId), IMAGE_ICON, frames[bi].w, frames[bi].h, LR_DEFAULTCOLOR);
        r.icon = IconDownscale(big, frames[bi].w, size);
        if (big) DestroyIcon(big);
    }
    if (!r.icon) {
        r.icon = (HICON)LoadImageW(inst, MAKEINTRESOURCEW(resId), IMAGE_ICON, size, size, LR_DEFAULTCOLOR);
    }
    return r;
}
static HICON LoadIconSharp(int resId, int size) { return LoadSharpIcon(resId, size, false).icon; }
// Icons der Fund-Blase (Bagger, Kleeblatt) in BUBBLE_ICON_PX: einmal laden und behalten (statt bei jedem Slide-Bild neu)
static SharpIcon g_bubbleIcon[5];   // Fix 41: [2] = Rakete, Fix 44: [3] = Ei, Fix 120: [4] = Drohne

// ===== Sprechblase (Bubble) =====
// Zeichnet die Such-Blase („searching“ / „Start in: X“) mit Pixel-Alpha (UpdateLayeredWindow)
static void PaintSearchingBubbleLayered(HWND hwnd) {
    RECT wr{};
    if (!GetWindowRect(hwnd, &wr)) return;

    const int w = wr.right - wr.left;
    const int h = wr.bottom - wr.top;
    if (w <= 0 || h <= 0) return;

    BITMAPINFO bmi{};
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = w;
    bmi.bmiHeader.biHeight = -h;
    bmi.bmiHeader.biPlanes = 1;
    bmi.bmiHeader.biBitCount = 32;
    bmi.bmiHeader.biCompression = BI_RGB;

    HDC memDC = CreateCompatibleDC(nullptr);
    if (!memDC) return;

    void* pixelData = nullptr;
    HBITMAP bitmap = CreateDIBSection(memDC, &bmi, DIB_RGB_COLORS, &pixelData, nullptr, 0);
    if (!bitmap || !pixelData) {
        if (bitmap) DeleteObject(bitmap);
        DeleteDC(memDC);
        return;
    }

    HGDIOBJ oldBitmap = SelectObject(memDC, bitmap);

    // Außenbereich mit Farbschlüssel füllen – wird später voll transparent
    constexpr DWORD TRANSPARENT_KEY = 0x00010001u;
    DWORD* pixels = static_cast<DWORD*>(pixelData);
    const size_t count = static_cast<size_t>(w) * static_cast<size_t>(h);
    std::fill(pixels, pixels + count, TRANSPARENT_KEY);

    // Slide: Körper um off px nach rechts verschoben, links davon bleibt alles durchsichtig
    const int off = std::max(0, std::min(g_bubbleSlideOffset, w));
    // Schwarzer Körper mit grauem Rand
    HPEN pen = CreatePen(PS_SOLID, 1, RGB(80, 80, 80));
    HBRUSH bg = CreateSolidBrush(RGB(0, 0, 0));
    HGDIOBJ oldPen = SelectObject(memDC, pen);
    HGDIOBJ oldBrush = SelectObject(memDC, bg);
    if (off < w) Rectangle(memDC, off, 0, off + w, h);
    SelectObject(memDC, oldPen);
    SelectObject(memDC, oldBrush);
    DeleteObject(pen);
    DeleteObject(bg);

    SetBkMode(memDC, TRANSPARENT);
    int fontSize = 18;
    // Während der Start-Verzögerung „Start in: X“ (grün) statt „searching“ anzeigen
    int cd = 0;
    if (g_lastWarRunning.load()) {
        auto now = std::chrono::steady_clock::now();
        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(now - TicksToTimePoint(g_cooldownStart.load())).count();
        const int startIn = StartInSeconds();
        if (elapsed >= 0 && elapsed < startIn) cd = startIn - (int)elapsed;
    }
    if (cd > 0) fontSize = 20;
    HFONT font = CreateFontW(fontSize, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        ANTIALIASED_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
    HFONT oldFont = (HFONT)SelectObject(memDC, font);

    RECT textRc{ off, 0, off + w, h };
    std::wstring text;
    COLORREF textColor = RGB(255, 255, 255);

    if (cd > 0) {
        text = L"Start in: " + std::to_wstring(cd);
        textColor = RGB(100, 220, 100);
    }
    else {
        std::wstring dots(g_bubbleDots, L'.');
        text = L"searching" + dots;
        textColor = RGB(255, 255, 255);
    }

    SetTextColor(memDC, textColor);
    if (off < w) DrawTextW(memDC, text.c_str(), -1, &textRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

    SelectObject(memDC, oldFont);
    DeleteObject(font);

    // In vormultipliziertes BGRA umrechnen und mit dem Fade-Alpha skalieren
    constexpr BYTE BASE_BACKGROUND_ALPHA = 255;
    const float fade = g_bubbleAlpha / 255.0f;
    for (size_t i = 0; i < count; ++i) {
        const DWORD rgb = pixels[i] & 0x00FFFFFFu;
        if (rgb == TRANSPARENT_KEY) {
            pixels[i] = 0x00000000u;
        }
        else if (rgb == 0) {
            BYTE a = (BYTE)(BASE_BACKGROUND_ALPHA * fade);
            pixels[i] = (static_cast<DWORD>(a) << 24);
        }
        else if (rgb == 0x00505050u) {
            BYTE a = (BYTE)(255 * fade);
            pixels[i] = (static_cast<DWORD>(a) << 24) | 0x00505050u;
        }
        else {
            const BYTE r = static_cast<BYTE>((rgb >> 16) & 0xFFu);
            const BYTE g = static_cast<BYTE>((rgb >> 8) & 0xFFu);
            const BYTE b = static_cast<BYTE>(rgb & 0xFFu);
            if (r == g && g == b) {
                BYTE a = (BYTE)(r * fade);
                pixels[i] = (static_cast<DWORD>(a) << 24) |
                    (static_cast<DWORD>(a) << 16) |
                    (static_cast<DWORD>(a) << 8) |
                    static_cast<DWORD>(a);
            }
            else {
                BYTE a = (BYTE)(255 * fade);
                pixels[i] = (static_cast<DWORD>(a) << 24) | (rgb & 0x00FFFFFFu);
            }
        }
    }

    // Bild auf das Layered-Fenster übertragen
    HDC screenDC = GetDC(nullptr);
    if (screenDC) {
        POINT dst{ wr.left, wr.top };
        POINT srcPt{ 0, 0 };
        SIZE size{ w, h };
        BLENDFUNCTION blend{ AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
        UpdateLayeredWindow(hwnd, screenDC, &dst, &size, memDC, &srcPt, 0, &blend, ULW_ALPHA);
        ReleaseDC(nullptr, screenDC);
    }

    SelectObject(memDC, oldBitmap);
    DeleteObject(bitmap);
    DeleteDC(memDC);
}

// Vorwärtsdeklaration (Definition weiter unten)
static void PositionBubbleToLastWar();
// ===== Slide-Animation der Blasen (kein Ein-/Ausblenden über Alpha) =====
// Neu zeichnen mit aktuellem g_bubbleSlideOffset
static void BubbleRepaint(HWND hwnd) {
    if (g_isDigFoundBubble) { InvalidateRect(hwnd, nullptr, FALSE); UpdateWindow(hwnd); }
    else PaintSearchingBubbleLayered(hwnd);
}
// Rein (von rechts an die normale Position, ease-out) bzw. raus (nach rechts, ease-in, danach schließen).
// Startet vom aktuellen Versatz -> eine laufende Animation kann umgekehrt werden.
static void BubbleStartSlide(HWND hwnd, bool slideIn) {
    if (!hwnd || !IsWindow(hwnd)) return;
    RECT wr{};
    int w = (GetWindowRect(hwnd, &wr) && wr.right > wr.left) ? (wr.right - wr.left) : g_bubbleW;
    g_slideFrom = std::max(0, std::min(g_bubbleSlideOffset, w));
    g_slideTo = slideIn ? 0 : w;
    int full = slideIn ? BUBBLE_SLIDE_IN_MS : BUBBLE_SLIDE_OUT_MS;
    g_slideDur = std::max(1, MulDiv(full, std::abs(g_slideTo - g_slideFrom), std::max(1, w)));
    g_slideStart = GetTickCount64();
    g_bubbleFadingIn = slideIn;      // „fährt herein“
    g_bubbleClosing = !slideIn;      // „fährt hinaus und wird danach geschlossen“
    SetTimer(hwnd, 2, 10, nullptr);
}
// Fensterprozedur der Sprechblase (Such-Blase und DIG-FOUND-Blase)
static LRESULT CALLBACK BubbleWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
    case WM_SETCURSOR:
        SetCursor(LoadCursor(nullptr, IDC_ARROW));
        return TRUE;
    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hwnd, &ps);
        // Such-Blase wird komplett layered gezeichnet
        if (!g_isDigFoundBubble) {
            EndPaint(hwnd, &ps);
            PaintSearchingBubbleLayered(hwnd);
            return 0;
        }
        RECT rc; GetClientRect(hwnd, &rc);
        // Doppelpuffer; Blase um den Slide-Versatz nach rechts verschoben, freigelegte Fläche = Farbschlüssel (durchsichtig)
        HDC paintDC = hdc;
        HDC memDC = CreateCompatibleDC(paintDC);
        HBITMAP memBmp = memDC ? CreateCompatibleBitmap(paintDC, std::max(1L, rc.right), std::max(1L, rc.bottom)) : nullptr;
        HGDIOBJ oldMemBmp = nullptr;
        if (memDC && memBmp) { oldMemBmp = SelectObject(memDC, memBmp); hdc = memDC; }
        {
            HBRUSH keyBr = CreateSolidBrush(BUBBLE_SLIDE_KEY);
            FillRect(hdc, &rc, keyBr);
            DeleteObject(keyBr);
        }
        const int slideOff = std::max(0, std::min<int>(g_bubbleSlideOffset, rc.right));
        SetViewportOrgEx(hdc, slideOff, 0, nullptr);
        const bool luckyBubble = (g_bubbleKind == 1);
        const bool fireworkBubble = (g_bubbleKind == 2);   // Fix 41
        const bool eggBubble = (g_bubbleKind == 3);   // Fix 44: wie Lucky (Wort gelb, Absender lila)
        const bool droneBubble = (g_bubbleKind == 4);   // Fix 120: wie Dig (2 Zeilen, Ort unterstrichen), Wort lila, Drohnen-Icon

        // DIG-FOUND-Blase: schwarzer Hintergrund mit abgerundetem Rahmen
        HBRUSH bg = CreateSolidBrush(RGB(0, 0, 0));
        FillRect(hdc, &rc, bg);
        DeleteObject(bg);

        HPEN pen = CreatePen(PS_SOLID, 1, RGB(80, 80, 80));
        HPEN oldPen = (HPEN)SelectObject(hdc, pen);
        HBRUSH nullBrush = (HBRUSH)SelectObject(hdc, GetStockObject(NULL_BRUSH));
        RoundRect(hdc, 0, 0, rc.right, rc.bottom, 10, 10);

        SelectObject(hdc, oldPen);
        SelectObject(hdc, nullBrush);
        DeleteObject(pen);

        SetBkMode(hdc, TRANSPARENT);
        HFONT font = CreateFontW(18, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
        HFONT oldFont = (HFONT)SelectObject(hdc, font);

        // Fix 34: Icon (Bagger bzw. Kleeblatt) vor zwei Zeilen Text wie im Log (siehe NotifyLines), Block zentriert
        if (g_isDigFoundBubble) {
            const NotifyLines& t = g_bubbleText;
            HFONT tf = CreateFontW(g_bubbleFontPx, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
                CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
            HFONT uf = (luckyBubble || fireworkBubble || eggBubble) ? nullptr : CreateFontW(g_bubbleFontPx, 0, 0, 0, FW_NORMAL, FALSE, TRUE, FALSE, DEFAULT_CHARSET,
                OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
            if (tf) SelectObject(hdc, tf);
            auto textW = [&](const std::wstring& x) { SIZE z = {}; if (!x.empty()) GetTextExtentPoint32W(hdc, x.c_str(), (int)x.size(), &z); return (int)z.cx; };
            const int iconSize = BUBBLE_ICON_PX, spacing = BUBBLE_ICON_GAP;   // Fix 36: 28 px aus dem 256er-Bild
            const bool two = !fireworkBubble && !t.line2.empty();   // Fix 42: Feuerwerk nur eine Zeile (mittig)
            const bool colon = !fireworkBubble && t.colon;
            const int w1 = textW(t.line1), wc = colon ? textW(L":") : 0, w2 = two ? textW(t.line2) : 0;
            const int maxText = BubbleMaxTextW((int)rc.right);   // Fix 36: breiter als 60 % der Arbeitsfläche -> „…“
            const int blockW = std::min(maxText, std::max(w1 + wc, w2));
            const int total = iconSize + spacing + blockW;
            int startX = ((int)rc.right - 22 - total) / 2 + 9;   // rechts 22 px für das × freihalten (wie bisher)
            if (startX < 6) startX = 6;
            TEXTMETRICW tm = {};
            GetTextMetricsW(hdc, &tm);
            const int lh = tm.tmHeight > 0 ? (int)tm.tmHeight : g_bubbleFontPx;
            const int blockH = two ? 2 * lh + 1 : lh;
            const int top = std::max(0, ((int)rc.bottom - blockH) / 2);
            SharpIcon& icon = g_bubbleIcon[droneBubble ? 4 : (eggBubble ? 3 : (fireworkBubble ? 2 : (luckyBubble ? 1 : 0)))];
            if (!icon.icon && !icon.pbgra) icon = LoadSharpIcon(droneBubble ? IDI_TEST_DRONE : (eggBubble ? IDI_GOLDEN_EGG : (fireworkBubble ? IDI_FIREWORK : (luckyBubble ? IDI_LUCKY_GIFT : DigIconId()))), iconSize, true);   // Fix 36/41/44/120
            if (!icon.icon && !icon.pbgra && droneBubble) icon = LoadSharpIcon(DigIconId(), iconSize, true);   // Fix 120: ohne 904 -> Bagger
            {
                int iconY = ((int)rc.bottom - iconSize) / 2;
                if (iconY < 0) iconY = 0;
                const int iconX = BubbleIconX(startX);   // Fix 38/39: 5 px weiter links, Text unverändert
                bool drawn = false;
                if (icon.pbgra) {   // vormultipliziertes Bild 1:1 per (Gdi)AlphaBlend, AC_SRC_ALPHA (kein Strecken)
                    HDC sdc = CreateCompatibleDC(hdc);
                    if (sdc) {
                        HGDIOBJ ob = SelectObject(sdc, icon.pbgra);
                        BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
                        drawn = GdiAlphaBlend(hdc, iconX, iconY, iconSize, iconSize, sdc, 0, 0, iconSize, iconSize, bf) != FALSE;
                        SelectObject(sdc, ob);
                        DeleteDC(sdc);
                    }
                }
                if (!drawn && icon.icon) DrawIconEx(hdc, iconX, iconY, icon.icon, iconSize, iconSize, 0, nullptr, DI_NORMAL);
            }
            const int tx = startX + iconSize + spacing;
            const UINT fl = DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS;
            // Zeile 1: Dig-Text grün bzw. Lucky-Wort goldgelb (+ „:“ weiß)
            const int w1d = std::min(w1, std::max(1, maxText - wc));
            RECT r1 = { tx, top, tx + w1d + 1, top + lh };
            SetTextColor(hdc, droneBubble ? DRONE_COLOR : (eggBubble ? EGG_COLOR : (fireworkBubble ? FIREWORK_COLOR : (luckyBubble ? LUCKY_GIFT_COLOR : RGB(0, 255, 0)))));
            DrawTextW(hdc, t.line1.c_str(), (int)t.line1.size(), &r1, fl);
            if (colon) {
                RECT rc1 = { tx + w1d, top, tx + w1d + wc + 2, top + lh };
                SetTextColor(hdc, RGB(255, 255, 255));
                DrawTextW(hdc, L":", 1, &rc1, fl);
            }
            // Zeile 2: Warzone-Teil weiß unterstrichen bzw. Absender lila
            if (two) {
                RECT r2 = { tx, top + lh + 1, tx + std::min(w2, maxText) + 1, top + 2 * lh + 1 };
                if (uf) SelectObject(hdc, uf);
                SetTextColor(hdc, (luckyBubble || eggBubble) ? LUCKY_SENDER_COLOR : RGB(255, 255, 255));   // Fix 42: Feuerwerk hat keine Zeile 2
                DrawTextW(hdc, t.line2.c_str(), (int)t.line2.size(), &r2, fl);
            }
            SelectObject(hdc, font);
            if (tf) DeleteObject(tf);
            if (uf) DeleteObject(uf);
        }
        else {
            SetTextColor(hdc, RGB(255, 255, 255));
            std::wstring dots(g_bubbleDots, L'.');
            std::wstring text = L"searching" + dots;
            DrawTextW(hdc, text.c_str(), -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
        }

        // Schließen-Symbol (×) oben rechts
        if (g_isDigFoundBubble) {
            RECT closeRc = { rc.right - 18, 2, rc.right - 4, 16 };
            SetTextColor(hdc, RGB(180, 180, 180));
            DrawTextW(hdc, L"×", -1, &closeRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
        }

        SelectObject(hdc, oldFont);
        DeleteObject(font);

        SetViewportOrgEx(hdc, 0, 0, nullptr);
        if (hdc != paintDC) {
            BitBlt(paintDC, 0, 0, rc.right, rc.bottom, hdc, 0, 0, SRCCOPY);
            SelectObject(memDC, oldMemBmp);
            hdc = paintDC;
        }
        if (memBmp) DeleteObject(memBmp);
        if (memDC) DeleteDC(memDC);

        EndPaint(hwnd, &ps);
        return 0;
    }
    case WM_MOUSEMOVE:
        // Fix 36: Maus über der Fund-Blase -> Ausblend-Countdown anhalten, bis die Maus sie verlässt (WM_MOUSELEAVE)
        if (g_isDigFoundBubble && !g_bubbleHover) {
            g_bubbleHover = true;
            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd, 0 };
            TrackMouseEvent(&tme);
            // fährt sie gerade von selbst hinaus (Zeit abgelaufen, nicht per Klick), wieder hereinholen
            if (g_bubbleClosing && !g_bubbleUserClose) BubbleStartSlide(hwnd, true);
        }
        return 0;
    case WM_MOUSELEAVE:
        // Fix 36: Countdown läuft weiter – Restzeit, mindestens aber ~1,6 s
        if (g_bubbleHover) {
            g_bubbleHover = false;
            g_bubbleTicks = BubbleTicksAfterLeave(g_bubbleTicks);
        }
        return 0;
    case WM_LBUTTONUP: {
        // Klick-Logik: × schließt nur die DIG-FOUND-Blase, Klick auf die Blase öffnet das Hauptfenster
        POINT pt = { GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
        RECT rc; GetClientRect(hwnd, &rc);
        RECT closeRc = { rc.right - 18, 2, rc.right - 4, 16 };
        if (g_isDigFoundBubble && PtInRect(&closeRc, pt)) {
            // Klick auf ×: Blase nach rechts hinausfahren
            g_bubbleUserClose = true;
            if (!g_bubbleClosing) BubbleStartSlide(hwnd, false);
        }
        else {
            const bool foundBubble = g_isDigFoundBubble;   // Fix 31: nur Dig-/Lucky-Blase (nicht die Such-Blase)
            // Klick auf die Blase: DIG-FOUND-Blase schließen
            if (g_isDigFoundBubble) g_bubbleUserClose = true;
            if (g_isDigFoundBubble && !g_bubbleClosing) BubbleStartSlide(hwnd, false);
            // Hauptfenster öffnen – gleiche Logik wie Linksklick aufs Tray-Icon
            if (g_hWnd && IsWindow(g_hWnd))
                SendMessageW(g_hWnd, WM_TRAYICON, 0, (LPARAM)WM_LBUTTONUP);
            if (foundBubble) LogGlowStart();               // Fix 31: zugehörige Log-Zeile aufleuchten lassen
        }
        return 0;
    }
    case WM_TIMER:
        // Timer 3: Blase am Last-War-Fenster ausrichten
        if (wParam == 3) {
            PositionBubbleToLastWar();
            return 0;
        }
        // Timer 1: DIG-FOUND-Blase nach ca. 12 Ticks ausblenden (pausiert, solange die Maus darüber ist), Such-Blase: Punkte
        if (wParam == 1) {
            if (g_isDigFoundBubble) {
                g_bubbleTicks = BubbleNextTick(g_bubbleTicks, g_bubbleHover);
                if (BubbleShouldHide(g_bubbleTicks, g_bubbleHover, g_bubbleClosing)) BubbleStartSlide(hwnd, false);
            }
            else {
                g_bubbleTicks++;
                g_bubbleDots = (g_bubbleDots % 3) + 1;
                InvalidateRect(hwnd, nullptr, TRUE);
            }
        }
        else if (wParam == 2) {
            // Timer 2: Slide-Animation (rein: ease-out, raus: ease-in), zeitbasiert, voll deckend (kein Fade)
            ULONGLONG el = GetTickCount64() - g_slideStart;
            double t = (el >= (ULONGLONG)g_slideDur) ? 1.0 : (double)el / (double)g_slideDur;
            double e = (g_slideTo < g_slideFrom) ? 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t) : t * t * t;
            g_bubbleSlideOffset = g_slideFrom + (int)((g_slideTo - g_slideFrom) * e + (g_slideTo >= g_slideFrom ? 0.5 : -0.5));
            if (t >= 1.0) g_bubbleSlideOffset = g_slideTo;
            BubbleRepaint(hwnd);
            if (t >= 1.0) {
                KillTimer(hwnd, 2);
                g_bubbleFadingIn = false;
                if (g_bubbleClosing) {
                    DestroyWindow(hwnd);
                    g_hBubble = nullptr;
                    return 0;
                }
            }
        }
        return 0;
    case WM_DESTROY:
        g_hBubble = nullptr;
        g_isDigFoundBubble = false;
        g_bubbleHover = false;
        g_bubbleUserClose = false;
        return 0;
    }
    return DefWindowProcW(hwnd, msg, wParam, lParam);
}

// Prüft per Prozessliste, ob die PID zu LastWar.exe gehört (klappt auch ohne Zugriffsrechte auf den Prozess)
static bool IsLastWarProcessId(DWORD pid) {
    if (!pid) return false;
    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snap == INVALID_HANDLE_VALUE) return false;
    bool result = false;
    PROCESSENTRY32W pe{ sizeof(pe) };
    if (Process32FirstW(snap, &pe)) {
        do { if (pe.th32ProcessID == pid) { result = (_wcsicmp(pe.szExeFile, L"LastWar.exe") == 0); break; } } while (Process32NextW(snap, &pe));
    }
    CloseHandle(snap);
    return result;
}
// Sucht das Last-War-Spielfenster (exakter Titel, sonst Titel mit „Last War“ –
// dann aber nur Fenster von LastWar.exe, nie die eigenen Fenster oder z. B. einen Browser-Tab)
static HWND FindLastWarWindowUncached() {
    HWND hwnd = FindWindowW(nullptr, L"Last War-Survival Game");
    if (hwnd && IsWindowVisible(hwnd)) return hwnd;
    const DWORD ownPid = GetCurrentProcessId();
    hwnd = nullptr;
    while ((hwnd = FindWindowExW(nullptr, hwnd, nullptr, nullptr)) != nullptr) {
        if (!IsWindowVisible(hwnd)) continue;
        DWORD wndPid = 0;
        GetWindowThreadProcessId(hwnd, &wndPid);
        if (wndPid == ownPid) continue;
        wchar_t title[256] = {};
        GetWindowTextW(hwnd, title, 256);
        if (wcsstr(title, L"Last War") != nullptr && IsLastWarProcessId(wndPid)) {
            return hwnd;
        }
    }
    return nullptr;
}
// Wie oben, aber mit Zwischenspeicher: die Fenstersuche läuft nur, wenn das gemerkte Fenster
// ungültig/unsichtbar ist, sonst höchstens alle 250 ms (die Position selbst wird weiter bei jedem Tick gelesen)
static HWND FindLastWarWindow() {
    static HWND s_cached = nullptr;
    static ULONGLONG s_lastLookup = 0;
    static bool s_haveLookup = false;
    ULONGLONG nowTick = GetTickCount64();
    bool fresh = s_haveLookup && (nowTick - s_lastLookup < 250);
    if (fresh) {
        if (!s_cached) return nullptr;
        if (IsWindow(s_cached) && IsWindowVisible(s_cached)) return s_cached;
    }
    s_cached = FindLastWarWindowUncached();
    s_lastLookup = nowTick;
    s_haveLookup = true;
    return s_cached;
}

// Positioniert die Blase oben rechts am Last-War-Fenster (bei Vollbild am Bildschirmrand)
static void PositionBubbleToLastWar() {
    if (!g_hBubble || !IsWindow(g_hBubble)) return;
    int bw = g_bubbleW, bh = 52;
    int screenW = GetSystemMetrics(SM_CXSCREEN);
    int screenH = GetSystemMetrics(SM_CYSCREEN);

    HWND lw = FindLastWarWindow();
    bool isFullscreen = false;
    RECT r{};
    if (lw && GetWindowRect(lw, &r)) {
        int ww = r.right - r.left;
        int wh = r.bottom - r.top;
        // Vollbild, wenn das Fenster (fast) den ganzen Bildschirm abdeckt
        if (ww >= screenW - 10 && wh >= screenH - 10)
            isFullscreen = true;
    }

    int x, y;
    if (isFullscreen || !lw) {
        x = screenW - bw + 2;
        y = -4;
    }
    else {
        x = r.right - bw - 6;
        y = r.top + 29;
    }
    // Nur verschieben/nach oben holen, wenn sich die Position geändert hat oder ein sichtbares Fenster darüber liegt
    RECT cur{};
    bool samePos = GetWindowRect(g_hBubble, &cur) && cur.left == x && cur.top == y;
    bool covered = false;
    for (HWND above = GetWindow(g_hBubble, GW_HWNDPREV); above; above = GetWindow(above, GW_HWNDPREV)) {
        if (IsWindowVisible(above)) { covered = true; break; }
    }
    if (!samePos || covered)
        SetWindowPos(g_hBubble, HWND_TOPMOST, x, y, bw, bh, SWP_NOACTIVATE | SWP_NOSIZE);
}

// Zeigt die Such-Blase an (falls noch keine Blase offen ist)
static void ShowSpeechBubble() {
    if (g_hBubble && IsWindow(g_hBubble)) return;

    g_isDigFoundBubble = false;
    g_bubbleKind = 0;
    g_bubbleW = 170;
    g_bubbleDots = 1;
    g_bubbleTicks = 0;
    g_bubbleClosing = false;

    WNDCLASSW wc = {};
    wc.lpfnWndProc = BubbleWndProc;
    wc.hInstance = GetModuleHandleW(nullptr);
    wc.lpszClassName = L"SpeechBubbleClass";
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    RegisterClassW(&wc);

    int w = g_bubbleW, h = 52;
    int x = 100, y = 100;
    HWND lw = FindLastWarWindow();
    if (lw) {
        RECT r;
        if (GetWindowRect(lw, &r)) {
            x = r.right - w - 6;
            y = r.top + 29;
        }
    }

    g_hBubble = CreateWindowExW(
        WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_LAYERED,
        L"SpeechBubbleClass", nullptr,
        WS_POPUP,
        x, y, w, h,
        nullptr, nullptr, wc.hInstance, nullptr);

    if (g_hBubble) {
        g_bubbleAlpha = 255;               // voll deckend, kein Fade
        g_bubbleSlideOffset = w;           // startet ganz rechts draußen
        ShowWindow(g_hBubble, SW_SHOWNOACTIVATE);
        // Timer: 1 = Animation, 2 = Slide, 3 = dem Spielfenster folgen
        SetTimer(g_hBubble, 1, 400, nullptr);
        SetTimer(g_hBubble, 3, 8, nullptr);
        PositionBubbleToLastWar();
        InvalidateRect(g_hBubble, nullptr, FALSE);
        BubbleStartSlide(g_hBubble, true);
    }
}

// ===== Sprechblase: DIG FOUND =====
// Zeigt die DIG-FOUND-Blase (ersetzt eine offene Such-Blase) und spielt optional den Sound ab
// kind 0 = Dig, 1 = Lucky Gift; text = Zeilen wie im Log (Fix 34, siehe NotifyLines).
// Kein Cooldown: jeder Fund meldet sich. Es gibt immer höchstens ein Blasenfenster (g_hBubble).
// Fix 23: Ist schon eine Fund-Blase offen (egal welche Art, auch beim Herein-/Hinausfahren), wird DASSELBE Fenster
// mit dem neuen Inhalt (Dig bzw. Lucky Gift) wiederverwendet: laufende Animation abbrechen, ganz nach rechts draußen
// (nur Farbschlüssel = unsichtbar) und von vorn hereinfahren; Anzeigedauer neu starten.
// Fix 36: Blase so breit wie der Text (beide Zeilen) + Icon + Ränder, min. 170, max. 60 % der Arbeitsfläche des Monitors
// mit dem Spiel (sonst Hauptmonitor). Schrift 18 px; passt es so nicht, 17 px; darüber „…“. Höhe bleibt 52. Nutzt g_bubbleText.
static int BubbleWorkWidth() {
    HWND lw = FindLastWarWindow();
    POINT origin = { 0, 0 };
    HMONITOR mon = lw ? MonitorFromWindow(lw, MONITOR_DEFAULTTOPRIMARY) : MonitorFromPoint(origin, MONITOR_DEFAULTTOPRIMARY);
    MONITORINFO mi = {};
    mi.cbSize = sizeof(mi);
    if (mon && GetMonitorInfoW(mon, &mi) && mi.rcWork.right > mi.rcWork.left) return (int)(mi.rcWork.right - mi.rcWork.left);
    return GetSystemMetrics(SM_CXSCREEN);
}
static int BubbleLayoutWidth() {
    const int workW = BubbleWorkWidth();
    int textW = 0;
    g_bubbleFontPx = 18;
    HDC dc = GetDC(nullptr);
    if (!dc) return BUBBLE_MIN_W;
    for (int px = 18; px >= 17; --px) {
        HFONT f = CreateFontW(px, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
            CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
        HGDIOBJ old = f ? SelectObject(dc, f) : nullptr;
        const std::wstring l1 = NotifyTitle(g_bubbleText);
        SIZE a = {}, b = {};
        if (!l1.empty()) GetTextExtentPoint32W(dc, l1.c_str(), (int)l1.size(), &a);
        if (!g_bubbleText.line2.empty()) GetTextExtentPoint32W(dc, g_bubbleText.line2.c_str(), (int)g_bubbleText.line2.size(), &b);
        if (old) SelectObject(dc, old);
        if (f) DeleteObject(f);
        g_bubbleFontPx = px;
        textW = (int)std::max(a.cx, b.cx);
        if (BubbleNeededWidth(textW) <= BubbleMaxWidth(workW)) break;   // passt mit 18 px
    }
    ReleaseDC(nullptr, dc);
    return BubbleWidthFor(textW, workW);
}
static void ShowFoundBubble(int kind, const NotifyLines& text) {
    g_bubbleText = text;
    if (g_hBubble && IsWindow(g_hBubble) && g_isDigFoundBubble) {
        if (g_soundEnabled) PlaySoundW(MAKEINTRESOURCEW(201), GetModuleHandleW(nullptr), SND_RESOURCE | SND_ASYNC);
        KillTimer(g_hBubble, 2);                 // laufendes Herein-/Hinausfahren abbrechen
        g_bubbleKind = kind;
        g_bubbleTicks = 0;                       // Anzeigedauer neu (Hover-Zustand bleibt: Maus evtl. noch darüber)
        g_bubbleClosing = false;
        g_bubbleUserClose = false;
        g_bubbleFadingIn = false;
        g_bubbleW = BubbleLayoutWidth();         // Fix 36: Breite je nach Text (min. 170, max. 60 % Arbeitsfläche, Höhe 52)
        g_bubbleSlideOffset = g_bubbleW;         // Startposition: ganz rechts draußen
        SetWindowPos(g_hBubble, nullptr, 0, 0, g_bubbleW, BUBBLE_H, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
        BubbleRepaint(g_hBubble);
        PositionBubbleToLastWar();
        BubbleStartSlide(g_hBubble, true);       // von vorn hereinfahren
        return;
    }
    if (g_hBubble && IsWindow(g_hBubble)) {
        DestroyWindow(g_hBubble);
        g_hBubble = nullptr;
    }

    if (g_soundEnabled) {
        PlaySoundW(MAKEINTRESOURCEW(201), GetModuleHandleW(nullptr), SND_RESOURCE | SND_ASYNC);
    }

    g_isDigFoundBubble = true;
    g_bubbleKind = kind;
    g_bubbleTicks = 0;
    g_bubbleClosing = false;
    g_bubbleHover = false;
    g_bubbleUserClose = false;
    g_bubbleW = BubbleLayoutWidth();   // Fix 36: Breite je nach Text (min. 170, max. 60 % Arbeitsfläche), Höhe 52

    WNDCLASSW wc = {};
    wc.lpfnWndProc = BubbleWndProc;
    wc.hInstance = GetModuleHandleW(nullptr);
    wc.lpszClassName = L"SpeechBubbleClass";
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    RegisterClassW(&wc);

    int w = g_bubbleW, h = 52;
    int x = 100, y = 100;
    HWND lw = FindLastWarWindow();
    if (lw) {
        RECT r;
        if (GetWindowRect(lw, &r)) {
            x = r.right - w - 6;
            y = r.top + 29;
        }
    }

    g_hBubble = CreateWindowExW(
        WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_LAYERED,
        L"SpeechBubbleClass", nullptr,
        WS_POPUP,
        x, y, w, h,
        nullptr, nullptr, wc.hInstance, nullptr);

    if (g_hBubble) {
        g_bubbleAlpha = 255;               // voll deckend, kein Fade
        g_bubbleSlideOffset = w;           // startet ganz rechts draußen (nur Farbschlüssel = unsichtbar)
        SetLayeredWindowAttributes(g_hBubble, BUBBLE_SLIDE_KEY, 255, LWA_ALPHA | LWA_COLORKEY);
        SetWindowPos(g_hBubble, HWND_TOPMOST, x, y, w, h, SWP_SHOWWINDOW | SWP_NOACTIVATE);
        ShowWindow(g_hBubble, SW_SHOWNOACTIVATE);
        // Timer: 1 = Anzeigedauer, 2 = Slide, 3 = dem Spielfenster folgen
        SetTimer(g_hBubble, 1, 400, nullptr);
        SetTimer(g_hBubble, 3, 8, nullptr);
        PositionBubbleToLastWar();
        InvalidateRect(g_hBubble, nullptr, TRUE);
        UpdateWindow(g_hBubble);
        BubbleStartSlide(g_hBubble, true);
    }
}

// ===== Schrift und Einstellungen (Registry) =====
// Lädt die eingebettete Schrift „Inter“ aus den Ressourcen (ID 200)
static HFONT LoadEmbeddedFont() {
    HRSRC hRes = FindResourceW(nullptr, MAKEINTRESOURCEW(200), RT_RCDATA);
    if (!hRes) return nullptr;
    HGLOBAL hData = LoadResource(nullptr, hRes);
    if (!hData) return nullptr;
    void* pFont = LockResource(hData);
    DWORD size = SizeofResource(nullptr, hRes);
    if (!pFont || !size) return nullptr;
    DWORD numFonts = 0;
    HANDLE hFontRes = AddFontMemResourceEx(pFont, size, nullptr, &numFonts);
    if (!hFontRes) return nullptr;
    return CreateFontW(18, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Inter");
}
// Fix 72: Schrift für START: eingebettete „Poppins SemiBold“ (SIL Open Font License, Ressource IDR_FONT_START);
// fehlt sie, „Segoe UI Semibold“ (bei Windows dabei). Die Schrift wird nur einmal pro Prozess registriert.
static HANDLE g_hStartFontRes = nullptr;
static HFONT CreateStartButtonFont(int pixelHeight) {
    if (!g_hStartFontRes) {
        HRSRC hRes = FindResourceW(nullptr, MAKEINTRESOURCEW(IDR_FONT_START), RT_RCDATA);
        HGLOBAL hData = hRes ? LoadResource(nullptr, hRes) : nullptr;
        void* pFont = hData ? LockResource(hData) : nullptr;
        DWORD size = hRes ? SizeofResource(nullptr, hRes) : 0;
        DWORD numFonts = 0;
        if (pFont && size) g_hStartFontRes = AddFontMemResourceEx(pFont, size, nullptr, &numFonts);
    }
    return CreateFontW(-pixelHeight, 0, 0, 0, g_hStartFontRes ? FW_NORMAL : FW_SEMIBOLD, FALSE, FALSE, FALSE,
        DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
        CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, g_hStartFontRes ? L"Poppins SemiBold" : L"Segoe UI Semibold");
}
static ULONG_PTR g_gdiplusToken = 0;   // GDI+ nur während das Einstellungsfenster offen ist
// Registry-Pfad der gespeicherten Einstellungen (HKCU)
static const wchar_t* REG_PATH = L"Software\\LastWarBot";
// Speichert den Discord-Token per DPAPI verschlüsselt (nur unter demselben Windows-Benutzer lesbar) als REG_BINARY „token_enc“
static bool SaveTokenEncrypted(HKEY hKey, const std::wstring& token) {
    if (token.empty()) {
        // Leerer Token: leerer Binärwert (wie früher ein leerer String)
        BYTE dummy = 0;
        return RegSetValueExW(hKey, L"token_enc", 0, REG_BINARY, &dummy, 0) == ERROR_SUCCESS;
    }
    DATA_BLOB in{};
    in.cbData = (DWORD)(token.size() * sizeof(wchar_t));
    in.pbData = (BYTE*)token.data();
    DATA_BLOB out{};
    if (!CryptProtectData(&in, L"LastWarDigBot", nullptr, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, &out)) return false;
    LONG rc = RegSetValueExW(hKey, L"token_enc", 0, REG_BINARY, out.pbData, out.cbData);
    LocalFree(out.pbData);
    return rc == ERROR_SUCCESS;
}
// Liest und entschlüsselt „token_enc“; false, wenn nicht vorhanden oder nicht entschlüsselbar
static bool LoadTokenEncrypted(HKEY hKey, std::wstring& token) {
    DWORD type = 0, size = 0;
    if (RegQueryValueExW(hKey, L"token_enc", nullptr, &type, nullptr, &size) != ERROR_SUCCESS || type != REG_BINARY) return false;
    if (size == 0) { token.clear(); return true; }
    if (size > 64 * 1024) return false;
    std::vector<BYTE> data(size);
    if (RegQueryValueExW(hKey, L"token_enc", nullptr, &type, data.data(), &size) != ERROR_SUCCESS || type != REG_BINARY || size == 0) return false;
    DATA_BLOB in{};
    in.cbData = size;
    in.pbData = data.data();
    DATA_BLOB out{};
    if (!CryptUnprotectData(&in, nullptr, nullptr, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, &out)) return false;
    std::wstring t((const wchar_t*)out.pbData, out.cbData / sizeof(wchar_t));
    SecureZeroMemory(out.pbData, out.cbData);
    LocalFree(out.pbData);
    // Wie beim früheren REG_SZ: nur bis zum ersten \0
    size_t z = t.find(L'\0');
    if (z != std::wstring::npos) t.resize(z);
    token = t;
    return true;
}
// Liest einen REG_SZ-Wert (max. 1023 Zeichen, immer nullterminiert); false bei Fehler oder falschem Typ
static bool ReadRegString(HKEY hKey, const wchar_t* name, std::wstring& out) {
    wchar_t buf[1025] = {};
    DWORD type = 0;
    DWORD size = (DWORD)(sizeof(buf) - sizeof(wchar_t));
    if (RegQueryValueExW(hKey, name, nullptr, &type, (BYTE*)buf, &size) != ERROR_SUCCESS || type != REG_SZ) return false;
    size_t chars = size / sizeof(wchar_t);
    if (chars > 1024) chars = 1024;
    buf[chars] = L'\0';
    out = buf;
    return true;
}
// Fix 25: zuletzt erkannte Spielsprache („en“, „de“ …) für das Lucky-Log-Wort; eigener Wert
// (wird unabhängig von „save“ gelesen/geschrieben; löscht „save“ = aus den Schlüssel, ist sie eben wieder unbekannt)
// Fix 57: Wert heißt jetzt „luckyLang2“ und wird NUR aus der Sprach-Probe (Spieltexte) geschrieben. Der alte Wert „luckyLang“
// konnte aus Chat-Dig-Posts stammen (z. B. „ar“ auf einem deutschen Spiel) -> wird nie mehr gelesen und beim Speichern gelöscht.
static std::string LoadLuckyLangSetting() {
    HKEY hKey;
    if (RegOpenKeyExW(HKEY_CURRENT_USER, REG_PATH, 0, KEY_READ, &hKey) != ERROR_SUCCESS) return std::string();
    std::wstring w;
    bool ok = ReadRegString(hKey, L"luckyLang2", w);
    RegCloseKey(hKey);
    std::string r;
    if (ok && w.size() <= 8) for (wchar_t c : w) { if (c < L'a' || c > L'z') return std::string(); r += (char)c; }
    return r;
}
static void SaveLuckyLangSetting(const std::string& lang) {
    HKEY hKey;
    if (RegCreateKeyExW(HKEY_CURRENT_USER, REG_PATH, 0, nullptr, 0, KEY_WRITE, nullptr, &hKey, nullptr) != ERROR_SUCCESS) return;
    std::wstring w(lang.begin(), lang.end());
    RegSetValueExW(hKey, L"luckyLang2", 0, REG_SZ, (BYTE*)w.c_str(), (DWORD)((w.size() + 1) * sizeof(wchar_t)));
    RegDeleteValueW(hKey, L"luckyLang");                       // Fix 57: alter, evtl. aus Chat stammender Wert
    RegCloseKey(hKey);
}
// Fix 49: gefundener Ei-Name je goodsId („eggName<goodsId>“ = „<Spielsprache>|<Name>“) -> nach einem Neustart steht der volle
// Name schon in der ersten Meldung (die Lokalisierung liegt nicht in jeder Sitzung lesbar im Speicher: log11/log12 nie)
static bool LoadEggNameSetting(const std::string& gid, std::string& lang, std::wstring& name) {
    HKEY hKey;
    if (RegOpenKeyExW(HKEY_CURRENT_USER, REG_PATH, 0, KEY_READ, &hKey) != ERROR_SUCCESS) return false;
    std::wstring w;
    const std::wstring v = L"eggName" + std::wstring(gid.begin(), gid.end());
    const bool ok = ReadRegString(hKey, v.c_str(), w);
    RegCloseKey(hKey);
    const size_t bar = ok ? w.find(L'|') : std::wstring::npos;
    if (bar == std::wstring::npos || bar > 8 || bar + 1 >= w.size() || w.size() - bar - 1 > 160) return false;
    lang.clear();
    for (size_t i = 0; i < bar; ++i) { if (w[i] < L'a' || w[i] > L'z') return false; lang += (char)w[i]; }
    name = w.substr(bar + 1);
    return true;
}
static void SaveEggNameSetting(const std::string& gid, const std::string& lang, const std::wstring& name) {
    HKEY hKey;
    if (name.empty() || RegCreateKeyExW(HKEY_CURRENT_USER, REG_PATH, 0, nullptr, 0, KEY_WRITE, nullptr, &hKey, nullptr) != ERROR_SUCCESS) return;
    const std::wstring v = L"eggName" + std::wstring(gid.begin(), gid.end());
    const std::wstring d = std::wstring(lang.begin(), lang.end()) + L"|" + name;
    RegSetValueExW(hKey, v.c_str(), 0, REG_SZ, (BYTE*)d.c_str(), (DWORD)((d.size() + 1) * sizeof(wchar_t)));
    RegCloseKey(hKey);
}
// Fix 94: gemerkte Nachrichten für das Dropdown „Discord Message“ (neueste zuerst, höchstens 20, nur UI-Thread).
// Auf die Platte (Registry-Wert „messages“, REG_MULTI_SZ) kommen sie NUR mit „save“: beim START über SaveSettings, beim
// Löschen (Entf) sofort, aber nur wenn bereits mit „save“ gespeichert wurde. START ohne „save“ löscht alles (nach Rückfrage).
static std::vector<std::wstring> g_messageHistory;
static const size_t MESSAGE_HISTORY_MAX = 20;
// Fix 99: Standardnachricht ist fest eingebaut: immer erster Eintrag der Liste, nie gespeichert/gelöscht/doppelt
static const wchar_t* const BUILTIN_MESSAGE = L"DIG @everyone !";
static void WriteMessageHistory(HKEY hKey) {
    std::wstring multi;
    for (const std::wstring& m : g_messageHistory) if (!m.empty()) { multi += m; multi.push_back(L'\0'); }
    if (multi.empty()) { RegDeleteValueW(hKey, L"messages"); return; }
    multi.push_back(L'\0');
    RegSetValueExW(hKey, L"messages", 0, REG_MULTI_SZ, (const BYTE*)multi.data(), (DWORD)(multi.size() * sizeof(wchar_t)));
}
static bool OpenSavedSettingsKey(HKEY& hKey, REGSAM access) {   // nur, wenn mit „save“ gespeichert wurde
    if (RegOpenKeyExW(HKEY_CURRENT_USER, REG_PATH, 0, access, &hKey) != ERROR_SUCCESS) return false;
    DWORD save = 0, size = sizeof(save), type = 0;
    if (RegQueryValueExW(hKey, L"save", nullptr, &type, (BYTE*)&save, &size) == ERROR_SUCCESS && type == REG_DWORD && save == 1) return true;
    RegCloseKey(hKey);
    return false;
}
static bool HasSavedSettings() {
    HKEY hKey;
    if (!OpenSavedSettingsKey(hKey, KEY_READ)) return false;
    RegCloseKey(hKey);
    return true;
}
static void LoadMessageHistory() {
    g_messageHistory.clear();
    HKEY hKey;
    if (!OpenSavedSettingsKey(hKey, KEY_READ)) return;
    DWORD type = 0, size = 0;
    if (RegQueryValueExW(hKey, L"messages", nullptr, &type, nullptr, &size) == ERROR_SUCCESS && type == REG_MULTI_SZ && size > 0 && size < 64 * 1024) {
        std::vector<wchar_t> buf(size / sizeof(wchar_t) + 2, L'\0');
        if (RegQueryValueExW(hKey, L"messages", nullptr, &type, (BYTE*)buf.data(), &size) == ERROR_SUCCESS) {
            for (const wchar_t* p = buf.data(); *p && g_messageHistory.size() < MESSAGE_HISTORY_MAX; p += wcslen(p) + 1)
                if (wcslen(p) <= 500 && std::wstring(p) != BUILTIN_MESSAGE) g_messageHistory.push_back(p);   // Fix 99: eingebaute nicht doppelt
        }
    }
    RegCloseKey(hKey);
}
static void PersistMessageHistoryIfSaved() {   // nach Entf: nur wenn „save“ an UND schon gespeichert wurde
    if (!g_saveChecked) return;
    HKEY hKey;
    if (!OpenSavedSettingsKey(hKey, KEY_READ | KEY_WRITE)) return;
    WriteMessageHistory(hKey);
    RegCloseKey(hKey);
}
static void RememberMessage(const std::wstring& m) {   // vorn einfügen, Dubletten entfernen
    if (m.empty() || m.size() > 500) return;
    if (m == BUILTIN_MESSAGE) return;   // Fix 99: eingebaute Standardnachricht wird nie als eigener Eintrag gemerkt
    g_messageHistory.erase(std::remove(g_messageHistory.begin(), g_messageHistory.end(), m), g_messageHistory.end());
    g_messageHistory.insert(g_messageHistory.begin(), m);
    if (g_messageHistory.size() > MESSAGE_HISTORY_MAX) g_messageHistory.resize(MESSAGE_HISTORY_MAX);
}
// Fix 95: gemerkte Bots (Name + Token) und Channels (Name + ID) für die Dropdowns „Bot Token“ / „Discord Channel ID“.
// Neueste zuerst, höchstens 20, nur UI-Thread. Im Feld und in der Liste stehen nur Namen, nie der Token.
// Auf die Platte NUR mit „save“ (wie die Nachrichten): Bots DPAPI-verschlüsselt („bots_enc“), Channels als „channels“
// (REG_MULTI_SZ „id|name“). Kann nicht verschlüsselt werden, wird nichts geschrieben (kein Token im Klartext).
struct SavedBot { std::wstring name, token; };
struct SavedChannel { std::wstring name, id; };   // name ohne „#“
static std::vector<SavedBot> g_botHistory;
static std::vector<SavedChannel> g_channelHistory;
static const size_t BOT_HISTORY_MAX = 20;
static void WriteBotChannelHistory(HKEY hKey) {
    std::wstring ser;
    for (const SavedBot& b : g_botHistory)
        if (!b.name.empty() && !b.token.empty()) { ser += b.name; ser.push_back(L'\x1F'); ser += b.token; ser.push_back(L'\x1E'); }
    bool wrote = false;
    if (!ser.empty()) {
        DATA_BLOB in{};
        in.cbData = (DWORD)(ser.size() * sizeof(wchar_t));
        in.pbData = (BYTE*)ser.data();
        DATA_BLOB out{};
        if (CryptProtectData(&in, L"LastWarDigBot", nullptr, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, &out)) {
            wrote = RegSetValueExW(hKey, L"bots_enc", 0, REG_BINARY, out.pbData, out.cbData) == ERROR_SUCCESS;
            LocalFree(out.pbData);
        }
        SecureZeroMemory(&ser[0], ser.size() * sizeof(wchar_t));
    }
    if (!wrote) RegDeleteValueW(hKey, L"bots_enc");
    std::wstring multi;
    for (const SavedChannel& c : g_channelHistory)
        if (!c.id.empty() && !c.name.empty()) { multi += c.id; multi.push_back(L'|'); multi += c.name; multi.push_back(L'\0'); }
    if (multi.empty()) { RegDeleteValueW(hKey, L"channels"); return; }
    multi.push_back(L'\0');
    RegSetValueExW(hKey, L"channels", 0, REG_MULTI_SZ, (const BYTE*)multi.data(), (DWORD)(multi.size() * sizeof(wchar_t)));
}
// Lädt die gemerkten Bots/Channels (nur, wenn mit „save“ gespeichert; sonst bleibt die Liste dieser Sitzung)
static void LoadBotChannelHistory() {
    HKEY hKey;
    if (!OpenSavedSettingsKey(hKey, KEY_READ)) return;
    g_botHistory.clear();
    g_channelHistory.clear();
    DWORD type = 0, size = 0;
    if (RegQueryValueExW(hKey, L"bots_enc", nullptr, &type, nullptr, &size) == ERROR_SUCCESS && type == REG_BINARY && size > 0 && size < 64 * 1024) {
        std::vector<BYTE> data(size);
        if (RegQueryValueExW(hKey, L"bots_enc", nullptr, &type, data.data(), &size) == ERROR_SUCCESS && type == REG_BINARY && size > 0) {
            DATA_BLOB in{};
            in.cbData = size;
            in.pbData = data.data();
            DATA_BLOB out{};
            if (CryptUnprotectData(&in, nullptr, nullptr, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, &out)) {
                std::wstring ser((const wchar_t*)out.pbData, out.cbData / sizeof(wchar_t));
                SecureZeroMemory(out.pbData, out.cbData);
                LocalFree(out.pbData);
                size_t p = 0;
                while (p < ser.size() && g_botHistory.size() < BOT_HISTORY_MAX) {
                    const size_t e = ser.find(L'\x1E', p);
                    if (e == std::wstring::npos) break;
                    const size_t u = ser.find(L'\x1F', p);
                    if (u != std::wstring::npos && u > p && u + 1 < e && u - p <= 100 && e - u - 1 <= 200)
                        g_botHistory.push_back({ ser.substr(p, u - p), ser.substr(u + 1, e - u - 1) });
                    p = e + 1;
                }
                if (!ser.empty()) SecureZeroMemory(&ser[0], ser.size() * sizeof(wchar_t));
            }
        }
    }
    size = 0;
    if (RegQueryValueExW(hKey, L"channels", nullptr, &type, nullptr, &size) == ERROR_SUCCESS && type == REG_MULTI_SZ && size > 0 && size < 64 * 1024) {
        std::vector<wchar_t> buf(size / sizeof(wchar_t) + 2, L'\0');
        if (RegQueryValueExW(hKey, L"channels", nullptr, &type, (BYTE*)buf.data(), &size) == ERROR_SUCCESS) {
            for (const wchar_t* p = buf.data(); *p && g_channelHistory.size() < BOT_HISTORY_MAX; p += wcslen(p) + 1) {
                const std::wstring e = p;
                const size_t bar = e.find(L'|');
                if (bar != std::wstring::npos && bar > 0 && bar <= 20 && bar + 1 < e.size() && e.size() - bar - 1 <= 100)
                    g_channelHistory.push_back({ e.substr(bar + 1), e.substr(0, bar) });
            }
        }
    }
    RegCloseKey(hKey);
}
// Nach Entf: Bots/Channels sofort schreiben, aber nur wenn „save“ an UND schon gespeichert wurde
static void PersistBotChannelHistoryIfSaved() {
    if (!g_saveChecked) return;
    HKEY hKey;
    if (!OpenSavedSettingsKey(hKey, KEY_READ | KEY_WRITE)) return;
    WriteBotChannelHistory(hKey);
    RegCloseKey(hKey);
}
// Speichert alle Einstellungen in der Registry (löscht sie, wenn „save“ aus ist)
static void SaveSettings(bool save, const std::wstring& token, const std::wstring& channel, int refreshMinutes, bool startGame, int startInSeconds, const std::wstring& message, bool autoRefresh, bool discord) {
    HKEY hKey;
    if (!save) { RegDeleteKeyW(HKEY_CURRENT_USER, REG_PATH); return; }
    if (RegCreateKeyExW(HKEY_CURRENT_USER, REG_PATH, 0, nullptr, 0, KEY_WRITE, nullptr, &hKey, nullptr) != ERROR_SUCCESS) return;
    DWORD one = 1;
    RegSetValueExW(hKey, L"save", 0, REG_DWORD, (BYTE*)&one, sizeof(one));
    RegDeleteValueW(hKey, L"server");   // Fix 43: keine Server-Auswahl mehr – alten Wert entfernen
    // Token verschlüsselt speichern und den alten Klartext-Wert löschen;
    // schlägt die Verschlüsselung fehl, wie bisher im Klartext speichern (Token geht nicht verloren)
    if (SaveTokenEncrypted(hKey, token)) {
        RegDeleteValueW(hKey, L"token");
    }
    else {
        RegDeleteValueW(hKey, L"token_enc");
        RegSetValueExW(hKey, L"token", 0, REG_SZ, (BYTE*)token.c_str(), (DWORD)((token.size() + 1) * sizeof(wchar_t)));
    }
    RegSetValueExW(hKey, L"channel", 0, REG_SZ, (BYTE*)channel.c_str(), (DWORD)((channel.size() + 1) * sizeof(wchar_t)));
    DWORD refreshVal = (DWORD)refreshMinutes;
    RegSetValueExW(hKey, L"refresh", 0, REG_DWORD, (BYTE*)&refreshVal, sizeof(refreshVal));
    DWORD startGameVal = startGame ? 1 : 0;
    RegSetValueExW(hKey, L"startgame", 0, REG_DWORD, (BYTE*)&startGameVal, sizeof(startGameVal));
    DWORD autoRefreshVal = autoRefresh ? 1 : 0;
    RegSetValueExW(hKey, L"autorefresh", 0, REG_DWORD, (BYTE*)&autoRefreshVal, sizeof(autoRefreshVal));
    DWORD startInVal = (DWORD)startInSeconds;
    RegSetValueExW(hKey, L"startin", 0, REG_DWORD, (BYTE*)&startInVal, sizeof(startInVal));
    RegSetValueExW(hKey, L"message", 0, REG_SZ, (BYTE*)message.c_str(), (DWORD)((message.size() + 1) * sizeof(wchar_t)));
    DWORD discordVal = discord ? 1 : 0;   // Fix 68: Häkchen „dig message“
    RegSetValueExW(hKey, L"discord", 0, REG_DWORD, (BYTE*)&discordVal, sizeof(discordVal));
    // Reste der entfernten E-Mail-Funktion aus älteren Versionen löschen
    RegDeleteValueW(hKey, L"email");
    RegDeleteValueW(hKey, L"emailmsg");
    // Fix 51: Einstellungen „sound“, „logging“ und „cooldown“ gibt es nicht mehr – alte Werte entfernen
    RegDeleteValueW(hKey, L"sound");
    RegDeleteValueW(hKey, L"logging");
    RegDeleteValueW(hKey, L"cooldown");
    WriteMessageHistory(hKey);   // Fix 94: gemerkte Nachrichten (nur hier, also nur mit „save“)
    WriteBotChannelHistory(hKey);   // Fix 95: gemerkte Bots (verschlüsselt) und Channels
    RegCloseKey(hKey);
}
// Lädt die Einstellungen aus der Registry; false, wenn nichts gespeichert ist
// Fix 51: alte Werte „sound“, „logging“, „cooldown“ werden nicht mehr gelesen (beim nächsten Speichern gelöscht)
static bool LoadSettings(std::wstring& token, std::wstring& channel, int& refreshMinutes, bool& startGame, int& startInSeconds, std::wstring& message, bool& autoRefresh, bool& discord) {
    HKEY hKey;
    if (RegOpenKeyExW(HKEY_CURRENT_USER, REG_PATH, 0, KEY_READ, &hKey) != ERROR_SUCCESS) return false;
    DWORD save = 0, size = sizeof(save), type = 0;
    if (RegQueryValueExW(hKey, L"save", nullptr, &type, (BYTE*)&save, &size) != ERROR_SUCCESS || save != 1) {
        RegCloseKey(hKey); return false;
    }
    // Token: bevorzugt verschlüsselt („token_enc“), sonst alter Klartext-Wert („token“) aus früheren Versionen
    if (!LoadTokenEncrypted(hKey, token))
        ReadRegString(hKey, L"token", token);
    ReadRegString(hKey, L"channel", channel);
    DWORD refreshVal = 30;
    size = sizeof(refreshVal);
    if (RegQueryValueExW(hKey, L"refresh", nullptr, &type, (BYTE*)&refreshVal, &size) == ERROR_SUCCESS && type == REG_DWORD) {
        refreshMinutes = (int)refreshVal;
    }
    else {
        refreshMinutes = 30;
    }
    DWORD startGameVal = 0;
    size = sizeof(startGameVal);
    if (RegQueryValueExW(hKey, L"startgame", nullptr, &type, (BYTE*)&startGameVal, &size) == ERROR_SUCCESS)
        startGame = (startGameVal != 0);
    else
        startGame = false;
    DWORD autoRefreshVal = 0;
    size = sizeof(autoRefreshVal);
    if (RegQueryValueExW(hKey, L"autorefresh", nullptr, &type, (BYTE*)&autoRefreshVal, &size) == ERROR_SUCCESS)
        autoRefresh = (autoRefreshVal != 0);
    else
        autoRefresh = false;
    DWORD startInVal = 30;
    size = sizeof(startInVal);
    if (RegQueryValueExW(hKey, L"startin", nullptr, &type, (BYTE*)&startInVal, &size) == ERROR_SUCCESS && type == REG_DWORD)
        startInSeconds = (int)startInVal;
    else
        startInSeconds = 30;
    if (!ReadRegString(hKey, L"message", message))
        message = L"DIG @everyone !";
    DWORD discordVal = 0;   // Fix 68: fehlt der Wert (ältere Version) -> aus
    size = sizeof(discordVal);
    discord = RegQueryValueExW(hKey, L"discord", nullptr, &type, (BYTE*)&discordVal, &size) == ERROR_SUCCESS && type == REG_DWORD && discordVal != 0;
    RegCloseKey(hKey);
    return true;
}

// ===== Log (RichEdit im Hauptfenster) =====
// Hängt farbigen Text ans Ende des Logs an
void AppendColoredText(const std::wstring& text, COLORREF color, bool bold = false, bool underline = false) {
    if (!g_hRichEdit || text.empty()) return;
    int len = GetWindowTextLengthW(g_hRichEdit);
    SendMessageW(g_hRichEdit, EM_SETSEL, len, len);
    CHARFORMAT2W cf = {};
    cf.cbSize = sizeof(cf);
    cf.dwMask = CFM_COLOR | CFM_FACE | CFM_SIZE | CFM_CHARSET | CFM_BOLD | CFM_UNDERLINE;
    cf.dwEffects = (bold ? CFE_BOLD : 0) | (underline ? CFE_UNDERLINE : 0);
    cf.crTextColor = color;
    cf.yHeight = 260;
    cf.bCharSet = DEFAULT_CHARSET;
    wcscpy_s(cf.szFaceName, L"Segoe UI");
    SendMessageW(g_hRichEdit, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
    SendMessageW(g_hRichEdit, EM_REPLACESEL, FALSE, (LPARAM)text.c_str());
}
// ===== Standort-Nadel vor jeder Fund-Zeile =====
// Icon-Ressource 900 (in der .rc: 900 ICON "dig_pin.ico"; Zahl statt Name, damit Windows weiter das App-Icon für die .exe nimmt). Fehlt sie, sieht das Log aus wie bisher.
// Jede Log-Zeile bekommt links einen kleinen Einzug; die Nadel wird nach dem normalen Zeichnen des Logs
// in diesen Einzug gemalt (kein eingebettetes Bild, kein zusätzlicher Speicher pro Zeile).
static HICON g_pinIcon = nullptr;
static HICON g_luckyIcon = nullptr;   // Kleeblatt (Ressource IDI_LUCKY_GIFT = 901) vor Lucky-Gift-Zeilen
static HICON g_fireworkIcon = nullptr;   // Fix 41: Rakete (Ressource IDI_FIREWORK = 902) vor Feuerwerk-Zeilen
static HICON g_eggIcon = nullptr;   // Fix 44: Goldenes Ei (Ressource IDI_GOLDEN_EGG = 903) vor Ei-Zeilen
static HICON g_digLineIcon = nullptr;   // Fix 116: Bagger (App-Icon, Ressource 1) vor Dig-Zeilen; die Nadel steht dort hinter dem Koordinaten-Link
static HICON g_droneLineIcon = nullptr;   // Fix 120: Drohne (904) vor Drohnen-Zeilen (statt Bagger; Nadel wie bei Digs)
static bool g_pinTried = false;
static int g_pinSize = 0, g_pinGap = 0, g_pinDpi = 96;
static void EnsurePinIcon() {
    if (g_pinTried || !g_hRichEdit) return;
    g_pinTried = true;
    HDC dc = GetDC(g_hRichEdit);
    if (dc) { g_pinDpi = GetDeviceCaps(dc, LOGPIXELSY); ReleaseDC(g_hRichEdit, dc); }
    if (g_pinDpi <= 0) g_pinDpi = 96;
    g_pinSize = MulDiv(12, g_pinDpi, 72);  // ca. Höhe der Log-Schrift (13 pt)
    g_pinGap = MulDiv(3, g_pinDpi, 96);    // ca. 3 px Abstand zur Uhrzeit
    g_pinIcon = LoadIconSharp(900, g_pinSize);              // Fix 34: scharf in genau dieser Größe
    g_luckyIcon = LoadIconSharp(IDI_LUCKY_GIFT, g_pinSize);
    g_fireworkIcon = LoadIconSharp(IDI_FIREWORK, g_pinSize);   // Fix 41
    g_eggIcon = LoadIconSharp(IDI_GOLDEN_EGG, g_pinSize);   // Fix 44
    g_digLineIcon = LoadIconSharp(DigIconId(), g_pinSize);              // Fix 116
    g_droneLineIcon = LoadIconSharp(IDI_TEST_DRONE, g_pinSize);   // Fix 120 (fehlt 904 -> Bagger)
}
// Einzug für die nächste Log-Zeile setzen (Platz für die Nadel bzw. bei Lucky Gift für das Kleeblatt)
static void ApplyPinIndent(bool lucky = false, bool firework = false, bool egg = false) {   // Fix 41: firework = Rakete, Fix 44: egg = Ei
    EnsurePinIcon();
    if (!g_pinIcon && !g_luckyIcon && !g_fireworkIcon && !g_eggIcon) return;
    HICON icon = egg ? g_eggIcon : (firework ? g_fireworkIcon : (lucky ? g_luckyIcon : g_pinIcon));
    int len = GetWindowTextLengthW(g_hRichEdit);
    SendMessageW(g_hRichEdit, EM_SETSEL, len, len);
    PARAFORMAT2 pf = {};
    pf.cbSize = sizeof(pf);
    pf.dwMask = PFM_STARTINDENT;
    pf.dxStartIndent = icon ? MulDiv(g_pinSize + g_pinGap, 1440, g_pinDpi) : 0;
    SendMessageW(g_hRichEdit, EM_SETPARAFORMAT, 0, (LPARAM)&pf);
}
// Lokalisiertes Log-Wort für Lucky Gift je Spielsprache, sonst „Lucky Gift“ (fix 24: alle 16 Sprachen, VORLÄUFIGE
// Übersetzungen – hier korrigieren; \u-Escapes, damit der Quelltext ASCII-sicher bleibt). Reihenfolge wie baseTargets.
struct LuckyLogLabel { const char* lang; const wchar_t* text; };
static const LuckyLogLabel LUCKY_LOG_LABELS[] = {
    { "en", L"Lucky Gift" },
    { "de", L"Gl\u00FCcksgeschenk" },
    { "fr", L"Cadeau chanceux" },
    { "ru", L"\u0421\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A" },
    { "ko", L"\uD589\uC6B4\uC758 \uC120\uBB3C" },
    { "th", L"\u0E02\u0E2D\u0E07\u0E02\u0E27\u0E31\u0E0D\u0E19\u0E33\u0E42\u0E0A\u0E04" },
    { "ja", L"\u5E78\u904B\u306E\u30AE\u30D5\u30C8" },
    { "pt", L"Presente da Sorte" },
    { "es", L"Regalo de la Suerte" },
    { "tr", L"\u015Eans Hediyesi" },
    { "zh", L"\u5E78\u904B\u79AE\u7269" },
    { "it", L"Regalo Fortunato" },
    { "ar", L"\u0647\u062F\u064A\u0629 \u0627\u0644\u062D\u0638" },
    { "vi", L"Qu\u00E0 May M\u1EAFn" },
    { "id", L"Hadiah Keberuntungan" },
    { "pl", L"Szcz\u0119\u015Bliwy prezent" },
};
static const wchar_t* const LUCKY_LOG_FALLBACK = L"Lucky Gift";
static std::wstring LuckyLogText(const std::string& lang) {
    for (const auto& l : LUCKY_LOG_LABELS) if (lang == l.lang) return l.text;
    return LUCKY_LOG_FALLBACK;
}
// Ist die Log-Zeile ab Zeichen idx eine Lucky-Gift-Zeile („[hh:mm:ss]: <Lucky-Wort>“ oder „… <Lucky-Wort>: Name“)?
// Dig-Zeilen enthalten immer „<Dig-Text>\u200E [“ (WriteDigLogLine) -> nie Lucky, auch falls der Dig-Text zufällig mit dem
// Lucky-Wort beginnt. In Lucky-Zeilen kommt „\u200E [“ nie vor (Name ohne U+200E und ohne Leerzeichen am Anfang).
static bool IsLuckyLogLine(HWND hwnd, LONG idx, LONG total) {
    wchar_t buf[257] = {};
    LONG endIdx = std::min<LONG>(total, idx + 256);
    if (endIdx <= idx) return false;
    TEXTRANGEW tr = { { idx, endIdx }, buf };
    LONG got = (LONG)SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
    std::wstring line(buf, std::max<LONG>(0, std::min<LONG>(got, 256)));
    size_t cr = line.find_first_of(L"\r\n");
    if (cr != std::wstring::npos) line.resize(cr);
    size_t p = line.find(L"]: ");
    if (line.empty() || line[0] != L'[' || p == std::wstring::npos) return false;
    std::wstring rest = line.substr(p + 3);
    while (!rest.empty() && (rest.back() == L' ' || rest.back() == L'\u200E')) rest.pop_back();
    if (rest.find(L"\u200E [") != std::wstring::npos) return false;   // Dig-Zeile (Marke nach dem Dig-Text)
    // Fix 29: Abhol-Zähler „ N/20“ bzw. „ N“ am Zeilenende (ohne Absender steht er direkt hinter dem Wort)
    std::wstring core = rest;
    {
        auto digitsBack = [&](size_t& k) { size_t d = 0; while (k > 0 && core[k - 1] >= L'0' && core[k - 1] <= L'9' && d < 4) { --k; ++d; } return d; };
        size_t k = core.size();
        bool ok = digitsBack(k) > 0;
        if (ok && k > 0 && core[k - 1] == L'/') { --k; ok = digitsBack(k) > 0; }
        if (ok && k > 0 && core[k - 1] == L' ') core.resize(k - 1); else core = rest;
    }
    auto isLabel = [&](const std::wstring& t) { return rest == t || core == t || (rest.size() > t.size() + 2 && rest.compare(0, t.size() + 2, t + L": ") == 0); };
    if (isLabel(LUCKY_LOG_FALLBACK)) return true;
    for (const auto& l : LUCKY_LOG_LABELS) if (isLabel(l.text)) return true;
    return false;
}
// Fix 41/44: Log-Wort für Feuerwerk je Spielsprache (alle 16, Reihenfolge wie LUCKY_LOG_LABELS; en/de bestätigt,
// übrige VORLÄUFIG – hier korrigieren), sonst Englisch „Firework“
struct FireworkLogLabel { const char* lang; const wchar_t* text; };
static const FireworkLogLabel FIREWORK_LOG_LABELS[] = {
    { "en", L"Firework" },
    { "de", L"Feuerwerk" },
    { "fr", L"Feu d'artifice" },
    { "ru", L"\u0424\u0435\u0439\u0435\u0440\u0432\u0435\u0440\u043A" },
    { "ko", L"\uBD88\uAF43\uB180\uC774" },
    { "th", L"\u0E14\u0E2D\u0E01\u0E44\u0E21\u0E49\u0E44\u0E1F" },
    { "ja", L"\u82B1\u706B" },
    { "pt", L"Fogos de Artif\u00EDcio" },
    { "es", L"Fuegos artificiales" },
    { "tr", L"Havai Fi\u015Fek" },
    { "zh", L"\u7159\u706B" },
    { "it", L"Fuochi d'artificio" },
    { "ar", L"\u0623\u0644\u0639\u0627\u0628 \u0646\u0627\u0631\u064A\u0629" },
    { "vi", L"Ph\u00E1o hoa" },
    { "id", L"Kembang Api" },
    { "pl", L"Fajerwerki" },
};
static const wchar_t* const FIREWORK_LOG_FALLBACK = L"Firework";
static std::wstring FireworkLogText(const std::string& lang) {
    for (const auto& l : FIREWORK_LOG_LABELS) if (lang == l.lang) return l.text;
    return FIREWORK_LOG_FALLBACK;
}
// Fix 41/42: Ist die Log-Zeile ab idx eine Feuerwerk-Zeile („[hh:mm:ss]: <Feuerwerk-Wort>“, nie mit Absender)?
// Dig-Zeilen („\u200E [“) nie; Lucky-Zeilen beginnen mit dem Lucky-Wort -> nie Feuerwerk.
static bool IsFireworkLogLine(HWND hwnd, LONG idx, LONG total) {
    wchar_t buf[257] = {};
    LONG endIdx = std::min<LONG>(total, idx + 256);
    if (endIdx <= idx) return false;
    TEXTRANGEW tr = { { idx, endIdx }, buf };
    LONG got = (LONG)SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
    std::wstring line(buf, std::max<LONG>(0, std::min<LONG>(got, 256)));
    size_t cr = line.find_first_of(L"\r\n");
    if (cr != std::wstring::npos) line.resize(cr);
    size_t p = line.find(L"]: ");
    if (line.empty() || line[0] != L'[' || p == std::wstring::npos) return false;
    std::wstring rest = line.substr(p + 3);
    while (!rest.empty() && (rest.back() == L' ' || rest.back() == L'\u200E')) rest.pop_back();
    if (rest.find(L"\u200E [") != std::wstring::npos) return false;   // Dig-Zeile
    {   // Fix 118: Abholer-Zahl „ N“ am Ende abschneiden
        size_t k = rest.size();
        while (k > 0 && rest[k - 1] >= L'0' && rest[k - 1] <= L'9') --k;
        if (k < rest.size() && k > 0 && rest[k - 1] == L' ' && rest.size() - k <= 4) rest.resize(k - 1);
    }
    auto isLabel = [&](const std::wstring& t) { return rest == t; };   // Fix 42: nur das Wort
    if (isLabel(FIREWORK_LOG_FALLBACK)) return true;
    for (const auto& l : FIREWORK_LOG_LABELS) if (isLabel(l.text)) return true;
    return false;
}
// Fix 44: Log-Wort für das Ei je Spielsprache – immer nur das allgemeine Wort „Ei“, nie der Post-Titel
// (en/de/id bestätigt, übrige VORLÄUFIG – hier korrigieren). Reihenfolge wie LUCKY_LOG_LABELS; sonst Englisch „Egg“.
struct EggLogLabel { const char* lang; const wchar_t* text; };
static const EggLogLabel EGG_LOG_LABELS[] = {
    { "en", L"Egg" },
    { "de", L"Ei" },
    { "fr", L"\u0152uf" },
    { "ru", L"\u042F\u0439\u0446\u043E" },
    { "ko", L"\uC54C" },
    { "th", L"\u0E44\u0E02\u0E48" },
    { "ja", L"\u5375" },
    { "pt", L"Ovo" },
    { "es", L"Huevo" },
    { "tr", L"Yumurta" },
    { "zh", L"\u86CB" },
    { "it", L"Uovo" },
    { "ar", L"\u0628\u064A\u0636\u0629" },
    { "vi", L"Tr\u1EE9ng" },
    { "id", L"Telur" },
    { "pl", L"Jajko" },
};
static const wchar_t* const EGG_LOG_FALLBACK = L"Egg";
static std::wstring EggLogText(const std::string& lang) {
    for (const auto& l : EGG_LOG_LABELS) if (lang == l.lang) return l.text;
    return EGG_LOG_FALLBACK;
}
// Fix 48: volle Ei-Namen, die im Log stehen (WriteEggLogLine / Umbenennen; nur UI-Thread, max. 32) – sonst wäre eine Zeile
// „Goldenes Ei (Diamant): …“ keine Ei-Zeile (Ei-Nadel, Aufleuchten und Abhol-Zahl fehlten).
static std::vector<std::wstring> g_eggLineNames;
static void EggLineNameAdd(const std::wstring& n) {
    if (n.empty() || std::find(g_eggLineNames.begin(), g_eggLineNames.end(), n) != g_eggLineNames.end()) return;
    if (g_eggLineNames.size() >= 32) g_eggLineNames.erase(g_eggLineNames.begin());
    g_eggLineNames.push_back(n);
}
// Fix 44: Ist die Log-Zeile ab idx eine Ei-Zeile („[hh:mm:ss]: <Ei-Wort>“ bzw. „… <Ei-Wort>: Name“, optional „ N/total“)?
// Wie IsLuckyLogLine; Dig-Zeilen („\u200E [“) nie.
static bool IsEggLogLine(HWND hwnd, LONG idx, LONG total) {
    wchar_t buf[257] = {};
    LONG endIdx = std::min<LONG>(total, idx + 256);
    if (endIdx <= idx) return false;
    TEXTRANGEW tr = { { idx, endIdx }, buf };
    LONG got = (LONG)SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
    std::wstring line(buf, std::max<LONG>(0, std::min<LONG>(got, 256)));
    size_t cr = line.find_first_of(L"\r\n");
    if (cr != std::wstring::npos) line.resize(cr);
    size_t p = line.find(L"]: ");
    if (line.empty() || line[0] != L'[' || p == std::wstring::npos) return false;
    std::wstring rest = line.substr(p + 3);
    while (!rest.empty() && (rest.back() == L' ' || rest.back() == L'\u200E')) rest.pop_back();
    if (rest.find(L"\u200E [") != std::wstring::npos) return false;   // Dig-Zeile
    std::wstring core = rest;
    {
        auto digitsBack = [&](size_t& k) { size_t d = 0; while (k > 0 && core[k - 1] >= L'0' && core[k - 1] <= L'9' && d < 4) { --k; ++d; } return d; };
        size_t k = core.size();
        bool ok = digitsBack(k) > 0;
        if (ok && k > 0 && core[k - 1] == L'/') { --k; ok = digitsBack(k) > 0; }
        if (ok && k > 0 && core[k - 1] == L' ') core.resize(k - 1); else core = rest;
    }
    auto isLabel = [&](const std::wstring& t) { return rest == t || core == t || (rest.size() > t.size() + 2 && rest.compare(0, t.size() + 2, t + L": ") == 0); };
    if (isLabel(EGG_LOG_FALLBACK)) return true;
    for (const auto& l : EGG_LOG_LABELS) if (isLabel(l.text)) return true;
    for (const auto& n : g_eggLineNames) if (isLabel(n)) return true;   // Fix 48
    return false;
}
// Malt die Nadel vor jede sichtbare Log-Zeile (nur innerhalb von clip = neu gezeichneter Bereich,
// sonst würden die halbtransparenten Ränder bereits gemalter Nadeln mehrfach überblendet)
static void DrawClaimChecks(HWND hwnd, HDC dc, const RECT& rc, LONG total);   // Fix 114 (unten, nach g_luckyCountLines)
static void ClaimAnimTick(HWND hwnd);   // Fix 114
static const UINT_PTR CLAIM_ANIM_TIMER = 0x434B;   // Fix 114: Haken-Animation (Timer am RichEdit)
// Fix 116: Dig-Zeile („[hh:mm:ss]: <Dig-Text>\u200E [<Ort>]“)? endIdx = Position des Zeilenendes ('\r') hinter „]“
static bool DigLogLineEnd(HWND hwnd, LONG idx, LONG total, LONG& endIdx, bool* drone = nullptr) {
    wchar_t buf[257] = {};
    const LONG e = std::min<LONG>(total, idx + 256);
    if (e <= idx) return false;
    TEXTRANGEW tr = { { idx, e }, buf };
    const LONG got = (LONG)SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
    if (got <= 0 || buf[0] != L'[') return false;
    LONG k = 0;
    while (k < got && k < 256 && buf[k] != L'\r' && buf[k] != L'\n') ++k;
    if (k >= got || k < 6 || buf[k - 1] != L']') return false;
    std::wstring_view line(buf, (size_t)k);
    if (line.find(L"]: ") == std::wstring_view::npos || line.find(L"\u200E [") == std::wstring_view::npos) return false;
    endIdx = idx + k;
    if (drone) *drone = line.find(L"\u200E\u200E [") != std::wstring_view::npos;   // Fix 120: Drohnen-Zeile (doppelte LRM-Marke)
    return true;
}
static void DrawLogPins(HWND hwnd, HRGN clip) {
    RECT rc;
    GetClientRect(hwnd, &rc);
    GETTEXTLENGTHEX gtl = { GTL_NUMCHARS | GTL_PRECISE, 1200 };
    LONG total = (LONG)SendMessageW(hwnd, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0);
    if (total <= 0) return;
    int lineCount = (int)SendMessageW(hwnd, EM_GETLINECOUNT, 0, 0);
    int line = (int)SendMessageW(hwnd, EM_GETFIRSTVISIBLELINE, 0, 0);
    HDC dc = GetDC(hwnd);
    if (!dc) return;
    if (clip) SelectClipRgn(dc, clip);
    for (; line < lineCount; ++line) {
        LONG idx = (LONG)SendMessageW(hwnd, EM_LINEINDEX, line, 0);
        if (idx < 0 || idx >= total) break;
        POINTL pt = {};
        SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&pt, idx);
        if (pt.y > rc.bottom) break;
        bool paraStart = (idx == 0);
        if (!paraStart) {
            wchar_t c[2] = {};
            TEXTRANGEW tr = { { idx - 1, idx }, c };
            SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
            paraStart = (c[0] == L'\r' || c[0] == L'\n');
        }
        if (!paraStart) continue;  // umgebrochene Folgezeile: keine Nadel
        int lineH = MulDiv(g_pinSize, 4, 3);
        LONG next = (LONG)SendMessageW(hwnd, EM_LINEINDEX, line + 1, 0);
        if (next > idx) {
            POINTL npt = {};
            SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&npt, next);
            if (npt.y > pt.y) lineH = npt.y - pt.y;
        }
        int x = pt.x - g_pinGap - g_pinSize;
        int y = pt.y + (lineH - g_pinSize) / 2;
        // Lucky-Gift-Zeile: Kleeblatt statt Nadel
        HICON lineIcon = (g_luckyIcon && IsLuckyLogLine(hwnd, idx, total)) ? g_luckyIcon : g_pinIcon;
        // Fix 41: Rakete vor Feuerwerk-Zeilen (Prüfung erst, wenn es in dieser Sitzung ein Feuerwerk gab)
        if (g_fireworkCount > 0 && g_fireworkIcon && lineIcon == g_pinIcon && IsFireworkLogLine(hwnd, idx, total)) lineIcon = g_fireworkIcon;
        // Fix 44: Ei vor Ei-Zeilen (Prüfung erst, wenn es in dieser Sitzung ein Ei gab)
        if (g_eggCount > 0 && g_eggIcon && lineIcon == g_pinIcon && IsEggLogLine(hwnd, idx, total)) lineIcon = g_eggIcon;
        // Fix 116: Dig-Zeile -> Bagger vorne, Nadel direkt hinter dem Koordinaten-Link (kleiner Abstand, senkrecht mittig)
        LONG digEnd = -1;
        bool droneLine = false;
        if (lineIcon == g_pinIcon && (g_digLineIcon || g_pinIcon) && DigLogLineEnd(hwnd, idx, total, digEnd, &droneLine)) {
            if (g_digLineIcon) lineIcon = g_digLineIcon;
            if (droneLine && g_droneLineIcon) lineIcon = g_droneLineIcon;   // Fix 120
            if (g_pinIcon) {
                POINTL ep = {};
                SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&ep, digEnd);
                int eh = MulDiv(g_pinSize, 4, 3);
                const LONG eln = (LONG)SendMessageW(hwnd, EM_EXLINEFROMCHAR, 0, digEnd);
                const LONG enx = (LONG)SendMessageW(hwnd, EM_LINEINDEX, (WPARAM)(eln + 1), 0);
                if (enx > digEnd) { POINTL pn = {}; SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&pn, enx); if (pn.y > ep.y && pn.y - ep.y < 4 * g_pinSize) eh = (int)(pn.y - ep.y); }
                else if (ep.y == pt.y) eh = lineH;
                DrawIconEx(dc, (int)ep.x + g_pinGap, (int)ep.y + (eh - g_pinSize) / 2, g_pinIcon, g_pinSize, g_pinSize, 0, nullptr, DI_NORMAL);
            }
        }
        if (lineIcon) DrawIconEx(dc, x, y, lineIcon, g_pinSize, g_pinSize, 0, nullptr, DI_NORMAL);
    }
    DrawClaimChecks(hwnd, dc, rc, total);   // Fix 114
    if (clip) SelectClipRgn(dc, nullptr);
    ReleaseDC(hwnd, dc);
}
// ===== Fix 31: Ziel-Zeile der letzten Benachrichtigung (nur UI-Thread) =====
// Jede Benachrichtigung (Blase + Windows-Hinweis) zeigt den neuesten Fund -> genau ein Ziel, das neueste überschreibt.
// Gemerkt wird der Zeilenanfang (Zeichenposition) plus der unveränderliche Anfang „[hh:mm:ss]: “; Umbenennen, Zahl-Updates
// und Kürzen führen die Position nach (LuckyLogShift / LuckyLogTrimmed). Vor dem Aufleuchten wird geprüft, dass dort noch
// genau diese Zeile steht (Absatzanfang, Uhrzeit-Anfang, Zeilenart Dig/Lucky), sonst kein Leuchten.
// Zurückgehaltene Lucky-Zeilen (Sprach-Probe, Fix 27): Ziel wartet auf die uuid und wird beim Schreiben gesetzt.
struct LogGlowTarget { bool set = false; LONG lineStart = -1; std::wstring prefix; bool lucky = false; std::string pendingUuid; bool firework = false; bool egg = false; };   // Fix 41: + firework, Fix 44: + egg
static LogGlowTarget g_glowTarget;
static LONG g_logLastStart = -1;          // zuletzt geschriebene Dig-/Lucky-Zeile
static std::wstring g_logLastPrefix;
static bool g_logLastLucky = false;
static bool g_logLastFirework = false;   // Fix 41
static bool g_logLastEgg = false;   // Fix 44
static void LogGlowTargetClear() { g_glowTarget = LogGlowTarget(); }
static void LogGlowTargetLast() {
    LogGlowTargetClear();
    if (g_logLastStart < 0) return;
    g_glowTarget.set = true; g_glowTarget.lineStart = g_logLastStart; g_glowTarget.prefix = g_logLastPrefix; g_glowTarget.lucky = g_logLastLucky;
    g_glowTarget.firework = g_logLastFirework;   // Fix 41
    g_glowTarget.egg = g_logLastEgg;   // Fix 44
}
static void LogGlowTargetPending(const std::string& uuid) { LogGlowTargetClear(); g_glowTarget.pendingUuid = uuid; }
// Von WriteDigLogLine / WriteLuckyLogLine: Zeile ab lineStart („[“) geschrieben
static void LogGlowNoteLine(LONG lineStart, const std::wstring& timeStr, bool lucky, const std::string& uuid, bool firework = false, bool egg = false) {
    g_logLastStart = lineStart; g_logLastPrefix = L"[" + timeStr + L"]: "; g_logLastLucky = lucky; g_logLastFirework = firework; g_logLastEgg = egg;   // Fix 41/44
    if (lucky && !uuid.empty() && g_glowTarget.pendingUuid == uuid) LogGlowTargetLast();
}
static void LogGlowShift(LONG at, LONG delta) {
    if (g_glowTarget.set && g_glowTarget.lineStart >= at) g_glowTarget.lineStart += delta;
    if (g_logLastStart >= at) g_logLastStart += delta;
}
static void LogGlowTrimDrop(LONG cut) {   // vor dem Verschieben: weggekürzte Zeilen vergessen
    if (g_glowTarget.set&& g_glowTarget.lineStart < cut) LogGlowTargetClear();
    if (g_logLastStart >= 0 && g_logLastStart < cut) g_logLastStart = -1;
}
// true + start: Ziel existiert noch genau so im Log
static bool LogGlowTargetValid(HWND hwnd, LONG& start) {
    if (!hwnd || !g_glowTarget.set || g_glowTarget.lineStart < 0 || g_glowTarget.prefix.size() > 64) return false;
    GETTEXTLENGTHEX gtl = { GTL_NUMCHARS | GTL_PRECISE, 1200 };
    const LONG total = (LONG)SendMessageW(hwnd, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0);
    const LONG a = g_glowTarget.lineStart;
    const LONG n = (LONG)g_glowTarget.prefix.size();
    if (a + n > total) return false;
    wchar_t buf[80] = {};
    const LONG from = a > 0 ? a - 1 : 0;
    TEXTRANGEW tr = { { from, a + n }, buf };
    const LONG got = (LONG)SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
    if (got != a + n - from) return false;
    const std::wstring t(buf, (size_t)got);
    if (a > 0 && t[0] != L'\r' && t[0] != L'\n') return false;
    if (t.compare((size_t)(a - from), (size_t)n, g_glowTarget.prefix) != 0) return false;
    if (IsLuckyLogLine(hwnd, a, total) != g_glowTarget.lucky) return false;
    if (IsFireworkLogLine(hwnd, a, total) != g_glowTarget.firework) return false;   // Fix 41
    if (IsEggLogLine(hwnd, a, total) != g_glowTarget.egg) return false;   // Fix 44
    start = a;
    return true;
}
// ===== Ende Fix 31 (Ziel) =====
// Zählerzeile: Breite eines Texts in der Zählerschrift
static int CounterTextWidth(HWND h, const std::wstring& t) {
    HDC dc = GetDC(h);
    if (!dc) return 0;
    HGDIOBJ old = g_hDigCountFont ? SelectObject(dc, g_hDigCountFont) : nullptr;
    SIZE sz = {};
    GetTextExtentPoint32W(dc, t.c_str(), (int)t.size(), &sz);
    if (old) SelectObject(dc, old);
    ReleaseDC(h, dc);
    return sz.cx;
}
// Zähler malen: Wort („Digs: “ / „Lucky Gifts: “) im bisherigen Grau, Zahl in eigener Farbe (owner-drawn STATIC)
static const int MAIN_COUNT_SLASH_PAD = 2;   // Fix 119: px links und rechts vom „/“ (abgeholt / gemeldet)
// Fix 114: claimed >= 0 -> „abgeholt/gemeldet“: abgeholt weiß (alle abgeholt: Kategorie-Farbe), „/“ grau, gemeldet in Farbe
static void DrawCounter(const DRAWITEMSTRUCT* dis, const std::wstring& label, int n, COLORREF numColor, HICON icon, int claimed = -1) {
    HDC dc = dis->hDC;
    RECT rc = dis->rcItem;
    FillRect(dc, &rc, (HBRUSH)GetStockObject(BLACK_BRUSH));
    SetBkMode(dc, TRANSPARENT);
    HGDIOBJ old = g_hDigCountFont ? SelectObject(dc, g_hDigCountFont) : nullptr;
    // Icon links, vertikal mittig zur Textzeile; Wort + Zahl rücken um Icon + Abstand nach rechts
    TEXTMETRICW tm = {};
    GetTextMetricsW(dc, &tm);
    if (icon) DrawIconEx(dc, rc.left, rc.top + (tm.tmHeight - MAIN_COUNT_ICON) / 2, icon, MAIN_COUNT_ICON, MAIN_COUNT_ICON, 0, nullptr, DI_NORMAL);
    rc.left += MAIN_COUNT_ICON + MAIN_COUNT_ICON_GAP;
    SIZE sz = {};
    GetTextExtentPoint32W(dc, label.c_str(), (int)label.size(), &sz);
    SetTextColor(dc, RGB(150, 150, 150));
    DrawTextW(dc, label.c_str(), (int)label.size(), &rc, DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX);
    std::wstring num = std::to_wstring(n);
    RECT rn = rc; rn.left += sz.cx;
    if (claimed >= 0) {   // Fix 114
        const std::wstring cs = std::to_wstring(claimed);
        SetTextColor(dc, (claimed == n && n > 0) ? numColor : RGB(255, 255, 255));
        DrawTextW(dc, cs.c_str(), (int)cs.size(), &rn, DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX);
        SIZE s2 = {}; GetTextExtentPoint32W(dc, cs.c_str(), (int)cs.size(), &s2); rn.left += s2.cx;
        rn.left += MAIN_COUNT_SLASH_PAD;   // Fix 119: kleiner Abstand vor „/“
        SetTextColor(dc, RGB(150, 150, 150));
        DrawTextW(dc, L"/", 1, &rn, DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX);
        GetTextExtentPoint32W(dc, L"/", 1, &s2); rn.left += s2.cx + MAIN_COUNT_SLASH_PAD;   // Fix 119: und danach
    }
    SetTextColor(dc, numColor);
    DrawTextW(dc, num.c_str(), (int)num.size(), &rn, DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOPREFIX);
    if (old) SelectObject(dc, old);
}
// Zählerzeile anordnen: jeder Zähler so breit wie sein Text, Abstand MAIN_COUNT_GAP. Fix 44: vier Zähler (Digs, Lucky
// Gifts, Fireworks, Eggs); passt die Reihe nicht ins Fenster (rechter Rand 10 px wie das Log), werden alle Abstände
// gleichmäßig verkleinert (min. MAIN_COUNT_GAP_MIN).
static void LayoutCounters() {
    if (!g_hDigCount) return;
    // Fix 114: Reihenfolge Digs, Fireworks, Lucky Gifts, Eggs; Breite = Summe der einzeln gemalten Teile (wie DrawCounter),
    // damit alle Abstände genau gleich sind. Fix 120: Test Flight Failure direkt nach Digs (fünf Zähler)
    HWND hs[5] = { g_hDigCount, g_hDroneCount, g_hFireworkCount, g_hLuckyCount, g_hEggCount };
    const std::wstring ts[5][3] = { { L"Digs: ", L"", std::to_wstring(g_digCount) },
                                    { L"Test Flight Failure: ", L"", std::to_wstring(g_droneCount) },   // Fix 120
                                    { L"Fireworks: ", std::to_wstring(g_fireworkClaimed), std::to_wstring(g_fireworkCount) },   // Fix 118
                                    { L"Lucky Gifts: ", std::to_wstring(g_luckyClaimed), std::to_wstring(g_luckyCount) },
                                    { L"Eggs: ", std::to_wstring(g_eggClaimed), std::to_wstring(g_eggCount) } };
    int ws[5] = {}, sum = 0, n = 0;
    for (int k = 0; k < 5 && hs[k]; ++k) {
        int tw = CounterTextWidth(hs[k], ts[k][0]) + CounterTextWidth(hs[k], ts[k][2]);
        if (!ts[k][1].empty()) tw += CounterTextWidth(hs[k], ts[k][1]) + CounterTextWidth(hs[k], L"/") + 2 * MAIN_COUNT_SLASH_PAD;   // Fix 119
        ws[k] = MAIN_COUNT_ICON + MAIN_COUNT_ICON_GAP + tw + 4; sum += ws[k]; ++n;
    }
    int gap = MAIN_COUNT_GAP;
    RECT pc = {};
    HWND par = GetParent(g_hDigCount);
    if (n > 1 && par && GetClientRect(par, &pc) && pc.right > 0) {
        const int avail = (int)pc.right - 20;
        if (sum + (n - 1) * gap > avail) gap = std::max(MAIN_COUNT_GAP_MIN, (avail - sum) / (n - 1));
    }
    int x = 10;
    for (int k = 0; k < n; ++k) {
        MoveWindow(hs[k], x, MAIN_COUNT_Y, ws[k], MAIN_COUNT_H, TRUE);
        InvalidateRect(hs[k], nullptr, TRUE);
        x += ws[k] + gap;
    }
    HWND parent = GetParent(g_hDigCount);
    if (parent) {   // freigewordenen Streifen der Zählerzeile (z. B. nach Verschieben) neu malen
        RECT r; GetClientRect(parent, &r);
        r.top = MAIN_COUNT_Y; r.bottom = MAIN_COUNT_Y + MAIN_COUNT_H;
        InvalidateRect(parent, &r, TRUE);
    }
}
// Leeres Log (noch keine Log-Zeile und kein Dig in dieser Sitzung): dezenter grauer Hinweis „Nothing found yet“ in der Mitte. Nur gemalt, nie Teil des Log-Texts.
static bool LogShowsEmptyHint(HWND hwnd) {
    if (g_digCount > 0 || g_droneCount > 0) return false;   // Fix 120: + Drohnen
    GETTEXTLENGTHEX gtl = { GTL_DEFAULT, 1200 };
    return SendMessageW(hwnd, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0) <= 0;
}
static void DrawLogEmptyHint(HWND hwnd, HRGN clip) {
    RECT rc;
    GetClientRect(hwnd, &rc);
    HDC dc = GetDC(hwnd);
    if (!dc) return;
    if (clip) SelectClipRgn(dc, clip);
    HGDIOBJ oldFont = SelectObject(dc, g_hFont ? (HGDIOBJ)g_hFont : GetStockObject(DEFAULT_GUI_FONT));
    SetBkMode(dc, TRANSPARENT);
    SetTextColor(dc, RGB(110, 110, 110));
    DrawTextW(dc, L"Nothing found yet", -1, &rc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
    SelectObject(dc, oldFont);
    if (clip) SelectClipRgn(dc, nullptr);
    ReleaseDC(hwnd, dc);
}
// ===== Fix 31: Aufleuchten der Ziel-Zeile =====
// Hell, dunkel – LOG_GLOW_PULSES-mal (je 1 s) in LOG_GLOW_MS (sin²-Verlauf), ca. 60 Bilder/s (Timer 16 ms am RichEdit). Nach jedem normalen
// Neuzeichnen der Zeile wird ihr Bild (ganze Breite, alle umgebrochenen Teilzeilen) einmal aufgenommen; je Bild wird nur
// noch „Screen“-überblendet (Schwarz -> sanftes Warmgrau, helle Schrift bleibt hell) und in einem Stück kopiert -> kein
// Flackern, das RichEdit selbst wird pro Bild nicht neu gezeichnet. Speicher nur während der 2 s (eine Zeile, Pixelpuffer).
static const UINT_PTR LOG_GLOW_TIMER = 0x4C47;
static const int LOG_GLOW_PULSES = 3;                                  // Fix 32: 3 Pulse (vorher 2)
static const ULONGLONG LOG_GLOW_MS = 1000ULL * LOG_GLOW_PULSES;         // je Puls 1 s
static double LogGlowLevelAt(ULONGLONG ms) {                          // 0..1, ms seit Start
    const double t = (double)ms / (double)LOG_GLOW_MS;                 // 0..1
    const double s = std::sin(t * LOG_GLOW_PULSES * 3.14159265358979323846);   // LOG_GLOW_PULSES Bögen
    return s * s;
}
static const int LOG_GLOW_R = 78, LOG_GLOW_G = 74, LOG_GLOW_B = 56;   // Höhepunkt der Aufhellung (über Schwarz)
struct LogGlowAnim { bool active = false; ULONGLONG t0 = 0; RECT rc = {}; RECT vis = {}; bool haveBase = false; std::vector<DWORD> base; };
static LogGlowAnim g_glow;
static bool LogGlowLineRect(HWND hwnd, RECT& out) {
    LONG start = 0;
    if (!LogGlowTargetValid(hwnd, start)) return false;
    GETTEXTLENGTHEX gtl = { GTL_NUMCHARS | GTL_PRECISE, 1200 };
    const LONG total = (LONG)SendMessageW(hwnd, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0);
    LONG next = total;   // Anfang des nächsten Absatzes
    {
        wchar_t buf[1025] = {};
        const LONG e = std::min<LONG>(total, start + 1024);
        TEXTRANGEW tr = { { start, e }, buf };
        const LONG got = (LONG)SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
        for (LONG i = 0; i < got && i < 1024; ++i) if (buf[i] == L'\r' || buf[i] == L'\n') { next = start + i + 1; break; }
    }
    POINTL a = {}, b = {};
    SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&a, start);
    SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&b, next);
    RECT cl; GetClientRect(hwnd, &cl);
    out.left = cl.left; out.right = cl.right; out.top = a.y;
    out.bottom = b.y > a.y ? b.y : a.y + (g_pinSize > 0 ? MulDiv(g_pinSize, 4, 3) : 20);
    return true;
}
static double LogGlowLevel(ULONGLONG now) { return LogGlowLevelAt(now - g_glow.t0); }
// Zeile mit der aktuellen Helligkeit malen; capture = Zeile wurde eben frisch gezeichnet -> Bild neu aufnehmen
static void LogGlowPaint(HWND hwnd, bool capture) {
    if (!g_glow.active) return;
    RECT cl; GetClientRect(hwnd, &cl);
    RECT v;
    if (!IntersectRect(&v, &g_glow.rc, &cl)) return;
    const int w = v.right - v.left, h = v.bottom - v.top;
    if (w <= 0 || h <= 0 || (size_t)w * (size_t)h > 4000000) return;
    if (!capture && (!g_glow.haveBase || !EqualRect(&v, &g_glow.vis))) return;
    HDC dc = GetDC(hwnd);
    if (!dc) return;
    BITMAPINFO bi = {};
    bi.bmiHeader.biSize = sizeof(bi.bmiHeader);
    bi.bmiHeader.biWidth = w;
    bi.bmiHeader.biHeight = -h;
    bi.bmiHeader.biPlanes = 1;
    bi.bmiHeader.biBitCount = 32;
    bi.bmiHeader.biCompression = BI_RGB;
    void* bits = nullptr;
    HBITMAP bmp = CreateDIBSection(dc, &bi, DIB_RGB_COLORS, &bits, nullptr, 0);
    HDC mem = bmp ? CreateCompatibleDC(dc) : nullptr;
    if (mem && bits) {
        HGDIOBJ old = SelectObject(mem, bmp);
        DWORD* px = (DWORD*)bits;
        const size_t cnt = (size_t)w * (size_t)h;
        if (capture) {
            GdiFlush();
            BitBlt(mem, 0, 0, w, h, dc, v.left, v.top, SRCCOPY);
            GdiFlush();
            g_glow.base.assign(px, px + cnt);
            g_glow.vis = v;
            g_glow.haveBase = true;
        }
        const double lv = LogGlowLevel(GetTickCount64());
        const unsigned gr = (unsigned)(LOG_GLOW_R * lv + 0.5), gg = (unsigned)(LOG_GLOW_G * lv + 0.5), gb = (unsigned)(LOG_GLOW_B * lv + 0.5);
        for (size_t i = 0; i < cnt; ++i) {   // Screen: c + g - c*g/255 (Schwarz -> g, Weiß bleibt Weiß)
            const DWORD c = g_glow.base[i];
            const unsigned b0 = c & 0xFF, g0 = (c >> 8) & 0xFF, r0 = (c >> 16) & 0xFF;
            const unsigned b1 = b0 + gb - b0 * gb / 255, g1 = g0 + gg - g0 * gg / 255, r1 = r0 + gr - r0 * gr / 255;
            px[i] = (r1 << 16) | (g1 << 8) | b1;
        }
        BitBlt(dc, v.left, v.top, w, h, mem, 0, 0, SRCCOPY);
        SelectObject(mem, old);
    }
    if (mem) DeleteDC(mem);
    if (bmp) DeleteObject(bmp);
    ReleaseDC(hwnd, dc);
}
static void LogGlowStop(HWND hwnd) {
    if (!g_glow.active) return;
    KillTimer(hwnd, LOG_GLOW_TIMER);
    g_glow.active = false;
    g_glow.haveBase = false;
    std::vector<DWORD>().swap(g_glow.base);   // Puffer freigeben
    InvalidateRect(hwnd, &g_glow.rc, FALSE);  // Zeile wieder normal zeichnen
}
static void LogGlowTick(HWND hwnd) {
    if (!g_glow.active) { KillTimer(hwnd, LOG_GLOW_TIMER); return; }
    if (GetTickCount64() - g_glow.t0 >= LOG_GLOW_MS) { LogGlowStop(hwnd); return; }
    HWND top = GetAncestor(hwnd, GA_ROOT);
    if (!IsWindowVisible(hwnd) || (top && (IsIconic(top) || !IsWindowVisible(top)))) return;
    RECT r;
    if (!LogGlowLineRect(hwnd, r)) { LogGlowStop(hwnd); return; }
    if (!EqualRect(&r, &g_glow.rc) || !g_glow.haveBase) {   // verschoben (Scrollen/neue Zeile): neu zeichnen lassen, dann aufnehmen
        InvalidateRect(hwnd, &g_glow.rc, FALSE);
        g_glow.rc = r;
        g_glow.haveBase = false;
        InvalidateRect(hwnd, &r, FALSE);
        return;
    }
    LogGlowPaint(hwnd, false);
}
// Nach dem Öffnen des Fensters (Klick auf Windows-Hinweis oder Blase): Ziel-Zeile ggf. ins Bild holen und aufleuchten lassen.
// Ein neuer Klick während des Leuchtens startet neu (auf dem neuen Ziel). Ziel fehlt/ungültig -> nichts.
static void LogGlowStart() {
    HWND hwnd = g_hRichEdit;
    if (!hwnd || !IsWindow(hwnd)) return;
    LogGlowStop(hwnd);
    RECT r;
    if (!LogGlowLineRect(hwnd, r)) return;
    RECT cl; GetClientRect(hwnd, &cl);
    if (r.top < cl.top || r.bottom > cl.bottom) {   // nur scrollen, wenn die Zeile nicht ganz sichtbar ist
        const LONG line = (LONG)SendMessageW(hwnd, EM_EXLINEFROMCHAR, 0, (LPARAM)g_glowTarget.lineStart);
        const LONG first = (LONG)SendMessageW(hwnd, EM_GETFIRSTVISIBLELINE, 0, 0);
        const int lineH = g_pinSize > 0 ? MulDiv(g_pinSize, 4, 3) : 20;
        const LONG visLines = std::max<LONG>(1, (cl.bottom - cl.top) / std::max(1, lineH));
        const LONG want = std::max<LONG>(0, line - visLines / 2);
        SendMessageW(hwnd, EM_LINESCROLL, 0, (LPARAM)(want - first));
        if (!LogGlowLineRect(hwnd, r)) return;
    }
    g_glow.active = true;
    g_glow.t0 = GetTickCount64();
    g_glow.rc = r;
    g_glow.haveBase = false;
    InvalidateRect(hwnd, &r, FALSE);   // frisch zeichnen -> aufnehmen -> leuchten
    SetTimer(hwnd, LOG_GLOW_TIMER, 16, nullptr);
}
// ===== Ende Fix 31 (Aufleuchten) =====
static LRESULT CALLBACK LogPinSubclass(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam, UINT_PTR, DWORD_PTR) {
    if (msg == WM_NCDESTROY) { KillTimer(hwnd, LOG_GLOW_TIMER); KillTimer(hwnd, CLAIM_ANIM_TIMER); g_glow.active = false; RemoveWindowSubclass(hwnd, LogPinSubclass, 30); }
    if (msg == WM_TIMER && wParam == LOG_GLOW_TIMER) { LogGlowTick(hwnd); return 0; }   // Fix 31
    if (msg == WM_TIMER && wParam == CLAIM_ANIM_TIMER) { ClaimAnimTick(hwnd); return 0; }   // Fix 114
    if (msg == WM_PAINT && g_glow.active) {
        // Fix 31: ganze Ziel-Zeile mitzeichnen lassen (sauberes Bild ohne altes Leuchten), danach aufnehmen und überblenden
        RECT gr;
        if (LogGlowLineRect(hwnd, gr)) { g_glow.rc = gr; InvalidateRect(hwnd, &gr, FALSE); }
        else LogGlowStop(hwnd);   // Zeile weg -> nicht mehr leuchten (alte Stelle wird normal gezeichnet)
    }
    if (msg == WM_PAINT) {
        bool hint = LogShowsEmptyHint(hwnd);
        if (g_pinIcon || g_luckyIcon || g_fireworkIcon || g_eggIcon || hint) {   // Fix 44: + Ei
            // Neu zu zeichnenden Bereich merken (wird von BeginPaint im RichEdit geleert), Nadeln/Hinweis nur dort malen
            HRGN rgn = CreateRectRgn(0, 0, 0, 0);
            int rgnType = rgn ? GetUpdateRgn(hwnd, rgn, FALSE) : ERROR;
            LRESULT r = DefSubclassProc(hwnd, msg, wParam, lParam);
            if (rgnType != ERROR && rgnType != NULLREGION) {
                if (hint) DrawLogEmptyHint(hwnd, rgn);
                else DrawLogPins(hwnd, rgn);
            }
            if (rgn) DeleteObject(rgn);
            if (g_glow.active) LogGlowPaint(hwnd, true);   // Fix 31
            return r;
        }
        if (g_glow.active) { LRESULT r = DefSubclassProc(hwnd, msg, wParam, lParam); LogGlowPaint(hwnd, true); return r; }   // Fix 31
    }
    if (msg == WM_SIZE) {
        // Hinweis ist zentriert: bei Größenänderung komplett neu malen, sonst bleiben Reste stehen
        LRESULT r = DefSubclassProc(hwnd, msg, wParam, lParam);
        if (LogShowsEmptyHint(hwnd)) InvalidateRect(hwnd, nullptr, FALSE);
        return r;
    }
    return DefSubclassProc(hwnd, msg, wParam, lParam);
}
// Max. Zeichen im Log; kurz vor dem Limit werden die ältesten Zeilen entfernt (Speicher bleibt begrenzt)
static const LONG LOG_MAX_CHARS = 1 << 20;
static void LuckyLogTrimmed(LONG cut);   // Fix 29: gemerkte Lucky-Stellen nach dem Kürzen nachführen (Definition unten)
static void TrimLogIfNeeded() {
    if (!g_hRichEdit) return;
    GETTEXTLENGTHEX gtl = { GTL_DEFAULT, 1200 };
    LONG len = (LONG)SendMessageW(g_hRichEdit, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0);
    if (len < LOG_MAX_CHARS - 4096) return;
    // Bis zum Anfang eines ganzen Eintrags löschen, danach ist das Log ca. zu 3/4 gefüllt
    LONG cutChar = len - (LOG_MAX_CHARS / 4) * 3;
    LONG cut = -1;
    // Nächsten echten Absatzumbruch ('\r') nach cutChar suchen – keine halbe, umgebrochene Zeile stehen lassen
    {
        wchar_t buf[257] = {};
        LONG rangeEnd = std::min<LONG>(len, cutChar + 256);
        TEXTRANGEW tr = { { cutChar, rangeEnd }, buf };
        LONG got = (LONG)SendMessageW(g_hRichEdit, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
        for (LONG i = 0; i < got && i < 256; ++i) {
            if (buf[i] == L'\r') { cut = cutChar + i + 1; break; }
        }
    }
    // Kein Umbruch gefunden: wie bisher am Anfang der nächsten Bildschirmzeile schneiden
    if (cut <= 0) {
        LONG line = (LONG)SendMessageW(g_hRichEdit, EM_EXLINEFROMCHAR, 0, (LPARAM)cutChar);
        cut = (LONG)SendMessageW(g_hRichEdit, EM_LINEINDEX, (WPARAM)(line + 1), 0);
        if (cut <= 0) cut = cutChar;
    }
    SendMessageW(g_hRichEdit, EM_SETSEL, 0, (LPARAM)cut);
    SendMessageW(g_hRichEdit, EM_REPLACESEL, FALSE, (LPARAM)L"");
    LuckyLogTrimmed(cut);
}
// ===== Spiel starten =====
// Startet Last War über den Launcher in %LOCALAPPDATA%
static void StartLastWarGame() {
    wchar_t localAppData[MAX_PATH] = {};
    if (FAILED(SHGetFolderPathW(nullptr, CSIDL_LOCAL_APPDATA, nullptr, 0, localAppData)))
        return;
    std::wstring launcherPath = std::wstring(localAppData) + L"\\FunFly\\Last War-Survival Game\\LastWarLauncher.exe";
    if (GetFileAttributesW(launcherPath.c_str()) == INVALID_FILE_ATTRIBUTES)
        return;
    ShellExecuteW(nullptr, L"open", launcherPath.c_str(), nullptr, nullptr, SW_SHOWNORMAL);
}

// ===== Fund melden =====
// Daten eines Funds für die Übergabe an den UI-Thread
struct DigInfo {
    int server = 0;
    std::wstring x;
    std::wstring y;
    // Log-Zeile schreiben (Logging war beim Fund an) und Uhrzeit des Funds
    bool log = false;
    std::wstring timeStr;
    // Gefundener Dig-Text in der Spielsprache (z. B. „Testflugstörung“)
    std::wstring digText;
    // Warzone-Wort in der Spielsprache inkl. evtl. Leerzeichen vor „#“ (z. B. „Kriegszone “, Arabisch leer)
    std::wstring zoneText;
    bool hasZoneText = false;
    bool drone = false;   // Fix 120: Testflugdrohne (Dig-Art 'F') statt Schatz
};

// Schreibt die Fund-Zeile (Dig-Text in der Spielsprache) ins Log (nur im UI-Thread aufrufen)
static void WriteDigLogLine(const DigInfo& d) {
    if (!g_hRichEdit) return;
    TrimLogIfNeeded();
    ApplyPinIndent();
    AppendColoredText(L"[", LOG_TIME_COLOR);   // Fix 114: Uhrzeit samt Klammern und Doppelpunkt grau
    AppendColoredText(d.timeStr, LOG_TIME_COLOR);
    AppendColoredText(L"]: ", LOG_TIME_COLOR);
    {   // Fix 31: Zeilenanfang „[“ für das Aufleuchten nach Klick auf die Benachrichtigung
        CHARRANGE cr = { 0, 0 };
        SendMessageW(g_hRichEdit, EM_EXGETSEL, 0, (LPARAM)&cr);
        LogGlowNoteLine(cr.cpMax - 4 - (LONG)d.timeStr.size(), d.timeStr, false, std::string());
    }
    // U+200E (Links-nach-rechts-Marke) nach Dig-Text und Warzone-Wort: arabischer Text zieht sonst „[#…“ in seine Leserichtung
    // Fix 120: Drohne lila, Fallback „Test Flight Failure“, Marke „\u200E\u200E [“ (DigLogLineEnd erkennt daran die Drohnen-Zeile)
    if (d.drone) AppendColoredText((d.digText.empty() ? std::wstring(L"Test Flight Failure") : d.digText) + L"\u200E\u200E ", DRONE_COLOR);
    else AppendColoredText((d.digText.empty() ? std::wstring(L"DIG FOUND !") : d.digText) + L"\u200E ", RGB(0, 255, 0));
    AppendColoredText(L"[" + (d.hasZoneText ? d.zoneText : std::wstring(L"Warzone ")) + L"\u200E#", RGB(255, 255, 255), false, true);
    AppendColoredText(std::to_wstring(d.server), RGB(255, 255, 255), false, true);
    AppendColoredText(L" X:", RGB(255, 255, 255), false, true);
    AppendColoredText(d.x, RGB(255, 255, 255), false, true);
    AppendColoredText(L" Y:", RGB(255, 255, 255), false, true);
    AppendColoredText(d.y, RGB(255, 255, 255), false, true);
    AppendColoredText(L"]", RGB(255, 255, 255), false, true);
    AppendColoredText(L"\r\n", RGB(255, 255, 255));
    SendMessageW(g_hRichEdit, WM_VSCROLL, SB_BOTTOM, 0);
    if (g_pinIcon) InvalidateRect(g_hRichEdit, nullptr, FALSE);  // Nadeln neu malen
}

// Meldet einen Fund an den UI-Thread: dort werden Log-Zeile (Dig-Text, wenn Logging an ist),
// Blase und Tray-Hinweis erzeugt (WM_DIGFOUND). Das RichEdit wird nur noch im UI-Thread angefasst.
void AddDigLog(const std::wstring& timeStr, int server, const std::wstring& x, const std::wstring& y, const std::wstring& digText, const std::wstring& zoneText, bool hasZoneText, bool drone) {
    HWND hwnd = g_hWnd;
    if (hwnd && IsWindow(hwnd)) {
        auto info = std::make_unique<DigInfo>();
        info->server = server;
        info->x = x;
        info->y = y;
        info->log = g_loggingEnabled.load();
        info->timeStr = timeStr;
        info->digText = digText;
        info->zoneText = zoneText;
        info->hasZoneText = hasZoneText;
        info->drone = drone;   // Fix 120
        // Nur bei erfolgreichem Posten gehört der Speicher dem UI-Thread, sonst wird er hier freigegeben
        if (PostMessageW(hwnd, WM_DIGFOUND, 0, (LPARAM)info.get()))
            info.release();
    }
}

// ===== Lucky Gift (Glücksgeschenk) melden – nur Blase + Log, kein Discord, kein Dig-Zähler =====
struct LuckyInfo {
    bool log = false;            // Logging war beim Fund an (wie bei Digs)
    std::wstring timeStr;
    std::wstring label;          // „Glücksgeschenk“ (Deutsch) bzw. „Lucky Gift“
    std::wstring sender;         // Absender (senderInfo.name), leer = unbekannt
    bool langKnown = true;       // false: Sprache noch nicht per Dig bestätigt (gespeichert/„en“) -> Zeile zum Umbenennen merken
    std::string uuid;            // Fix 29: Geschenk-uuid (Zähler der Zeile später aktualisieren)
    int claims = -1;             // Fix 29: Anzahl Abholer (clientUpdateExtra), -1 = unbekannt -> keine Zahl
    int total = 0;               // Fix 29: Gesamtzahl (20 bei goodsId 995002), 0 = unbekannt -> nur „N“
};
static void LuckyNotifyFound(const LuckyInfo& d);   // Fix 34: Blase + Windows-Hinweis mit dem Text der Log-Zeile (Definition unten)
struct LuckyCountUpd { std::string uuid; int n = -1; int total = 0; };   // Fix 29: WM_LUCKYCOUNT
// Fix 27: Ergebnis der Sprach-Probe (eigener Thread, siehe LuckyProbeThread) für Worker und UI
static std::atomic<int> g_luckyProbeLabel{ -1 };                     // Index in LUCKY_LOG_LABELS, -1 = nichts erkannt
static std::atomic<bool> g_luckyProbeBusy{ false };                  // Probe für den aktuellen Spielprozess läuft gerade
static std::atomic<unsigned long long> g_luckyProbeHoldUntil{ 0 };   // GetTickCount64(): Lucky-Log-Zeilen höchstens bis dahin zurückhalten
static std::atomic<bool> g_luckyDigConfirmed{ false };               // Worker: Sprache per Dig bestätigt -> Probe unnötig
// ===== Fix 25: Lucky-Zeilen nachträglich in die Spielsprache umbenennen (nur UI-Thread) =====
// Solange die Spielsprache unbekannt ist (noch kein Dig gesehen), wird mit dem Ersatzwort geloggt und die Stelle des Worts
// gemerkt (max. 50 Zeilen). Ist die Sprache bekannt (WM_LUCKYRELABEL), wird NUR das Wort ersetzt (Farbe LUCKY_GIFT_COLOR);
// Uhrzeit, „: “ (weiß), Name (#D46BFF), Absatz-Einzug und Kleeblatt bleiben. Vor jedem Ersetzen wird geprüft, ob an der
// gemerkten Stelle noch genau diese Lucky-Zeile steht (Zeilenanfang, „]: “ + altes Wort, IsLuckyLogLine) – hat sich der Text
// verschoben (Log gekürzt/geleert), wird die Zeile sicher übersprungen.
struct LuckyPendingLabel { LONG lineStart; LONG labelStart; std::wstring label; bool known = false; };   // Fix 66: known = mit (vermeintlich) bestätigter Sprache geschrieben
static std::vector<LuckyPendingLabel> g_luckyPendingLabels;
static const size_t LUCKY_PENDING_MAX = 50;
// Fix 48: Ei-Zeile mit dem Wort „Ei“ (Name fehlte) – Stelle je uuid für ein späteres Umbenennen (max. 50)
struct EggLabelLine { std::string uuid; LONG lineStart; LONG labelStart; std::wstring label; };
static std::vector<EggLabelLine> g_eggLabelLines;
static void LuckyRememberLabel(LONG lineStart, LONG labelStart, const std::wstring& label, bool known = false) {
    if (g_luckyPendingLabels.size() >= LUCKY_PENDING_MAX) g_luckyPendingLabels.erase(g_luckyPendingLabels.begin());
    g_luckyPendingLabels.push_back({ lineStart, labelStart, label, known });
}
static LONG LuckyLogCaret() {
    CHARRANGE cr = { 0, 0 };
    SendMessageW(g_hRichEdit, EM_EXGETSEL, 0, (LPARAM)&cr);
    return cr.cpMax;
}
static std::wstring LuckyLogRange(LONG a, LONG b) {
    if (b <= a) return std::wstring();
    std::vector<wchar_t> buf((size_t)(b - a) + 1, L'\0');
    TEXTRANGEW tr = { { a, b }, buf.data() };
    LONG got = (LONG)SendMessageW(g_hRichEdit, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
    return std::wstring(buf.data(), (size_t)std::max<LONG>(0, std::min<LONG>(got, b - a)));
}
// ===== Fix 29: Abhol-Zähler „ N/20“ am Ende der Lucky-Zeile (nur UI-Thread) =====
// Leerzeichen weiß, Zahl grün wie die Zahl des Dig-Zählers; ab N >= Gesamtzahl rot (#FF4040); Gesamtzahl unbekannt -> nur „ N“
// (grün); Zahl unbekannt -> nichts (kann später erscheinen). Die Stelle wird je uuid gemerkt (max. 50 Zeilen). Steigt die Zahl
// (WM_LUCKYCOUNT), wird NUR die Zahl ersetzt – keine neue Zeile, keine Blase, kein Tray, kein Zähler. Vor dem Ersetzen wird
// geprüft, dass an der Stelle noch genau diese Lucky-Zeile mit genau dieser Zahl am Zeilenende steht, sonst übersprungen.
static const COLORREF LUCKY_COUNT_COLOR = RGB(0, 255, 0);
static const COLORREF LUCKY_COUNT_FULL_COLOR = RGB(255, 64, 64);
struct LuckyCountLine { std::string uuid; LONG lineStart; LONG countPos; std::wstring text; std::wstring prev; int n; int total; bool egg = false; bool stale = false; bool fw = false; };   // Fix 118: fw = Feuerwerk-Zeile (Abholer-Zahl ohne Maximum)
//   // Fix 44: egg = Ei-Zeile; Fix 115: stale = Zahl nicht mehr ersetzbar (Symbol bleibt)
static std::vector<LuckyCountLine> g_luckyCountLines;
static const size_t LUCKY_COUNT_LINES_MAX = 2000;   // Fix 117: 200 -> 2000, damit auch in langen Sitzungen jede Lucky-/Ei-Zeile im Log ihr Symbol behält (Kürzen des Logs entfernt ohnehin)
static std::wstring LuckyCountText(int n, int total) {
    if (n < 0) return std::wstring();
    return L" " + std::to_wstring(n) + (total > 0 ? L"/" + std::to_wstring(total) : std::wstring());
}
static COLORREF LuckyCountColor(int n, int total) { return (total > 0 && n >= total) ? LUCKY_COUNT_FULL_COLOR : LUCKY_COUNT_COLOR; }
static void LuckyRememberCount(const LuckyCountLine& c) {
    if (c.uuid.empty()) return;
    for (auto it = g_luckyCountLines.begin(); it != g_luckyCountLines.end(); ) { if (it->uuid == c.uuid) it = g_luckyCountLines.erase(it); else ++it; }
    if (g_luckyCountLines.size() >= LUCKY_COUNT_LINES_MAX) g_luckyCountLines.erase(g_luckyCountLines.begin());   // Fix 114: 200 statt 50 (Status-Symbol)
    g_luckyCountLines.push_back(c);
}
// Text ab Position at um delta Zeichen verschoben (Wort umbenannt, Zahl ersetzt): gemerkte Stellen dahinter nachführen
static void LuckyLogShift(LONG at, LONG delta) {
    if (delta == 0) return;
    for (auto& c : g_luckyCountLines) { if (c.lineStart >= at) c.lineStart += delta; if (c.countPos >= at) c.countPos += delta; }
    for (auto& p : g_luckyPendingLabels) { if (p.lineStart >= at) p.lineStart += delta; if (p.labelStart >= at) p.labelStart += delta; }
    for (auto& p : g_eggLabelLines) { if (p.lineStart >= at) p.lineStart += delta; if (p.labelStart >= at) p.labelStart += delta; }   // Fix 48
    LogGlowShift(at, delta);   // Fix 31
}
// Log vorne um cut Zeichen gekürzt (TrimLogIfNeeded): gelöschte Zeilen vergessen, Rest verschieben
static void LuckyLogTrimmed(LONG cut) {
    if (cut <= 0) return;
    for (auto it = g_luckyCountLines.begin(); it != g_luckyCountLines.end(); ) { if (it->lineStart < cut) it = g_luckyCountLines.erase(it); else ++it; }
    for (auto it = g_luckyPendingLabels.begin(); it != g_luckyPendingLabels.end(); ) { if (it->lineStart < cut) it = g_luckyPendingLabels.erase(it); else ++it; }
    for (auto it = g_eggLabelLines.begin(); it != g_eggLabelLines.end(); ) { if (it->lineStart < cut) it = g_eggLabelLines.erase(it); else ++it; }   // Fix 48
    LogGlowTrimDrop(cut);   // Fix 31
    LuckyLogShift(cut, -cut);
}
static void LuckySetRangeColor(LONG a, LONG b, COLORREF color) {
    if (b <= a) return;
    CHARRANGE r = { a, b };
    SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&r);
    CHARFORMAT2W cf = {};
    cf.cbSize = sizeof(cf);
    cf.dwMask = CFM_COLOR | CFM_FACE | CFM_SIZE | CFM_CHARSET | CFM_BOLD | CFM_UNDERLINE;
    cf.dwEffects = 0;
    cf.crTextColor = color;
    cf.yHeight = 260;
    cf.bCharSet = DEFAULT_CHARSET;
    wcscpy_s(cf.szFaceName, L"Segoe UI");
    SendMessageW(g_hRichEdit, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
}
// Neue Zahl n (Gesamtzahl total) in die gemerkte Zeile der uuid schreiben; true = ersetzt
static bool LuckyUpdateCountLine(const std::string& uuid, int n, int total) {
    if (!g_hRichEdit || uuid.empty() || n < 0) return false;
    for (size_t i = 0; i < g_luckyCountLines.size(); ++i) {
        LuckyCountLine& c = g_luckyCountLines[i];
        if (c.uuid != uuid) continue;
        if (c.stale) return false;                                     // Fix 115: Stelle unsicher -> Zahl bleibt, Symbol bleibt
        if (total < c.total) total = c.total;
        if (n < c.n || (n == c.n && total == c.total)) return false;   // Zahlen steigen nur
        GETTEXTLENGTHEX gtl = { GTL_NUMCHARS | GTL_PRECISE, 1200 };
        const LONG totalLen = (LONG)SendMessageW(g_hRichEdit, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0);
        const LONG len = (LONG)c.text.size();
        bool ok = c.lineStart >= 0 && c.countPos > c.lineStart + 4 && c.countPos + len < totalLen &&
            (c.lineStart == 0 || LuckyLogRange(c.lineStart - 1, c.lineStart) == L"\r") &&
            LuckyLogRange(c.lineStart, c.lineStart + 1) == L"[" &&
            LuckyLogRange(c.countPos - 1, c.countPos) == c.prev &&
            LuckyLogRange(c.countPos, c.countPos + len) == c.text &&
            LuckyLogRange(c.countPos + len, c.countPos + len + 1) == L"\r" &&        // Zahl steht am Zeilenende
            (c.egg ? IsEggLogLine(g_hRichEdit, c.lineStart, totalLen) : c.fw ? IsFireworkLogLine(g_hRichEdit, c.lineStart, totalLen) : IsLuckyLogLine(g_hRichEdit, c.lineStart, totalLen));   // Fix 44; Fix 118
        if (!ok) { c.stale = true; return false; }   // Fix 115: nicht mehr vergessen – Status-Symbol sucht das Zeilenende selbst
        const std::wstring nt = LuckyCountText(n, total);
        CHARRANGE oldSel = { 0, 0 };
        SendMessageW(g_hRichEdit, EM_EXGETSEL, 0, (LPARAM)&oldSel);
        POINT scroll = { 0, 0 };
        SendMessageW(g_hRichEdit, EM_GETSCROLLPOS, 0, (LPARAM)&scroll);
        CHARRANGE r = { c.countPos, c.countPos + len };
        SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&r);
        SendMessageW(g_hRichEdit, EM_REPLACESEL, FALSE, (LPARAM)nt.c_str());
        LuckySetRangeColor(c.countPos, c.countPos + 1, RGB(255, 255, 255));
        LuckySetRangeColor(c.countPos + 1, c.countPos + (LONG)nt.size(), LuckyCountColor(n, total));
        const LONG at = c.countPos + len, delta = (LONG)nt.size() - len;
        if (oldSel.cpMin >= at) oldSel.cpMin += delta;
        if (oldSel.cpMax >= at) oldSel.cpMax += delta;
        c.text = nt; c.n = n; c.total = total;
        const LONG keepPos = c.countPos;   // Fix 115: bei leerer Zahl (erste Zahl) ist countPos == at und würde mitverschoben
        LuckyLogShift(at, delta);
        c.countPos = keepPos;
        SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&oldSel);
        SendMessageW(g_hRichEdit, EM_SETSCROLLPOS, 0, (LPARAM)&scroll);
        InvalidateRect(g_hRichEdit, nullptr, FALSE);
        return true;
    }
    return false;
}
// Ersetzt das Wort aller gemerkten Zeilen durch newLabel, leert die Liste; Rückgabe = Anzahl umbenannter Zeilen
// Fix 66: all = false (Fix 25, Sprache jetzt bekannt): nur Zeilen mit Ersatzwort, Zeilen mit bestätigter Sprache bleiben gemerkt;
// all = true (Sprach-Probe nachträglich korrigiert, z. B. veraltete deutsche Texte in einem thailändischen Spiel): alle Zeilen.
static int LuckyRelabelLines(const std::wstring& newLabel, bool all = false) {
    int done = 0;
    if (!g_hRichEdit || newLabel.empty() || g_luckyPendingLabels.empty()) { if (!g_hRichEdit) g_luckyPendingLabels.clear(); return 0; }
    GETTEXTLENGTHEX gtl = { GTL_NUMCHARS | GTL_PRECISE, 1200 };
    LONG total = (LONG)SendMessageW(g_hRichEdit, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0);
    CHARRANGE oldSel = { 0, 0 };
    SendMessageW(g_hRichEdit, EM_EXGETSEL, 0, (LPARAM)&oldSel);
    POINT scroll = { 0, 0 };
    SendMessageW(g_hRichEdit, EM_GETSCROLLPOS, 0, (LPARAM)&scroll);
    // Von hinten nach vorne: ein Ersetzen verschiebt nur Text dahinter, die vorderen Positionen bleiben gültig
    // Fix 66: Einträge bleiben gemerkt (neues Wort, known = true), damit eine spätere Korrektur der Sprache sie noch findet;
    // ungültige Stellen (Zeile verschoben/gelöscht) werden entfernt (lineStart = -1).
    for (auto it = g_luckyPendingLabels.rbegin(); it != g_luckyPendingLabels.rend(); ++it) {
        LuckyPendingLabel& p = *it;
        if (!all && p.known) continue;                         // Fix 66: Fix-25-Umbenennen nur für Ersatzwort-Zeilen
        if (p.label == newLabel) { p.known = true; continue; }
        LONG len = (LONG)p.label.size();
        bool okLine = !(p.lineStart < 0 || p.labelStart < p.lineStart + 4 || p.labelStart + len > total);
        if (okLine && p.lineStart > 0 && LuckyLogRange(p.lineStart - 1, p.lineStart) != L"\r") okLine = false;
        if (okLine && LuckyLogRange(p.lineStart, p.lineStart + 1) != L"[") okLine = false;
        if (okLine && LuckyLogRange(p.labelStart - 3, p.labelStart + len) != L"]: " + p.label) okLine = false;
        if (okLine) {
            std::wstring after = LuckyLogRange(p.labelStart + len, std::min<LONG>(total, p.labelStart + len + 1));
            if (!after.empty() && after != L":" && after != L"\r" && after != L" ") okLine = false;   // Fix 29: „ N/20“ ohne Absender
        }
        if (okLine && !IsLuckyLogLine(g_hRichEdit, p.lineStart, total)) okLine = false;
        if (!okLine) { p.lineStart = -1; continue; }
        CHARRANGE r = { p.labelStart, p.labelStart + len };
        SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&r);
        SendMessageW(g_hRichEdit, EM_REPLACESEL, FALSE, (LPARAM)newLabel.c_str());
        // Neues Wort wie AppendColoredText formatieren (Goldgelb, Segoe UI, 13 pt, nicht fett/unterstrichen)
        CHARRANGE nr = { p.labelStart, p.labelStart + (LONG)newLabel.size() };
        SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&nr);
        CHARFORMAT2W cf = {};
        cf.cbSize = sizeof(cf);
        cf.dwMask = CFM_COLOR | CFM_FACE | CFM_SIZE | CFM_CHARSET | CFM_BOLD | CFM_UNDERLINE;
        cf.dwEffects = 0;
        cf.crTextColor = LUCKY_GIFT_COLOR;
        cf.yHeight = 260;
        cf.bCharSet = DEFAULT_CHARSET;
        wcscpy_s(cf.szFaceName, L"Segoe UI");
        SendMessageW(g_hRichEdit, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
        LONG delta = (LONG)newLabel.size() - len;
        total += delta;
        if (oldSel.cpMin >= p.labelStart + len) oldSel.cpMin += delta;
        if (oldSel.cpMax >= p.labelStart + len) oldSel.cpMax += delta;
        LuckyLogShift(p.labelStart + len, delta);   // Fix 29: Zähler-Stellen dahinter nachführen
        for (auto& c : g_luckyCountLines)           // Zeile ohne Absender: Zahl folgt direkt dem Wort -> neues letztes Zeichen merken
            if (c.countPos == p.labelStart + (LONG)newLabel.size()) c.prev = newLabel.substr(newLabel.size() - 1);
        p.label = newLabel; p.known = true;                    // Fix 66
        ++done;
    }
    g_luckyPendingLabels.erase(std::remove_if(g_luckyPendingLabels.begin(), g_luckyPendingLabels.end(),
        [](const LuckyPendingLabel& q) { return q.lineStart < 0; }), g_luckyPendingLabels.end());   // Fix 66
    SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&oldSel);
    SendMessageW(g_hRichEdit, EM_SETSCROLLPOS, 0, (LPARAM)&scroll);
    if (done) InvalidateRect(g_hRichEdit, nullptr, FALSE);
    return done;
}
// ===== Ende Fix 25 (UI) =====
// Log-Zeile „[hh:mm:ss]: Glücksgeschenk: Absender“ mit Kleeblatt davor (ohne Absender nur „Glücksgeschenk“; nur im UI-Thread aufrufen)
static void WriteLuckyLogLine(const LuckyInfo& d) {
    if (!g_hRichEdit) return;
    TrimLogIfNeeded();
    ApplyPinIndent(true);
    AppendColoredText(L"[", LOG_TIME_COLOR);   // Fix 114: Uhrzeit samt Klammern und Doppelpunkt grau
    AppendColoredText(d.timeStr, LOG_TIME_COLOR);
    AppendColoredText(L"]: ", LOG_TIME_COLOR);
    const LONG lineStart = LuckyLogCaret() - 4 - (LONG)d.timeStr.size();   // Fix 29: Zeilenanfang „[“
    LogGlowNoteLine(lineStart, d.timeStr, true, d.uuid);                    // Fix 31
    if (!d.label.empty()) {                  // Fix 66: auch Zeilen mit bestätigter Sprache merken (spätere Korrektur der Probe)
        LONG labelStart = LuckyLogCaret();   // Zeichenposition direkt nach „]: “
        LuckyRememberLabel(labelStart - 4 - (LONG)d.timeStr.size(), labelStart, d.label, d.langKnown);
    }
    AppendColoredText(d.label, LUCKY_GIFT_COLOR);
    if (!d.sender.empty()) {
        AppendColoredText(L": ", RGB(255, 255, 255));
        // U+200E vor und nach dem Namen: ein arabischer/hebräischer Name bleibt am Zeilenende und zieht „: “ nicht in seine Leserichtung
        AppendColoredText(L"\u200E" + d.sender + L"\u200E", LUCKY_SENDER_COLOR);
    }
    // Fix 29: Abhol-Zähler „ N/20“ (Zahl unbekannt -> nichts, Stelle trotzdem gemerkt -> kann per Update erscheinen)
    if (!d.uuid.empty()) {
        LuckyCountLine c;
        c.uuid = d.uuid; c.lineStart = lineStart; c.countPos = LuckyLogCaret(); c.n = d.claims; c.total = d.claims >= 0 ? d.total : 0;
        c.prev = LuckyLogRange(c.countPos - 1, c.countPos);
        c.text = LuckyCountText(d.claims, d.total);
        if (!c.text.empty()) {
            AppendColoredText(L" ", RGB(255, 255, 255));
            AppendColoredText(c.text.substr(1), LuckyCountColor(d.claims, d.total));
        }
        LuckyRememberCount(c);
    }
    AppendColoredText(L"\r\n", RGB(255, 255, 255));
    SendMessageW(g_hRichEdit, WM_VSCROLL, SB_BOTTOM, 0);
    if (g_pinIcon || g_luckyIcon) InvalidateRect(g_hRichEdit, nullptr, FALSE);
}
// Fix 27: Solange die Sprach-Probe läuft (max. LUCKY_PROBE_HOLD_MS ab Probe-Start), werden Lucky-Log-Zeilen mit noch
// unbestätigter Sprache kurz zurückgehalten (Zähler sofort; Fix 34: Blase und Tray mit dem Text der Zeile erst beim
// Schreiben, auch bei ausgeschaltetem Logging) und dann mit dem erkannten Wort geschrieben. Ohne Ergebnis: gespeichertes Wort wie bisher, Zeile gemerkt -> späteres Umbenennen (Fix 25). Nur UI-Thread.
static std::vector<LuckyInfo> g_luckyHeld;
static bool LuckyHoldActive() {
    return g_luckyProbeBusy.load() && GetTickCount64() < g_luckyProbeHoldUntil.load();
}
// true: Zeile übernommen (Aufrufer schreibt sie dann nicht selbst); Reihenfolge bleibt, solange schon Zeilen warten
static bool LuckyHoldLine(const LuckyInfo& d) {
    if (g_luckyHeld.size() >= 50) return false;   // Fix 34: auch ohne Logging (Benachrichtigung wartet auf die Sprache)
    if (g_luckyHeld.empty() && (d.langKnown || !LuckyHoldActive())) return false;
    g_luckyHeld.push_back(d);
    return true;
}
// force = sofort (z. B. vor dem Umbenennen); label = per Dig bestätigtes Wort (sonst Ergebnis der Probe)
static void LuckyFlushHeld(bool force, const std::wstring* label = nullptr) {
    if (g_luckyHeld.empty() || (!force && LuckyHoldActive())) return;
    const int li = g_luckyProbeLabel.load();
    const int nLabels = (int)(sizeof(LUCKY_LOG_LABELS) / sizeof(LUCKY_LOG_LABELS[0]));
    std::vector<LuckyInfo> held;
    held.swap(g_luckyHeld);
    for (auto& d : held) {
        if (!d.langKnown && label) { d.label = *label; d.langKnown = true; }
        else if (!d.langKnown && li >= 0 && li < nLabels) { d.label = LUCKY_LOG_LABELS[li].text; d.langKnown = true; }
        if (d.log) WriteLuckyLogLine(d);
    }
    LuckyNotifyFound(held.back());   // Fix 34: eine Benachrichtigung (neueste) mit dem jetzt bekannten Wort
}
// Fix 29: neue Abhol-Zahl (WM_LUCKYCOUNT) – zurückgehaltene Zeile bzw. bereits geschriebene Zeile; sonst nichts
static void LuckyApplyCount(const LuckyCountUpd& u) {
    for (auto& d : g_luckyHeld) {
        if (d.uuid != u.uuid) continue;
        if (u.n > d.claims) d.claims = u.n;
        if (u.total > d.total) d.total = u.total;
    }
    LuckyUpdateCountLine(u.uuid, u.n, u.total);
}
static void AddLuckyLog(const std::wstring& timeStr, const std::wstring& label, const std::wstring& sender, bool langKnown = true,
    const std::string& uuid = std::string(), int claims = -1, int total = 0) {
    HWND hwnd = g_hWnd;
    if (hwnd && IsWindow(hwnd)) {
        auto info = std::make_unique<LuckyInfo>();
        info->log = g_loggingEnabled.load();
        info->timeStr = timeStr;
        info->label = label;
        info->sender = sender;
        info->langKnown = langKnown;
        info->uuid = uuid;           // Fix 29
        info->claims = claims;
        info->total = total;
        if (PostMessageW(hwnd, WM_LUCKYFOUND, 0, (LPARAM)info.get()))
            info.release();
    }
}
// Fix 25: neues Log-Wort an den UI-Thread (gemerkte Lucky-Zeilen umbenennen)
static void PostLuckyRelabel(const std::wstring& label, bool all = false) {   // Fix 66: all = auch Zeilen mit bestätigter Sprache
    HWND hwnd = g_hWnd;
    if (hwnd && IsWindow(hwnd)) {
        auto p = std::make_unique<std::wstring>(label);
        if (PostMessageW(hwnd, WM_LUCKYRELABEL, all ? 1 : 0, (LPARAM)p.get()))
            p.release();
    }
}
// Fix 29: gestiegene Abhol-Zahl an den UI-Thread (nur die Zahl der Lucky-Zeile wird ersetzt)
static void PostLuckyCount(const std::string& uuid, int n, int total) {
    HWND hwnd = g_hWnd;
    if (hwnd && IsWindow(hwnd)) {
        auto p = std::make_unique<LuckyCountUpd>();
        p->uuid = uuid; p->n = n; p->total = total;
        if (PostMessageW(hwnd, WM_LUCKYCOUNT, 0, (LPARAM)p.get()))
            p.release();
    }
}
// Fix 114: eigene uid in der Abholer-Liste -> UI-Thread (Haken + Zähler „abgeholt/gemeldet“)
// initial = schon beim Melden abgeholt (Zeile zeigt sofort den Haken, ohne Animation)
static void PostLuckyMine(const std::string& uuid, bool initial = false) {
    HWND hwnd = g_hWnd;
    if (hwnd && IsWindow(hwnd)) {
        auto p = std::make_unique<std::string>(uuid);
        if (PostMessageW(hwnd, WM_LUCKYMINE, initial ? 1 : 0, (LPARAM)p.get()))
            p.release();
    }
}
// Fix 114 (nur UI-Thread): je uuid 1 = als Lucky gezählt, 2 = als Ei gezählt, 4 = selbst abgeholt, 8 = als Feuerwerk gezählt (Fix 118); höchstens 2500 uuids (Fix 117)
static std::unordered_map<std::string, unsigned char> g_uiGiftFlags;
static std::deque<std::string> g_uiGiftOrder;
static unsigned char& UiGiftFlags(const std::string& uuid) {
    auto it = g_uiGiftFlags.find(uuid);
    if (it != g_uiGiftFlags.end()) return it->second;
    if (g_uiGiftOrder.size() >= 2500) {   // Fix 117: 400 -> 2500 (mehr als LUCKY_COUNT_LINES_MAX, Haken bleibt bei alten Zeilen)
        g_uiGiftFlags.erase(g_uiGiftOrder.front()); g_uiGiftOrder.pop_front(); }
    g_uiGiftOrder.push_back(uuid);
    return g_uiGiftFlags[uuid];
}
static bool UiGiftMine(const std::string& uuid) {
    auto it = g_uiGiftFlags.find(uuid);
    return it != g_uiGiftFlags.end() && (it->second & 4);
}
// Gemeldetes Geschenk gezählt (vor LayoutCounters aufrufen)
static void UiGiftCounted(const std::string& uuid, bool egg) {
    if (uuid.empty()) return;
    unsigned char& f = UiGiftFlags(uuid);
    const unsigned char bit = egg ? 2 : 1;
    if (f & bit) return;
    f |= bit;
    if (f & 4) { if (egg) ++g_eggClaimed; else ++g_luckyClaimed; }
}
// Fix 118: gemeldetes Feuerwerk gezählt (Bit 8; vor LayoutCounters aufrufen)
static void UiFireworkCounted(const std::string& uuid) {
    if (uuid.empty()) return;
    unsigned char& f = UiGiftFlags(uuid);
    if (f & 8) return;
    f |= 8;
    if (f & 4) ++g_fireworkClaimed;
}
// ===== Fix 114: Status-Symbol hinter Lucky-/Ei-Zeilen =====
// Offen = grauer Ring (innen durchsichtig), abgeholt = grüner Kreis mit weißem Haken. Selbst gerastert (4x4 Unterabtastung,
// vormultipliziertes Alpha, AlphaBlend) – kein GDI+ im Hauptfenster, keine .ico. Bild 0 = offen, CLAIM_FRAMES = abgeholt,
// dazwischen die Animation (Ring grau -> grün, Haken wächst von links nach rechts). Einmal erzeugt, ca. 11 KB.
static const int CLAIM_FRAMES = 10;
static const ULONGLONG CLAIM_ANIM_MS = 300;
static HBITMAP g_claimBmp[CLAIM_FRAMES + 1] = {};
static int g_claimBmpSize = 0;
static std::unordered_map<std::string, ULONGLONG> g_claimAnim;   // uuid -> Start der Animation (nur UI-Thread)
static float ClaimSegDist(float px, float py, float ax, float ay, float bx, float by, float f) {   // Abstand zur Strecke a->(a+f*(b-a))
    bx = ax + (bx - ax) * f; by = ay + (by - ay) * f;
    const float vx = bx - ax, vy = by - ay, l2 = vx * vx + vy * vy;
    float u = l2 > 0 ? ((px - ax) * vx + (py - ay) * vy) / l2 : 0.0f;
    u = u < 0 ? 0 : (u > 1 ? 1 : u);
    const float dx = px - (ax + u * vx), dy = py - (ay + u * vy);
    return std::sqrt(dx * dx + dy * dy);
}
static HBITMAP ClaimRenderFrame(int s, float t) {
    BITMAPINFO bi = {};
    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER); bi.bmiHeader.biWidth = s; bi.bmiHeader.biHeight = -s;
    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
    void* bits = nullptr;
    HBITMAP bmp = CreateDIBSection(nullptr, &bi, DIB_RGB_COLORS, &bits, nullptr, 0);
    if (!bmp || !bits) return bmp;
    const float e = t * t * (3 - 2 * t);                        // weich ein-/ausblenden
    const float pc = t <= 0.2f ? 0.0f : (t - 0.2f) / 0.8f;      // Haken beginnt kurz nach dem Ring
    const float ce = pc * pc * (3 - 2 * pc);
    const float S = (float)s, c = S / 2, R = S * 0.46f, w = std::max(1.2f, S * 0.09f), hw = std::max(0.9f, S * 0.075f);
    const float x0 = 0.29f * S, y0 = 0.52f * S, x1 = 0.44f * S, y1 = 0.67f * S, x2 = 0.72f * S, y2 = 0.37f * S;
    const float l1 = std::hypot(x1 - x0, y1 - y0), l2 = std::hypot(x2 - x1, y2 - y1), len = ce * (l1 + l2);
    const float gr = 115 + (46 - 115) * e, gg = 115 + (196 - 115) * e, gb = 115 + (92 - 115) * e;   // Ring grau -> grün
    unsigned char* px = (unsigned char*)bits;
    for (int y = 0; y < s; ++y) for (int x = 0; x < s; ++x) {
        float cD = 0, cR = 0, cC = 0;
        for (int sy = 0; sy < 4; ++sy) for (int sx = 0; sx < 4; ++sx) {
            const float fx = x + (sx + 0.5f) / 4, fy = y + (sy + 0.5f) / 4;
            const float dd = std::hypot(fx - c, fy - c);
            if (dd <= R) { cD += 1; if (dd >= R - w) cR += 1; }
            if (len > 0) {
                float dc = 1e9f;
                if (len <= l1) dc = ClaimSegDist(fx, fy, x0, y0, x1, y1, len / l1);
                else dc = std::min(ClaimSegDist(fx, fy, x0, y0, x1, y1, 1.0f), ClaimSegDist(fx, fy, x1, y1, x2, y2, (len - l1) / l2));
                if (dc <= hw) cC += 1;
            }
        }
        cD /= 16; cR /= 16; cC /= 16;
        float r = 0, g = 0, b = 0, a = 0;                       // vormultipliziert, „über“ stapeln
        auto over = [&](float cr, float cg, float cb, float ca) { r = cr * ca + r * (1 - ca); g = cg * ca + g * (1 - ca); b = cb * ca + b * (1 - ca); a = ca + a * (1 - ca); };
        over(46, 196, 92, cD * e);                              // Füllung grün (abgeholt)
        over(gr, gg, gb, cR);                                   // Ring
        over(255, 255, 255, cC);                                // Haken weiß
        unsigned char* q = px + ((size_t)y * s + x) * 4;
        q[0] = (unsigned char)(b + 0.5f); q[1] = (unsigned char)(g + 0.5f); q[2] = (unsigned char)(r + 0.5f); q[3] = (unsigned char)(a * 255 + 0.5f);
    }
    return bmp;
}
// Fix 117: erste sichtbare Spalte (Alpha >= 64) eines 32-Bit-Bildes; ohne Alpha über die Maske; -1 = unbekannt
static int BitmapInkLeft(HBITMAP bmp, int s, HBITMAP mask = nullptr) {
    if (!bmp || s <= 0) return -1;
    std::vector<DWORD> px((size_t)s * s);
    BITMAPINFO bi = {};
    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER); bi.bmiHeader.biWidth = s; bi.bmiHeader.biHeight = -s;
    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
    HDC dc = GetDC(nullptr);
    int got = GetDIBits(dc, bmp, 0, (UINT)s, px.data(), &bi, DIB_RGB_COLORS);
    bool alpha = false;
    for (DWORD v : px) if (v >> 24) { alpha = true; break; }
    if (got > 0 && !alpha && mask) {   // Maske: schwarz = deckend
        got = GetDIBits(dc, mask, 0, (UINT)s, px.data(), &bi, DIB_RGB_COLORS);
        for (DWORD& v : px) v = (v & 0xFFFFFF) ? 0 : 0xFF000000u;
    }
    ReleaseDC(nullptr, dc);
    if (got <= 0) return -1;
    for (int x = 0; x < s; ++x) for (int y = 0; y < s; ++y) if ((px[(size_t)y * s + x] >> 24) >= 64) return x;
    return -1;
}
static int IconInkLeft(HICON icon, int s) {
    ICONINFO ii = {};
    if (!icon || !GetIconInfo(icon, &ii)) return -1;
    int r = BitmapInkLeft(ii.hbmColor, s, ii.hbmMask);
    if (ii.hbmColor) DeleteObject(ii.hbmColor);
    if (ii.hbmMask) DeleteObject(ii.hbmMask);
    return r;
}
// Fix 117: Abstand Textende -> Ring/Haken wie bei der Dig-Nadel hinter „]“: g_pinGap plus der leere Rand links im Nadel-Bild,
// minus der leere Rand links im Ring-Bild (sichtbar gleicher Abstand). Einmal je Größe gemessen.
static int g_claimDx = 0;
static int g_claimDy = INT_MIN;          // Fix 118: senkrechter Versatz aus den Schrift-Maßen (ClaimMeasureDy)
static int g_claimDyInfo[7] = {};         // Fix 118: Messwerte (ascent, descent, intLeading, glyphTop, glyphH, ringTop, ringBot) – nur zur Kontrolle
static void ClaimMeasureDy();
static void ClaimEnsureBitmaps() {
    if (g_claimBmpSize == g_pinSize || g_pinSize <= 0) return;
    for (auto& b : g_claimBmp) { if (b) DeleteObject(b); b = nullptr; }
    g_claimBmpSize = g_pinSize;
    for (int f = 0; f <= CLAIM_FRAMES; ++f) g_claimBmp[f] = ClaimRenderFrame(g_pinSize, (float)f / CLAIM_FRAMES);
    g_claimDx = g_pinGap;
    const int pinL = IconInkLeft(g_pinIcon, g_pinSize), ringL = BitmapInkLeft(g_claimBmp[0], g_pinSize);
    if (pinL >= 0 && ringL >= 0) g_claimDx = std::max(1, g_pinGap + pinL - ringL);
    ClaimMeasureDy();
}
// Fix 118: senkrechte Lage aus den echten Schrift-Maßen (Log-Schrift Segoe UI 13 pt bei der DPI des Logs): Mitte der Ziffern
// (Grundlinie - halbe Ziffernhöhe, GetGlyphOutline '0') = Mitte des Rings (Deckkraft-Zeilen der Grafik). g_claimDy = Abstand
// Bild-Oberkante zur Zeilen-Oberkante; INT_MIN = Messung fehlgeschlagen -> alte Mitte der Zeilenhöhe.
static void ClaimMeasureDy() {
    g_claimDy = INT_MIN;
    if (g_pinSize <= 0 || !g_claimBmp[0]) return;
    HDC dc = GetDC(g_hRichEdit);
    if (!dc) return;
    HFONT f = CreateFontW(-MulDiv(13, g_pinDpi, 72), 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
        CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH, L"Segoe UI");
    HGDIOBJ old = f ? SelectObject(dc, f) : nullptr;
    TEXTMETRICW tm = {};
    GLYPHMETRICS gm = {};
    const MAT2 id = { {0, 1}, {0, 0}, {0, 0}, {0, 1} };
    const bool okTm = f && GetTextMetricsW(dc, &tm);
    const bool okGm = f && GetGlyphOutlineW(dc, L'0', GGO_METRICS, &gm, 0, nullptr, &id) != GDI_ERROR;
    if (old) SelectObject(dc, old);
    if (f) DeleteObject(f);
    ReleaseDC(g_hRichEdit, dc);
    // Ring: erste/letzte Zeile mit Deckkraft
    const int s = g_pinSize;
    std::vector<DWORD> px((size_t)s * s);
    BITMAPINFO bi = {};
    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER); bi.bmiHeader.biWidth = s; bi.bmiHeader.biHeight = -s;
    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
    HDC sdc = GetDC(nullptr);
    const int got = GetDIBits(sdc, g_claimBmp[0], 0, (UINT)s, px.data(), &bi, DIB_RGB_COLORS);
    ReleaseDC(nullptr, sdc);
    int top = -1, bot = -1;
    for (int y = 0; got > 0 && y < s; ++y) for (int x = 0; x < s; ++x) if ((px[(size_t)y * s + x] >> 24) >= 64) { if (top < 0) top = y; bot = y; break; }
    if (!okTm || !okGm || top < 0 || gm.gmBlackBoxY == 0) return;
    // Ziffern-Mitte unter der Zeilen-Oberkante (Zeile beginnt mit der Oberkante der Schrift: Grundlinie = tmAscent)
    const double digitMid = tm.tmAscent - ((double)gm.gmptGlyphOrigin.y - gm.gmBlackBoxY / 2.0);
    const double ringMid = (top + bot + 1) / 2.0;
    g_claimDy = (int)std::lround(digitMid - ringMid);
    g_claimDyInfo[0] = tm.tmAscent; g_claimDyInfo[1] = tm.tmDescent; g_claimDyInfo[2] = tm.tmInternalLeading;
    g_claimDyInfo[3] = gm.gmptGlyphOrigin.y; g_claimDyInfo[4] = (int)gm.gmBlackBoxY; g_claimDyInfo[5] = top; g_claimDyInfo[6] = bot;
}
// Stelle des Symbols einer gemerkten Zeile (direkt hinter „ N/20“ bzw. Wort/Absender); false = nicht (mehr) gültig
static bool ClaimIconRect(HWND hwnd, const LuckyCountLine& c, LONG total, RECT& out) {
    LONG e = c.countPos + (LONG)c.text.size();
    if (c.lineStart < 0 || g_pinSize <= 0 || e <= 0 || c.lineStart >= total) return false;
    wchar_t ch[2] = {};
    TEXTRANGEW tr = { { e, e + 1 }, ch };
    if (e < total) SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&tr);
    if (e >= total || ch[0] != L'\r' || c.stale) {
        // Fix 115: gemerkte Zahl-Stelle passt nicht (mehr) -> Zeilenende ab dem Zeilenanfang suchen (Zeile muss noch dieselbe Art sein)
        wchar_t buf[513] = {};
        const LONG endIdx = std::min<LONG>(total, c.lineStart + 512);
        TEXTRANGEW lr = { { c.lineStart, endIdx }, buf };
        const LONG got = (LONG)SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&lr);
        if (got <= 0 || buf[0] != L'[') return false;
        if (c.lineStart > 0) {
            wchar_t pc[2] = {};
            TEXTRANGEW pr = { { c.lineStart - 1, c.lineStart }, pc };
            SendMessageW(hwnd, EM_GETTEXTRANGE, 0, (LPARAM)&pr);
            if (pc[0] != L'\r') return false;
        }
        LONG k = 0;
        while (k < got && k < 512 && buf[k] != L'\r') ++k;
        if (k >= got) return false;
        if (!(c.egg ? IsEggLogLine(hwnd, c.lineStart, total) : c.fw ? IsFireworkLogLine(hwnd, c.lineStart, total) : IsLuckyLogLine(hwnd, c.lineStart, total))) return false;   // Fix 118
        e = c.lineStart + k;
    }
    POINTL pt = {};
    SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&pt, e);
    int lineH = MulDiv(g_pinSize, 4, 3);
    const LONG ln = (LONG)SendMessageW(hwnd, EM_EXLINEFROMCHAR, 0, e);
    const LONG nx = (LONG)SendMessageW(hwnd, EM_LINEINDEX, (WPARAM)(ln + 1), 0);
    if (nx > e) { POINTL pn = {}; SendMessageW(hwnd, EM_POSFROMCHAR, (WPARAM)&pn, nx); if (pn.y > pt.y && pn.y - pt.y < 4 * g_pinSize) lineH = (int)(pn.y - pt.y); }
    ClaimEnsureBitmaps();
    out.left = (int)pt.x + g_claimDx;   // Fix 117: Abstand wie die Dig-Nadel
    out.top = (int)pt.y + (g_claimDy != INT_MIN ? g_claimDy : (lineH - g_pinSize) / 2);   // Fix 118: Ring-Mitte = Ziffern-Mitte
    out.right = out.left + g_pinSize; out.bottom = out.top + g_pinSize;
    return true;
}
static void ClaimAnimTick(HWND hwnd) {
    const ULONGLONG now = GetTickCount64();
    GETTEXTLENGTHEX gtl = { GTL_NUMCHARS | GTL_PRECISE, 1200 };
    const LONG total = (LONG)SendMessageW(hwnd, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0);
    for (auto it = g_claimAnim.begin(); it != g_claimAnim.end(); ) {
        for (const auto& c : g_luckyCountLines) {
            RECT r;
            if (c.uuid == it->first && ClaimIconRect(hwnd, c, total, r)) { InflateRect(&r, 1, 1); InvalidateRect(hwnd, &r, FALSE); }
        }
        if (now - it->second >= CLAIM_ANIM_MS) it = g_claimAnim.erase(it); else ++it;   // letztes Bild ist schon angefordert
    }
    if (g_claimAnim.empty()) KillTimer(hwnd, CLAIM_ANIM_TIMER);
}
static void UiGiftMineSet(const std::string& uuid, bool animate) {
    if (uuid.empty()) return;
    unsigned char& f = UiGiftFlags(uuid);
    if (f & 4) return;
    f |= 4;
    if (f & 1) ++g_luckyClaimed;
    if (f & 2) ++g_eggClaimed;
    if (f & 8) ++g_fireworkClaimed;   // Fix 118
    if (f & 11) LayoutCounters();
    if (!g_hRichEdit) return;
    bool shown = false;                                         // Animation nur, wenn die Zeile schon als „offen“ zu sehen war
    for (const auto& c : g_luckyCountLines) if (c.uuid == uuid) { shown = true; break; }
    if (animate && shown && g_claimAnim.size() < 20) {
        g_claimAnim[uuid] = GetTickCount64();
        SetTimer(g_hRichEdit, CLAIM_ANIM_TIMER, (UINT)(CLAIM_ANIM_MS / CLAIM_FRAMES), nullptr);
        ClaimAnimTick(g_hRichEdit);
    } else if (shown) InvalidateRect(g_hRichEdit, nullptr, FALSE);
}
// Status-Symbol aller gemerkten Lucky-/Ei-Zeilen (aus DrawLogPins, nach dem RichEdit-Bild)
static void DrawClaimChecks(HWND hwnd, HDC dc, const RECT& rc, LONG total) {
    if (g_luckyCountLines.empty()) return;
    ClaimEnsureBitmaps();
    if (!g_claimBmp[0] || !g_claimBmp[CLAIM_FRAMES]) return;
    HDC mem = CreateCompatibleDC(dc);
    if (!mem) return;
    HGDIOBJ old = nullptr;
    const ULONGLONG now = GetTickCount64();
    const BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
    // Fix 117: nur Zeilen im sichtbaren Textbereich prüfen (bei bis zu 2000 gemerkten Zeilen sonst viele Abfragen je Neuzeichnen)
    const LONG firstVis = (LONG)SendMessageW(hwnd, EM_LINEINDEX, (WPARAM)SendMessageW(hwnd, EM_GETFIRSTVISIBLELINE, 0, 0), 0);
    POINTL br = { rc.right - 1, rc.bottom - 1 };
    LONG lastVis = (LONG)SendMessageW(hwnd, EM_CHARFROMPOS, 0, (LPARAM)&br);
    if (lastVis < 0 || lastVis > total) lastVis = total;
    for (const auto& c : g_luckyCountLines) {
        if (c.lineStart > lastVis) continue;
        if (firstVis > 0 && (c.stale ? c.lineStart + 512 : c.countPos + (LONG)c.text.size()) < firstVis) continue;
        RECT r;
        if (!ClaimIconRect(hwnd, c, total, r)) continue;
        if (r.top > rc.bottom || r.bottom < rc.top || r.left >= rc.right) continue;
        int f = 0;
        if (UiGiftMine(c.uuid)) {
            f = CLAIM_FRAMES;
            auto a = g_claimAnim.find(c.uuid);
            if (a != g_claimAnim.end()) f = (int)std::min<ULONGLONG>(CLAIM_FRAMES, (now - a->second) * CLAIM_FRAMES / CLAIM_ANIM_MS);
        }
        if (!g_claimBmp[f]) continue;
        HGDIOBJ o = SelectObject(mem, g_claimBmp[f]);
        if (!old) old = o;
        AlphaBlend(dc, r.left, r.top, g_pinSize, g_pinSize, mem, 0, 0, g_pinSize, g_pinSize, bf);
    }
    if (old) SelectObject(mem, old);
    DeleteDC(mem);
}
// ===== Ende Fix 114 (Status-Symbol) =====

// ===== Statusanzeige im Hauptfenster =====
// Aktualisiert Statuszeile, „Start in“-Countdown und „Refresh in“-Countdown
// true, solange „searching“ angezeigt wird (weiß); „waiting for Last War“ und „no access“ bleiben rot
static bool g_statusSearching = false;
static void UpdateStatusLabel() {
    if (!g_hStatus) return;
    int dots = g_dotCount.load();
    std::wstring dotsStr(3, L'.');
    if (dots == 1) dotsStr = L".  ";
    else if (dots == 2) dotsStr = L".. ";
    else dotsStr = L"...";
    const bool noAccess = g_lastWarRunning.load() && g_lastWarNoAccess.load();

    int cd = 0;
    if (g_lastWarRunning.load() && !noAccess) {
        auto now = std::chrono::steady_clock::now();
        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(now - TicksToTimePoint(g_cooldownStart.load())).count();
        const int startIn = StartInSeconds();
        if (elapsed < startIn && elapsed >= 0) cd = startIn - (int)elapsed;
    }

    // Während der Start-Verzögerung (nach neu erkanntem Last-War-Prozess) weiter „waiting for Last War“,
    // „searching“ erst, wenn der „Start in“-Countdown abgelaufen ist
    std::wstring status;
    g_statusSearching = false;
    if (noAccess)
        status = L"no access - run as admin";
    else if (g_lastWarRunning.load() && cd <= 0) {
        status = L"searching" + dotsStr;
        g_statusSearching = true;
    }
    else
        status = L"waiting for Last War" + dotsStr;

    SetWindowTextW(g_hStatus, status.c_str());

    if (g_hCountdown) {
        if (cd > 0) {
            std::wstring cdText = L"Start in: " + std::to_wstring(cd);
            SetWindowTextW(g_hCountdown, cdText.c_str());
            ShowWindow(g_hCountdown, SW_SHOW);
        }
        else {
            ShowWindow(g_hCountdown, SW_HIDE);
        }
    }
    // Countdown bis zum nächsten Spiel-Neustart (nur mit „auto refresh game“, sonst ausgeblendet)
    if (g_hRefreshCountdown && !AutoRefreshActive()) {
        SetWindowTextW(g_hRefreshCountdown, L"");
        ShowWindow(g_hRefreshCountdown, SW_HIDE);
    }
    else if (g_hRefreshCountdown) {
        auto now = std::chrono::steady_clock::now();
        int total = g_refreshDuration * 60;
        int elapsed = (int)std::chrono::duration_cast<std::chrono::seconds>(now - TicksToTimePoint(g_lastFailsafeReset.load())).count();
        int remaining = total - elapsed;
        if (remaining < 0) remaining = 0;
        int minutes = remaining / 60;
        int seconds = remaining % 60;
        wchar_t rbuf[48];
        swprintf_s(rbuf, L"Refresh in: %02d:%02d", minutes, seconds);
        SetWindowTextW(g_hRefreshCountdown, rbuf);
        ShowWindow(g_hRefreshCountdown, SW_SHOW);
    }
}

// ===== Discord-Gateway =====
// Schützt WinHttpWebSocketSend und g_hWebSocket (Empfangs-Thread und Heartbeat-Thread senden beide)
static std::mutex g_gatewaySendMutex;
// Letzte empfangene Sequenznummer („s“) für den Heartbeat (-1 = noch keine -> null)
static std::atomic<long long> g_gatewaySeq{ -1 };
// Max. Größe einer zusammengesetzten Gateway-Nachricht (größere werden verworfen)
static const size_t GATEWAY_MAX_MESSAGE = 1024 * 1024;

// Sendet eine JSON-Nachricht über den Gateway-WebSocket
static bool SendGatewayPayload(const std::string& json) {
    std::lock_guard<std::mutex> lock(g_gatewaySendMutex);
    if (!g_hWebSocket) return false;
    return WinHttpWebSocketSend(g_hWebSocket, WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE, (PVOID)json.data(), (DWORD)json.size()) == ERROR_SUCCESS;
}
// Heartbeat mit der letzten Sequenznummer (null, solange noch keine empfangen wurde)
static void SendGatewayHeartbeat() {
    long long seq = g_gatewaySeq.load();
    std::string hb = "{\"op\":1,\"d\":" + (seq >= 0 ? std::to_string(seq) : std::string("null")) + "}";
    SendGatewayPayload(hb);
}
// Steuerung des Heartbeat-Threads einer Verbindung
struct GatewayHeartbeatCtl {
    std::mutex m;
    std::condition_variable cv;
    bool stop = false;
};
// Sendet regelmäßig den Heartbeat an das Gateway (erster nach Intervall × Zufallsfaktor, wie von Discord vorgegeben)
static void GatewayHeartbeatThread(GatewayHeartbeatCtl* ctl, int intervalMs) {
    std::mt19937 rng((unsigned)GetTickCount() ^ (unsigned)GetCurrentThreadId());
    int delay = (int)(intervalMs * std::uniform_real_distribution<double>(0.0, 1.0)(rng));
    std::unique_lock<std::mutex> lk(ctl->m);
    while (!ctl->stop && g_gatewayRunning) {
        if (ctl->cv.wait_for(lk, std::chrono::milliseconds(delay), [ctl] { return ctl->stop; })) break;
        lk.unlock();
        SendGatewayHeartbeat();
        lk.lock();
        delay = intervalMs;
    }
}
// Liest den Rohwert eines Felds der obersten JSON-Ebene (z. B. "op", "s", "t"); leer, wenn nicht vorhanden.
// Strings werden ohne Anführungszeichen geliefert, Zahlen/null unverändert.
static std::string GatewayTopLevelValue(const std::string& json, const char* key) {
    const size_t keyLen = strlen(key);
    const size_t n = json.size();
    int depth = 0;
    bool inStr = false;
    size_t strStart = 0;
    for (size_t i = 0; i < n; ++i) {
        char c = json[i];
        if (inStr) {
            if (c == '\\') { ++i; continue; }
            if (c != '"') continue;
            inStr = false;
            if (depth != 1) continue;
            // Ist dieser String ein Schlüssel der obersten Ebene?
            size_t len = i - strStart;
            size_t j = i + 1;
            while (j < n && (json[j] == ' ' || json[j] == '\t' || json[j] == '\r' || json[j] == '\n')) ++j;
            if (j >= n || json[j] != ':') continue;
            if (len != keyLen || json.compare(strStart, len, key) != 0) continue;
            ++j;
            while (j < n && (json[j] == ' ' || json[j] == '\t' || json[j] == '\r' || json[j] == '\n')) ++j;
            if (j < n && json[j] == '"') {
                size_t v = j + 1;
                size_t k = v;
                while (k < n && json[k] != '"') { if (json[k] == '\\') ++k; ++k; }
                if (k > n) k = n;
                return json.substr(v, k - v);
            }
            size_t v = j;
            while (j < n && json[j] != ',' && json[j] != '}' && json[j] != ']' && json[j] != ' ' && json[j] != '\r' && json[j] != '\n' && json[j] != '\t') ++j;
            return json.substr(v, j - v);
        }
        if (c == '"') { inStr = true; strStart = i + 1; }
        else if (c == '{' || c == '[') ++depth;
        else if (c == '}' || c == ']') --depth;
    }
    return std::string();
}
// Schließt alle Handles der Gateway-Verbindung und setzt sie auf nullptr
static void CloseGatewayHandles() {
    HINTERNET ws = nullptr;
    {
        std::lock_guard<std::mutex> lock(g_gatewaySendMutex);
        ws = g_hWebSocket;
        g_hWebSocket = nullptr;
    }
    if (ws) WinHttpCloseHandle(ws);
    if (g_hRequest) { WinHttpCloseHandle(g_hRequest); g_hRequest = nullptr; }
    if (g_hConnect) { WinHttpCloseHandle(g_hConnect); g_hConnect = nullptr; }
    if (g_hSession) { WinHttpCloseHandle(g_hSession); g_hSession = nullptr; }
}
// Eine Gateway-Verbindung: Hello abwarten, Identify senden, Heartbeat starten, empfangen bis zum Ende.
// Rückgabe: true = neu verbinden, false = endgültig aufhören (z. B. Token von Discord abgelehnt)
static bool RunGatewayConnection(const std::string& identify, bool& gotReady) {
    gotReady = false;
    g_gatewaySeq = -1;
    g_hSession = WinHttpOpen(L"DiscordGateway/1.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
    if (!g_hSession) { CloseGatewayHandles(); return true; }
    g_hConnect = WinHttpConnect(g_hSession, L"gateway.discord.gg", INTERNET_DEFAULT_HTTPS_PORT, 0);
    if (!g_hConnect) { CloseGatewayHandles(); return true; }
    g_hRequest = WinHttpOpenRequest(g_hConnect, L"GET", L"/?v=10&encoding=json", nullptr, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE);
    if (!g_hRequest) { CloseGatewayHandles(); return true; }
#pragma warning(push)
#pragma warning(disable: 6387)
    WinHttpSetOption(g_hRequest, WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET, nullptr, 0);
#pragma warning(pop)
    if (!WinHttpSendRequest(g_hRequest, WINHTTP_NO_ADDITIONAL_HEADERS, 0, nullptr, 0, 0, 0) ||
        !WinHttpReceiveResponse(g_hRequest, nullptr)) {
        CloseGatewayHandles();
        return true;
    }
    HINTERNET ws = WinHttpWebSocketCompleteUpgrade(g_hRequest, 0);
    if (!ws) { CloseGatewayHandles(); return true; }
    {
        std::lock_guard<std::mutex> lock(g_gatewaySendMutex);
        g_hWebSocket = ws;
    }
    WinHttpCloseHandle(g_hRequest);
    g_hRequest = nullptr;

    GatewayHeartbeatCtl hbCtl;
    std::thread hbThread;
    bool reconnect = true;
    bool overflow = false;
    std::string msg;
    BYTE buffer[4096];
    // Empfangsschleife: Fragmente zu ganzen Nachrichten zusammensetzen und nach Opcode auswerten
    while (g_gatewayRunning) {
        DWORD bytesRead = 0;
        WINHTTP_WEB_SOCKET_BUFFER_TYPE type = WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE;
        if (WinHttpWebSocketReceive(ws, buffer, sizeof(buffer), &bytesRead, &type) != ERROR_SUCCESS) break;
        if (type == WINHTTP_WEB_SOCKET_CLOSE_BUFFER_TYPE) {
            // Discord hat die Verbindung geschlossen; bei Authentifizierungs-/Intent-Fehlern nicht neu verbinden
            USHORT status = 0;
            BYTE reason[123];
            DWORD reasonLen = 0;
            if (WinHttpWebSocketQueryCloseStatus(ws, &status, reason, sizeof(reason), &reasonLen) == ERROR_SUCCESS) {
                if (status == 4004 || (status >= 4010 && status <= 4014)) reconnect = false;
            }
            break;
        }
        if (!overflow) {
            if (msg.size() + bytesRead > GATEWAY_MAX_MESSAGE) { overflow = true; msg.clear(); }
            else msg.append((const char*)buffer, bytesRead);
        }
        if (type == WINHTTP_WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE || type == WINHTTP_WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE) continue;
        bool endConnection = false;
        if (!overflow) {
            std::string opStr = GatewayTopLevelValue(msg, "op");
            int op = opStr.empty() ? -1 : atoi(opStr.c_str());
            std::string sStr = GatewayTopLevelValue(msg, "s");
            if (!sStr.empty() && sStr[0] >= '0' && sStr[0] <= '9') g_gatewaySeq = _atoi64(sStr.c_str());
            if (op == 10) {
                // Hello: Heartbeat-Intervall übernehmen, Heartbeat-Thread starten und Identify senden
                int interval = g_heartbeatInterval.load();
                size_t p = msg.find("\"heartbeat_interval\":");
                if (p != std::string::npos) {
                    int v = atoi(msg.c_str() + p + 21);
                    if (v > 0) interval = v;
                }
                g_heartbeatInterval = interval;
                if (!hbThread.joinable()) {
                    try { hbThread = std::thread(GatewayHeartbeatThread, &hbCtl, interval); }
                    catch (...) { endConnection = true; }
                }
                if (!endConnection && !SendGatewayPayload(identify)) endConnection = true;
            }
            else if (op == 1) {
                // Discord fordert sofort einen Heartbeat an
                SendGatewayHeartbeat();
            }
            else if (op == 7 || op == 9) {
                // Reconnect angefordert bzw. Session ungültig -> neu verbinden (mit neuem Identify)
                endConnection = true;
            }
            // Nach READY den Status „online“ setzen
            if (msg.find("\"t\":\"READY\"") != std::string::npos) {
                gotReady = true;
                SendGatewayPayload(R"({"op":3,"d":{"status":"online","since":null,"activities":[],"afk":false}})");
            }
        }
        overflow = false;
        msg.clear();
        if (msg.capacity() > 64 * 1024) std::string().swap(msg);
        if (endConnection) break;
    }
    // Heartbeat-Thread beenden, dann alle Handles schließen
    if (hbThread.joinable()) {
        {
            std::lock_guard<std::mutex> lk(hbCtl.m);
            hbCtl.stop = true;
        }
        hbCtl.cv.notify_all();
        hbThread.join();
    }
    CloseGatewayHandles();
    return reconnect;
}
// Verbindet den Bot mit dem Discord-Gateway (hält ihn online); bei Abbruch wird automatisch neu verbunden
// (Wartezeit 5 s, bei wiederholten Fehlern verdoppelt bis max. 60 s)
static void StartDiscordGateway(const std::wstring& token) {
    g_gatewayRunning = true;
    // Token und Channel auf druckbare ASCII-Zeichen reduzieren
    std::wstring wtoken = token;
    std::string stoken;
    for (wchar_t c : wtoken) {
        if (c > 32 && c < 127) stoken += (char)c;
    }
    if (stoken.length() > 80) stoken = stoken.substr(0, 72);
    {
        std::lock_guard<std::mutex> lock(g_discordCfgMutex);
        std::wstring wchannel = g_channelId;
        std::string schannel;
        for (wchar_t c : wchannel) {
            if (c > 32 && c < 127) schannel += (char)c;
        }
        if (schannel.length() > 20) schannel = schannel.substr(0, 19);
        g_channelId = std::wstring(schannel.begin(), schannel.end());
    }
    std::string identify = R"({"op":2,"d":{"token":")" + stoken + R"(","intents":0,"properties":{"os":"windows","browser":"custom","device":"custom"}}})";
    int backoffMs = 5000;
    while (g_gatewayRunning) {
        bool gotReady = false;
        bool reconnect = RunGatewayConnection(identify, gotReady);
        if (!reconnect) break;
        if (gotReady) backoffMs = 5000;
        Sleep(backoffMs);
        if (!gotReady) backoffMs = std::min(backoffMs * 2, 60000);
    }
    g_gatewayRunning = false;
}

// ===== Fix 34: Windows-Hinweis (Tray) mit den Zeilen der Blase: Titel = Zeile 1, Text = Zeile 2 =====
static void ShowFoundToast(int kind, const NotifyLines& t, bool silent = false) {   // Fix 48: silent = Ei umbenannt   // kind: 0 = Dig, 1 = Lucky Gift, 2 = Feuerwerk (Fix 41), 3 = Ei (Fix 44, wie Lucky), 4 = Drohne (Fix 120, wie Dig)
    if (!g_nid.hWnd || !g_nid.hIcon) return;
    NOTIFYICONDATAW nid = {};
    nid.cbSize = sizeof(NOTIFYICONDATAW);
    nid.hWnd = g_nid.hWnd;
    nid.uID = g_nid.uID;
    nid.uFlags = NIF_INFO | NIF_ICON;   // ohne NIF_TIP, sonst wird der Tooltip geleert
    SetTrayBalloonIcon(nid, kind);      // Fix 26/41: Bagger, Kleeblatt bzw. Rakete (sonst NIIF_INFO)
    if (silent) nid.dwInfoFlags |= NIIF_NOSOUND;
    nid.hIcon = g_nid.hIcon;
    wcsncpy_s(nid.szInfoTitle, NotifyFit(NotifyTitle(t), 63).c_str(), _TRUNCATE);
    wcsncpy_s(nid.szInfo, NotifyFit(kind == 2 ? std::wstring(L" ") : NotifyBody(t), 255).c_str(), _TRUNCATE);   // Fix 42: Feuerwerk nur Titel
    nid.uTimeout = 8000;
    Shell_NotifyIconW(NIM_MODIFY, &nid);
}
// Lucky Gift: Blase + Hinweis mit Log-Wort und Absender; Ziel fürs Aufleuchten = diese Zeile (Logging aus -> keins)
static void LuckyNotifyFound(const LuckyInfo& d) {
    const NotifyLines t = LuckyNotifyLines(d.label, d.sender);
    if (d.log) LogGlowTargetLast(); else LogGlowTargetClear();
    ShowFoundBubble(1, t);
    ShowFoundToast(1, t);
}
// ===== Fix 41: Feuerwerk (UI) – wie Lucky Gift, ohne Discord und ohne Cooldown =====
// Fix 48: gemeldet von FireworkOnChatPost (Chat-Post 693 „hat ein Feuerwerk gezündet“, Ereignis-Schlüssel = uuid).
struct FireworkInfo {
    bool log = true;            // Logging an -> Log-Zeile
    std::wstring timeStr;       // „hh:mm:ss“
    std::wstring label;         // Wort der Spielsprache (leer -> FireworkLabelNow im UI-Thread); Fix 42: kein Absender
    std::string uuid;           // Fix 118: für die spätere Abholer-Zahl / das Status-Symbol
    int claims = -1;            // Fix 118: Abholer bisher (-1 = unbekannt); kein Maximum in den Daten
};
// Wort der Spielsprache: Sprach-Probe des Lucky Gift, sonst gespeicherte Lucky-Sprache, sonst Englisch
// (Fix 57: beide Quellen kommen nur noch aus Spieltexten, nie aus Chat-Inhalten)
static std::wstring FireworkLabelNow() {
    const int i = g_luckyProbeLabel.load();
    if (i >= 0 && i < (int)(sizeof(LUCKY_LOG_LABELS) / sizeof(LUCKY_LOG_LABELS[0]))) return FireworkLogText(LUCKY_LOG_LABELS[i].lang);
    const std::string saved = LoadLuckyLangSetting();   // zuletzt erkannte Spielsprache („en“, „de“ …)
    if (!saved.empty()) return FireworkLogText(saved);
    return FIREWORK_LOG_FALLBACK;
}
// Log-Zeile „[hh:mm:ss]: Firework“ mit Rakete davor; nur das Wort blau, nie ein Absender (Fix 42). Nur UI-Thread.
static void WriteFireworkLogLine(const FireworkInfo& d) {
    if (!g_hRichEdit) return;
    TrimLogIfNeeded();
    ApplyPinIndent(false, true);
    AppendColoredText(L"[", LOG_TIME_COLOR);   // Fix 114: Uhrzeit samt Klammern und Doppelpunkt grau
    AppendColoredText(d.timeStr, LOG_TIME_COLOR);
    AppendColoredText(L"]: ", LOG_TIME_COLOR);
    const LONG lineStart = LuckyLogCaret() - 4 - (LONG)d.timeStr.size();   // Zeilenanfang „[“
    LogGlowNoteLine(lineStart, d.timeStr, false, std::string(), true);      // Ziel fürs Aufleuchten
    AppendColoredText(d.label.empty() ? std::wstring(FIREWORK_LOG_FALLBACK) : d.label, FIREWORK_COLOR);
    // Fix 118: Abholer-Zahl „ N“ (grün, ohne Maximum) wie bei Lucky; Stelle gemerkt -> Zahl steigt live, Status-Symbol dahinter
    if (!d.uuid.empty()) {
        LuckyCountLine c;
        c.uuid = d.uuid; c.lineStart = lineStart; c.countPos = LuckyLogCaret(); c.n = d.claims; c.total = 0; c.fw = true;
        c.prev = LuckyLogRange(c.countPos - 1, c.countPos);
        c.text = LuckyCountText(d.claims, 0);
        if (!c.text.empty()) {
            AppendColoredText(L" ", RGB(255, 255, 255));
            AppendColoredText(c.text.substr(1), LuckyCountColor(d.claims, 0));
        }
        LuckyRememberCount(c);
    }
    AppendColoredText(L"\r\n", RGB(255, 255, 255));
    SendMessageW(g_hRichEdit, WM_VSCROLL, SB_BOTTOM, 0);
    if (g_pinIcon || g_luckyIcon || g_fireworkIcon) InvalidateRect(g_hRichEdit, nullptr, FALSE);
}
// Blase + Windows-Hinweis (Rakete, Wort blau, einzeilig, ohne Absender); Klick -> Log öffnen + Zeile aufleuchten (Logging aus -> kein Ziel)
static void FireworkNotifyFound(const FireworkInfo& d) {
    const NotifyLines t = FireworkNotifyLines(d.label);
    if (d.log) LogGlowTargetLast(); else LogGlowTargetClear();
    ShowFoundBubble(2, t);
    ShowFoundToast(2, t);
}
// Zähler „Fireworks: N“ um 1 erhöhen (nur UI-Thread)
static void IncrementFireworkCount() {
    ++g_fireworkCount;
    if (g_hFireworkCount) SetWindowTextW(g_hFireworkCount, (L"Fireworks: " + std::to_wstring(g_fireworkCount)).c_str());
    LayoutCounters();
}
// Feuerwerk melden (aus jedem Thread): Zähler, Log-Zeile, Blase, Windows-Hinweis im UI-Thread. Kein Discord.
static void AddFireworkLog(const std::wstring& timeStr, const std::wstring& label = std::wstring(),
    const std::string& uuid = std::string(), int claims = -1) {   // Fix 42: ohne Absender; Fix 118: uuid + Abholer
    HWND hwnd = g_hWnd;
    if (hwnd && IsWindow(hwnd)) {
        auto info = std::make_unique<FireworkInfo>();
        info->log = g_loggingEnabled.load();
        info->timeStr = timeStr;
        info->label = label;
        info->uuid = uuid;
        info->claims = claims;
        if (PostMessageW(hwnd, WM_FIREWORKFOUND, 0, (LPARAM)info.get()))
            info.release();
    }
}
// ===== Ende Fix 41 (UI) =====
// ===== Fix 44: Ei (UI) – wie Lucky Gift (Wort gelb statt gold), ohne Discord und ohne Cooldown =====
// Gemeldet nur von der Ei-Erkennung (EggOnChatPost; Fix 47: jeder Geschenk-Post mit packetId != 502). Log-Wort = der
// volle Ei-Name aus der Spiel-Lokalisierung (Fix 47, z. B. „Goldenes Ei (Geburtstag)“), sonst das allgemeine Wort „Ei“ der
// Spielsprache. Abhol-Zahl wie Lucky (WM_LUCKYCOUNT, Zeile als Ei markiert).
struct EggInfo {
    bool log = true;            // Logging an -> Log-Zeile
    std::wstring timeStr;       // „hh:mm:ss“
    std::wstring label;         // leer -> EggLabelNow() im UI-Thread
    bool named = false;         // Fix 48: label ist ein voller Ei-Name aus dem Spiel (false = Wort „Ei“, später umbenennbar)
    std::wstring sender;        // Name aus senderInfo (leer = unbekannt)
    std::string uuid;           // für spätere Abhol-Zahl
    int claims = -1;            // Abholer bisher (-1 = unbekannt)
    int total = 0;              // Gesamtzahl aus den Daten (0 = unbekannt -> nur „N“)
};
// Wort der Spielsprache: Sprach-Probe des Lucky Gift, sonst gespeicherte Lucky-Sprache, sonst Englisch
// (Fix 57: beide Quellen kommen nur noch aus Spieltexten, nie aus Chat-Inhalten)
static std::wstring EggLabelNow() {
    const int i = g_luckyProbeLabel.load();
    if (i >= 0 && i < (int)(sizeof(LUCKY_LOG_LABELS) / sizeof(LUCKY_LOG_LABELS[0]))) return EggLogText(LUCKY_LOG_LABELS[i].lang);
    const std::string saved = LoadLuckyLangSetting();
    if (!saved.empty()) return EggLogText(saved);
    return EGG_LOG_FALLBACK;
}
// Log-Zeile „[hh:mm:ss]: Ei: Absender N/total“ mit Ei davor (Wort gelb, „:“ weiß, Name lila, Zahl grün/rot). Nur UI-Thread.
static void WriteEggLogLine(const EggInfo& d) {
    if (!g_hRichEdit) return;
    TrimLogIfNeeded();
    ApplyPinIndent(false, false, true);
    AppendColoredText(L"[", LOG_TIME_COLOR);   // Fix 114: Uhrzeit samt Klammern und Doppelpunkt grau
    AppendColoredText(d.timeStr, LOG_TIME_COLOR);
    AppendColoredText(L"]: ", LOG_TIME_COLOR);
    const LONG lineStart = LuckyLogCaret() - 4 - (LONG)d.timeStr.size();   // Zeilenanfang „[“
    LogGlowNoteLine(lineStart, d.timeStr, false, std::string(), false, true);
    {
        const std::wstring lab = d.label.empty() ? std::wstring(EGG_LOG_FALLBACK) : d.label;
        if (!d.uuid.empty() && !d.named) {   // Fix 48: Ei-Wort statt Namen -> Stelle für späteres Umbenennen merken
            for (auto it = g_eggLabelLines.begin(); it != g_eggLabelLines.end(); ++it) if (it->uuid == d.uuid) { g_eggLabelLines.erase(it); break; }
            if (g_eggLabelLines.size() >= 50) g_eggLabelLines.erase(g_eggLabelLines.begin());
            g_eggLabelLines.push_back({ d.uuid, lineStart, LuckyLogCaret(), lab });
        }
        if (d.named) EggLineNameAdd(lab);   // voller Name -> als Ei-Zeile erkennen
        AppendColoredText(lab, EGG_COLOR);
    }
    if (!d.sender.empty()) {
        AppendColoredText(L": ", RGB(255, 255, 255));
        AppendColoredText(L"\u200E" + d.sender + L"\u200E", LUCKY_SENDER_COLOR);   // wie Lucky: RTL-Name bleibt am Zeilenende
    }
    if (!d.uuid.empty()) {   // Abhol-Zähler „ N/total“ bzw. „ N“ (Zahl unbekannt -> nichts, Stelle trotzdem gemerkt)
        LuckyCountLine c;
        c.uuid = d.uuid; c.lineStart = lineStart; c.countPos = LuckyLogCaret(); c.n = d.claims; c.total = d.claims >= 0 ? d.total : 0;
        c.egg = true;
        c.prev = LuckyLogRange(c.countPos - 1, c.countPos);
        c.text = LuckyCountText(d.claims, d.total);
        if (!c.text.empty()) {
            AppendColoredText(L" ", RGB(255, 255, 255));
            AppendColoredText(c.text.substr(1), LuckyCountColor(d.claims, d.total));
        }
        LuckyRememberCount(c);
    }
    AppendColoredText(L"\r\n", RGB(255, 255, 255));
    SendMessageW(g_hRichEdit, WM_VSCROLL, SB_BOTTOM, 0);
    InvalidateRect(g_hRichEdit, nullptr, FALSE);
}
// Fix 48: zuletzt gezeigtes Ei (Blase/Hinweis) – für ein Umbenennen, solange beides noch sichtbar ist
static std::string g_eggShownUuid;
static NotifyLines g_eggShownLines;
static unsigned long long g_eggShownTick = 0;
// Blase + Windows-Hinweis wie Lucky (Zeile 1 Wort gelb + „:“, Zeile 2 Absender lila); Klick -> Log + Zeile aufleuchten
static void EggNotifyFound(const EggInfo& d) {
    const NotifyLines t = EggNotifyLines(d.label, d.sender);
    if (d.log) LogGlowTargetLast(); else LogGlowTargetClear();
    ShowFoundBubble(3, t);
    ShowFoundToast(3, t);
    g_eggShownUuid = d.uuid; g_eggShownLines = t; g_eggShownTick = GetTickCount64();   // Fix 48
}
// Fix 48: Name kam nach der Meldung -> NUR das Wort „Ei“ der gemerkten Zeile ersetzen (Farbe EGG_COLOR; Uhrzeit, Absender, Zahl,
// Nadel bleiben). Vorher prüfen, dass an der Stelle noch genau diese Ei-Zeile steht (wie LuckyRelabelLines), sonst überspringen.
// Ist die Blase dieses Eis noch offen, Zeile 1 tauschen (Breite neu); ist sein Windows-Hinweis noch sichtbar (< 8 s), ohne Ton neu.
static bool EggRelabelLine(const std::string& uuid, const std::wstring& newLabel) {
    if (uuid.empty() || newLabel.empty()) return false;
    EggLineNameAdd(newLabel);
    bool done = false;
    auto it = std::find_if(g_eggLabelLines.begin(), g_eggLabelLines.end(), [&](const EggLabelLine& e) { return e.uuid == uuid; });
    if (it != g_eggLabelLines.end()) {
        const EggLabelLine p = *it;
        g_eggLabelLines.erase(it);
        GETTEXTLENGTHEX gtl = { GTL_NUMCHARS | GTL_PRECISE, 1200 };
        const LONG total = g_hRichEdit ? (LONG)SendMessageW(g_hRichEdit, EM_GETTEXTLENGTHEX, (WPARAM)&gtl, 0) : 0;
        const LONG len = (LONG)p.label.size();
        bool ok = g_hRichEdit && p.label != newLabel && p.lineStart >= 0 && p.labelStart >= p.lineStart + 4 && p.labelStart + len <= total &&
            (p.lineStart == 0 || LuckyLogRange(p.lineStart - 1, p.lineStart) == L"\r") &&
            LuckyLogRange(p.lineStart, p.lineStart + 1) == L"[" &&
            LuckyLogRange(p.labelStart - 3, p.labelStart + len) == L"]: " + p.label;
        if (ok) {
            const std::wstring after = LuckyLogRange(p.labelStart + len, std::min<LONG>(total, p.labelStart + len + 1));
            ok = (after.empty() || after == L":" || after == L"\r" || after == L" ") && IsEggLogLine(g_hRichEdit, p.lineStart, total);
        }
        if (ok) {
            CHARRANGE oldSel = { 0, 0 };
            SendMessageW(g_hRichEdit, EM_EXGETSEL, 0, (LPARAM)&oldSel);
            POINT scroll = { 0, 0 };
            SendMessageW(g_hRichEdit, EM_GETSCROLLPOS, 0, (LPARAM)&scroll);
            CHARRANGE r = { p.labelStart, p.labelStart + len };
            SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&r);
            SendMessageW(g_hRichEdit, EM_REPLACESEL, FALSE, (LPARAM)newLabel.c_str());
            LuckySetRangeColor(p.labelStart, p.labelStart + (LONG)newLabel.size(), EGG_COLOR);
            const LONG delta = (LONG)newLabel.size() - len;
            if (oldSel.cpMin >= p.labelStart + len) oldSel.cpMin += delta;
            if (oldSel.cpMax >= p.labelStart + len) oldSel.cpMax += delta;
            LuckyLogShift(p.labelStart + len, delta);   // Zahl-Stellen, Aufleuchten dahinter nachführen
            for (auto& c : g_luckyCountLines)           // ohne Absender folgt die Zahl direkt dem Wort
                if (c.countPos == p.labelStart + (LONG)newLabel.size()) c.prev = newLabel.substr(newLabel.size() - 1);
            SendMessageW(g_hRichEdit, EM_EXSETSEL, 0, (LPARAM)&oldSel);
            SendMessageW(g_hRichEdit, EM_SETSCROLLPOS, 0, (LPARAM)&scroll);
            InvalidateRect(g_hRichEdit, nullptr, FALSE);
            done = true;
        }
    }
    if (g_eggShownUuid == uuid) {
        NotifyLines t = g_eggShownLines;
        t.line1 = NotifyStripBidi(newLabel);
        if (g_hBubble && IsWindow(g_hBubble) && g_isDigFoundBubble && g_bubbleKind == 3 && !g_bubbleClosing &&
            g_bubbleText.line1 == g_eggShownLines.line1 && g_bubbleText.line2 == g_eggShownLines.line2) {
            g_bubbleText.line1 = t.line1;
            const int w = BubbleLayoutWidth();
            if (w != g_bubbleW) {
                g_bubbleW = w;
                if (g_bubbleSlideOffset > w) g_bubbleSlideOffset = w;
                SetWindowPos(g_hBubble, nullptr, 0, 0, g_bubbleW, BUBBLE_H, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
                PositionBubbleToLastWar();
            }
            BubbleRepaint(g_hBubble);
            done = true;
        }
        if (GetTickCount64() - g_eggShownTick < 8000) ShowFoundToast(3, t, true);   // Hinweis noch sichtbar -> ohne Ton ersetzen
        g_eggShownLines = t;
    }
    return done;
}
// Zähler „Eggs: N“ um 1 erhöhen (nur UI-Thread)
static void IncrementEggCount() {
    ++g_eggCount;
    if (g_hEggCount) SetWindowTextW(g_hEggCount, (L"Eggs: " + std::to_wstring(g_eggCount)).c_str());
    LayoutCounters();
}
// Ei melden (aus jedem Thread): Zähler, Log-Zeile, Blase, Windows-Hinweis im UI-Thread. Kein Discord.
static void AddEggLog(const std::wstring& timeStr, const std::wstring& sender, const std::string& uuid, int claims, int total, const std::wstring& label) {
    HWND hwnd = g_hWnd;
    if (hwnd && IsWindow(hwnd)) {
        auto info = std::make_unique<EggInfo>();
        info->log = g_loggingEnabled.load();
        info->timeStr = timeStr;
        info->sender = sender;
        info->uuid = uuid;
        info->claims = claims;
        info->total = total;
        info->label = label;   // Fix 47: voller Ei-Name (leer -> EggLabelNow)
        if (PostMessageW(hwnd, WM_EGGFOUND, 0, (LPARAM)info.get()))
            info.release();
    }
}
// Fix 48: Name eines schon gemeldeten Eis gefunden (aus dem Worker) -> Zeile/Blase im UI-Thread umbenennen
struct EggRelabelUpd { std::string uuid; std::wstring label; };
static void PostEggRelabel(const std::string& uuid, const std::wstring& label) {
    HWND hwnd = g_hWnd;
    if (!hwnd || !IsWindow(hwnd) || uuid.empty() || label.empty()) return;
    auto u = std::make_unique<EggRelabelUpd>();
    u->uuid = uuid; u->label = label;
    if (PostMessageW(hwnd, WM_EGGRELABEL, 0, (LPARAM)u.get())) u.release();
}
// ===== Ende Fix 44 (Ei-UI) =====

// ===== Hauptfenster (WndProc) =====
// Fix 33: Das Hauptfenster wird nur beim Programmstart zentriert (CreateWindowW in wWinMain); beim erneuten Anzeigen
// (Tray-Klick, Tray-Menü „Show“, Blase, Windows-Hinweis) bleibt es, wo es zuletzt war (Verstecken/Wiederherstellen ändert
// Position und Größe nicht). Nur wenn es ganz außerhalb aller Bildschirme liegt (z. B. Monitor abgesteckt), wird es auf den
// nächstgelegenen Bildschirm geschoben (Arbeitsbereich, Größe bleibt). Aufruf nach dem Anzeigen (nicht minimiert).
static void KeepMainWindowOnScreen(HWND hwnd) {
    if (!hwnd || IsIconic(hwnd)) return;
    RECT rc;
    if (!GetWindowRect(hwnd, &rc)) return;
    if (MonitorFromRect(&rc, MONITOR_DEFAULTTONULL)) return;   // (teilweise) sichtbar -> nicht verschieben
    HMONITOR mon = MonitorFromRect(&rc, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi = {};
    mi.cbSize = sizeof(mi);
    if (!mon || !GetMonitorInfoW(mon, &mi)) return;
    const RECT& wa = mi.rcWork;
    const int w = rc.right - rc.left, h = rc.bottom - rc.top;
    int x = rc.left, y = rc.top;
    if (x + w > wa.right) x = wa.right - w;
    if (x < wa.left) x = wa.left;
    if (y + h > wa.bottom) y = wa.bottom - h;
    if (y < wa.top) y = wa.top;
    SetWindowPos(hwnd, nullptr, x, y, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
}
// Fensterprozedur des Hauptfensters: Status, Log, Tray-Icon, Fund-Benachrichtigungen
// Fix 30: Hauptfenster (Log) sicher nach vorne holen – auch aus dem Tray (versteckt) oder minimiert.
// Windows erlaubt SetForegroundWindow nur eingeschränkt; schlägt es fehl, kurz an den Eingabe-Thread des
// aktuellen Vordergrundfensters anhängen (AttachThreadInput) und erneut versuchen; zuletzt Taskleiste blinken lassen.
static void BringMainWindowToFront(HWND hwnd) {
    if (!hwnd || !IsWindow(hwnd)) return;
    if (!IsWindowVisible(hwnd)) ShowWindow(hwnd, SW_SHOW);
    if (IsIconic(hwnd)) ShowWindow(hwnd, SW_RESTORE);
    g_windowVisible = true;
    if (GetForegroundWindow() == hwnd) return;
    SetForegroundWindow(hwnd);
    if (GetForegroundWindow() == hwnd) return;
    HWND fg = GetForegroundWindow();
    const DWORD me = GetCurrentThreadId();
    const DWORD other = fg ? GetWindowThreadProcessId(fg, nullptr) : 0;
    const bool attached = other && other != me && AttachThreadInput(me, other, TRUE);
    BringWindowToTop(hwnd);
    SetForegroundWindow(hwnd);
    SetActiveWindow(hwnd);
    SetFocus(hwnd);
    if (attached) AttachThreadInput(me, other, FALSE);
    if (GetForegroundWindow() != hwnd) {
        FLASHWINFO fi = { sizeof(fi), hwnd, FLASHW_ALL | FLASHW_TIMERNOFG, 0, 0 };
        FlashWindowEx(&fi);
    }
}
LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    // Explorer wurde neu gestartet: Tray-Icon wieder anlegen
    if (g_msgTaskbarCreated != 0 && msg == g_msgTaskbarCreated) {
        if (g_nid.hWnd) Shell_NotifyIconW(NIM_ADD, &g_nid);
        return 0;
    }
    switch (msg) {
    case WM_CREATE:
        // Schriften, Statuszeile, Countdowns und Log anlegen
        LoadLibraryW(L"riched20.dll");
        g_hStatusFont = CreateFontW(20, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Inter");
        g_hStatus = CreateWindowW(L"STATIC", L"waiting for Last War.",
            WS_CHILD | WS_VISIBLE | SS_LEFT,
            10, 10, 280, 26, hwnd, nullptr, nullptr, nullptr);
        SendMessageW(g_hStatus, WM_SETFONT, (WPARAM)g_hStatusFont, TRUE);
        g_hCountdown = CreateWindowW(L"STATIC", L"",
            WS_CHILD | SS_CENTER | SS_NOPREFIX,
            220, 10, 160, 26, hwnd, nullptr, nullptr, nullptr);
        SendMessageW(g_hCountdown, WM_SETFONT, (WPARAM)g_hStatusFont, TRUE);
        g_hRefreshCountdown = CreateWindowW(L"STATIC", L"",
            WS_CHILD | SS_LEFT,
            430, 10, 150, 26, hwnd, nullptr, nullptr, nullptr);
        SendMessageW(g_hRefreshCountdown, WM_SETFONT, (WPARAM)g_hStatusFont, TRUE);
        // Dig-Zähler: kleine, nicht fette Zeile rechtsbündig unter „Refresh in“ (überlappt keine andere Anzeige)
        g_hDigCountFont = CreateFontW(15, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Inter");
        g_hDigCount = CreateWindowW(L"STATIC", L"Digs: 0",
            WS_CHILD | WS_VISIBLE | SS_OWNERDRAW | SS_NOPREFIX,
            10, MAIN_COUNT_Y, 160, MAIN_COUNT_H, hwnd, nullptr, nullptr, nullptr);
        if (g_hDigCountFont) SendMessageW(g_hDigCount, WM_SETFONT, (WPARAM)g_hDigCountFont, TRUE);
        // Fix 120: Drohnen-Zähler: gleiche Schrift, direkt rechts neben „Digs: N“ (Position setzt LayoutCounters)
        g_hDroneCount = CreateWindowW(L"STATIC", L"Test Flight Failure: 0",
            WS_CHILD | WS_VISIBLE | SS_OWNERDRAW | SS_NOPREFIX,
            10 + 160 + MAIN_COUNT_GAP, MAIN_COUNT_Y, 160, MAIN_COUNT_H, hwnd, nullptr, nullptr, nullptr);
        if (g_hDigCountFont) SendMessageW(g_hDroneCount, WM_SETFONT, (WPARAM)g_hDigCountFont, TRUE);
        // Lucky-Gift-Zähler: gleiche Schrift, rechts neben „Digs: N“ (Position setzt LayoutCounters)
        g_hLuckyCount = CreateWindowW(L"STATIC", L"Lucky Gifts: 0",
            WS_CHILD | WS_VISIBLE | SS_OWNERDRAW | SS_NOPREFIX,
            10 + 160 + MAIN_COUNT_GAP, MAIN_COUNT_Y, 160, MAIN_COUNT_H, hwnd, nullptr, nullptr, nullptr);
        if (g_hDigCountFont) SendMessageW(g_hLuckyCount, WM_SETFONT, (WPARAM)g_hDigCountFont, TRUE);
        // Fix 41: Feuerwerk-Zähler: gleiche Schrift, rechts neben „Lucky Gifts: N“ (Position setzt LayoutCounters)
        g_hFireworkCount = CreateWindowW(L"STATIC", L"Fireworks: 0",
            WS_CHILD | WS_VISIBLE | SS_OWNERDRAW | SS_NOPREFIX,
            10 + 2 * (160 + MAIN_COUNT_GAP), MAIN_COUNT_Y, 160, MAIN_COUNT_H, hwnd, nullptr, nullptr, nullptr);
        if (g_hDigCountFont) SendMessageW(g_hFireworkCount, WM_SETFONT, (WPARAM)g_hDigCountFont, TRUE);
        // Fix 44: Ei-Zähler: gleiche Schrift, rechts neben „Fireworks: N“ (Position setzt LayoutCounters)
        g_hEggCount = CreateWindowW(L"STATIC", L"Eggs: 0",
            WS_CHILD | WS_VISIBLE | SS_OWNERDRAW | SS_NOPREFIX,
            10 + 3 * (160 + MAIN_COUNT_GAP), MAIN_COUNT_Y, 160, MAIN_COUNT_H, hwnd, nullptr, nullptr, nullptr);
        if (g_hDigCountFont) SendMessageW(g_hEggCount, WM_SETFONT, (WPARAM)g_hDigCountFont, TRUE);
        if (!g_hCountIconDig) g_hCountIconDig = LoadIconSharp(DigIconId(), MAIN_COUNT_ICON);                  // Fix 36: 14 px aus dem 256er-Bild
        if (!g_hCountIconLucky) g_hCountIconLucky = LoadIconSharp(IDI_LUCKY_GIFT, MAIN_COUNT_ICON);
        if (!g_hCountIconFirework) g_hCountIconFirework = LoadIconSharp(IDI_FIREWORK, MAIN_COUNT_ICON);   // Fix 41
        if (!g_hCountIconEgg) g_hCountIconEgg = LoadIconSharp(IDI_GOLDEN_EGG, MAIN_COUNT_ICON);   // Fix 44
        if (!g_hCountIconDrone) g_hCountIconDrone = LoadIconSharp(IDI_TEST_DRONE, MAIN_COUNT_ICON);   // Fix 120
        if (!g_hCountIconDrone) g_hCountIconDrone = LoadIconSharp(DigIconId(), MAIN_COUNT_ICON);   // Fix 120: ohne 904 -> Bagger
        LayoutCounters();
        g_hRichEdit = CreateWindowExW(0, RICHEDIT_CLASSW, nullptr,
            WS_CHILD | WS_VISIBLE | WS_VSCROLL | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL,
            10, MAIN_LOG_Y, 560, 288, hwnd, nullptr, nullptr, nullptr);
        SendMessageW(g_hRichEdit, EM_SETBKGNDCOLOR, 0, RGB(0, 0, 0));
        SetWindowTheme(g_hRichEdit, L"DarkMode_Explorer", nullptr);
        SetWindowSubclass(g_hRichEdit, LogPinSubclass, 30, 0);
        if (g_hFont) SendMessageW(g_hRichEdit, WM_SETFONT, (WPARAM)g_hFont, TRUE);
        // Log-Limit anheben (Standard sind ca. 32.000 Zeichen); ältere Zeilen werden bei Bedarf gekürzt
        SendMessageW(g_hRichEdit, EM_EXLIMITTEXT, 0, (LPARAM)LOG_MAX_CHARS);
        SetTimer(hwnd, 1, 16, nullptr);
        return 0;
    case WM_TIMER:
        if (wParam == 1) {
            // Timer 1 (16 ms): Status-Punkte ca. alle 400 ms weiterschalten
            LuckyFlushHeld(false);   // Fix 27: zurückgehaltene Lucky-Zeilen (Probe fertig / Wartezeit um)
            static int dotTick = 0;
            if (++dotTick >= 25) {
                dotTick = 0;
                int d = g_dotCount.load();
                d = (d % 3) + 1;
                g_dotCount = d;
                UpdateStatusLabel();
            }

            // Such-Blase nur zeigen, wenn Last War läuft und im Vordergrund ist
            bool lastWarFg = IsLastWarForeground();
            bool digBubbleActive = (g_hBubble && IsWindow(g_hBubble) && g_isDigFoundBubble);
            if (lastWarFg && !digBubbleActive && g_lastWarRunning.load() && !g_lastWarNoAccess.load()) {
                if (!g_hBubble || !IsWindow(g_hBubble)) {
                    ShowSpeechBubble();
                }
                else {
                    // Such-Blase fährt gerade hinaus, Last War ist wieder vorne: wieder hereinfahren
                    if (!g_isDigFoundBubble && g_bubbleClosing) BubbleStartSlide(g_hBubble, true);
                    PositionBubbleToLastWar();
                }
            }
            else if (!digBubbleActive && g_hBubble && IsWindow(g_hBubble) && !g_isDigFoundBubble) {
                // Such-Blase nach rechts hinausfahren (schließt sich am Ende selbst)
                if (!g_bubbleClosing) BubbleStartSlide(g_hBubble, false);
            }
        }
        return 0;
    case WM_DIGFOUND: {
        // Fund im UI-Thread: Log-Zeile, dann Blase und Tray-Hinweis – ohne Cooldown (der gilt nur für Discord-Pings im WorkerThread)
        std::unique_ptr<DigInfo> dig((DigInfo*)lParam);
        if (dig) {
            // Jeder gemeldete Dig zählt (auch bei ausgeschaltetem Logging); erster Dig blendet den Leer-Hinweis aus
            // Fix 120: Testflugdrohne zählt getrennt („Test Flight Failure: N“), Discord-Ping bleibt wie bisher
            if (dig->drone) {
                ++g_droneCount;
                if (g_hDroneCount) SetWindowTextW(g_hDroneCount, (L"Test Flight Failure: " + std::to_wstring(g_droneCount)).c_str());
            }
            else {
                ++g_digCount;
                if (g_hDigCount) SetWindowTextW(g_hDigCount, (L"Digs: " + std::to_wstring(g_digCount)).c_str());
            }
            LayoutCounters();
            if (g_digCount + g_droneCount == 1 && g_hRichEdit) InvalidateRect(g_hRichEdit, nullptr, FALSE);  // RichEdit malt seinen Hintergrund selbst
        }
        if (dig && dig->log) WriteDigLogLine(*dig);
        if (dig) { if (dig->log) LogGlowTargetLast(); else LogGlowTargetClear(); }   // Fix 31: Ziel = diese Zeile (Logging aus -> keins)
        {   // Fix 34: Blase + Windows-Hinweis mit Dig-Text und Warzone-Teil wie in der Log-Zeile
            NotifyLines t;
            if (dig) t = DigNotifyLines(dig->digText, dig->zoneText, dig->hasZoneText, dig->server, dig->x, dig->y, dig->drone);
            else t.line1 = L"DIG FOUND !";
            const int kind = (dig && dig->drone) ? 4 : 0;   // Fix 120: Drohne eigene Blase/Hinweis (Icon 904, Wort lila)
            ShowFoundBubble(kind, t);
            if (dig) ShowFoundToast(kind, t);
        }
        return 0;
    }
    case WM_LUCKYFOUND: {
        // Lucky Gift im UI-Thread: Log-Zeile (nur wenn Logging an ist, wie bei Digs), Blase und Windows-Hinweis.
        // Kein Discord, Dig-Zähler bleibt unberührt; ohne Cooldown. Fix 34: wartet die Zeile auf die Sprach-Probe,
        // kommen Blase/Hinweis erst mit ihr (LuckyFlushHeld), damit sie dasselbe Wort zeigen.
        std::unique_ptr<LuckyInfo> lucky((LuckyInfo*)lParam);
        bool luckyHeld = false;
        bool luckyWantLog = lucky && lucky->log;
        if (lucky && LuckyHoldLine(*lucky)) { lucky->log = false; luckyHeld = true; }   // Fix 27: Log-Zeile wartet kurz auf die Sprach-Probe
        if (lucky) {
            // Jedes gemeldete Lucky Gift (neue uuid) zählt, auch bei ausgeschaltetem Logging (wie „Digs:“)
            ++g_luckyCount;
            UiGiftCounted(lucky->uuid, false);   // Fix 114
            if (g_hLuckyCount) SetWindowTextW(g_hLuckyCount, (L"Lucky Gifts: " + std::to_wstring(g_luckyCount)).c_str());
            LayoutCounters();
        }
        if (lucky && lucky->log) WriteLuckyLogLine(*lucky);
        if (lucky) {   // Fix 31: Ziel = diese Zeile (zurückgehalten -> beim Schreiben; Logging aus -> keins)
            if (luckyHeld) { if (luckyWantLog) LogGlowTargetPending(lucky->uuid); }   // Fix 34: ohne Logging bleibt das Ziel
            else if (lucky->log) LogGlowTargetLast();
            else LogGlowTargetClear();
        }
        if (lucky && g_hRichEdit) InvalidateRect(g_hRichEdit, nullptr, FALSE);
        if (lucky && !luckyHeld) LuckyNotifyFound(*lucky);   // Fix 34: Blase + Windows-Hinweis (zurückgehalten -> beim Schreiben)
        return 0;
    }
    case WM_FIREWORKFOUND: {
        // Fix 41: Feuerwerk im UI-Thread – wie Lucky Gift: Zähler (auch ohne Logging), Log-Zeile (nur mit Logging),
        // Blase + Windows-Hinweis; Klick -> Log + Aufleuchten. Kein Discord, kein Cooldown.
        std::unique_ptr<FireworkInfo> fw((FireworkInfo*)lParam);
        if (fw) {
            if (fw->label.empty()) fw->label = FireworkLabelNow();
            UiFireworkCounted(fw->uuid);   // Fix 118: abgeholt/gemeldet wie Lucky/Ei
            IncrementFireworkCount();
            if (fw->log) WriteFireworkLogLine(*fw);
            if (g_hRichEdit) InvalidateRect(g_hRichEdit, nullptr, FALSE);
            FireworkNotifyFound(*fw);
        }
        return 0;
    }
    case WM_EGGFOUND: {
        // Fix 44: Ei im UI-Thread – wie Lucky Gift: Zähler (auch ohne Logging), Log-Zeile (nur mit Logging),
        // Blase + Windows-Hinweis; Klick -> Log + Aufleuchten. Kein Discord, kein Cooldown. Abhol-Zahl: WM_LUCKYCOUNT.
        std::unique_ptr<EggInfo> egg((EggInfo*)lParam);
        if (egg) {
            egg->named = !egg->label.empty();   // Fix 48: true = voller Ei-Name aus dem Spiel
            if (egg->label.empty()) egg->label = EggLabelNow();
            UiGiftCounted(egg->uuid, true);   // Fix 114
            IncrementEggCount();
            if (egg->log) WriteEggLogLine(*egg);
            if (g_hRichEdit) InvalidateRect(g_hRichEdit, nullptr, FALSE);
            EggNotifyFound(*egg);
        }
        return 0;
    }
    case WM_EGGRELABEL: {
        // Fix 48: voller Ei-Name kam nach der Meldung -> Wort „Ei“ in Zeile/Blase ersetzen (kein Zähler, keine neue Meldung)
        std::unique_ptr<EggRelabelUpd> u((EggRelabelUpd*)lParam);
        if (u) EggRelabelLine(u->uuid, u->label);
        return 0;
    }
    case WM_LUCKYRELABEL: {
        // Fix 25: Spielsprache jetzt bekannt -> gemerkte Lucky-Zeilen umbenennen (schon gezeigte Blase/Tray bleiben unverändert)
        std::unique_ptr<std::wstring> label((std::wstring*)lParam);
        if (label) { LuckyFlushHeld(true, label.get()); LuckyRelabelLines(*label, wParam == 1); }   // Fix 27: wartende Zeilen zuerst; Fix 66: wParam 1 = alle
        return 0;
    }
    case WM_LUCKYMINE: {
        // Fix 114: eigene uid in der Abholer-Liste -> Haken hinter der Zeile, Zähler „abgeholt/gemeldet“
        std::unique_ptr<std::string> u((std::string*)lParam);
        if (u) UiGiftMineSet(*u, wParam == 0);
        return 0;
    }
    case WM_LUCKYCOUNT: {
        // Fix 29: Abhol-Zahl gestiegen -> NUR die Zahl in der Lucky-Zeile ersetzen (keine neue Zeile, Blase, Tray, Zähler, Discord)
        std::unique_ptr<LuckyCountUpd> u((LuckyCountUpd*)lParam);
        if (u) LuckyApplyCount(*u);
        return 0;
    }
    case WM_CTLCOLORSTATIC: {
        // Farben: Status weiß (läuft) / rot (wartet), „Start in“ grün, „Refresh in“ weiß (Fix 44, früher orange)
        HDC hdc = (HDC)wParam;
        HWND hCtrl = (HWND)lParam;
        if (hCtrl == g_hStatus) {
            SetBkMode(hdc, TRANSPARENT);
            if (g_statusSearching)
                SetTextColor(hdc, RGB(255, 255, 255));
            else
                SetTextColor(hdc, RGB(255, 80, 80));
            return (LRESULT)GetStockObject(BLACK_BRUSH);
        }
        if (hCtrl == g_hCountdown) {
            SetBkMode(hdc, TRANSPARENT);
            SetTextColor(hdc, RGB(100, 220, 100));
            return (LRESULT)GetStockObject(BLACK_BRUSH);
        }
        if (hCtrl == g_hRefreshCountdown) {
            SetBkMode(hdc, TRANSPARENT);
            SetTextColor(hdc, RGB(255, 255, 255));   // Fix 44: weiß (früher orange RGB(255, 140, 0))
            return (LRESULT)GetStockObject(BLACK_BRUSH);
        }
        if (hCtrl == g_hDigCount) {
            SetBkMode(hdc, TRANSPARENT);
            SetTextColor(hdc, RGB(150, 150, 150));
            return (LRESULT)GetStockObject(BLACK_BRUSH);
        }
        return DefWindowProcW(hwnd, msg, wParam, lParam);
    }
    case WM_SIZE:
        if (g_hStatus) {
            RECT rc; GetClientRect(hwnd, &rc);
            MoveWindow(g_hStatus, 10, 10, rc.right - 20, 26, TRUE);
        }
        if (g_hCountdown) {
            // „Start in“ immer genau mittig im Fenster (Text zentriert, unabhängig von der Ziffernzahl)
            RECT rc; GetClientRect(hwnd, &rc);
            MoveWindow(g_hCountdown, rc.right / 2 - 80, 10, 160, 26, TRUE);
        }
        if (g_hRefreshCountdown) {   // Fix 120: „Refresh in“ rechtsbündig verankert (bei 600 px Fensterbreite wie bisher x = 430)
            RECT rc; GetClientRect(hwnd, &rc);
            MoveWindow(g_hRefreshCountdown, std::max(10, (int)rc.right - 154), 10, 150, 26, TRUE);
        }
        if (g_hDigCount) LayoutCounters();
        if (g_hRichEdit) {
            RECT rc; GetClientRect(hwnd, &rc);
            MoveWindow(g_hRichEdit, 10, MAIN_LOG_Y, rc.right - 20, rc.bottom - (MAIN_LOG_Y + 10), TRUE);
        }
        {
            // Trennlinien laufen über die volle Breite: ihre Streifen neu malen, damit kein altes Ende stehen bleibt
            RECT rc; GetClientRect(hwnd, &rc);
            RECT strip = { 0, MAIN_SEP_Y, rc.right, MAIN_SEP_Y + 1 };
            InvalidateRect(hwnd, &strip, TRUE);
            RECT stripTop = { 0, MAIN_TOPSEP_Y, rc.right, MAIN_TOPSEP_Y + 1 };
            InvalidateRect(hwnd, &stripTop, TRUE);
        }
        return 0;
    case WM_PAINT: {
        // Feine graue Trennlinien (1 px): unter der Statuszeile und zwischen Zähler und Log
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hwnd, &ps);
        RECT rc; GetClientRect(hwnd, &rc);
        RECT line = { 10, MAIN_SEP_Y, rc.right - 10, MAIN_SEP_Y + 1 };
        RECT lineTop = { 10, MAIN_TOPSEP_Y, rc.right - 10, MAIN_TOPSEP_Y + 1 };
        HBRUSH br = CreateSolidBrush(RGB(60, 60, 60));
        if (br) {
            FillRect(hdc, &lineTop, br);
            FillRect(hdc, &line, br);
            DeleteObject(br);
        }
        EndPaint(hwnd, &ps);
        return 0;
    }
    case WM_SYSCOMMAND:
        // Minimieren versteckt das Fenster (nur noch im Tray), Maximieren ist gesperrt
        if (wParam == SC_MINIMIZE) {
            ShowWindow(hwnd, SW_HIDE);
            g_windowVisible = false;
            return 0;
        }
        if (wParam == SC_MAXIMIZE) return 0;
        break;
    case WM_MEASUREITEM: {
        // Tray-Menü (owner-drawn): Größe der Einträge
        MEASUREITEMSTRUCT* mis = (MEASUREITEMSTRUCT*)lParam;
        if (mis->CtlType == ODT_MENU) {
            HDC hdc = GetDC(hwnd);
            HFONT hFont = CreateFontW(-15, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
                DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
            HFONT oldFont = (HFONT)SelectObject(hdc, hFont);
            SIZE size = {};
            if (mis->itemID == 100) {
                GetTextExtentPoint32W(hdc, APP_TITLE.c_str(), (int)APP_TITLE.length(), &size);
                mis->itemWidth = size.cx + 48;
                mis->itemHeight = 36;
            }
            else if (mis->itemID == 101) {
                mis->itemWidth = 160;
                mis->itemHeight = 9;
            }
            else if (mis->itemID == 1) {
                const wchar_t* txt = g_windowVisible ? L"Hide" : L"Show";
                GetTextExtentPoint32W(hdc, txt, (int)wcslen(txt), &size);
                mis->itemWidth = size.cx + 32;
                mis->itemHeight = 30;
            }
            else if (mis->itemID == 2) {
                GetTextExtentPoint32W(hdc, L"Close", 5, &size);
                mis->itemWidth = size.cx + 32;
                mis->itemHeight = 30;
            }
            SelectObject(hdc, oldFont);
            DeleteObject(hFont);
            ReleaseDC(hwnd, hdc);
        }
        return TRUE;
    }
    case WM_DRAWITEM: {
        // Tray-Menü zeichnen: Titel mit Icon, Trennlinie, Show/Hide, Close
        DRAWITEMSTRUCT* dis = (DRAWITEMSTRUCT*)lParam;
        // Zählerzeile: Wort grau, Dig-Zahl im Dig-Log-Grün, Lucky-Zahl im Lucky-Orange, Feuerwerk blau, Ei gelb (Fix 44)
        if (dis->CtlType == ODT_STATIC && dis->hwndItem == g_hDigCount) { DrawCounter(dis, L"Digs: ", g_digCount, RGB(0, 255, 0), g_hCountIconDig); return TRUE; }
        if (dis->CtlType == ODT_STATIC && dis->hwndItem == g_hDroneCount) { DrawCounter(dis, L"Test Flight Failure: ", g_droneCount, DRONE_COLOR, g_hCountIconDrone); return TRUE; }   // Fix 120: Zahl lila
        if (dis->CtlType == ODT_STATIC && dis->hwndItem == g_hLuckyCount) { DrawCounter(dis, L"Lucky Gifts: ", g_luckyCount, LUCKY_GIFT_COLOR, g_hCountIconLucky, g_luckyClaimed); return TRUE; }
        if (dis->CtlType == ODT_STATIC && dis->hwndItem == g_hFireworkCount) { DrawCounter(dis, L"Fireworks: ", g_fireworkCount, FIREWORK_COLOR, g_hCountIconFirework, g_fireworkClaimed); return TRUE; }   // Fix 41: Zahl blau
        if (dis->CtlType == ODT_STATIC && dis->hwndItem == g_hEggCount) { DrawCounter(dis, L"Eggs: ", g_eggCount, EGG_COLOR, g_hCountIconEgg, g_eggClaimed); return TRUE; }   // Fix 44: Zahl gelb
        if (dis->CtlType == ODT_MENU) {
            bool selected = (dis->itemState & ODS_SELECTED) && !(dis->itemState & ODS_DISABLED);
            COLORREF bg = selected ? RGB(32, 32, 32) : RGB(0, 0, 0);
            HBRUSH brush = CreateSolidBrush(bg);
            FillRect(dis->hDC, &dis->rcItem, brush);
            DeleteObject(brush);
            SetBkMode(dis->hDC, TRANSPARENT);
            SetTextColor(dis->hDC, RGB(255, 255, 255));
            HFONT hFont = CreateFontW(-15, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
                DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Segoe UI");
            HFONT oldFont = (HFONT)SelectObject(dis->hDC, hFont);
            if (dis->itemID == 100) {
                if (g_nid.hIcon) {
                    DrawIconEx(dis->hDC, dis->rcItem.left + 10, dis->rcItem.top + 10,
                        g_nid.hIcon, 16, 16, 0, nullptr, DI_NORMAL);
                }
                RECT rc = dis->rcItem;
                rc.left += 36;
                DrawTextW(dis->hDC, APP_TITLE.c_str(), -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
            }
            else if (dis->itemID == 101) {
                HPEN pen = CreatePen(PS_SOLID, 1, RGB(48, 48, 48));
                HPEN oldPen = (HPEN)SelectObject(dis->hDC, pen);
                int y = (dis->rcItem.top + dis->rcItem.bottom) / 2;
                MoveToEx(dis->hDC, dis->rcItem.left + 8, y, nullptr);
                LineTo(dis->hDC, dis->rcItem.right - 8, y);
                SelectObject(dis->hDC, oldPen);
                DeleteObject(pen);
            }
            else if (dis->itemID == 1) {
                const wchar_t* txt = g_windowVisible ? L"Hide" : L"Show";
                RECT rc = dis->rcItem;
                rc.left += 16;
                DrawTextW(dis->hDC, txt, -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
            }
            else if (dis->itemID == 2) {
                RECT rc = dis->rcItem;
                rc.left += 16;
                DrawTextW(dis->hDC, L"Close", -1, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
            }
            SelectObject(dis->hDC, oldFont);
            DeleteObject(hFont);
        }
        return TRUE;
    }
    case WM_TRAYICON:
        // Fix 30: Klick auf die Windows-Benachrichtigung (nur die Dig- und Lucky-Gift-Hinweise nutzen NIF_INFO)
        // -> Hauptfenster wie beim Linksklick aufs Tray-Icon öffnen (Fix 33: an der bisherigen Stelle) und sicher nach vorne holen.
        // Ohne NIM_SETVERSION (Version 0, wie hier) steht das Ereignis direkt in lParam; mit NOTIFYICON_VERSION_4
        // stünde es in LOWORD(lParam) – LOWORD deckt beides ab. Windows meldet den Klick nur, solange die
        // Benachrichtigung angezeigt wird; ein späterer Klick im Info-Center sendet nichts an das Programm.
        if (LOWORD(lParam) == NIN_BALLOONUSERCLICK) {
            BringMainWindowToFront(hwnd);
            KeepMainWindowOnScreen(hwnd);   // Fix 33: nicht mehr zentrieren
            LogGlowStart();   // Fix 31: zugehörige Log-Zeile aufleuchten lassen
            return 0;
        }
        // Links- oder Doppelklick (auch Klick auf die Blase): Hauptfenster an der bisherigen Stelle anzeigen (Fix 33: nicht mehr zentrieren)
        if (lParam == WM_LBUTTONDBLCLK || lParam == WM_LBUTTONUP) {
            ShowWindow(hwnd, SW_SHOW);
            ShowWindow(hwnd, SW_RESTORE);
            KeepMainWindowOnScreen(hwnd);
            SetForegroundWindow(hwnd);
            g_windowVisible = true;
        }
        // Rechtsklick: dunkles Kontextmenü (Show/Hide, Close)
        if (lParam == WM_RBUTTONUP) {
            POINT pt; GetCursorPos(&pt);
            HMENU menu = CreatePopupMenu();
            AppendMenuW(menu, MF_OWNERDRAW | MF_DISABLED, 100, APP_TITLE.c_str());
            AppendMenuW(menu, MF_OWNERDRAW | MF_DISABLED, 101, nullptr);
            AppendMenuW(menu, MF_OWNERDRAW, 1, g_windowVisible ? L"Hide" : L"Show");
            AppendMenuW(menu, MF_OWNERDRAW, 2, L"Close");
            MENUINFO mi = { sizeof(mi) };
            mi.fMask = MIM_BACKGROUND;
            HBRUSH hBrush = CreateSolidBrush(RGB(0, 0, 0));
            mi.hbrBack = hBrush;
            SetMenuInfo(menu, &mi);
            SetForegroundWindow(hwnd);
            int sel = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_NONOTIFY | TPM_RIGHTBUTTON, pt.x, pt.y, 0, hwnd, nullptr);
            DestroyMenu(menu);
            DeleteObject(hBrush);
            if (sel == 1) {
                ShowWindow(hwnd, g_windowVisible ? SW_HIDE : SW_SHOW);
                if (!g_windowVisible) { ShowWindow(hwnd, SW_RESTORE); KeepMainWindowOnScreen(hwnd); SetForegroundWindow(hwnd); }   // Fix 33
                g_windowVisible = !g_windowVisible;
            }
            if (sel == 2) {
                if (g_hConfigWnd && IsWindow(g_hConfigWnd)) {
                    DestroyWindow(g_hConfigWnd);
                    g_hConfigWnd = nullptr;
                }
                Shell_NotifyIconW(NIM_DELETE, &g_nid);
                PostQuitMessage(0);
            }
        }
        return 0;
    case WM_CLOSE:
        if (g_hConfigWnd && IsWindow(g_hConfigWnd)) {
            DestroyWindow(g_hConfigWnd);
            g_hConfigWnd = nullptr;
        }
        Shell_NotifyIconW(NIM_DELETE, &g_nid);
        DestroyWindow(hwnd);
        return 0;
    case WM_DESTROY:
        if (g_hStatusFont) DeleteObject(g_hStatusFont);
        if (g_hDigCountFont) { DeleteObject(g_hDigCountFont); g_hDigCountFont = nullptr; }
        KillTimer(hwnd, 1);
        Shell_NotifyIconW(NIM_DELETE, &g_nid);
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcW(hwnd, msg, wParam, lParam);
}

// ===== Speicher-Scan: Hilfsfunktionen =====
// Aktuelle Uhrzeit als „HH:MM:SS“
static std::string now_time_hms() {
    std::time_t t = std::time(nullptr);
    std::tm tm{};
    localtime_s(&tm, &t);
    std::ostringstream oss;
    oss << std::put_time(&tm, "%H:%M:%S");
    return oss.str();
}
// Prozess-ID anhand des Exe-Namens (0 = läuft nicht)
DWORD GetPIDByName(const std::wstring& processName) {
    DWORD pid = 0;
    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snap == INVALID_HANDLE_VALUE) return 0;
    PROCESSENTRY32W pe{ sizeof(pe) };
    if (Process32FirstW(snap, &pe)) {
        do { if (processName == pe.szExeFile) { pid = pe.th32ProcessID; break; } } while (Process32NextW(snap, &pe));
    }
    CloseHandle(snap);
    return pid;
}

// ===== Discord-Ping =====
// Sendet die Nachricht per Discord-API in den Channel (blockiert; läuft im eigenen Thread)
static void sendDiscordPingBlocking(const std::wstring& channel_id, const std::wstring& token, const std::wstring& msg) {
    // JSON-Sonderzeichen escapen (Steuerzeichen < 0x20 als \u00XX)
    std::wstring escaped;
    for (wchar_t c : msg) {
        if (c == L'\\') escaped += L"\\\\";
        else if (c == L'"') escaped += L"\\\"";
        else if (c == L'\n') escaped += L"\\n";
        else if (c == L'\r') escaped += L"\\r";
        else if (c < 0x20) {
            wchar_t hex[8];
            swprintf_s(hex, L"\\u%04X", (unsigned)c);
            escaped += hex;
        }
        else escaped += c;
    }
    // Nach UTF-8 umwandeln
    int needed = WideCharToMultiByte(CP_UTF8, 0, escaped.c_str(), -1, nullptr, 0, nullptr, nullptr);
    std::string utf8(needed > 0 ? needed - 1 : 0, '\0');
    if (needed > 0)
        WideCharToMultiByte(CP_UTF8, 0, escaped.c_str(), -1, utf8.data(), needed, nullptr, nullptr);
    std::string body = "{\"content\":\"" + utf8 + "\"}";
    HINTERNET s = WinHttpOpen(L"MyBot/1.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, 0, 0, 0);
    if (!s) return;
    // Zeitlimits 5 s (Namensauflösung, Verbindung, Senden, Antwort)
    WinHttpSetTimeouts(s, 5000, 5000, 5000, 5000);
    HINTERNET c = WinHttpConnect(s, L"discord.com", INTERNET_DEFAULT_HTTPS_PORT, 0);
    if (!c) { WinHttpCloseHandle(s); return; }
    std::wstring url = L"/api/v10/channels/" + channel_id + L"/messages";
    HINTERNET r = WinHttpOpenRequest(c, L"POST", url.c_str(), 0, 0, 0, WINHTTP_FLAG_SECURE);
    if (!r) { WinHttpCloseHandle(c); WinHttpCloseHandle(s); return; }
    std::wstring headers = L"Authorization: Bot " + token + L"\r\nContent-Type: application/json";
    if (WinHttpSendRequest(r, headers.c_str(), (DWORD)headers.length(), (LPVOID)body.c_str(), (DWORD)body.size(), (DWORD)body.size(), 0))
        WinHttpReceiveResponse(r, 0);
    WinHttpCloseHandle(r); WinHttpCloseHandle(c); WinHttpCloseHandle(s);
}
// Sendet die eingestellte Nachricht in den Channel, ohne den Scan zu blockieren
// (Token/Channel/Nachricht werden vorher unter Lock kopiert, der Request läuft in einem eigenen Thread)
void sendDiscordPing() {
    std::wstring channel_id, token, msg;
    {
        std::lock_guard<std::mutex> lock(g_discordCfgMutex);
        channel_id = g_channelId;
        token = g_discordToken;
        msg = g_discordMessage.empty() ? L"DIG @everyone !" : g_discordMessage;
    }
    try {
        std::thread(sendDiscordPingBlocking, channel_id, token, msg).detach();
    }
    catch (...) {
        // Thread konnte nicht gestartet werden -> wie früher direkt senden
        sendDiscordPingBlocking(channel_id, token, msg);
    }
}

// ===== Prozess-Steuerung =====
// Beendet einen Prozess und wartet max. timeout_ms auf das Ende
bool terminateProcessAndWait(DWORD pid, DWORD timeout_ms) {
    if (!pid) return false;
    HANDLE h = OpenProcess(SYNCHRONIZE | PROCESS_TERMINATE, FALSE, pid);
    if (!h) return false;
    TerminateProcess(h, 0);
    DWORD r = WaitForSingleObject(h, timeout_ms);
    CloseHandle(h);
    return r == WAIT_OBJECT_0;
}

// ===== Strenger Dig-Filter =====
// Ein echter Dig steht im Speicher als eigener String:
//   [8-Byte-Länge][<Ziel-Text> [<u>](<Wort> #<Warzone> X:<n> Y:<n>)[</u>]]\0
// Koordinaten werden nur aus genau diesem String übernommen.

// Ergebnis der strengen Prüfung
struct StrictDigResult {
    bool ok = false;
    // Ablehnungsgrund (nur zur Info)
    std::string reason;
    // kompletter Dig-String bis \0
    std::string str;
    std::string x, y;
    // lokalisiertes Wort vor '#' (z. B. „Warzone“)
    std::string label;
    // Fix 43: Warzone-Nummer aus dem Dig-Text (Ziffern hinter '#')
    std::string server;
    // Abstand Ende Ziel-Text -> „X“ in Bytes
    size_t gap = 0;
};
// Grenzwerte: max. Stringlänge und max. Abstand Ziel-Text -> Koordinaten (Thai/Russisch brauchen mehr)
static const size_t STRICT_MAX_STRING = 256;
static const size_t STRICT_MAX_GAP = 64;
// Gültiges UTF-8 ohne Steuerzeichen?
static bool StrictIsValidUtf8NoCtl(const std::string& s) {
    for (unsigned char c : s) if (c < 0x20 || c == 0x7F) return false;
    if (s.empty()) return true;
    return MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, s.data(), (int)s.size(), nullptr, 0) > 0;
}
// UTF-8 -> UTF-16
static std::wstring StrictUtf8ToWide(const std::string& s) {
    if (s.empty()) return std::wstring();
    int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), nullptr, 0);
    std::wstring out(n > 0 ? n : 0, L'\0');
    if (n > 0) MultiByteToWideChar(CP_UTF8, 0, s.data(), (int)s.size(), &out[0], n);
    return out;
}
// Unsichtbare Zeichen (Zero-Width, BiDi, Variation Selectors, weiches Trennzeichen)
static bool StrictIsInvisible(unsigned cp) {
    return (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x2060 && cp <= 0x2064) || cp == 0xFEFF || cp == 0x00AD ||
        cp == 0x034F || cp == 0x061C || (cp >= 0x202A && cp <= 0x202E) || (cp >= 0x2066 && cp <= 0x2069) ||
        (cp >= 0xFE00 && cp <= 0xFE0F);
}
// BiDi-Richtungszeichen – bei Arabisch normal und kein Hinweis auf Fake-Digs
static bool StrictIsBidiMark(unsigned cp) {
    return cp == 0x200E || cp == 0x200F || cp == 0x061C || (cp >= 0x202A && cp <= 0x202E) || (cp >= 0x2066 && cp <= 0x2069);
}
// Enthält der String unsichtbare Zeichen (BiDi-Zeichen ausgenommen)?
static bool StrictHasInvisible(const std::string& s) {
    std::wstring w = StrictUtf8ToWide(s);
    for (wchar_t c : w) if (StrictIsInvisible((unsigned)c) && !StrictIsBidiMark((unsigned)c)) return true;
    return false;
}
// Entfernt BiDi-Richtungszeichen (für die Struktur-Prüfung bei Arabisch)
static std::string StrictStripBidi(const std::string& s) {
    std::wstring w = StrictUtf8ToWide(s), o;
    for (wchar_t c : w) if (!StrictIsBidiMark((unsigned)c)) o += c;
    if (o.size() == w.size()) return s;
    int n = WideCharToMultiByte(CP_UTF8, 0, o.data(), (int)o.size(), nullptr, 0, nullptr, nullptr);
    std::string r(n, '\0');
    WideCharToMultiByte(CP_UTF8, 0, o.data(), (int)o.size(), &r[0], n, nullptr, nullptr);
    return r;
}
// Fix 43: Warzone-Nummer ab s[p]: 1–6 Ziffern, keine führende Null, danach keine weitere Ziffer -> Anzahl Ziffern, sonst 0
static size_t DigWarzoneNumLen(std::string_view s, size_t p) {
    size_t n = 0;
    while (p + n < s.size() && s[p + n] >= '0' && s[p + n] <= '9') { if (++n > 6) return 0; }
    if (n == 0 || s[p] == '0') return 0;
    return n;
}
// Fix 43: Marker-Präfix (endet auf '#', z. B. „(Kriegszone #“) im Text, direkt gefolgt von einer gültigen Warzone-Nummer?
static bool DigHasMarker(std::string_view s, std::string_view prefix) {
    for (size_t f = s.find(prefix); f != std::string_view::npos; f = s.find(prefix, f + 1))
        if (DigWarzoneNumLen(s, f + prefix.size())) return true;
    return false;
}
// Prüft einen Treffer streng (Schritte 1–7) und liefert bei Erfolg die Koordinaten und die Warzone-Nummer
static StrictDigResult StrictDigCheck(std::string_view mem, size_t pos, const std::string& pattern,
    const std::vector<std::string>& requiredContexts) {
    StrictDigResult r;
    // 1) Ziel-Text steht am Anfang eines Strings (davor \0)
    if (pos < 8 || mem[pos - 1] != '\0') { r.reason = "Ziel-Text steht nicht am Anfang eines Strings (kein \\0 davor)"; return r; }
    // 2) String-Ende (\0) in vernünftiger Länge
    size_t end = mem.find('\0', pos);
    if (end == std::string_view::npos || end - pos > STRICT_MAX_STRING) { r.reason = "kein String-Ende innerhalb " + std::to_string(STRICT_MAX_STRING) + " Bytes"; return r; }
    r.str.assign(mem.data() + pos, end - pos);
    // 3) 8-Byte-Längenfeld direkt davor passt zur Stringlänge (Toleranz für entfernte U+200B, je 3 Bytes)
    unsigned long long L = 0;
    memcpy(&L, mem.data() + pos - 8, 8);
    if (L < r.str.size() || L - r.str.size() > 30 || (L - r.str.size()) % 3 != 0) {
        r.reason = "Laengenfeld (" + std::to_string(L) + ") passt nicht zur Stringlaenge (" + std::to_string(r.str.size()) + ")";
        return r;
    }
    // 4) Gültiges UTF-8, keine Steuerzeichen, keine unsichtbaren Zeichen
    if (!StrictIsValidUtf8NoCtl(r.str)) { r.reason = "ungueltiges UTF-8 oder Steuerzeichen im String"; return r; }
    if (StrictHasInvisible(r.str)) { r.reason = "unsichtbare Unicode-Zeichen (Zero-Width/BiDi) im String"; return r; }
    // 5) Struktur hinter dem Ziel-Text: Koordinaten im selben String, verankert bis zum String-Ende
    std::string rest = StrictStripBidi(r.str.substr(pattern.size()));
    //    Wort vor '#' optional (Arabisch hat keins), optionaler Trenner nach der Warzone-Nummer, <u> auch in der Klammer
    static const std::regex rx(R"(^\s?(?:<u>)?\((?:<u>)?([^()<>#0-9]{0,48}?)\s?#(\d{1,6})\s*(?:[^()<>#0-9A-Za-z\s]{1,16}\s*)?X\s*:\s*(\d{1,4})\s+Y\s*:\s*(\d{1,4})\s*(?:</u>)?\)(?:</u>)?$)");
    std::smatch m;
    if (!std::regex_match(rest, m, rx)) { r.reason = "Struktur passt nicht: erwartet '<Ziel> [<u>](<Wort> #<WZ> X:<n> Y:<n>)[</u>]'"; return r; }
    r.label = m[1].str();
    //    Wort nur aus Buchstaben/Leerzeichen; Warzone-Nummer beliebig, aber gültig (Fix 43: 1–6 Ziffern, keine führende Null)
    for (unsigned char c : r.label) {
        if (c < 0x80 && !isalpha(c) && c != ' ') { r.reason = "Warzone-Wort enthaelt Nicht-Buchstaben: '" + r.label + "'"; return r; }
    }
    if (!DigWarzoneNumLen(m[2].str(), 0)) { r.reason = "ungueltige Warzone #" + m[2].str(); return r; }
    r.server = m[2].str();
    // 6) Abstand Ziel-Text -> „X“ begrenzen
    r.gap = (size_t)m.position(3) - 2;
    if (r.gap > STRICT_MAX_GAP) { r.reason = "Abstand Ziel-Text -> Koordinaten zu gross (" + std::to_string(r.gap) + " Bytes)"; return r; }
    // 7) Warzone-Marker muss ein bekannter sein (alle Sprachen), exakt an der '('-Position
    size_t paren = r.str.find('(', pattern.size());
    bool markerOk = false;
    for (const auto& ctx : requiredContexts) {
        // Marker teils mit „ X:“ am Ende – nur bis inkl. '#' vergleichen, dahinter muss die Warzone-Nummer stehen (Fix 43)
        std::string c = ctx;
        size_t xp = c.find(" X:");
        if (xp != std::string::npos) c = c.substr(0, xp);
        if (paren != std::string::npos && r.str.compare(paren, c.size(), c) == 0 && DigWarzoneNumLen(r.str, paren + c.size())) { markerOk = true; break; }
    }
    // Sprachen ohne lateinisches Wort (z. B. Arabisch „(#1036 …“): Struktur + Warzone-Nummer reichen
    if (!markerOk) {
        bool latin = false;
        for (unsigned char c : r.label) if (c < 0x80 && isalpha(c)) { latin = true; break; }
        if (!latin) markerOk = true;
    }
    if (!markerOk) { r.reason = "Warzone-Marker '(" + r.label + "...' ist keiner der bekannten Marker"; return r; }
    r.x = m[3].str();
    r.y = m[4].str();
    r.ok = true;
    return r;
}

// ===== Failsafe =====
// Nur bei „auto refresh game“: fordert alle „Refresh“-Minuten einen Spiel-Neustart an. Ohne Häkchen kein periodischer
// Reset mehr (Start-Verzögerung nur noch bei neu erkanntem Last-War-Prozess); der Timer startet beim Ankreuzen neu.
void FailsafeThread() {
    g_lastFailsafeReset = TimePointToTicks(std::chrono::steady_clock::now());
    while (true) {
        auto now = std::chrono::steady_clock::now();
        int failsafeSeconds = g_refreshDuration * 60;
        if (!AutoRefreshActive()) {
            g_lastFailsafeReset = TimePointToTicks(now);
        }
        else if (std::chrono::duration_cast<std::chrono::seconds>(now - TicksToTimePoint(g_lastFailsafeReset.load())).count() >= failsafeSeconds) {
            g_resetRequested = true;
            g_lastFailsafeReset = TimePointToTicks(std::chrono::steady_clock::now());
        }
        Sleep(100);
    }
}

// ===== Lucky Gift / Glücksgeschenk =====
// Das genaue Speicherformat ist noch unbekannt. Best-Effort nach dem Vorbild der Dig-uuid-Erkennung:
//  a) Anhang-JSONs mit "shareType":<≠27> bzw. mit "uuid" (ohne shareType 27) werden flach geparst.
//     Enthält ein Schlüssel/Wert Hinweise wie lucky/redpacket/packet/envelope/gift/diamond oder ist der
//     shareType als Lucky-Gift-Typ gelernt -> „stark“: neue uuid wird sofort einmal gemeldet.
//     Sonst „schwach“: uuid wartet (max. 30 min) auf einen frischen Lucky-Gift-Text.
//  b) Lucky-Gift-Text: eigener Lua-String, beginnt mit „Ich habe“ und enthält „Glück“ oder „Diamant“
//     (z. B. „Ich habe gerade 5,000 Diamanten erhalten, teil mein Glück!“). Je Adresse ein Slot (wie Dig-fulltext).
//     Ein frischer Slot wird 1:1 mit einer gleichzeitig neu aufgetauchten schwachen uuid gepaart und gemeldet
//     (Vorrang: JSON enthält die Diamanten-Zahl des Texts, dann nächste Adresse). Ein Text ohne uuid wird NIE gemeldet.
//  Duplikatschutz nur über die uuid (eigene Menge, 20000, FIFO); in der Start-Verzögerung gesehene uuids/Texte
//  gelten als alt. Die Dig-Daten (g_seenMsgIds, g_pendingMsgs, g_digSlots) werden nicht verändert.
static const size_t LUCKY_SEEN_CAP = 20000;
static const size_t LUCKY_PENDING_CAP = 4096;
static const ULONGLONG LUCKY_PENDING_TTL_MS = 30ULL * 60 * 1000;
static std::unordered_set<unsigned long long> g_luckySeenIds;
static std::deque<unsigned long long> g_luckySeenOrder;
struct LuckyPending {
    int shareType = -1; bool strong = false;
    unsigned firstFull = 0; unsigned long long firstPass = 0; ULONGLONG firstTick = 0;
    uintptr_t addr = 0; std::string json;
};
static std::unordered_map<unsigned long long, LuckyPending> g_luckyPending;
struct LuckyTextSlot {
    std::string text; bool consumed = false;
    unsigned firstFull = 0; unsigned long long firstPass = 0, lastPass = 0;
};
static std::unordered_map<uintptr_t, LuckyTextSlot> g_luckyTexts;
static std::unordered_map<int, int> g_luckyPairedTypes;      // shareType -> Anzahl Text-Paarungen (ab 2 = gelernt)
static unsigned g_luckyLastStrongFull = 0;
static bool g_luckyHadStrong = false;
static std::string g_luckyLang;                               // Spielsprache für das Log-Wort („en“, „de“ …; Fix 25: gespeichert)
static bool g_luckyLangLoaded = false;                        // Fix 25: g_luckyLang einmal aus der Registry geladen
static bool g_luckyRelabelPending = false;                    // Fix 25: Zeilen mit Ersatzwort geloggt, Sprache noch offen

// Sicherer Auszug: Steuerzeichen -> '.', '"' -> '\'', max. maxLen Bytes (UTF-8 bleibt erhalten)
static std::string LuckySafe(std::string_view v, size_t maxLen = 300) {
    std::string r;
    size_t n = std::min(v.size(), maxLen);
    r.reserve(n + 4);
    for (size_t i = 0; i < n; ++i) {
        unsigned char c = (unsigned char)v[i];
        r += (c < 0x20 || c == 0x7F) ? '.' : (c == '"' ? '\'' : (char)c);
    }
    if (v.size() > maxLen) r += "...";
    return r;
}
static void MarkLuckySeen(unsigned long long id) {
    if (!g_luckySeenIds.insert(id).second) return;
    g_luckySeenOrder.push_back(id);
    while (g_luckySeenOrder.size() > LUCKY_SEEN_CAP) {
        g_luckySeenIds.erase(g_luckySeenOrder.front());
        g_luckySeenOrder.pop_front();
    }
}
// uuid der Glücksgeschenke: 32 Hex-Zeichen (z. B. 61ead681850a402cba8c04c02778acf3) -> Kleinbuchstaben
static bool LuckyHexUuid(std::string_view v, std::string& out) {
    if (v.size() != 32) return false;
    out.clear();
    for (char c : v) {
        if (c >= '0' && c <= '9') out += c;
        else if (c >= 'a' && c <= 'f') out += c;
        else if (c >= 'A' && c <= 'F') out += (char)(c - 'A' + 'a');
        else return false;
    }
    return true;
}
// Bekannte Glücksgeschenk-uuids (Hex-String), eigene Menge, FIFO, Obergrenze 20000
static std::unordered_set<std::string> g_luckySeenHex;
static std::deque<std::string> g_luckySeenHexOrder;
static void MarkLuckySeenHex(const std::string& id) {
    if (!g_luckySeenHex.insert(id).second) return;
    g_luckySeenHexOrder.push_back(id);
    while (g_luckySeenHexOrder.size() > LUCKY_SEEN_CAP) {
        g_luckySeenHex.erase(g_luckySeenHexOrder.front());
        g_luckySeenHexOrder.pop_front();
    }
}
static std::string LuckyLower(std::string_view v) {
    std::string r(v);
    for (auto& c : r) c = (char)tolower((unsigned char)c);
    return r;
}
// Hinweis-Wörter für Lucky Gift / Red Packet im JSON (Kleinbuchstaben)
static bool LuckyJsonHint(std::string_view json, std::string& which) {
    static const char* HINTS[] = { "lucky", "luck", "redpack", "red_pack", "redpacket", "red_packet", "packet",
        "envelope", "hongbao", "gift", "diamond" };
    std::string low = LuckyLower(json);
    for (const char* h : HINTS) if (low.find(h) != std::string::npos) { which = h; return true; }
    return false;
}
// Diamanten-Zahl aus dem Text („5,000“ / „5.000“ -> „5000“), leer wenn keine
static std::string LuckyTextNumber(const std::string& t) {
    std::string r;
    for (size_t i = 0; i < t.size(); ++i) {
        if (t[i] >= '0' && t[i] <= '9') r += t[i];
        else if (!r.empty() && (t[i] == ',' || t[i] == '.') && i + 1 < t.size() && t[i + 1] >= '0' && t[i + 1] <= '9') continue;
        else if (!r.empty()) break;
    }
    return r;
}
// Spielsprache für das Log-Wort: aus dem Lucky-Text bzw. aus vorhandenen Dig-Texten (nur lesen)
