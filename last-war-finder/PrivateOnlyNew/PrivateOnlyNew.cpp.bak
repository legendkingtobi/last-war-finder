#ifndef IDI_EXCAVATOR
#define IDI_EXCAVATOR 905
#endif
static int DigIconId() {
    static int id = 0;
    if (!id) id = FindResourceW(GetModuleHandleW(nullptr), MAKEINTRESOURCEW(IDI_EXCAVATOR), RT_GROUP_ICON) ? IDI_EXCAVATOR : 1;
    return id;
}
// Fix 124: App-Icon in Systemgröße (groß/klein), geteilt (LR_SHARED -> kein DestroyIcon nötig, kein Leck bei jedem Öffnen)
static HICON AppIcon(bool isSmall) {
    const int cx = GetSystemMetrics(isSmall ? SM_CXSMICON : SM_CXICON), cy = GetSystemMetrics(isSmall ? SM_CYSMICON : SM_CYICON);
    return (HICON)LoadImageW(GetModuleHandleW(nullptr), MAKEINTRESOURCEW(1), IMAGE_ICON, cx > 0 ? cx : (isSmall ? 16 : 32), cy > 0 ? cy : (isSmall ? 16 : 32), LR_DEFAULTCOLOR | LR_SHARED);
}
