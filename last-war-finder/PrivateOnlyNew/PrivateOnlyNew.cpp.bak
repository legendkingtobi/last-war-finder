// Umrechnung Zeitpunkt <-> Ticks
static long long TimePointToTicks(std::chrono::steady_clock::time_point tp) {
    return tp.time_since_epoch().count();
}
static std::chrono::steady_clock::time_point TicksToTimePoint(long long ticks) {
    return std::chrono::steady_clock::time_point(std::chrono::steady_clock::duration(ticks));
}
