// ===== Fix 27: Sprach-Probe =====
// Einmal je Spielprozess (Bot-Start mit laufendem Spiel, Spielstart, Neustart = neue PID) durchsucht ein eigener Thread
// (Priorität unter normal, eigener Prozess-Handle, eigener 512-KB-Puffer, nach jedem Block Sleep(0)) die privaten,
// beschreibbaren Speicherbereiche des Spiels einmal nach den 32 Dig-Texten (LUCKY_LANG_PATTERNS, UTF-8 und – Fix 57 – UTF-16).
// Beide Texte einer Sprache (außer en) -> sofort fertig. Englisch allein reicht nicht für einen Abbruch
// (könnte als Ersatztabelle geladen sein): dann bis zum Ende weiter, eine andere Sprache hat Vorrang. Ohne Treffer:
// später erneut (Spiel lädt noch), höchstens LUCKY_PROBE_MAX_TRIES Mal.
// Ergebnis -> g_luckyProbeLabel (Worker speichert „luckyLang2“ und benennt um, UI schreibt wartende Zeilen).
// Fix 57: NUR die Spieltexte (Lokalisierung der Oberfläche) zählen. Früher entschieden Dig-Posts anderer Spieler im Chat
// (g_digSlots, jede Sprache) mit Vorrang, und die Probe zählte auch Chat-Treffer -> „هدية الحظ“ auf einem deutschen Spiel
// (Server mit arabischen Spielern). Jetzt: g_digSlots entscheiden nie, und ein Treffer zählt nur mit Spieltext-Umgebung
// (siehe LuckyLangContext). Das Spiel startet beim Umstellen der Sprache neu (neue PID, log13) -> neue Probe.
static const size_t LUCKY_PROBE_CHUNK = 512 * 1024;
static const size_t LUCKY_PROBE_OVERLAP = 512;           // > längster Text (UTF-16) samt Objektkopf
static const unsigned long long LUCKY_PROBE_HOLD_MS = 5000;
static const int LUCKY_PROBE_MAX_TRIES = 8;
static const int LUCKY_PROBE_NLANG = (int)(sizeof(LUCKY_LOG_LABELS) / sizeof(LUCKY_LOG_LABELS[0]));
static const size_t LUCKY_PROBE_NPAT = sizeof(LUCKY_LANG_PATTERNS) / sizeof(LUCKY_LANG_PATTERNS[0]);
static std::atomic<bool> g_luckyProbeNews{ false };      // Fix 44: neues Probe-Ergebnis -> Worker übernimmt die Sprache
static int LuckyLabelIndex(const std::string& lang) {
    for (int i = 0; i < LUCKY_PROBE_NLANG; ++i) if (lang == LUCKY_LOG_LABELS[i].lang) return i;
    return -1;
}
// Mehrmuster-Suche nach Wu-Manber (Blöcke aus 2 Bytes): Fenster = kürzester Text (m Bytes); passt der letzte Block
// des Fensters zu keinem Text, springt die Suche bis zu m-1 Bytes weiter -> deutlich schneller als Byte für Byte.
// Fix 57: UTF-8-Text -> UTF-16LE-Bytes (alle Dig-Texte liegen in der BMP)
static std::string LuckyUtf8To16le(const char* s) {
    std::string r;
    for (const unsigned char* p = (const unsigned char*)s; *p; ) {
        unsigned c = *p++;
        if (c >= 0xE0 && p[0] && p[1]) { c = ((c & 0x0F) << 12) | ((unsigned)(p[0] & 0x3F) << 6) | (p[1] & 0x3F); p += 2; }
        else if (c >= 0xC0 && p[0]) { c = ((c & 0x1F) << 6) | (p[0] & 0x3F); p += 1; }
        r += (char)(c & 0xFF); r += (char)(c >> 8);
    }
    return r;
}
struct LuckyProbeTables {
    size_t m = 0;                                          // kürzeste Textlänge
    unsigned char shift[65536];                            // Sprungweite je 2-Byte-Block
    unsigned char head[65536] = {};                        // erster Text (1-basiert) mit diesem Fenster-Endblock
    unsigned char next[LUCKY_PROBE_NPAT] = {};             // weitere Texte mit gleichem Block (1-basiert)
    size_t len[LUCKY_PROBE_NPAT] = {};
    int label[LUCKY_PROBE_NPAT] = {};
    unsigned char bit[LUCKY_PROBE_NPAT] = {};
    bool u16 = false;                                      // Fix 57: Texte als UTF-16LE (Il2Cpp-Strings)
    std::string pat[LUCKY_PROBE_NPAT];                     // Fix 57: Textbytes in dieser Kodierung
    explicit LuckyProbeTables(bool wide = false) : u16(wide) {
        m = 255;
        for (size_t i = 0; i < LUCKY_PROBE_NPAT; ++i) {
            pat[i] = wide ? LuckyUtf8To16le(LUCKY_LANG_PATTERNS[i].pattern) : std::string(LUCKY_LANG_PATTERNS[i].pattern);
            len[i] = pat[i].size(); m = std::min(m, len[i]);
        }
        memset(shift, (int)(m - 1), sizeof(shift));
        for (size_t i = 0; i < LUCKY_PROBE_NPAT; ++i) {
            const unsigned char* t = (const unsigned char*)pat[i].data();
            for (size_t q = 1; q < m; ++q) {                   // Block t[q-1..q] im Präfix der Länge m
                const unsigned k = t[q - 1] | ((unsigned)t[q] << 8);
                shift[k] = (unsigned char)std::min<size_t>(shift[k], m - 1 - q);
            }
            const unsigned k = t[m - 2] | ((unsigned)t[m - 1] << 8);
            next[i] = head[k]; head[k] = (unsigned char)(i + 1);
            label[i] = LuckyLabelIndex(LUCKY_LANG_PATTERNS[i].lang);
            int before = 0;
            for (size_t j = 0; j < i; ++j) if (strcmp(LUCKY_LANG_PATTERNS[j].lang, LUCKY_LANG_PATTERNS[i].lang) == 0) ++before;
            bit[i] = (unsigned char)(1u << std::min(before, 1));
        }
    }
};
static const LuckyProbeTables& LuckyProbeTab() { static const LuckyProbeTables t; return t; }
// Entscheidung aus den Treffer-Bits (1 = Schatz-Text, 2 = Testflug-Text, 3 = beide) je Sprache.
// final = false: nur ein sicheres Paar (nicht en) beendet die Suche; final = true: Ende des Speichers erreicht.
static int LuckyProbeDecide(const unsigned char* mask, bool final) {
    const int en = LuckyLabelIndex("en");
    int pair = -1, any = -1, anyCount = 0;
    for (int i = 0; i < LUCKY_PROBE_NLANG; ++i) {
        if (i == en || !mask[i]) continue;
        if (mask[i] == 3 && pair < 0) pair = i;
        any = i; ++anyCount;
    }
    if (pair >= 0) return pair;
    if (!final) return -1;
    if (anyCount == 1) return any;                          // nur eine andere Sprache (ein Text)
    if (anyCount == 0 && en >= 0 && mask[en]) return en;    // nur Englisch
    return -1;                                              // nichts oder mehrdeutig
}
// Fix 57: schwache Stufe (eigenständige Strings ohne Schlüssel) entscheidet nur mit einem PAAR einer Sprache (oder nur en)
static int LuckyProbeDecideWeak(const unsigned char* weak) {
    const int en = LuckyLabelIndex("en");
    int pair = -1, pairs = 0, others = 0;
    for (int i = 0; i < LUCKY_PROBE_NLANG; ++i) {
        if (i == en || !weak[i]) continue;
        ++others;
        if (weak[i] == 3) { pair = i; ++pairs; }
    }
    if (pairs == 1) return pair;
    if (others == 0 && en >= 0 && weak[en]) return en;
    return -1;
}
// ===== Fix 57: Treffer nur als SPIELTEXT, nie aus dem Chat =====
// Chat-Dig-Posts (jede Sprache der Mitspieler) enthalten denselben Text, aber immer mit Koordinaten „(Kriegszone #1036 X:488 Y:436)“
// und liegen im Chat-JSON („"msg":“, „roomId“, „senderInfo“). Spieltexte liegen in der Lokalisierung:
//  Stufe 1 (stark) – UTF-8-Tabelle [Schlüssellänge][Schlüssel][Textlänge varint][Text] (gleiches Format wie item_name, log23:
//    „\x16zone_war_government_12\x17Belohnung des Eroberers\x16zone_war_government_13…“) bzw. UTF-16-Objekt, dessen Schlüssel-Objekt
//    (gleiche Klasse, Bezeichner) genau eine Objektgröße darüber liegt (Fix 49/55);
//  Stufe 2 (schwach) – ganzer eigenständiger String (Länge < 0x20 bzw. NUL davor, Stringende danach), nur als Ersatz am Ende.
// Immer verworfen: Rest des Strings mit Ziffer außerhalb {…} (Koordinaten/Zahlen), Anführungszeichen/Backslash (JSON), und jeder
// Treffer mit Chat-JSON-Schlüssel in ±LUCKY_PROBE_CHAT_WIN Byte (UTF-8 oder UTF-16). Kosten nur je Text-Treffer (selten).
struct LuckyProbeStats { unsigned raw = 0, table = 0, plain = 0, chat = 0, other = 0; };
static const size_t LUCKY_PROBE_CHAT_WIN = 1024;
static bool LuckyLangKeyChar(unsigned char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c == '.' || c == '-'; }
static bool LuckyLangAlpha(unsigned char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
// Rest nach dem Text (Zeichencodes): keine Ziffer (ASCII oder arabisch-indisch) außerhalb {…}, kein " oder Backslash
static bool LuckyLangRestOk(const unsigned char* r, size_t n, bool u16) {
    int depth = 0;
    for (size_t i = 0; i < n; ) {
        unsigned c;
        if (u16) { if (i + 1 >= n) break; c = r[i] | ((unsigned)r[i + 1] << 8); i += 2; }
        else {
            c = r[i++];
            if (c == 0xD9 && i < n && r[i] >= 0xA0 && r[i] <= 0xA9) { c = 0x660; ++i; }   // ٠–٩ in UTF-8
        }
        if (c == '{') ++depth;
        else if (c == '}') { if (depth > 0) --depth; }
        else if (c == '"' || c == '\\') return false;
        else if (depth == 0 && ((c >= '0' && c <= '9') || (c >= 0x660 && c <= 0x669))) return false;
    }
    return true;
}
static bool LuckyLangNearChat(const unsigned char* d, size_t len, size_t st) {
    static const std::string K8[] = { "\"msg\":", "msg\\\":", "roomId", "senderInfo" };
    static const std::string K16[] = { LuckyUtf8To16le("\"msg\":"), LuckyUtf8To16le("msg\\\":"), LuckyUtf8To16le("roomId"), LuckyUtf8To16le("senderInfo") };
    const size_t a = st > LUCKY_PROBE_CHAT_WIN ? st - LUCKY_PROBE_CHAT_WIN : 0, b = std::min(len, st + LUCKY_PROBE_CHAT_WIN);
    const std::string_view w((const char*)d + a, b - a);
    for (const auto& k : K8) if (w.find(k) != std::string_view::npos) return true;
    for (const auto& k : K16) if (w.find(k) != std::string_view::npos) return true;
    return false;
}
// UTF-8: 2 = Tabellen-Eintrag mit Schlüssel, 1 = eigenständiger String, 0 = nein
static int LuckyLangCtx8(const unsigned char* d, size_t len, size_t st, size_t plen) {
    if (st < 1) return 0;
    const unsigned char b1 = d[st - 1];
    if (b1 == 0) {                                         // C-String: NUL davor, NUL danach
        size_t e = st + plen;
        while (e < len && e < st + 512 && d[e]) ++e;
        if (e >= len || d[e]) return 0;
        return LuckyLangRestOk(d + st + plen, e - st - plen, false) ? 1 : 0;
    }
    if (b1 & 0x80) return 0;
    size_t L = b1, lb = 1;                                 // Textlänge als varint (1–2 Byte) direkt davor
    if (st >= 2 && (d[st - 2] & 0x80)) { if (!b1) return 0; L = (d[st - 2] & 0x7F) | ((size_t)b1 << 7); lb = 2; }
    if (L < plen || L > 4096 || st + L > len) return 0;
    if (!LuckyLangRestOk(d + st + plen, L - plen, false)) return 0;
    const size_t kend = st - lb;                           // Schlüssel davor: [Länge][Bezeichner], Länge genau passend
    size_t r = 0;
    while (r < 64 && r < kend && LuckyLangKeyChar(d[kend - 1 - r])) ++r;
    for (size_t kl = 3; kl <= r && kl < kend; ++kl) {
        if (d[kend - 1 - kl] != kl) continue;
        for (size_t i = kend - kl; i < kend; ++i) if (LuckyLangAlpha(d[i])) return 2;
    }
    return (lb == 2 || b1 < 0x20) ? 1 : 0;                 // ohne Schlüssel nur mit klarer Längenangabe (kein druckbares Zeichen)
}
// UTF-16 (st = Textanfang): Il2Cpp-String [klass][monitor 0][Länge][Text][00 00], 8-Byte-ausgerichtet
static int LuckyLangCtx16(const unsigned char* d, size_t len, size_t st, size_t plen) {
    if (st < 20 || ((st - 20) & 7)) return 0;
    const size_t o = st - 20;
    unsigned long long k = 0, mon = 0; int n = 0;
    memcpy(&k, d + o, 8); memcpy(&mon, d + o + 8, 8); memcpy(&n, d + o + 16, 4);
    if (k == 0 || (k & 7) || (k >> 47) || mon != 0 || n < (int)(plen / 2) || n > 2048) return 0;
    const size_t e = st + 2 * (size_t)n;
    if (e + 2 > len || d[e] || d[e + 1]) return 0;
    if (!LuckyLangRestOk(d + st + plen, e - st - plen, true)) return 0;
    const size_t sz = (20 + 2 * (size_t)n + 2 + 15) / 16 * 16, o2 = o + sz;   // Schlüssel-Objekt genau darüber?
    if (o2 + 22 <= len) {
        unsigned long long k2 = 0, mon2 = 1; int n2 = 0;
        memcpy(&k2, d + o2, 8); memcpy(&mon2, d + o2 + 8, 8); memcpy(&n2, d + o2 + 16, 4);
        if (k2 == k && mon2 == 0 && n2 >= 3 && n2 <= 64 && (20 + 2 * (size_t)n2 + 2 + 15) / 16 * 16 == sz && o2 + 22 + 2 * (size_t)n2 <= len &&
            !d[o2 + 20 + 2 * (size_t)n2] && !d[o2 + 21 + 2 * (size_t)n2]) {
            bool key = true, letter = false;
            for (int i = 0; i < n2 && key; ++i) {
                const unsigned char lo = d[o2 + 20 + 2 * (size_t)i], hi = d[o2 + 21 + 2 * (size_t)i];
                if (hi || !LuckyLangKeyChar(lo)) key = false;
                letter = letter || LuckyLangAlpha(lo);
            }
            if (key && letter) return 2;
        }
    }
    return 1;
}
// 2 = Spieltext-Tabelle, 1 = eigenständiger String, 0 = sonstiges, -1 = Chat
static int LuckyLangContext(const unsigned char* d, size_t len, size_t st, size_t plen, bool u16) {
    const int c = u16 ? LuckyLangCtx16(d, len, st, plen) : LuckyLangCtx8(d, len, st, plen);
    if (c > 0 && LuckyLangNearChat(d, len, st)) return -1;
    return c;
}
static bool LuckyProbeScanTab(const LuckyProbeTables& tb, const unsigned char* d, size_t len, unsigned char* mask, unsigned char* weak, LuckyProbeStats* ps) {
    bool newHit = false;
    const size_t m = tb.m;
    for (size_t pos = m - 1; pos < len; ) {                // pos = letztes Byte des Fensters
        const unsigned k = d[pos - 1] | ((unsigned)d[pos] << 8);
        const unsigned sh = tb.shift[k];
        if (sh) { pos += sh; continue; }
        const size_t st = pos + 1 - m;                     // möglicher Textanfang
        for (unsigned p1 = tb.head[k]; p1; p1 = tb.next[p1 - 1]) {
            const size_t p = p1 - 1;
            if (tb.len[p] > len - st || tb.label[p] < 0) continue;
            if (memcmp(d + st, tb.pat[p].data(), tb.len[p]) != 0) continue;
            const int c = LuckyLangContext(d, len, st, tb.len[p], tb.u16);   // Fix 57
            if (ps) { ++ps->raw; if (c == 2) ++ps->table; else if (c == 1) ++ps->plain; else if (c < 0) ++ps->chat; else ++ps->other; }
            if (c == 2) { if (!(mask[tb.label[p]] & tb.bit[p])) { mask[tb.label[p]] |= tb.bit[p]; newHit = true; } }
            else if (c == 1 && weak) weak[tb.label[p]] |= tb.bit[p];
        }
        ++pos;
    }
    return newHit;
}
// Durchsucht einen gelesenen Block. Rückgabe: sichere Sprache (Paar aus Spieltext-Tabellen) oder -1.
// Fix 57: kein Entfernen von U+200B mehr (Spieltexte enthalten keine; die Umgebungsprüfung braucht die echten Offsets);
// t16 = UTF-16-Tabellen (nur während der Probe angelegt), weak = Treffer der schwachen Stufe.
static int LuckyProbeScanBuf(char* data, size_t len, unsigned char* mask, unsigned char* weak = nullptr,
    const LuckyProbeTables* t16 = nullptr, LuckyProbeStats* ps = nullptr) {
    const unsigned char* d = (const unsigned char*)data;
    bool newHit = LuckyProbeScanTab(LuckyProbeTab(), d, len, mask, weak, ps);
    if (t16 && LuckyProbeScanTab(*t16, d, len, mask, weak, ps)) newHit = true;
    return newHit ? LuckyProbeDecide(mask, false) : -1;
}
struct LuckyProbeResult {
    int label = -1;
    unsigned char mask[LUCKY_PROBE_NLANG] = {};
    unsigned char weak[LUCKY_PROBE_NLANG] = {};            // Fix 57: schwache Stufe
    int how = 0;                                           // Fix 57: 1 = Tabelle, 2 = eigenständiger String
    LuckyProbeStats stats;
    unsigned long long bytes = 0;
    unsigned long long ms = 0;
    size_t regions = 0;
    bool noAccess = false, aborted = false;
};
// Ganzer Speicher eines geöffneten Prozesses (gleiche Bereiche wie der Dig-Scan: MEM_COMMIT, MEM_PRIVATE, PAGE_READWRITE)
static void LuckyProbeScanProcess(HANDLE h, LuckyProbeResult& r) {
    SYSTEM_INFO sys; GetSystemInfo(&sys);
    uintptr_t addr = (uintptr_t)sys.lpMinimumApplicationAddress;
    const uintptr_t end = (uintptr_t)sys.lpMaximumApplicationAddress;
    std::vector<char> buf(LUCKY_PROBE_CHUNK);
    std::unique_ptr<LuckyProbeTables> t16(new (std::nothrow) LuckyProbeTables(true));   // Fix 57: nur während der Probe (~130 KB)
    MEMORY_BASIC_INFORMATION mbi;
    while (addr < end) {
        if (VirtualQueryEx(h, (LPCVOID)addr, &mbi, sizeof(mbi)) == 0) break;
        const uintptr_t next = (uintptr_t)mbi.BaseAddress + mbi.RegionSize;
        if (next <= addr) break;
        if (mbi.State == MEM_COMMIT && mbi.Type == MEM_PRIVATE && (mbi.Protect & 0xFF) == PAGE_READWRITE && !(mbi.Protect & PAGE_GUARD)) {
            ++r.regions;
            uintptr_t a = (uintptr_t)mbi.BaseAddress;
            SIZE_T remaining = mbi.RegionSize;
            while (remaining > 0) {
                if (g_luckyDigConfirmed.load()) { r.aborted = true; return; }
                SIZE_T n = std::min<SIZE_T>(remaining, LUCKY_PROBE_CHUNK);
                SIZE_T got = 0;
                BOOL ok = ReadProcessMemory(h, (LPCVOID)a, buf.data(), n, &got);
                if (!ok && GetLastError() == ERROR_PARTIAL_COPY && got > 0) ok = TRUE;
                if (ok && got > 0) {
                    r.bytes += got;
                    int l = LuckyProbeScanBuf(buf.data(), (size_t)got, r.mask, r.weak, t16.get(), &r.stats);
                    if (l >= 0) { r.label = l; r.how = 1; return; }
                }
                if (n == remaining || n <= LUCKY_PROBE_OVERLAP) break;
                a += n - LUCKY_PROBE_OVERLAP;                 // Blöcke überlappen (Text über die Blockgrenze)
                remaining -= n - LUCKY_PROBE_OVERLAP;
                Sleep(0);                                      // Dig-Thread nicht ausbremsen
            }
        }
        addr = next;
        Sleep(0);
    }
    r.label = LuckyProbeDecide(r.mask, true);
    if (r.label >= 0) r.how = 1;
    else if ((r.label = LuckyProbeDecideWeak(r.weak)) >= 0) r.how = 2;   // Fix 57: Ersatz nur ohne Tabellen-Ergebnis
}
// Fix 57: Zusammenfassung des letzten Versuchs (Probe-Thread schreibt vor g_luckyProbeNews, Worker liest danach)
struct LuckyProbeLast { DWORD pid; int attempt, label, how; unsigned raw, table, plain, chat, other, mb, ms; };
static LuckyProbeLast g_luckyProbeLast = {};
static void LuckyProbeThread() {
    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
    static const unsigned long long RETRY_MS[] = { 2000, 3000, 5000, 10000, 15000, 30000, 60000 };
    DWORD lastPid = 0;
    int attempts = 0;
    bool done = true;
    unsigned long long nextTry = 0;
    for (;;) {
        const DWORD pid = GetPIDByName(L"LastWar.exe");
        unsigned long long now = GetTickCount64();
        if (pid != lastPid) {                                  // Spiel gestartet / beendet / neu gestartet
            lastPid = pid; attempts = 0; nextTry = now; done = (pid == 0);
            g_luckyProbeLabel = -1;
            g_luckyDigConfirmed = false;
        }
        if (!done && g_luckyDigConfirmed.load()) done = true;
        if (!done && now >= nextTry) {
            g_luckyProbeHoldUntil = now + LUCKY_PROBE_HOLD_MS;
            g_luckyProbeBusy = true;
            LuckyProbeResult r;
            HANDLE h = OpenProcess(PROCESS_VM_READ | PROCESS_QUERY_INFORMATION, FALSE, pid);
            if (h) { LuckyProbeScanProcess(h, r); CloseHandle(h); }
            else r.noAccess = true;
            r.ms = GetTickCount64() - now;
            ++attempts;
            if (r.label >= 0) g_luckyProbeLabel = r.label;     // vor Busy=false (UI liest danach das Ergebnis)
            g_luckyProbeLast = { pid, attempts, r.label, r.how, r.stats.raw, r.stats.table, r.stats.plain, r.stats.chat, r.stats.other,
                                 (unsigned)(r.bytes >> 20), (unsigned)r.ms };   // Fix 57: eine Log-Zeile im Worker
            const bool giveUp = r.label < 0 && attempts >= LUCKY_PROBE_MAX_TRIES;
            done = r.label >= 0 || r.aborted || giveUp;
            if (!done) nextTry = GetTickCount64() + RETRY_MS[std::min<int>(attempts - 1, (int)(sizeof(RETRY_MS) / sizeof(RETRY_MS[0])) - 1)];
            if (done || attempts == 1) g_luckyProbeNews = true;   // Fix 44: früher Log-Zeile, jetzt nur das Signal
        }
        g_luckyProbeBusy = false;
        Sleep(1000);
    }
}
// Fix 25: g_luckyLang = zuletzt erkannte Sprache, beim ersten Aufruf aus der Registry geladen, damit Geschenke nach einem
// Neustart sofort das richtige Wort bekommen. known = true nur, wenn die Sprach-Probe sie JETZT bestätigt; sonst (gespeicherte
// Sprache oder Ersatz „en“) werden die Zeilen gemerkt und nach dem Probe-Ergebnis ggf. umbenannt.
// Fix 57: Dig-Texte (g_digSlots) entscheiden NICHT mehr – sie stammen aus Chat-Posts beliebiger Mitspieler (jede Sprache).
// Reihenfolge: Probe (nur Spieltexte) > gespeicherte „luckyLang2“ (nur aus der Probe geschrieben) > „en“.
static bool LuckyLangSupported(const std::string& lang) {
    for (const auto& l : LUCKY_LOG_LABELS) if (lang == l.lang) return true;
    return false;
}
static std::string LuckyDetectLang(bool* known = nullptr) {
    if (known) *known = false;
    if (!g_luckyLangLoaded) {
        g_luckyLangLoaded = true;
        std::string saved = LoadLuckyLangSetting();
        if (g_luckyLang.empty() && LuckyLangSupported(saved)) g_luckyLang = saved;
    }
    // Fix 27/57: Ergebnis der Sprach-Probe (aktueller Spielprozess, nur Spieltexte) gilt als bestätigt
    const int pl = g_luckyProbeLabel.load();
    if (pl >= 0 && pl < LUCKY_PROBE_NLANG) {
        if (g_luckyLang != LUCKY_LOG_LABELS[pl].lang) { g_luckyLang = LUCKY_LOG_LABELS[pl].lang; SaveLuckyLangSetting(g_luckyLang); }
        if (known) *known = true;
        return g_luckyLang;
    }
    return g_luckyLang.empty() ? std::string(LUCKY_LANG_DEFAULT) : g_luckyLang;
}
// Fix 25: nur solange Zeilen mit Ersatzwort offen sind (sonst sofort zurück): Sprache bekannt -> UI benennt sie um.
// Kosten: ein atomarer Lesezugriff auf das Probe-Ergebnis, keine Speichersuche (Fix 57: keine Dig-Slots mehr).
static void LuckyCheckRelabel() {
    if (!g_luckyRelabelPending) return;
    bool known = false;
    std::string lang = LuckyDetectLang(&known);
    if (!known) return;
    g_luckyRelabelPending = false;
    PostLuckyRelabel(LuckyLogText(lang));
}
// Text als UTF-8
static std::string WideToUtf8Lucky(const std::wstring& w) {
    if (w.empty()) return std::string();
    int n = WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), nullptr, 0, nullptr, nullptr);
    std::string r(n > 0 ? n : 0, '\0');
    if (n > 0) WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), &r[0], n, nullptr, nullptr);
    return r;
}
// Absendername (roh aus dem Speicher, UTF-8, ggf. mehrfach JSON-escaped) -> UTF-16 fürs Log.
// '\'-Folgen werden zusammengefasst (Escape-Ebenen egal): \uXXXX (auch Surrogat-Paare) -> Zeichen, \" \' \/ \\ -> Zeichen,
// \n \r \t \b \f -> entfernt. Ungültiges UTF-8 -> U+FFFD. Steuer- und Bidi-Steuerzeichen werden entfernt, Leerzeichen
// am Rand gekürzt, höchstens LUCKY_SENDER_MAX Zeichen (Surrogat-Paare werden nie getrennt).
static const size_t LUCKY_SENDER_MAX = 40;
static std::wstring LuckySenderName(std::string_view raw, size_t maxChars = LUCKY_SENDER_MAX) {   // Fix 53: maxChars (Ei-Namen 80)
    auto hex4 = [&](size_t i, unsigned& v) -> bool {
        if (i + 4 > raw.size()) return false;
        v = 0;
        for (size_t k = i; k < i + 4; ++k) {
            char c = raw[k]; v <<= 4;
            if (c >= '0' && c <= '9') v |= (unsigned)(c - '0');
            else if (c >= 'a' && c <= 'f') v |= (unsigned)(c - 'a' + 10);
            else if (c >= 'A' && c <= 'F') v |= (unsigned)(c - 'A' + 10);
            else return false;
        }
        return true;
        };
    // nächste \uXXXX-Folge ab i (beliebig viele '\' davor); Länge in n
    auto uEsc = [&](size_t i, unsigned& v, size_t& n) -> bool {
        size_t k = i; while (k < raw.size() && raw[k] == '\\') ++k;
        if (k == i || k >= raw.size() || raw[k] != 'u' || !hex4(k + 1, v)) return false;
        n = k + 5 - i; return true;
        };
    std::vector<unsigned> cps;
    for (size_t i = 0; i < raw.size(); ) {
        unsigned char c = (unsigned char)raw[i];
        if (c == '\\') {
            unsigned v = 0; size_t n = 0;
            if (uEsc(i, v, n)) {
                i += n;
                if (v >= 0xD800 && v <= 0xDBFF) {
                    unsigned lo = 0; size_t n2 = 0;
                    if (uEsc(i, lo, n2) && lo >= 0xDC00 && lo <= 0xDFFF) { cps.push_back(0x10000 + ((v - 0xD800) << 10) + (lo - 0xDC00)); i += n2; }
                    else cps.push_back(0xFFFD);
                }
                else if (v >= 0xDC00 && v <= 0xDFFF) cps.push_back(0xFFFD);
                else cps.push_back(v);
                continue;
            }
            size_t k = i; while (k < raw.size() && raw[k] == '\\') ++k;
            if (k >= raw.size()) break;                                  // '\' am Ende: weglassen
            char e = raw[k];
            if (e == 'n' || e == 'r' || e == 't' || e == 'b' || e == 'f') { i = k + 1; continue; }
            i = k;                                                       // Zeichen nach dem Escape normal übernehmen
            if (e == '"' || e == '\'' || e == '/') { cps.push_back((unsigned char)e); i = k + 1; }
            continue;
        }
        // UTF-8 dekodieren (streng: keine Überlangen, keine Surrogate, max. U+10FFFF)
        unsigned cp = 0; size_t len = 0;
        if (c < 0x80) { cp = c; len = 1; }
        else if (c >= 0xC2 && c <= 0xDF) { cp = c & 0x1F; len = 2; }
        else if (c >= 0xE0 && c <= 0xEF) { cp = c & 0x0F; len = 3; }
        else if (c >= 0xF0 && c <= 0xF4) { cp = c & 0x07; len = 4; }
        bool ok = len > 0 && i + len <= raw.size();
        for (size_t k = 1; ok && k < len; ++k) {
            unsigned char cc = (unsigned char)raw[i + k];
            if ((cc & 0xC0) != 0x80) ok = false; else cp = (cp << 6) | (cc & 0x3F);
        }
        if (ok && ((len == 3 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) || (len == 4 && (cp < 0x10000 || cp > 0x10FFFF)))) ok = false;
        if (!ok) { cps.push_back(0xFFFD); ++i; continue; }
        cps.push_back(cp); i += len;
    }
    std::vector<unsigned> keep;
    for (unsigned cp : cps) {
        if (cp < 0x20 || (cp >= 0x7F && cp <= 0x9F)) continue;                       // Steuerzeichen
        if (cp == 0x200E || cp == 0x200F || (cp >= 0x202A && cp <= 0x202E) || (cp >= 0x2066 && cp <= 0x2069) ||
            cp == 0x2028 || cp == 0x2029 || cp == 0xFEFF) continue;                    // Bidi-/Zeilen-Steuerzeichen, BOM
        keep.push_back(cp);
    }
    auto isSpace = [](unsigned cp) { return cp == 0x20 || cp == 0xA0 || cp == 0x3000 || (cp >= 0x2000 && cp <= 0x200B); };
    size_t a = 0, b = keep.size();
    while (a < b && isSpace(keep[a])) ++a;
    while (b > a && isSpace(keep[b - 1])) --b;
    std::wstring w;
    size_t chars = 0;
    for (size_t i = a; i < b; ++i) {
        if (chars == maxChars) { w += L"\u2026"; break; }                             // gekürzt: „…“
        unsigned cp = keep[i];
        if (cp >= 0x10000) { cp -= 0x10000; w += (wchar_t)(0xD800 + (cp >> 10)); w += (wchar_t)(0xDC00 + (cp & 0x3FF)); }
        else w += (wchar_t)cp;
        ++chars;
    }
    return w;
}
// ===== Fix 29: Abhol-Zähler aus clientUpdateExtra des Geschenk-Posts ('post':611) =====
// Wert "<Unix-ms letzte Änderung>|<uid>,<uid>,…|<Zahl>": die uid-Liste = alle Abholer (Absender zuerst), ihre Anzahl = „N“
// von „N/20“ im Spiel. Gesamtzahl 20 nur bei goodsId 995002. Zustand nur für GEMELDETE Geschenke (max. LUCKY_CLAIMS_CAP):
// steigt die Zahl, bekommt der UI-Thread NUR die neue Zahl (WM_LUCKYCOUNT).
struct LuckyClaimState { int n = -1; long long ts = 0; int total = 0; unsigned long long tick = 0; bool bannerTotal = false; bool mine = false; };   // Fix 114: mine   // tick = GetTickCount64() der Meldung
static std::unordered_map<std::string, LuckyClaimState> g_luckyClaims;
static std::deque<std::string> g_luckyClaimOrder;
static const size_t LUCKY_CLAIMS_CAP = 200;
// Fix 114: eigene Spieler-uid (nur Worker; je Spielprozess neu gesucht, nie gespeichert)
static std::string g_ownUid;
// Jede gelesene Kopie eines Geschenk-Posts mit clientUpdateExtra (ASCII und UTF-16); unbekannte uuids werden ignoriert
static void LuckyClaimsSeen(const std::string& uuid, int n, long long ts, int total, uintptr_t addr, const char* enc, bool mine = false) {
    (void)addr; (void)enc;                                     // Fix 44: nur noch für das entfernte Debug-Log
    if (n < 0) return;
    auto it = g_luckyClaims.find(uuid);
    if (it == g_luckyClaims.end()) return;
    LuckyClaimState& c = it->second;
    if (mine && !c.mine) { c.mine = true; PostLuckyMine(uuid); }   // Fix 114: eigene uid in irgendeiner Kopie
    if (n < c.n) return;                                       // älterer Stand (andere Kopie) – Zahlen steigen nur
    const bool up = n > c.n || total > c.total;
    if (!up && ts <= c.ts) return;
    c.n = n; c.total = std::max(c.total, total); c.ts = std::max(c.ts, ts);
    if (up) PostLuckyCount(uuid, c.n, c.total);
}
// UTF-16-Suche nur nötig, solange ein gemeldetes Geschenk (letzte 24 h) noch nicht voll ist (N < 20 bzw. Gesamtzahl unbekannt)
static bool LuckyClaimsOpen() {
    const unsigned long long now = GetTickCount64();
    for (const auto& kv : g_luckyClaims)
        if ((kv.second.total <= 0 || kv.second.n < kv.second.total) && now - kv.second.tick < 24ULL * 3600 * 1000) return true;
    return false;
}
static void LuckyReport(const std::string& uuid, const std::string& how, const std::string& rawSender,
    int claims = -1, long long claimTs = 0, int claimTotal = 0, bool mine = false) {
    (void)how;                                 // Fix 44: nur noch für das entfernte Debug-Log
    LuckyCheckRelabel();                       // ältere Ersatzwort-Zeilen zuerst (Reihenfolge der Nachrichten bleibt)
    bool langKnown = false;
    std::string lang = LuckyDetectLang(&langKnown);
    std::string timeStr = now_time_hms();
    std::wstring label = LuckyLogText(lang);
    std::wstring sender = LuckySenderName(rawSender);
    if (!langKnown && g_loggingEnabled.load()) g_luckyRelabelPending = true;
    if (!g_luckyClaims.count(uuid)) {                           // Fix 29: ab jetzt Abhol-Zahl dieses Geschenks verfolgen
        if (g_luckyClaimOrder.size() >= LUCKY_CLAIMS_CAP) { g_luckyClaims.erase(g_luckyClaimOrder.front()); g_luckyClaimOrder.pop_front(); }
        g_luckyClaimOrder.push_back(uuid);
    }
    LuckyClaimState& cs = g_luckyClaims[uuid];
    cs.n = claims; cs.ts = claims >= 0 ? claimTs : 0; cs.total = claimTotal; cs.tick = GetTickCount64();
    AddLuckyLog(std::wstring(timeStr.begin(), timeStr.end()), label, sender, langKnown, uuid, claims, claimTotal);
    if (mine && !cs.mine) { cs.mine = true; PostLuckyMine(uuid, true); }   // Fix 114: schon beim Melden selbst abgeholt
}
// ===== Glücksgeschenk als CHAT-NACHRICHT (einzige Meldequelle) =====
// Beispiel (Teil eines Chat-JSON-Arrays, Anhang escaped in customJsonParam):
// {"appId":"100017",...,"extra":{"customJsonParam":"{\"packetId\":502,\"bigRewardType\":1,\"senderInfo\":{...\"name\":\"MrsRoberts416\"...},
//   \"bigRewardInfo\":{...},\"uuid\":\"61ead681850a402cba8c04c02778acf3\"}","isProxy":1,"post":763,"seqId":182399,"userLang":"en"},
//  "group":"alliance","msg":"?",...,"roomId":"alliance_1036_...","sendTime":1793419730,...}
// Suche ab dem Schlüssel customJsonParam (fix 5). Erlaubte Varianten:
//  - Nachrichten-Quote oq = ' " \' \" (beliebig viele '\'), Anhang als String mit stärker escapetem Quote iq
//    (z. B. \' \\' \\\') oder als unescaptes Objekt {…} (iq = oq)
//  - packetId und uuid an beliebiger Stelle IM Anhang (Anhang max. 12000 Bytes, Ende über Quote-/Klammer-Ebene bestimmt)
//  - roomId + sendTime (Sekunden oder ms) bis 3000 Bytes nach dem Anhang, nur bis zum Ende derselben Nachricht
//    (Klammerebene; spätestens appId/customJsonParam der nächsten Nachricht), ersatzweise zwischen appId derselben Nachricht und customJsonParam (max. 3000 Bytes davor)
// Die uuid (32 Hex, auch 8-4-4-4-12 mit Bindestrichen) muss INNERHALB des customJsonParam-Werts liegen.
// Fix 20: Anhänge mit redPacketServerId/goodsId (frische Geschenke, z. B. „Ich habe gerade 5,000 Diamanten erhalten“)
// werden NICHT mehr verworfen – sie zählen nur, weil sie in einer echten Chat-Nachricht stehen (customJsonParam + roomId +
// sendTime derselben Nachricht + uuid). Das flache RedPacketManager-JSON (ohne customJsonParam/roomId/sendTime) kann
// weiterhin nie gemeldet werden. Abgelehnte Anhänge: out.why = Grund (nur für die Diagnose, siehe LuckyScanChatPosts).
struct LuckyChatPost {
    std::string uuid, sender, roomId, group, seqId, sendTime, variant;
    size_t start = 0, end = 0;     // customJsonParam-Anfang bis sendTime-Ende (für Log-Auszug)
    size_t uuidPos = 0;
    const char* why = nullptr;     // Ablehnungsgrund (nur gesetzt, wenn ein echter Anhang {…} gefunden wurde)
    size_t attBody = 0, attLen = 0;
    int claims = -1;               // Fix 29: Anzahl Abholer aus clientUpdateExtra (-1 = Feld fehlt/ungültig)
    long long claimTs = 0;         // Fix 29: Zeitstempel (Unix-ms) aus clientUpdateExtra
    int claimTotal = 0;            // Fix 29: 20 bei goodsId 995002, sonst 0
    bool mine = false;             // Fix 114: eigene uid steht in der Abholer-Liste
};
// Fix 29: clientUpdateExtra (Quote oq der Nachricht) in w lesen: "<10–13 Ziffern>|<uid>,…|<Ziffern>"; Anzahl = gültige,
// verschiedene uids (nur Ziffern, 5–20 Stellen; leere Liste = 0). Anderer Wert (z. B. "complete") -> false.
static bool LuckyParseClaims(std::string_view w, const std::string& oq, int& n, long long& ts, bool* mine = nullptr) {
    const std::string nk = oq + "clientUpdateExtra" + oq + ":" + oq;
    const size_t q = w.find(nk);
    if (q == std::string_view::npos) return false;
    const size_t vs = q + nk.size();
    const size_t ve = w.find(oq, vs);
    if (ve == std::string_view::npos || ve - vs > 4000) return false;
    const std::string_view v = w.substr(vs, ve - vs);
    const size_t b1 = v.find('|'), b2 = b1 == std::string_view::npos ? b1 : v.find('|', b1 + 1);
    if (b2 == std::string_view::npos || b1 < 10 || b1 > 13 || v.find('|', b2 + 1) != std::string_view::npos) return false;
    auto digits = [](std::string_view d) { return !d.empty() && d.find_first_not_of("0123456789") == std::string_view::npos; };
    if (!digits(v.substr(0, b1)) || !digits(v.substr(b2 + 1)) || v.size() - b2 - 1 > 9) return false;
    long long t = 0;
    for (char c : v.substr(0, b1)) t = t * 10 + (c - '0');
    const std::string_view list = v.substr(b1 + 1, b2 - b1 - 1);
    std::vector<std::string_view> ids;
    size_t a = 0;
    while (!list.empty() && a <= list.size()) {
        size_t e = list.find(',', a);
        if (e == std::string_view::npos) e = list.size();
        const std::string_view id = list.substr(a, e - a);
        if (id.size() < 5 || id.size() > 20 || !digits(id) || ids.size() >= 200) return false;
        if (std::find(ids.begin(), ids.end(), id) == ids.end()) ids.push_back(id);
        a = e + 1;
    }
    n = (int)ids.size(); ts = t;
    if (mine) *mine = !g_ownUid.empty() && std::find(ids.begin(), ids.end(), std::string_view(g_ownUid)) != ids.end();   // Fix 114
    return true;
}
// Anzahl '\' ab Position k (vorwärts) bzw. direkt vor Position k (rückwärts, nicht unter lo)
static size_t LuckyBsRun(std::string_view m, size_t k) {
    size_t n = 0; while (k + n < m.size() && m[k + n] == '\\' && n < 16) ++n; return n;
}
static size_t LuckyBsBefore(std::string_view m, size_t k, size_t lo) {
    size_t n = 0; while (k > lo && m[k - 1] == '\\' && n < 16) { --k; ++n; } return n;
}
// p = Position des Wortes customJsonParam
static bool LuckyParseChatPost(std::string_view m, size_t p, LuckyChatPost& out) {
    static const std::string K = "customJsonParam";
    const size_t kEnd = p + K.size();
    if (kEnd + 8 > m.size()) return false;
    const size_t bo = LuckyBsRun(m, kEnd);
    const char qc = m[kEnd + bo];
    if (qc != '\'' && qc != '"') return false;
    const std::string oq = std::string(bo, '\\') + qc;
    if (p < oq.size() || m.compare(p - oq.size(), oq.size(), oq) != 0 || LuckyBsBefore(m, p - oq.size(), 0) != 0) return false;
    const size_t keyStart = p - oq.size();
    out.start = keyStart;
    auto rej = [&](const char* r) { out.why = r; return false; };
    size_t v = kEnd + oq.size();
    while (v < m.size() && m[v] == ' ') ++v;
    if (v >= m.size() || m[v] != ':') return false;
    ++v;
    while (v < m.size() && m[v] == ' ') ++v;
    if (v >= m.size()) return false;
    bool objForm = false;
    size_t body = 0, attEnd = 0, afterAtt = 0;
    std::string iq;
    if (m.compare(v, oq.size(), oq) == 0 && v + oq.size() < m.size() && m[v + oq.size()] == '{') {
        // String-Form: Anhang endet am ersten Quote qc mit genau bo vorangestellten '\'
        body = v + oq.size();
        const size_t bi = LuckyBsRun(m, body + 1);
        if (body + 1 + bi >= m.size()) return false;
        const char iqc = m[body + 1 + bi];
        if ((iqc != '\'' && iqc != '"') || bi <= bo) return rej("attachment-inner-quoting");
        iq = std::string(bi, '\\') + iqc;
        const size_t lim = std::min(m.size(), body + 12000);
        size_t i = body + 1;
        for (; i < lim; ++i) {
            if (m[i] == '\0') return rej("nul-in-attachment");
            if (m[i] != qc) continue;
            const size_t n = LuckyBsBefore(m, i, body);
            if (n == bo) break;
            if (n < bo) return rej("unescaped-quote-in-attachment");
        }
        if (i >= lim) return rej("attachment-too-long-or-cut");
        attEnd = i - bo;                       // Position des schließenden oq
        afterAtt = attEnd + oq.size();
        if (attEnd == 0 || m[attEnd - 1] != '}') return rej("attachment-no-closing-brace");
    }
    else if (m[v] == '{') {
        // Objekt-Form: passende '}' (Klammern in Strings ignoriert)
        objForm = true; iq = oq; body = v;
        const size_t lim = std::min(m.size(), body + 12000);
        int depth = 0; bool inStr = false; size_t i = body;
        for (; i < lim; ++i) {
            char c = m[i];
            if (c == '\0') return rej("nul-in-attachment");
            if (inStr) { if (c == qc && LuckyBsBefore(m, i, body) == bo) inStr = false; continue; }
            if (c == qc && LuckyBsBefore(m, i, body) == bo) { inStr = true; continue; }
            if (c == '{') ++depth;
            else if (c == '}' && --depth == 0) break;
        }
        if (i >= lim) return rej("attachment-too-long-or-cut");
        attEnd = i + 1; afterAtt = attEnd;
    }
    else {
        return false;
    }
    std::string_view att = m.substr(body, attEnd - body);
    out.attBody = body; out.attLen = att.size();
    // redPacketServerId/goodsId sind erlaubt (frische Geschenke); roomId + sendTime derselben Nachricht bleiben Pflicht (unten)
    const bool rpFields = att.find("redPacketServerId") != std::string_view::npos || att.find("goodsId") != std::string_view::npos;
    // packetId (mit Anhang-Quoting) Pflicht
    if (att.find(iq + "packetId" + iq + ":") == std::string_view::npos) return rej("no-packetId");
    // uuid (32 Hex, oder 36 Zeichen 8-4-4-4-12 -> auf 32 Hex normalisiert, gleicher Duplikatschutz) im Anhang
    const std::string nU = iq + "uuid" + iq + ":" + iq;
    size_t uPos = std::string_view::npos;
    for (size_t u = att.find(nU); u != std::string_view::npos; u = att.find(nU, u + 1)) {
        size_t h = u + nU.size();
        std::string hx;
        if (h + 32 + iq.size() <= att.size() && LuckyHexUuid(att.substr(h, 32), hx) && att.compare(h + 32, iq.size(), iq) == 0) {
            out.uuid = hx; uPos = body + u; break;
        }
        if (h + 36 + iq.size() <= att.size() && att[h + 8] == '-' && att[h + 13] == '-' && att[h + 18] == '-' && att[h + 23] == '-' &&
            att.compare(h + 36, iq.size(), iq) == 0) {
            std::string d;
            for (size_t k = 0; k < 36; ++k) if (k != 8 && k != 13 && k != 18 && k != 23) d += att[h + k];
            if (LuckyHexUuid(d, hx)) { out.uuid = hx; uPos = body + u; break; }
        }
    }
    if (uPos == std::string_view::npos) return rej("no-uuid");
    // Absender: senderInfo.name
    size_t si = att.find(iq + "senderInfo" + iq);
    if (si != std::string_view::npos) {
        const std::string nN = iq + "name" + iq + ":" + iq;
        size_t nn = att.find(nN, si);
        if (nn != std::string_view::npos) {
            size_t vs = nn + nN.size(), ve = att.find(iq, vs);
            while (ve != std::string_view::npos && ve - vs < 200 && LuckyBsBefore(att, ve, vs) > 0) ve = att.find(iq, ve + 1);
            if (ve != std::string_view::npos && ve - vs < 200) out.sender = std::string(att.substr(vs, ve - vs));
        }
    }
    auto field = [&](std::string_view w, const char* k, std::string& val, size_t& endPos) -> bool {
        const std::string nk = oq + k + oq + ":";
        size_t q = w.find(nk);
        if (q == std::string_view::npos) return false;
        size_t vs = q + nk.size(), ve;
        if (w.compare(vs, oq.size(), oq) == 0) { vs += oq.size(); ve = w.find(oq, vs); }
        else { ve = vs; while (ve < w.size() && w[ve] != ',' && w[ve] != '}' && w[ve] != '\\') ++ve; }
        if (ve == std::string_view::npos || ve >= w.size() || ve - vs > 120) return false;
        val = std::string(w.substr(vs, ve - vs)); endPos = ve;
        return true;
        };
    auto sendOk = [&]() { return !out.sendTime.empty() && out.sendTime.size() <= 13 && out.sendTime.find_first_not_of("0123456789") == std::string::npos; };
    // Felder nach dem Anhang, nur innerhalb DERSELBEN Nachricht: Fenster endet an der '}', die das Nachrichten-Objekt
    // schließt (Klammerebene außerhalb von oq-Strings; nach dem Anhang stehen wir in "extra":{…} = Ebene 0,
    // die Nachricht ist Ebene -1, deren Ende -> Ebene -2), spätestens nach 3000 Bytes bzw. am nächsten appId/customJsonParam.
    std::string_view fw = m.substr(afterAtt, std::min<size_t>(m.size() - afterAtt, 3000));
    {
        int depth = 0; bool inStr = false; size_t cut = fw.size();
        for (size_t i = 0; i < fw.size(); ++i) {
            const char c = fw[i];
            if (c == '\0') { cut = i; break; }
            if (c == qc && LuckyBsBefore(fw, i, 0) == bo) { inStr = !inStr; continue; }
            if (inStr) continue;
            if (c == '{') ++depth;
            else if (c == '}' && --depth < -1) { cut = i + 1; break; }   // schließende '}' behalten (sendTime als letztes Feld)
        }
        fw = fw.substr(0, cut);
    }
    size_t bnd = std::min(fw.find(oq + "appId" + oq), fw.find(oq + "customJsonParam" + oq));
    if (bnd != std::string_view::npos) fw = fw.substr(0, bnd);
    // Fix 29: Abhol-Zähler derselben Nachricht (Felder alphabetisch -> clientUpdateExtra vor extra, also zwischen appId und
    // customJsonParam; ersatzweise im Fenster danach). Gesamtzahl 20 nur bei goodsId 995002 im Anhang.
    {
        int cn = -1; long long cts = 0; bool cm = false;
        const size_t lo = keyStart > 3000 ? keyStart - 3000 : 0;
        const size_t ap = m.substr(lo, keyStart - lo).rfind(oq + "appId" + oq);
        bool got = false;
        if (ap != std::string_view::npos) {
            const std::string_view bw = m.substr(lo + ap, keyStart - (lo + ap));
            if (bw.find('\0') == std::string_view::npos && bw.find(oq + "customJsonParam" + oq) == std::string_view::npos) got = LuckyParseClaims(bw, oq, cn, cts, &cm);
        }
        if (!got) got = LuckyParseClaims(fw, oq, cn, cts, &cm);
        if (got) {
            out.claims = cn; out.claimTs = cts; out.mine = cm;
            const std::string g = iq + "goodsId" + iq + ":";
            const size_t gp = att.find(g);
            if (gp != std::string_view::npos) {
                size_t gv = gp + g.size();
                if (att.compare(gv, iq.size(), iq) == 0) gv += iq.size();
                if (att.compare(gv, 6, "995002") == 0 && (gv + 6 >= att.size() || !std::isdigit((unsigned char)att[gv + 6]))) out.claimTotal = 20;
            }
        }
    }
    size_t eRoom = 0, eSend = 0, eTmp = 0;
    bool fwd = field(fw, "roomId", out.roomId, eRoom) && field(fw, "sendTime", out.sendTime, eSend) && !out.roomId.empty() && sendOk();
    bool bwd = false;
    if (!fwd) {
        // Ersatz: Felder vor dem Anhang, ab appId derselben Nachricht (max. 3000 Bytes zurück, ohne Nachrichtengrenze dazwischen)
        out.roomId.clear(); out.sendTime.clear();
        size_t lo = keyStart > 3000 ? keyStart - 3000 : 0;
        size_t ap = m.substr(lo, keyStart - lo).rfind(oq + "appId" + oq);
        if (ap != std::string_view::npos) {
            std::string_view bw = m.substr(lo + ap, keyStart - (lo + ap));
            if (bw.find('\0') == std::string_view::npos && bw.find(oq + "customJsonParam" + oq) == std::string_view::npos) {
                size_t e1 = 0, e2 = 0;
                bwd = field(bw, "roomId", out.roomId, e1) && field(bw, "sendTime", out.sendTime, e2) && !out.roomId.empty() && sendOk();
            }
        }
        if (!bwd) return rej("no-roomId/sendTime-in-same-message");
    }
    if (fwd) { field(fw, "seqId", out.seqId, eTmp); field(fw, "group", out.group, eTmp); }
    // Fix 22: Anhang ohne eigenes senderInfo.name (Chat-Post 'post':611 mit flachem Paket-Anhang): Absender aus dem
    // äußeren 'senderInfo':{…'userName':'X'} DERSELBEN Nachricht (nur im Fenster fw, das an Nachrichtenende bzw.
    // nächstem appId/customJsonParam endet). Quoting wie die Nachricht (oq, auch "…"); Dekodierung wie bisher (LuckySenderName).
    if (out.sender.empty() && fwd) {
        const std::string nS = oq + "senderInfo" + oq + ":{";
        const size_t so = fw.find(nS);
        if (so != std::string_view::npos) {
            size_t oe = so + nS.size(); int depth = 1; bool inStr = false;
            for (; oe < fw.size(); ++oe) {                      // Ende des senderInfo-Objekts (Klammerebene außerhalb von oq-Strings)
                const char c = fw[oe];
                if (c == qc && LuckyBsBefore(fw, oe, 0) == bo) { inStr = !inStr; continue; }
                if (inStr) continue;
                if (c == '{') ++depth;
                else if (c == '}' && --depth == 0) break;
            }
            std::string_view sv = fw.substr(so, oe - so);
            const std::string nN = oq + "userName" + oq + ":" + oq;
            const size_t nn = sv.find(nN);
            if (nn != std::string_view::npos) {
                const size_t vs = nn + nN.size();
                size_t ve = vs;
                for (; ve < sv.size() && ve - vs < 200; ++ve)
                    if (sv[ve] == qc && LuckyBsBefore(sv, ve, vs) == bo) break;
                if (ve < sv.size() && ve - vs < 200 && ve >= vs + bo) out.sender = std::string(sv.substr(vs, ve - bo - vs));
            }
        }
    }
    // Anhang mit redPacketServerId/goodsId nur als echter Geschenk-Post (Absender innen oder außen), nie als flaches Paket-JSON
    if (rpFields && out.sender.empty()) return rej("rpFields-without-senderInfo");
    out.start = keyStart; out.end = fwd ? afterAtt + std::max(eRoom, eSend) : afterAtt;
    out.uuidPos = uPos;
    out.variant = "oq=" + LuckySafe(oq, 8) + " iq=" + LuckySafe(iq, 8) + (objForm ? " object" : "") + (bwd ? " fieldsBefore" : "") + (rpFields ? " rpFields" : "");
    return true;
}
// ===== Fix 44: Ei (Goldenes Ei / Telur Emas) als CHAT-NACHRICHT – gleicher Parser wie Lucky Gift =====
// Fix 47: Einordnung über die FAMILIE (GiftPostKind): Im Spiel ist jedes Rotpaket („red_pocket_…“) ein Goldenes Ei; das
// Glücksgeschenk ist das einzige Paket mit packetId 502 (alle echten Lucky Gifts in luckygift/log1–15, egg/log1–2: packetId 502,
// Post 611 mit goodsId 995002 bzw. Banner 763 ohne goodsId). Eier: packetId 401 (goodsId 670001 Geburtstag), packetId 1
// (goodsId 653052 Diamant). Also: packetId 502 (goodsId fehlt/995002) = Lucky Gift (unverändert), jede andere packetId mit
// goodsId/redPacketServerId oder Banner = Ei (auch unbekannte Sorten), Rest = weder noch (nicht gemeldet).
// Abhol-Banner (bigRewardInfo/bigRewardType, z. B. Post 616 „hat alle goldenen Eier erhalten“) sind KEIN neues Ei (DETECT BANNER).
// Gesamtzahl je Ei aus den Daten (totalNum/totalCount/maxNum/maxCount/packetNum/total, 1..999), sonst aus EGG_ID_RULES
// (je goodsId, belegt durch Spiel-Screenshots), sonst unbekannt (0, Log zeigt nur „N“).
// Duplikatschutz über die uuid (eigene Menge);
// in der Start-Verzögerung gesehene Eier gelten als alt. Abhol-Zahl live wie Lucky (gleiche UI-Nachricht WM_LUCKYCOUNT).
struct EggIdRule { const char* key; const char* value; int total; const char* nameKey; };   // value mit Leerzeichen = Text im Anhang; nameKey: Fix 47
static const EggIdRule EGG_ID_RULES[] = {
    // Fix 47: NUR noch Gesamtzahl je Ei-Sorte (die Erkennung selbst läuft über die Familie, siehe GiftPostKind).
    // Fix 46 (Ei-Log log1): {"packetId":401,"goodsId":670001,…}, item_name670001 = „Goldenes Ei (Geburtstag)“, Karte 16/40.
    // Fix 47 (Ei-Log log2): {"packetId":1,"goodsId":653052,…}, item_desc653052_1 = „Ein goldenes Ei, das Diamanten
    //   enthält“, Karte „Goldenes Ei (Diamant)“ 20/20. Kein Gesamtzahl-Feld in den Daten -> Zahl je goodsId aus dem Screenshot.
    // Fix 47 (Name): nameKey = Text-Schlüssel des Spiels für den Karten-Titel (Diamant: item_name653070_1, kein item_name653052 in log1–3).
    { "goodsId", "670001", 40, "item_name670001" },         // Goldenes Ei (Geburtstag), 40 Abholungen
    { "goodsId", "653052", 20, "item_name653070_1" },       // Goldenes Ei (Diamant), 20 Abholungen
    // Fix 49 (egg log8/log9/log10): jedes Ei dieser Sorten endete mit Abhol-Banner bei n=20 (log9: 660100 x11, 660101 x7,
    //   660102 x5, 660103 x10, 666801 x1, 650049 x1; log10: 653074 x60, 666801 x3; log11: 653074 x40, 650049 x3, 650048 x2); Karten-Screenshots: Steuer Lv. 4 20/20,
    //   Champion 20/20, „Belohnung des Eroberers“ 20/20. Kein Gesamtzahl-Feld in den Daten. 650049 nur 1 Ei belegt (Banner bei 20).
    { "goodsId", "660100", 20, "item_name_650045" },   // Fix 63: Spiel-Schlüssel Steuer Lv1 (sprachunabhängig)                   // Goldenes Ei (Steuer), Stufe laut Karte
    { "goodsId", "660101", 20, "item_name_650046" },   // Fix 63: Spiel-Schlüssel Steuer Lv2 (sprachunabhängig)                   // Goldenes Ei (Steuer)
    { "goodsId", "660102", 20, "item_name_650047" },   // Fix 63: Spiel-Schlüssel Steuer Lv3 (sprachunabhängig)                   // Goldenes Ei (Steuer)
    { "goodsId", "660103", 20, "item_name_650048" },   // Fix 63: Spiel-Schlüssel Steuer Lv4 (sprachunabhängig)                   // Lv. 4 Goldenes Ei (Steuer)
    { "goodsId", "666801", 20, "s6_minigame_item_name1" },  // Fix 55: Spiel-Schlüssel (log16: UTF-16 Wert direkt unter dem Schlüssel)                   // Goldenes Ei des Champions
    { "goodsId", "653074", 20, "zone_war_government_12" }, // Fix 57: Spiel-Schlüssel (log23: UTF-8-Tabelle + UTF-16-Wert direkt unter dem Schlüssel) – Belohnung des Eroberers (packetId 100)
    { "goodsId", "650049", 20, nullptr },                   // packetId 205 (log9 1 + log11 3 Eier, alle Banner bei 20)
    { "goodsId", "650077", 20, "item_name_650047" },   // Fix 65: packetId 208, Karte (de) = Lv. 3 Goldenes Ei (Steuer)
    { "goodsId", "650084", 20, "item_name_650046" },   // Fix 64: packetId 342, Karte (fr) = Steuer Niv.2 (gleicher Text wie 650046)
    { "goodsId", "650085", 20, "item_name_650047" },   // Fix 64: packetId 343, Karte (fr) = Steuer Niv.3 (gleicher Text wie 650047)
    { "goodsId", "650048", 20, nullptr },                   // packetId 204 (log11: 2 Eier, beide Banner bei 20)
    { nullptr, nullptr, 0, nullptr }                        // Ende der Liste
};
static const char* const EGG_TOTAL_KEYS[] = { "totalNum", "totalCount", "maxNum", "maxCount", "packetNum", "total" };
// Wert (Zahl/Wort) zum Schlüssel key im Anhang, beliebige Quote-Escapes ("k":v, \"k\":\"v\", 'k':'v'); leer = fehlt
static std::string EggAttValue(std::string_view a, const char* key) {
    const size_t n = strlen(key);
    for (size_t p = a.find(key); p != std::string_view::npos; p = a.find(key, p + 1)) {
        if (p == 0 || (a[p - 1] != '"' && a[p - 1] != '\'')) continue;
        size_t q = p + n;
        int g = 0;
        while (q < a.size() && (a[q] == '"' || a[q] == '\'' || a[q] == '\\') && g < 8) { ++q; ++g; }
        if (g == 0 || q >= a.size() || a[q] != ':') continue;
        ++q;
        while (q < a.size() && (a[q] == ' ' || a[q] == '"' || a[q] == '\'' || a[q] == '\\')) ++q;
        size_t e = q;
        while (e < a.size() && e - q < 80 && (isalnum((unsigned char)a[e]) || a[e] == '_' || a[e] == '-')) ++e;
        if (e > q) return std::string(a.substr(q, e - q));
    }
    return std::string();
}
static const EggIdRule* EggMatchRule(std::string_view att) {
    for (int k = 0; EGG_ID_RULES[k].key; ++k) {
        const EggIdRule& r = EGG_ID_RULES[k];
        if (strchr(r.value, ' ') ? att.find(r.value) != std::string_view::npos : EggAttValue(att, r.key) == r.value) return &r;
    }
    return nullptr;
}
static int EggTotalFromData(std::string_view att, const EggIdRule* r, const char** src) {
    for (const char* k : EGG_TOTAL_KEYS) {
        const std::string v = EggAttValue(att, k);
        if (v.empty() || v.size() > 3 || v.find_first_not_of("0123456789") != std::string::npos) continue;
        const int t = atoi(v.c_str());
        if (t >= 1 && t <= 999) { *src = k; return t; }
    }
    if (r && r->total > 0) { *src = "rule"; return r->total; }
    *src = "unknown";
    return 0;
}
// Fix 50: KEIN Ablauf-Filter (Fix 49 entfernt): jedes Ei wird gemeldet, auch abgelaufene aus dem Chat-Verlauf –
// aber jede uuid nur einmal je Sitzung (g_eggSeenHex, auch nach Scrollen/erneutem Durchlauf).
static bool EggIsBanner(std::string_view att) {
    return att.find("bigRewardInfo") != std::string_view::npos || att.find("bigRewardType") != std::string_view::npos ||
        att.find("Saya mendapatkan") != std::string_view::npos;
}
// Fix 47: Art eines (vom Parser angenommenen) Geschenk-Posts nach seiner Familie
enum GiftKind { GIFT_LUCKY, GIFT_EGG, GIFT_OTHER };
static GiftKind GiftPostKind(std::string_view att) {
    const std::string pk = EggAttValue(att, "packetId"), gid = EggAttValue(att, "goodsId");
    if (pk == "502") return (gid.empty() || gid == "995002") ? GIFT_LUCKY : GIFT_OTHER;   // Lucky Gift: nur bekannte Kennung
    if (pk.empty()) return GIFT_OTHER;
    if (!gid.empty() || att.find("redPacketServerId") != std::string_view::npos || EggIsBanner(att)) return GIFT_EGG;
    return GIFT_OTHER;
}

// Fix 47: voller Ei-Name wie auf der Karte im Chat, aus der geladenen Lokalisierung des Spiels (jede Spielsprache).
// Format im Speicher (UTF-8-Tabelle, belegt in Ei-Log log1/log2/log3):
//   [Schlüssellänge 1 Byte][Schlüssel][Textlänge varint][Text], z. B. 0F "item_name670001" 18 "Goldenes Ei (Geburtstag)",
//   11 "item_name653070_1" 15 "Goldenes Ei (Diamant)".
// Schlüssel je goodsId: nameKey aus EGG_ID_RULES, sonst item_name<goodsId>; zweite Wahl item_name<goodsId> bzw. item_name<goodsId>_1.
// Fix 52: dritte Wahl item_name_<goodsId> (Spiel-Format mit „_“, belegt egg log2–13: „item_name_650049“ -> „Lv. 5 Goldenes Ei (Steuer)“,
//   „item_name_650048“ -> „Lv. 4 Goldenes Ei (Steuer)“; vorher nie gesucht -> 650049 blieb ohne Namen).
// Gesucht wird nur, solange ein Name fehlt: je gelesenem Block EINE Suche nach „item_name“ (gleicher Scan, kein eigener Lauf).
// Fix 48: Die Tabelle lädt das Spiel erst SPÄT (live log4: Geburtstag/Diamant erst ~30 s nach der Meldung in Bereich
// 0x338EA0000, „item_name653070_1“ bei 0x3391E4672) -> KEIN endgültiges Aufgeben mehr:
//   - Sorte schon gemeldet und ohne Namen: jeder volle Durchlauf sucht (bis gefunden);
//   - bekannte, noch nie gesehene Sorte: die ersten EGG_NAME_START_FULL vollen Durchläufe, danach jeder EGG_NAME_IDLE_EVERY-te;
//   - ein Ei wartet auf seinen Namen (EggHeld): jeder Durchlauf sucht, der nächste Durchlauf ist voll (EggNameWantsFullScan).
// Hot-Durchläufe ohne wartendes Ei suchen nicht. Nicht gefunden -> Wort „Ei“ der Spielsprache, Zeile wird später umbenannt.
// Cache: höchstens EGG_NAME_CAP Sorten.
static bool EggWordIn(std::string_view t);   // Fix 67
struct EggNameSlot {
    std::string goodsId; std::string keys[3]; std::wstring name; int prio = 3; bool done = false; bool seen = false; bool fresh = false; bool cached = false;
    unsigned at8[3] = {}, at16[3] = {}, raw[3] = {}, bad[3] = {};
    std::string via;
    bool stored = false;
    std::string lang;                       // Fix 60: Spielsprache (Probe), unter der der Name gilt; leer = noch nicht bestätigt
    std::string oldLang; std::wstring oldName;   // Fix 60: gespeicherter Name einer ANDEREN Sprache (Kopie im Speicher nie nehmen)
    unsigned oldSkipFull = 0;
    std::wstring guess[3]; unsigned guessPass[3] = {};                  // Fix 61: Wert direkt NACH dem Schlüssel (nur Ersatz)
    unsigned long long refKey[3] = {}, refKlass[3] = {};       // Fix 61: Adresse/Klasse des UTF-16-Schlüssel-Objekts ohne Wert darunter
    std::vector<unsigned long long> refVal[3];
};             // Fix 61: Wert-Zeiger aus Einträgen {Schlüssel-Zeiger, Wert-Zeiger}   // Fix 60: erster volle Durchlauf, in dem nur diese alte Kopie gefunden wurde   // Fix 57: Name schon mit vertrauter Spielsprache gespeichert   // Fix 56: Diagnose-Schlüssel (nur Log)   // Fix 55: Herkunft, wenn nicht über einen Schlüssel (Stufen-Geschwister)   // Fix 53: je Schlüssel und Such-Durchlauf: UTF-8-Tabelle / UTF-16-Objekt / anderes Format / Wert verworfen
static const size_t EGG_NAME_CAP = 32;
static const unsigned EGG_NAME_START_FULL = 30;   // Fix 49: 3 -> 30 (log11: Tabelle nur kurz nach dem Start lesbar)
static const unsigned EGG_NAME_IDLE_EVERY = 6;
static std::vector<EggNameSlot> g_eggNames;
static unsigned g_eggNamePassNo = 0, g_eggNameFullPasses = 0;   // 0 = Worker hat noch keinen Durchlauf begonnen (dann nie warten)
static bool g_eggNameScanPass = false;                          // dieser Durchlauf sucht Namen
static bool g_eggNameHoldOpen = false;                          // mind. ein Ei wartet auf seinen Namen
struct EggNameStats { unsigned long long chunks = 0, bytes = 0, hits = 0, lenByte = 0, otherKey = 0, value = 0, text = 0, found = 0, hits16 = 0, keys16 = 0, found16 = 0; };
static EggNameStats g_eggNameStats;
static bool EggNamePending(const EggNameSlot& s) { return !s.done; }
static std::string EggLangNow();
// Fix 60: Spielsprache NUR aus der Sprach-Probe dieses Spielprozesses (leer = noch unbekannt). „luckyLang2“ allein kann von
// einer früheren Sitzung stammen (log25: Spiel auf Englisch umgestellt, gespeichert 'de' -> deutsche Ei-Namen aus dem Cache).
static std::string EggLangConfirmed() {
    const int i = g_luckyProbeLabel.load();
    if (i >= 0 && i < (int)(sizeof(LUCKY_LOG_LABELS) / sizeof(LUCKY_LOG_LABELS[0]))) return LUCKY_LOG_LABELS[i].lang;
    return std::string();
}
// Fix 60: Text = gespeicherter Name einer anderen Sprache als der bestätigten (z. B. deutscher Rest im Speicher nach dem Umstellen)?
// Wird nur übersprungen, solange in den nächsten 3 vollen Durchläufen eine andere Kopie gefunden werden kann (gleicher Text in
// beiden Sprachen bleibt so möglich).
static const unsigned EGG_OLD_LANG_SKIP_FULL = 3;
static bool EggNameOldLang(EggNameSlot& s, const std::wstring& w) {
    const std::string now = EggLangConfirmed();
    if (now.empty() || s.oldName.empty() || s.oldLang == now || w != s.oldName) return false;
    if (!s.oldSkipFull) s.oldSkipFull = g_eggNameFullPasses ? g_eggNameFullPasses : 1;
    if (g_eggNameFullPasses >= s.oldSkipFull + EGG_OLD_LANG_SKIP_FULL) return false;
    return true;
}
// Fix 67: log37 (id) – unter item_name670001 lag 64 Bytes tiefer der Nachbar-Text „Tingkatkan Bar Tanker“ statt
// „Telur Emas Ulang Tahun“. Ein Wert zu einem item_name-Schlüssel muss ein Ei-Wort enthalten, sonst verworfen (Suche geht weiter).
// Champion/Eroberer (andere Schlüssel) werden nicht geprüft.
static void EggRefKey(EggNameSlot& s, int k, unsigned long long addr, unsigned long long klass);   // Fix 67
static bool EggNameNoEggWord(const EggNameSlot& s, const std::string& key, const std::wstring& w) {
    (void)s;
    if (key.compare(0, 9, "item_name") != 0) return false;
    const std::string u = WideToUtf8Lucky(w);
    if (EggWordIn(u)) return false;
    return true;
}
// Fix 57: gespeicherten Namen nur mit der VERTRAUTEN Spielsprache übernehmen
// Fix 60: vertraut = NUR die Sprach-Probe dieses Spielprozesses (nicht mehr „luckyLang2“ allein, kann veraltet sein)
static bool EggNameTryCache(EggNameSlot& s, const std::string& now) {
    std::string lang;
    std::wstring cached;
    if (!LoadEggNameSetting(s.goodsId, lang, cached) || cached.empty()) return false;
    if (now.empty() || lang != now) { s.oldLang = lang; s.oldName = cached; return false; }   // Fix 60: Sprache anders/unbekannt
    if (s.keys[0].compare(0, 9, "item_name") == 0 && !EggWordIn(WideToUtf8Lucky(cached))) return false;   // Fix 67: falscher alter Name
    s.name = cached; s.prio = 0; s.done = true; s.cached = true; s.stored = true; s.lang = lang;
    return true;
}
static EggNameSlot* EggNameAdd(const std::string& gid, const char* nameKey) {
    if (gid.empty() || gid.size() > 12 || gid.find_first_not_of("0123456789") != std::string::npos || g_eggNames.size() >= EGG_NAME_CAP) return nullptr;
    EggNameSlot s;
    s.goodsId = gid;
    s.keys[0] = nameKey ? std::string(nameKey) : "item_name" + gid;
    s.keys[1] = (nameKey && s.keys[0] != "item_name" + gid) ? "item_name" + gid : "item_name" + gid + "_1";
    s.keys[2] = "item_name_" + gid;                            // Fix 52
    g_eggNames.push_back(std::move(s));
    EggNameTryCache(g_eggNames.back(), EggLangConfirmed());    // Fix 49/57/60: Name aus einer früheren Sitzung (nur mit bestätigter Spielsprache)
    return &g_eggNames.back();
}
static void EggNamesInit() {
    if (!g_eggNames.empty()) return;   // Regeln mit goodsId sind sofort gesucht (schon im Start-Durchlauf)
    for (int i = 0; EGG_ID_RULES[i].key; ++i)
        if (!strcmp(EGG_ID_RULES[i].key, "goodsId")) EggNameAdd(EGG_ID_RULES[i].value, EGG_ID_RULES[i].nameKey);
}
static EggNameSlot* EggNameSlotFor(const std::string& gid) {
    EggNamesInit();
    for (auto& s : g_eggNames) if (s.goodsId == gid) return &s;
    return EggNameAdd(gid, nullptr);
}
// Text = gültiges UTF-8 ohne Steuerzeichen und ohne Markup
static bool EggNameTextOk(std::string_view v) {
    for (size_t i = 0; i < v.size(); ) {
        const unsigned char c = (unsigned char)v[i];
        if (c < 0x20 || c == 0x7F || c == '<' || c == '>' || c == '{' || c == '}' || c == '\\') return false;
        size_t len = c < 0x80 ? 1 : (c >= 0xC2 && c <= 0xDF) ? 2 : (c >= 0xE0 && c <= 0xEF) ? 3 : (c >= 0xF0 && c <= 0xF4) ? 4 : 0;
        if (!len || i + len > v.size()) return false;
        for (size_t k = 1; k < len; ++k) if (((unsigned char)v[i + k] & 0xC0) != 0x80) return false;
        i += len;
    }
    return !v.empty();
}
// Fix 48: Beginn eines Durchlaufs (WorkerThread, nach der Bereichsauswahl): sucht dieser Durchlauf Namen?
static void EggNameBeginPass(bool fullScan) {
    EggNamesInit();
    ++g_eggNamePassNo;
    if (fullScan) ++g_eggNameFullPasses;
    bool any = false, seen = false;
    for (const auto& s : g_eggNames) if (EggNamePending(s)) { any = true; seen = seen || s.seen; }
    g_eggNameScanPass = any && (g_eggNameHoldOpen || (fullScan && (seen || g_eggNameFullPasses <= EGG_NAME_START_FULL ||
        g_eggNameFullPasses % EGG_NAME_IDLE_EVERY == 0)));
    if (g_eggNameScanPass) {
        g_eggNameStats = EggNameStats();
        for (auto& s : g_eggNames) for (int k = 0; k < 3; ++k) s.at8[k] = s.at16[k] = s.raw[k] = s.bad[k] = 0;   // Fix 53
    }
}
// Fix 48: Ein Ei wartet auf seinen Namen -> nächster Durchlauf voll (statt Hot-Regions), damit die Tabelle sicher gelesen wird
static bool EggNameWantsFullScan() { return g_eggNameHoldOpen; }
// Ei-Wort im (UTF-8-)Text: „…ei“ am Wortende (Ei, Osterei), Eier, egg, Steuer, Champion und das Wort „Ei“ der übrigen Spielsprachen
static bool EggWordIn(std::string_view t) {
    std::string l(t);
    for (char& c : l) if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
    for (size_t p = l.find("ei"); p != std::string::npos; p = l.find("ei", p + 1)) {
        const char n = p + 2 < l.size() ? l[p + 2] : ' ';
        if (!(n >= 'a' && n <= 'z')) return true;
    }
    static const char* W[] = { "eier", "egg", "steuer", "champion", "telur", "huevo", "oeuf", "\xC5\x93uf", "uovo", "ovo", "yumurta", "tr\xE1\xBB\xA9ng",
                               "\xD1\x8F\xD0\xB9\xD1\x86", "\xD0\xAF\xD0\xB9\xD1\x86", "\xE5\x8D\xB5", "\xE8\x9B\x8B", "\xEC\x95\x8C", "\xE0\xB9\x84\xE0\xB8\x82\xE0\xB9\x88",
                               "\xD8\xA8\xD9\x8A\xD8\xB6", "jajko", "huevos", "telor",
                               "\xC5\x92uf", "jajo", "pisank", "\xE3\x82\xA8\xE3\x83\x83\xE3\x82\xB0" };   // Fix 67: Œuf (groß), jajo, pisanka, エッグ
    for (const char* w : W) if (l.find(w) != std::string::npos) return true;
    return false;
}
// Je gelesenem Block (aus LuckyScanChunk): nur in Such-Durchläufen (EggNameBeginPass)
// Fix 55: Such-Schlüssel, in denen „item_name“ NICHT am Anfang steht (666801: „s6_minigame_item_name1“). Gleiche Tabelle
// [Längen-Byte][Schlüssel][Textlänge varint][Text]; der „item_name“-Treffer liegt q Zeichen hinter dem Schlüsselanfang.
static bool EggNameOffsetKey8(std::string_view m, size_t p) {
    bool hit = false;
    for (auto& s : g_eggNames) {
        if (!EggNamePending(s)) continue;
        for (int k = 0; k < 3 && k < s.prio; ++k) {
            const std::string& K = s.keys[k];
            const size_t q = K.find("item_name");
            if (q == 0 || q == std::string::npos || p < q + 1) continue;
            const size_t b = p - q;
            if ((unsigned char)m[b - 1] != K.size() || m.compare(b, K.size(), K) != 0) continue;
            hit = true;
            ++s.at8[k];
            size_t i = b + K.size();
            if (i >= m.size()) { ++s.bad[k]; continue; }
            size_t len = (unsigned char)m[i++];
            if (len & 0x80) { if (i >= m.size()) { ++s.bad[k]; continue; } len = (len & 0x7F) | ((size_t)(unsigned char)m[i++] << 7); }
            if (len < 1 || len > 160 || i + len > m.size()) { ++s.bad[k]; continue; }
            const std::string_view v = m.substr(i, len);
            if (!EggNameTextOk(v)) { ++s.bad[k]; continue; }
            const std::wstring w = LuckySenderName(v, 80);
            if (w.empty()) { ++s.bad[k]; continue; }
            if (EggNameOldLang(s, w)) { ++s.bad[k]; continue; }   // Fix 60

            s.name = w; s.prio = k; ++g_eggNameStats.found;
            if (k == 0) { s.done = true; s.fresh = true; }
        }
    }
    return hit;
}
static void EggNameScanChunk(std::string_view m) {
    if (!g_eggNameScanPass) return;
    EggNameStats& st = g_eggNameStats;
    ++st.chunks; st.bytes += m.size();
    static const std::string N = "item_name";
    static const std::boyer_moore_horspool_searcher<std::string::const_iterator> sN(N.begin(), N.end());
    for (auto it = std::search(m.begin(), m.end(), sN); it != m.end(); it = std::search(it + 1, m.end(), sN)) {
        const size_t p = (size_t)(it - m.begin());
        ++st.hits;
        if (EggNameOffsetKey8(m, p)) continue;                     // Fix 55
        const size_t kl = p > 0 ? (unsigned char)m[p - 1] : 0;       // Schlüssellänge davor
        if (kl < 10 || kl > 40 || p + kl + 2 > m.size()) { ++st.lenByte; continue; }
        const std::string_view key = m.substr(p, kl);
        bool keyHit = false;
        for (auto& s : g_eggNames) {
            if (!EggNamePending(s)) continue;
            for (int k = 0; k < 3 && k < s.prio; ++k) {
                if (key != s.keys[k]) continue;
                keyHit = true;
                ++s.at8[k];                                            // Fix 53
                size_t q = p + kl, len = (unsigned char)m[q++];
                if (len & 0x80) { len = (len & 0x7F) | ((size_t)(unsigned char)m[q++] << 7); if (len >= 0x4000) { ++st.value; ++s.bad[k]; continue; } }
                if (len < 1 || len > 160 || q + len > m.size()) { ++st.value; ++s.bad[k]; continue; }
                const std::string_view v = m.substr(q, len);
                if (!EggNameTextOk(v)) { ++st.text; ++s.bad[k]; continue; }
                const std::wstring w = LuckySenderName(v, 80);           // Fix 53: Ei-Namen bis 80 Zeichen (wie UTF-16-Pfad)
                if (w.empty()) { ++st.text; ++s.bad[k]; continue; }
                if (EggNameOldLang(s, w)) { ++s.bad[k]; continue; }   // Fix 60

                s.name = w; s.prio = k; ++st.found;
                if (k == 0) { s.done = true; s.fresh = true; }
            }
        }
        if (!keyHit) ++st.otherKey;
    }
}
// ===== Fix 49: zweite Namens-Quelle – Il2Cpp-String-Objekte (UTF-16), schon beim Start im Speicher =====
// Die UTF-8-Tabelle lädt das Spiel spät oder gar nicht (log5–log10: nie beim Start). Beim Start liegen die Texte als verwaltete
// Strings vor: [klass 8][monitor 8 = 0][int32 Länge][UTF-16][00 00], Größe auf 16 gerundet (Boehm-Klassen). Beim Laden der
// Lokalisierung wird der WERT direkt nach seinem SCHLÜSSEL angelegt, d. h. (Allokation läuft abwärts) liegt er genau eine
// Objektgröße UNTER dem Schlüssel – aber nur, wenn beide in dieselbe Größenklasse fallen. Belegt (zwei Spiel-Sitzungen,
// verschiedene klass/Adressen): log4 0x1299aa480 / log5–log10 0x12d120200 „item_name653070_1“ -> „Goldenes Ei (Diamant)“
// je 64 Byte darunter; ebenso „item_name_654175“ -> „Rock-Geschenkbox“. Verschiedene Klassen (z. B. item_name670001 64 B,
// „Goldenes Ei (Geburtstag)“ 80 B) -> hier kein Treffer (dann UTF-8-Tabelle bzw. Umbenennen). Strenge Prüfung des Werts:
// gleicher klass, monitor 0, gleiche Größenklasse, Adressabstand im Original genau eine Objektgröße, gültiger Text ohne
// Steuerzeichen/Markup, kein Schlüssel-Name. Kein Stichwort (Titel enthalten nicht immer „Ei“). Nur in Such-Durchläufen.
static size_t Il2CppStrSize(size_t len) { return (20 + 2 * len + 2 + 15) / 16 * 16; }
static bool Il2CppStrAt(std::string_view m, size_t o, unsigned long long& klass, std::wstring& out, size_t maxLen) {
    if (o + 22 > m.size()) return false;
    unsigned long long k = 0, mon = 0; int len = 0;
    memcpy(&k, m.data() + o, 8); memcpy(&mon, m.data() + o + 8, 8); memcpy(&len, m.data() + o + 16, 4);
    if (k == 0 || (k & 7) || (k >> 47) || mon != 0 || len < 1 || (size_t)len > maxLen) return false;
    const size_t e = o + 20 + 2 * (size_t)len;
    if (e + 2 > m.size() || m[e] || m[e + 1]) return false;
    out.assign((size_t)len, L'\0');
    for (int i = 0; i < len; ++i) { unsigned short c; memcpy(&c, m.data() + o + 20 + 2 * (size_t)i, 2); out[(size_t)i] = (wchar_t)c; }
    klass = k;
    return true;
}
// Wert-Text: keine Steuerzeichen/Markup, Surrogate paarweise, kein Schlüssel-Name (nur a-z0-9_ mit „_“ oder Ziffer)
static bool EggName16TextOk(const std::wstring& w) {
    bool ident = true, sepOrDigit = false;
    for (size_t i = 0; i < w.size(); ++i) {
        const unsigned c = (unsigned)w[i] & 0xFFFF;
        if (c < 0x20 || c == 0x7F || c == '<' || c == '>' || c == '{' || c == '}' || c == '\\' || c == 0xFFFD || c == 0xFFFF) return false;
        if (c >= 0xD800 && c <= 0xDBFF) { if (i + 1 >= w.size() || (((unsigned)w[i + 1] & 0xFFFF) < 0xDC00 || ((unsigned)w[i + 1] & 0xFFFF) > 0xDFFF)) return false; ++i; ident = false; continue; }
        if (c >= 0xDC00 && c <= 0xDFFF) return false;
        const bool lowDig = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_';
        if (!lowDig) ident = false;
        if (c == '_' || (c >= '0' && c <= '9')) sepOrDigit = true;
    }
    if (ident && sepOrDigit) return false;
    for (wchar_t c : w) if (c != L' ') return true;
    return false;
}
// ===== Fix 61: Wert-Objekt neben dem UTF-16-Schlüssel-Objekt (für ALLE Ei-Schlüssel) =====
// 1 = Wert-Objekt direkt darunter (lückenlos, JEDE Größe – bis Fix 60 nur gleiche Objektgröße wie der Schlüssel, darum fiel z. B.
// „Champion Golden Egg“ (64 B) unter s6_minigame_item_name1 (80 B) durch); 2 = nur direkt danach (Ersatz, nicht eindeutig – kann
// der Wert des nächsten Paars sein -> erst nach 2 vollen Durchläufen ohne eindeutigen Treffer, EggNameFinishPass).
// Gültig: gleiche Klasse wie der Schlüssel, monitor 0, Text druckbar, kein Schlüssel-Name (EggName16TextOk).
template <class AddrFn>
static int Egg16ValueNear(std::string_view m, size_t o, unsigned long long kk, size_t ksz, const AddrFn& origAddr, std::wstring& v) {
    unsigned long long vk = 0;
    for (size_t d = 32; d <= Il2CppStrSize(80); d += 16) {
        if (o < d || origAddr(o) - origAddr(o - d) != d) continue;
        if (Il2CppStrAt(m, o - d, vk, v, 80) && vk == kk && Il2CppStrSize(v.size()) == d && EggName16TextOk(v)) return 1;
    }
    const size_t a = o + ksz;
    if (a < m.size() && origAddr(a) - origAddr(o) == ksz && Il2CppStrAt(m, a, vk, v, 80) && vk == kk && EggName16TextOk(v)) return 2;
    v.clear();
    return 0;
}
static void EggGuessKey(EggNameSlot& s, int k, const std::wstring& v) {
    if (s.guess[k] != v) { s.guess[k] = v; s.guessPass[k] = g_eggNamePassNo; }
}
// Fix 55: UTF-16-Schlüsselobjekt, in dem „item_name“ nicht am Anfang steht (s6_minigame_item_name1). Gleiche Regel wie
// unten: Wert = String-Objekt gleicher Klasse/Größenklasse genau eine Objektgröße UNTER dem Schlüssel. Belegt in log4–log16:
// „Goldenes Ei (Diamant)“ liegt direkt vor „item_name653070_1“ (UTF-8-Tabelle: item_name653070_1 -> „Goldenes Ei (Diamant)“),
// und log16 (8 Kopien): „Goldenes Ei des Champions“ direkt vor „s6_minigame_item_name1“ (beide 80 Byte).
template <class AddrFn>
static bool EggNameOffsetKey16(std::string_view m, size_t p, const AddrFn& origAddr) {
    bool hit = false;
    for (auto& s : g_eggNames) {
        if (!EggNamePending(s)) continue;
        for (int k = 0; k < 3 && k < s.prio; ++k) {
            const std::string& K = s.keys[k];
            const size_t q = K.find("item_name");
            if (q == 0 || q == std::string::npos || p < 20 + 2 * q) continue;
            const size_t o = p - 2 * q - 20;
            if (origAddr(o) & 7) continue;
            unsigned long long kk = 0;
            std::wstring kw;
            if (!Il2CppStrAt(m, o, kk, kw, 40) || kw.size() != K.size()) continue;
            bool same = true;
            for (size_t i = 0; i < K.size(); ++i) if (kw[i] != (wchar_t)(unsigned char)K[i]) { same = false; break; }
            if (!same) continue;
            hit = true;
            ++s.at16[k];
            const size_t sz = Il2CppStrSize(kw.size());
            unsigned long long vk = 0;
            std::wstring v;
            const int nearV = Egg16ValueNear(m, o, kk, sz, origAddr, v);   // Fix 61: Wert direkt darunter (jede Größe), sonst direkt danach (Ersatz)
            const bool ok = nearV == 1;
            if (nearV == 2) EggGuessKey(s, k, v);
            if (!ok) {
                ++s.bad[k];
                EggRefKey(s, k, origAddr(o), kk);                      // Fix 61: Wert über den Dictionary-Eintrag suchen
                continue;
            }
            if (EggNameOldLang(s, v)) { ++s.bad[k]; continue; }   // Fix 60
            if (EggNameNoEggWord(s, K, v)) { ++s.bad[k]; EggRefKey(s, k, origAddr(o), kk); continue; }   // Fix 67: echten Wert über den Dictionary-Eintrag suchen

            s.name = v; s.prio = k; ++g_eggNameStats.found; ++g_eggNameStats.found16;
            if (k == 0) { s.done = true; s.fresh = true; }
        }
    }
    return hit;
}
static const char EGG_KEY16[] = { 'i', 0, 't', 0, 'e', 0, 'm', 0, '_', 0, 'n', 0, 'a', 0, 'm', 0, 'e', 0 };
template <class AddrFn>
static void EggNameScanChunk16(std::string_view m, const AddrFn& origAddr) {
    if (!g_eggNameScanPass) return;
    bool any = false;
    for (const auto& s : g_eggNames) if (EggNamePending(s)) { any = true; break; }
    if (!any) return;
    EggNameStats& st = g_eggNameStats;
    static const std::string N16(EGG_KEY16, sizeof(EGG_KEY16));
    static const std::boyer_moore_horspool_searcher<std::string::const_iterator> s16(N16.begin(), N16.end());
    for (auto it = std::search(m.begin(), m.end(), s16); it != m.end(); it = std::search(it + 1, m.end(), s16)) {
        const size_t p = (size_t)(it - m.begin());
        ++st.hits16;
        if (EggNameOffsetKey16(m, p, origAddr)) continue;          // Fix 55
        if (p < 20 || (origAddr(p - 20) & 7)) continue;
        const size_t o = p - 20;
        unsigned long long kk = 0;
        std::wstring kw;
        if (!Il2CppStrAt(m, o, kk, kw, 40)) continue;   // Fix 53: Schlüssel außerhalb eines String-Objekts
        std::string key;
        bool ascii = true;
        for (wchar_t c : kw) { if (c < 0x21 || c > 0x7E) { ascii = false; break; } key += (char)c; }
        if (!ascii) continue;
        ++st.keys16;
        for (auto& s : g_eggNames) {
            if (!EggNamePending(s)) continue;
            for (int k = 0; k < 3 && k < s.prio; ++k) {
                if (key != s.keys[k]) continue;
                ++s.at16[k];                                           // Fix 53
                const size_t sz = Il2CppStrSize(kw.size());
                unsigned long long vk = 0;
                std::wstring v;
                const int nearV = Egg16ValueNear(m, o, kk, sz, origAddr, v);   // Fix 61: Wert direkt darunter (jede Größe), sonst direkt danach (Ersatz)
                const bool ok = nearV == 1;
                if (nearV == 2) EggGuessKey(s, k, v);
                if (!ok) {
                    ++s.bad[k];                                        // Fix 53
                    EggRefKey(s, k, origAddr(o), kk);                      // Fix 61: Wert über den Dictionary-Eintrag suchen
                    continue;
                }
                if (EggNameOldLang(s, v)) { ++s.bad[k]; continue; }   // Fix 60
                if (EggNameNoEggWord(s, s.keys[k], v)) { ++s.bad[k]; EggRefKey(s, k, origAddr(o), kk); continue; }   // Fix 67: echten Wert über den Dictionary-Eintrag suchen
                s.name = v; s.prio = k; ++st.found; ++st.found16;
                if (k == 0) { s.done = true; s.fresh = true; }
            }
        }
    }
}
// ===== Fix 55: Steuer-Eier 660100–660103 = Stufe 1–4 (Karten: 660103 = „Lv. 4 Goldenes Ei (Steuer)“) =====
// log16: für 6601xx gibt es KEINEN eigenen Text-Schlüssel (alle item_name-Varianten 0/0/0/0); die Texte „Lv. 1..5 Goldenes Ei
// (Steuer)“ liegen als UTF-16-Objekte hintereinander (ohne Schlüssel dazwischen) bzw. als item_name_650045..650049 in der Tabelle.
// Sprachunabhängig: Spieltext des Ankers 650049 (sonst 650048) nehmen, die EINE Ziffernfolge (Stufe) durch die Stufe der Sorte
// ersetzen und den so gebildeten Text NUR übernehmen, wenn er wörtlich im Spielspeicher steht (UTF-16-String-Objekt oder
// UTF-8-Tabellenwert). Kein fester Text.
struct EggLevelSibling { const char* goodsId; int level; };
static const EggLevelSibling EGG_LEVEL_SIBLINGS[] = { { "660100", 1 },{ "660101", 2 },{ "660102", 3 },{ "660103", 4 },{ nullptr, 0 } };
static const char* const EGG_LEVEL_ANCHORS[] = { "650049", "650048", nullptr };
static EggNameSlot* EggNameFind(const std::string& gid);
static bool EggSiblingCandidate(int level, std::wstring& out, std::string& anchor) {
    for (int a = 0; EGG_LEVEL_ANCHORS[a]; ++a) {
        const EggNameSlot* as = EggNameFind(EGG_LEVEL_ANCHORS[a]);
        if (!as || as->name.empty() || !as->via.empty()) continue;
        const std::wstring& n = as->name;
        size_t runs = 0, r0 = 0, r1 = 0;
        for (size_t i = 0; i < n.size(); ) {
            if (n[i] >= L'0' && n[i] <= L'9') { size_t j = i; while (j < n.size() && n[j] >= L'0' && n[j] <= L'9') ++j; ++runs; r0 = i; r1 = j; i = j; }
            else ++i;
        }
        if (runs != 1) continue;
        out = n.substr(0, r0) + std::to_wstring(level) + n.substr(r1);
        anchor = std::string(EGG_LEVEL_ANCHORS[a]) + " \"" + LuckySafe(WideToUtf8Lucky(n), 120) + "\"";
        return true;
    }
    return false;
}
template <class AddrFn>
static void EggNameSiblingScan(std::string_view m, const AddrFn& origAddr) {
    if (!g_eggNameScanPass) return;
    for (int i = 0; EGG_LEVEL_SIBLINGS[i].goodsId; ++i) {
        EggNameSlot* s = EggNameFind(EGG_LEVEL_SIBLINGS[i].goodsId);
        if (!s || !EggNamePending(*s)) continue;
        std::wstring c;
        std::string anchor;
        if (!EggSiblingCandidate(EGG_LEVEL_SIBLINGS[i].level, c, anchor)) continue;
        std::string where;
        std::string n16;
        for (wchar_t ch : c) { n16 += (char)(ch & 0xFF); n16 += (char)((ch >> 8) & 0xFF); }
        const std::boyer_moore_horspool_searcher<std::string::const_iterator> s16(n16.begin(), n16.end());
        for (auto it = std::search(m.begin(), m.end(), s16); it != m.end() && where.empty(); it = std::search(it + 1, m.end(), s16)) {
            const size_t p = (size_t)(it - m.begin());
            if (p < 20 || (origAddr(p - 20) & 7)) continue;
            unsigned long long kk = 0;
            std::wstring w;
            if (!Il2CppStrAt(m, p - 20, kk, w, 80) || w != c) continue;
            where = "UTF-16 object";
        }
        const std::string u = WideToUtf8Lucky(c);
        if (where.empty() && u.size() < 128) {
            const std::boyer_moore_horspool_searcher<std::string::const_iterator> s8(u.begin(), u.end());
            for (auto it = std::search(m.begin(), m.end(), s8); it != m.end() && where.empty(); it = std::search(it + 1, m.end(), s8)) {
                const size_t p = (size_t)(it - m.begin());
                if (p >= 1 && (unsigned char)m[p - 1] == u.size()) where = "UTF-8 table value";
            }
        }
        if (where.empty() || EggNameOldLang(*s, c)) continue;   // Fix 60: alte Sprache
        s->name = c; s->prio = 0; s->done = true; s->fresh = true;
        s->via = "level sibling of " + std::string(EGG_LEVEL_ANCHORS[0]) + "/" + EGG_LEVEL_ANCHORS[1];
        ++g_eggNameStats.found;
    }
}
// ===== Fix 57: Spiel-Schlüssel ohne „item_name“ (653074: „zone_war_government_12“) =====
// log23 (Server 2, Fix-56-Sonde): UTF-8-Tabelle „\x16zone_war_government_12\x17Belohnung des Eroberers\x16zone_war_government_13…“
// und UTF-16-Objekt „Belohnung des Eroberers“ (80 B) genau eine Objektgröße UNTER dem Schlüssel-Objekt „zone_war_government_12“
// (gleiche Klasse). Die item_name-Suchen finden solche Schlüssel nie -> eigene Suche nach [Länge][Schlüssel] (UTF-8) bzw. dem
// UTF-16-Schlüssel-Objekt. Nur in Such-Durchläufen und nur, solange eine Sorte mit so einem Schlüssel keinen Namen hat
// (danach gespeichert -> nächste Sitzung keine Suche). Gleiche Prüfung des Werts wie EggNameOffsetKey8/16, kein Stichwort-Filter.
template <class AddrFn>
static void EggNameDirectKeyScan(std::string_view m, const AddrFn& origAddr) {
    if (!g_eggNameScanPass) return;
    for (auto& s : g_eggNames) {
        for (int k = 0; k < 3 && k < s.prio && EggNamePending(s); ++k) {
            const std::string K = s.keys[k];
            if (K.size() < 3 || K.size() > 40 || K.find("item_name") != std::string::npos) continue;
            const std::string n8 = std::string(1, (char)K.size()) + K;      // UTF-8-Tabelle: Länge + Schlüssel
            const std::boyer_moore_horspool_searcher<std::string::const_iterator> s8(n8.begin(), n8.end());
            for (auto it = std::search(m.begin(), m.end(), s8); it != m.end() && k < s.prio; it = std::search(it + 1, m.end(), s8)) {
                size_t i = (size_t)(it - m.begin()) + n8.size();
                ++s.at8[k];
                if (i >= m.size()) { ++s.bad[k]; continue; }
                size_t len = (unsigned char)m[i++];
                if (len & 0x80) { if (i >= m.size()) { ++s.bad[k]; continue; } len = (len & 0x7F) | ((size_t)(unsigned char)m[i++] << 7); }
                if (len < 1 || len > 160 || i + len > m.size()) { ++s.bad[k]; continue; }
                const std::string_view v = m.substr(i, len);
                if (!EggNameTextOk(v)) { ++s.bad[k]; continue; }
                const std::wstring w = LuckySenderName(v, 80);
                if (w.empty()) { ++s.bad[k]; continue; }
                if (EggNameOldLang(s, w)) { ++s.bad[k]; continue; }   // Fix 60

                s.name = w; s.prio = k; ++g_eggNameStats.found;
                if (k == 0) { s.done = true; s.fresh = true; }
            }
            if (k >= s.prio) continue;
            std::string n16;                                                  // UTF-16-Schlüssel-Objekt
            for (char c : K) { n16 += c; n16 += '\0'; }
            const std::boyer_moore_horspool_searcher<std::string::const_iterator> s16(n16.begin(), n16.end());
            for (auto it = std::search(m.begin(), m.end(), s16); it != m.end() && k < s.prio; it = std::search(it + 1, m.end(), s16)) {
                const size_t p = (size_t)(it - m.begin());
                if (p < 20) continue;
                const size_t o = p - 20;
                if (origAddr(o) & 7) continue;
                unsigned long long kk = 0;
                std::wstring kw;
                if (!Il2CppStrAt(m, o, kk, kw, 40) || kw.size() != K.size()) continue;   // genau dieser Schlüssel (nicht …_120)
                ++s.at16[k];
                const size_t sz = Il2CppStrSize(kw.size());
                unsigned long long vk = 0;
                std::wstring v;
                const int nearV = Egg16ValueNear(m, o, kk, sz, origAddr, v);   // Fix 61: Wert direkt darunter (jede Größe), sonst direkt danach (Ersatz)
                const bool ok = nearV == 1;
                if (nearV == 2) EggGuessKey(s, k, v);
                if (!ok) {
                    ++s.bad[k];
                    EggRefKey(s, k, origAddr(o), kk);                      // Fix 61: Wert über den Dictionary-Eintrag suchen
                    continue;
                }
                if (EggNameOldLang(s, v)) { ++s.bad[k]; continue; }   // Fix 60
                if (EggNameNoEggWord(s, K, v)) { ++s.bad[k]; EggRefKey(s, k, origAddr(o), kk); continue; }   // Fix 67: echten Wert über den Dictionary-Eintrag suchen

                s.name = v; s.prio = k; ++g_eggNameStats.found; ++g_eggNameStats.found16;
                if (k == 0) { s.done = true; s.fresh = true; }
            }
        }
    }
}
// ===== Fix 61: Wert über den Dictionary-Eintrag des Spiels =====
// log26 (Englisch): KEY16 666801 s6_minigame_item_name1 bei 0x129443dc0, aber der Wert „Champion Golden Egg“ steht NICHT direkt
// darunter (UTF-16-Objekt bei 0x12942c054, ~97 KB entfernt; in Deutsch lag er direkt darunter, Fix 55). Die Zuordnung Schlüssel ->
// Wert steht im Dictionary<string,string> des Spiels: Eintrag {int hashCode; int next; string key; string value} -> direkt nach
// dem 8-Byte-Zeiger auf das Schlüssel-Objekt folgt der Zeiger auf das Wert-Objekt. Generisch (kein Name fest):
//   1) Schlüssel-Objekt ohne Wert darunter -> Adresse merken (EggRefKey);
//   2) jeder Such-Block: 8-Byte-Zeiger auf diese Adresse suchen, folgenden Zeiger als Wert-Kandidat merken (höchstens 8);
//   3) Block mit einer Kandidaten-Adresse: dort String-Objekt der GLEICHEN Klasse wie der Schlüssel, gültiger Text, kein Schlüssel-Name.
static const size_t EGG_REF_MAX_CAND = 8;
static void EggRefKey(EggNameSlot& s, int k, unsigned long long addr, unsigned long long klass) {
    if (s.refKey[k] != addr) { s.refKey[k] = addr; s.refKlass[k] = klass; s.refVal[k].clear(); }
}
template <class AddrFn>
static void EggNameRefScan(std::string_view m, const AddrFn& origAddr) {
    if (!g_eggNameScanPass || m.size() < 32) return;
    const unsigned long long lo = origAddr(0), hi = origAddr(m.size() - 1);
    for (auto& s : g_eggNames) {
        if (!EggNamePending(s)) continue;
        for (int k = 0; k < 3 && k < s.prio; ++k) {
            if (!s.refKey[k]) continue;
            // 2) Zeiger auf das Schlüssel-Objekt
            if (s.refVal[k].size() < EGG_REF_MAX_CAND) {
                char pat[8]; memcpy(pat, &s.refKey[k], 8);
                const std::string_view pv(pat, 8);
                for (size_t p = m.find(pv); p != std::string_view::npos && s.refVal[k].size() < EGG_REF_MAX_CAND; p = m.find(pv, p + 1)) {
                    if ((origAddr(p) & 7) || p + 16 > m.size()) continue;
                    unsigned long long v = 0; memcpy(&v, m.data() + p + 8, 8);
                    if (v == 0 || (v & 7) || (v >> 47) || v == s.refKey[k]) continue;
                    if (std::find(s.refVal[k].begin(), s.refVal[k].end(), v) != s.refVal[k].end()) continue;
                    s.refVal[k].push_back(v);
                }
            }
            // 3) Wert-Objekt an einer Kandidaten-Adresse in diesem Block
            for (unsigned long long v : s.refVal[k]) {
                if (v < lo || v > hi) continue;
                // Fix 62: Block ohne U+200B-Stellen davor: Position = v - lo; mit entfernten U+200B (Text-Block, log27: 666801
                // „Champion Golden Egg“ bei 0x129312e00) ist die Position um die entfernten Bytes kleiner -> origAddr ist
                // monoton, darum Position per Binärsuche (früher: v - lo, traf das Objekt nicht -> Wert nie gelesen)
                size_t a = 0, b = std::min(m.size(), (size_t)(v - lo) + 1);
                while (a < b) { const size_t c = a + (b - a) / 2; if (origAddr(c) < v) a = c + 1; else b = c; }
                const size_t o = a;
                if (o >= m.size() || origAddr(o) != v) continue;
                unsigned long long vk = 0;
                std::wstring w;
                if (!Il2CppStrAt(m, o, vk, w, 80) || vk != s.refKlass[k] || !EggName16TextOk(w)) continue;
                if (EggNameOldLang(s, w)) { ++s.bad[k]; continue; }   // Fix 60
                if (EggNameNoEggWord(s, s.keys[k], w)) { ++s.bad[k]; continue; }   // Fix 67
                s.name = w; s.prio = k; ++g_eggNameStats.found; ++g_eggNameStats.found16;
                if (k == 0) { s.done = true; s.fresh = true; }
                break;
            }
            if (s.done) break;
        }
    }
}
static const size_t EGG_SEEN_CAP = 2000;
static std::unordered_set<std::string> g_eggSeenHex;
static std::deque<std::string> g_eggSeenOrder;
static void MarkEggSeen(const std::string& uuid) {
    if (!g_eggSeenHex.insert(uuid).second) return;
    g_eggSeenOrder.push_back(uuid);
    if (g_eggSeenOrder.size() > EGG_SEEN_CAP) { g_eggSeenHex.erase(g_eggSeenOrder.front()); g_eggSeenOrder.pop_front(); }
}
// Fix 49: uuids mit Abhol-Banner („hat alle … erhalten“ = Ei ist leer) -> Gesamtzahl = Abhol-Zahl (allgemein, jede Sorte;
// belegt: log9/log10 alle 226 Eier mit Banner, bekannte Sorten n = Regel-Zahl 40/20)
static std::unordered_set<std::string> g_eggBanners;
static std::deque<std::string> g_eggBannerOrder;
static void MarkEggBanner(const std::string& uuid) {
    if (!g_eggBanners.insert(uuid).second) return;
    g_eggBannerOrder.push_back(uuid);
    if (g_eggBannerOrder.size() > EGG_SEEN_CAP) { g_eggBanners.erase(g_eggBannerOrder.front()); g_eggBannerOrder.pop_front(); }
}
static std::unordered_map<std::string, LuckyClaimState> g_eggClaims;   // nur GEMELDETE Eier
static std::deque<std::string> g_eggClaimOrder;
// Jede gelesene Kopie eines Ei-Posts mit clientUpdateExtra (ASCII und UTF-16); unbekannte uuids werden ignoriert
static void EggClaimsSeen(const std::string& uuid, int n, long long ts, int total, const char* enc, bool mine = false) {
    (void)enc;
    if (n < 0 || g_eggClaims.empty()) return;
    auto it = g_eggClaims.find(uuid);
    if (it == g_eggClaims.end()) return;
    LuckyClaimState& c = it->second;
    if (mine && !c.mine) { c.mine = true; PostLuckyMine(uuid); }   // Fix 114
    if (n < c.n) return;                                       // älterer Stand – Zahlen steigen nur
    if (c.bannerTotal && n > total) total = n;                 // Fix 49: Banner -> Gesamtzahl = Abhol-Zahl
    const bool up = n > c.n || total > c.total;
    if (!up) return;
    c.n = n; c.total = std::max(c.total, total); c.ts = std::max(c.ts, ts);
    PostLuckyCount(uuid, c.n, c.total);                        // gleiche Zeilen-Aktualisierung wie Lucky (Zeile ist als Ei markiert)
}
static bool EggClaimsOpen() {
    const unsigned long long now = GetTickCount64();
    for (const auto& kv : g_eggClaims)
        if ((kv.second.total <= 0 || kv.second.n < kv.second.total) && now - kv.second.tick < 24ULL * 3600 * 1000) return true;
    return false;
}
// ===== Fix 48: Ei kurz zurückhalten, bis sein Name da ist; spätere Namen -> Zeile/Blase umbenennen =====
// Fehlt beim ersten Sehen der volle Name, wartet die Meldung höchstens bis zum Ende des NÄCHSTEN vollen Durchlaufs (der
// nächste Durchlauf ist dafür voll, ~1–2 Durchläufe). Name gefunden -> sofort mit Namen melden (Log, Blase, Windows-Hinweis);
// sonst mit dem Wort „Ei“ melden und die uuid merken: kommt der Name später (Tabelle lädt das Spiel spät), wird die Log-Zeile
// (und eine noch sichtbare Blase / ein noch sichtbarer Hinweis dieses Eis) umbenannt (WM_EGGRELABEL). Max. EGG_HELD_MAX
// wartende Eier, EGG_UNNAMED_MAX gemerkte Zeilen. Nur wenn der Worker Namen sucht (g_eggNamePassNo > 0).
struct EggHeld { std::string uuid, gid, time, desc, src, room, seqId, att; std::wstring sender; unsigned pass = 0; };
static std::vector<EggHeld> g_eggHeld;
static const size_t EGG_HELD_MAX = 20;
struct EggUnnamed { std::string uuid, gid; };
static std::deque<EggUnnamed> g_eggUnnamed;
static const size_t EGG_UNNAMED_MAX = 50;
static EggNameSlot* EggNameFind(const std::string& gid) {
    for (auto& s : g_eggNames) if (!gid.empty() && s.goodsId == gid) return &s;
    return nullptr;
}
// Fix 52: fest eingebaute Namen NUR wo sicher belegt (Bildschirmfoto der Karte im Chat + goodsId desselben Eis im selben Log), je
// Spielsprache. Nur solange das Spiel keinen Text geliefert hat; die Zeile bleibt gemerkt und wird mit dem Spieltext umbenannt.
// 660100–660102: Stufe nicht belegt (nur Vermutung über packetId 345–347) -> kein fester Name.
struct EggBuiltinName { const char* goodsId; const char* lang; const wchar_t* name; };
static const EggBuiltinName EGG_BUILTIN_NAMES[] = {
    // Fix 55: entfernt – 660103 kommt jetzt als Stufen-Geschwister von 650049 („Lv. 4 …“, log16 im Speicher belegt), 666801 über
    // den Spiel-Schlüssel s6_minigame_item_name1 (log16). Früher: 660103 „Lv. 4 Goldenes Ei (Steuer)“, 666801 „Goldenes Ei des Champions“ (de).
    { nullptr, nullptr, nullptr }
};
// Spielsprache wie EggLabelNow: Sprach-Probe des Lucky Gift, sonst gespeicherte Lucky-Sprache
static std::string EggLangNow() {
    const int i = g_luckyProbeLabel.load();
    if (i >= 0 && i < (int)(sizeof(LUCKY_LOG_LABELS) / sizeof(LUCKY_LOG_LABELS[0]))) return LUCKY_LOG_LABELS[i].lang;
    return LoadLuckyLangSetting();
}
static std::wstring EggBuiltinNameFor(const std::string& gid, const std::string& lang) {
    for (int i = 0; EGG_BUILTIN_NAMES[i].goodsId; ++i)
        if (gid == EGG_BUILTIN_NAMES[i].goodsId && lang == EGG_BUILTIN_NAMES[i].lang) return EGG_BUILTIN_NAMES[i].name;
    return std::wstring();
}
// Meldung an UI (Zahl/Gesamtzahl vom neuesten Stand in g_eggClaims)
static void EggReportNow(const EggHeld& h) {
    int claims = -1, total = 0;
    auto it = g_eggClaims.find(h.uuid);
    if (it != g_eggClaims.end()) { claims = it->second.n; total = it->second.total; }
    const EggNameSlot* ns = EggNameFind(h.gid);
    std::wstring label = ns ? ns->name : std::wstring();
    const bool gameEmpty = label.empty();
    if (gameEmpty) {                                           // Fix 52: fester Name nur wo sicher belegt
        const std::string lang = EggLangNow();
        label = EggBuiltinNameFor(h.gid, lang);
    }
    if (ns && gameEmpty) {
        for (auto u = g_eggUnnamed.begin(); u != g_eggUnnamed.end(); ++u) if (u->uuid == h.uuid) { g_eggUnnamed.erase(u); break; }
        if (g_eggUnnamed.size() >= EGG_UNNAMED_MAX) g_eggUnnamed.pop_front();
        g_eggUnnamed.push_back({ h.uuid, h.gid });
    }
    AddEggLog(std::wstring(h.time.begin(), h.time.end()), h.sender, h.uuid, claims, total, label);
}
// ===== Fix 66: Sprach-Probe gegen die Schrift der Ei-Namen aus den Spiel-Schlüsseln prüfen =====
// log36_th: Spiel auf Thai umgestellt, die Probe fand zuerst veraltete deutsche Spieltexte (result=de via=game-text-table) ->
// Lucky-Zeile „Glücksgeschenk“, Ei-Namen (item_name…, aus dem Speicher) aber richtig Thai. Ein Schlüssel für den Namen des
// Lucky Gift (packetId 502, goodsId 995002) ist in keinem Log belegt -> das Wort bleibt vorerst aus LUCKY_LOG_LABELS, aber die
// Sprache wird korrigiert: Schrift eines Namens -> Sprache NUR, wenn die Schrift eindeutig ist (Thai, Hangul, Kana, Kyrillisch,
// Arabisch). Ergebnis: Index in LUCKY_LOG_LABELS, -2 = nur Han (zh/ja), -3 = Latein (viele Sprachen), -1 = nichts/gemischt.
static int LuckyScriptLangOfText(const std::wstring& w) {
    int specific = -1; bool han = false, latin = false;
    for (wchar_t c : w) {
        const char* l = nullptr;
        if (c >= 0x0E00 && c <= 0x0E7F) l = "th";
        else if ((c >= 0xAC00 && c <= 0xD7AF) || (c >= 0x1100 && c <= 0x11FF) || (c >= 0x3130 && c <= 0x318F)) l = "ko";
        else if (c >= 0x3040 && c <= 0x30FF) l = "ja";
        else if (c >= 0x0400 && c <= 0x04FF) l = "ru";
        else if (c >= 0x0600 && c <= 0x06FF) l = "ar";
        else if (c >= 0x4E00 && c <= 0x9FFF) han = true;
        else if ((c >= L'A' && c <= L'Z') || (c >= L'a' && c <= L'z') || (c >= 0x00C0 && c <= 0x024F) || (c >= 0x1E00 && c <= 0x1EFF)) latin = true;
        if (l) {
            const int i = LuckyLabelIndex(l);
            if (specific >= 0 && i != specific) return -1;     // zwei eindeutige Schriften -> unklar
            specific = i;
        }
    }
    if (specific >= 0) return specific;                       // z. B. „Lv.4 ภาษี…“: Thai entscheidet, „Lv“ zählt nicht
    if (han) return -2;
    return latin ? -3 : -1;
}
// Passt die Schrift-Gruppe (Ergebnis oben) zur Sprache mit Index li?
static bool LuckyScriptFits(int script, int li) {
    if (script == -1 || li < 0 || li >= LUCKY_PROBE_NLANG) return true;
    const int own = LuckyScriptLangOfText(LUCKY_LOG_LABELS[li].text);   // Gruppe der Sprache aus ihrem eigenen Wort
    if (script >= 0) return script == li;
    if (script == -2) return own == -2 || li == LuckyLabelIndex("ja");   // nur Han: zh oder ja (Kanji ohne Kana)
    return own == -3;                                          // Latein
}
static const unsigned LUCKY_SCRIPT_MIN_VOTES = 2;              // mind. 2 verschiedene Ei-Sorten mit derselben eindeutigen Schrift
// Nach dem Probe-Block in EggNameFinishPass (Worker): Namen, die DIESER Spielprozess aus dem Speicher gelesen hat (nicht aus
// dem Cache) und die unter der aktuellen Probe-Sprache gelten. Keine Speichersuche, nur ein Lauf über g_eggNames (<= 32).
static void LuckyLangCrossCheck() {
    static int checkedFor = -2;                                // je Probe-Ergebnis höchstens eine Korrektur
    const int pl = g_luckyProbeLabel.load();
    // Fix 67: log38 (th) – Probe noch ohne Ergebnis (result=none) -> Lucky-Wort kam aus der gespeicherten Sprache (id).
    // Ohne Probe-Ergebnis entscheiden jetzt die Ei-Namen allein (gleiche Regel: >= 2 Namen, eine eindeutige Schrift).
    const bool none = pl < 0;
    if (pl >= LUCKY_PROBE_NLANG || (!none && pl == checkedFor)) return;
    const std::string lang = none ? std::string("none") : std::string(LUCKY_LOG_LABELS[pl].lang);
    unsigned votes[LUCKY_PROBE_NLANG] = {}; unsigned fits = 0;
    for (const auto& s : g_eggNames) {
        if (!s.done || s.cached || s.name.empty() || (!none && !s.lang.empty() && s.lang != lang)) continue;
        const int sc = LuckyScriptLangOfText(s.name);
        if (sc == -1) continue;
        if (!none && LuckyScriptFits(sc, pl)) { ++fits; continue; }
        if (sc >= 0) ++votes[sc];
    }
    int best = -1; unsigned bestN = 0, others = 0;
    for (int i = 0; i < LUCKY_PROBE_NLANG; ++i) {
        if (!votes[i]) continue;
        if (votes[i] > bestN) { if (best >= 0) others += bestN; best = i; bestN = votes[i]; }
        else others += votes[i];
    }
    if (best < 0) return;                                      // nichts Widersprüchliches (noch) – später erneut prüfen
    if (bestN < LUCKY_SCRIPT_MIN_VOTES || fits > 0 || others > 0) return;   // zu wenig Beleg -> Probe bleibt
    int expected = pl;
    if (!g_luckyProbeLabel.compare_exchange_strong(expected, best)) return;   // Probe-Thread hat inzwischen neu entschieden
    checkedFor = best;
    const std::string nl = LUCKY_LOG_LABELS[best].lang;
    for (auto& s : g_eggNames) {                               // passende Namen gelten ab jetzt unter der neuen Sprache (nicht verwerfen)
        if (!s.done || s.cached || s.name.empty() || (!none && !s.lang.empty() && s.lang != lang)) continue;
        if (LuckyScriptLangOfText(s.name) != best) continue;
        s.lang = nl;
        if (s.stored) SaveEggNameSetting(s.goodsId, nl, s.name);   // war unter der falschen Sprache gespeichert
    }
    PostLuckyRelabel(LuckyLogText(nl), true);                  // schon geschriebene Lucky-Zeilen (falsches Wort) umbenennen
}
// Ende jedes Durchlaufs (LuckyFinishPass): Zweitwahl übernehmen, Umbenennen, wartende Eier melden
static void EggNameFinishPass(bool fullScan) {
    if (g_eggNameScanPass && fullScan)                         // Fix 61: Ersatz „Wert direkt nach dem Schlüssel“ erst nach 2 vollen Durchläufen ohne eindeutigen Treffer
        for (auto& s : g_eggNames)
            for (int k = 0; k < 3 && k < s.prio && !s.done; ++k) {
                if (s.guess[k].empty() || g_eggNamePassNo < s.guessPass[k] + 2) continue;
                if (EggNameOldLang(s, s.guess[k])) { s.guess[k].clear(); continue; }   // Fix 60
                s.name = s.guess[k]; s.prio = k; ++g_eggNameStats.found; ++g_eggNameStats.found16;
                if (k == 0) { s.done = true; s.fresh = true; }
            }
    if (g_eggNameScanPass && fullScan)
        for (auto& s : g_eggNames) if (!s.done && s.prio < 3) { s.done = true; s.fresh = true; }
    static int lastProbe = -2;                                 // Fix 57: Probe-Ergebnis neu -> Cache prüfen / Speichern nachholen
    const int pl = g_luckyProbeLabel.load();
    if (pl != lastProbe) {
        lastProbe = pl;
        if (pl >= 0 && pl < (int)(sizeof(LUCKY_LOG_LABELS) / sizeof(LUCKY_LOG_LABELS[0]))) {
            const std::string lang = LUCKY_LOG_LABELS[pl].lang;
            for (auto& s : g_eggNames) {
                // Fix 60: Name einer anderen Spielsprache (Spiel neu in anderer Sprache) bzw. vor der Probe gefundene Kopie, die dem
                // gespeicherten Namen einer anderen Sprache gleicht -> verwerfen und neu suchen (Wartende Eier warten wieder)
                const bool otherLang = s.done && !s.lang.empty() && s.lang != lang;
                if (s.done && !s.name.empty() && (otherLang || (s.lang.empty() && EggNameOldLang(s, s.name)))) {
                    if (otherLang) { s.oldLang = s.lang; s.oldName = s.name; }
                    s.name.clear(); s.prio = 3; s.done = false; s.fresh = false; s.cached = false; s.stored = false; s.lang.clear(); s.via.clear(); s.oldSkipFull = 0;
                    for (int k = 0; k < 3; ++k) { s.refKey[k] = s.refKlass[k] = 0; s.refVal[k].clear(); s.guess[k].clear(); }   // Fix 61
                }
                if (!s.done && EggNameTryCache(s, lang)) s.fresh = true;   // wartende/früher ohne Namen gemeldete Eier umbenennen
                else if (s.done && !s.stored && !s.cached && !s.name.empty()) { SaveEggNameSetting(s.goodsId, lang, s.name); s.stored = true; }
                if (s.done) s.lang = lang;
            }
        }
    }
    LuckyLangCrossCheck();                                     // Fix 66: Probe gegen die Schrift der Ei-Namen (nächster Durchlauf übernimmt)
    for (auto& s : g_eggNames) {
        if (!s.fresh) continue;
        s.fresh = false;
        if (!s.stored) {                                       // Fix 49: für den nächsten Start merken (Fix 57: nur mit vertrauter Sprache)
            const std::string lang = EggLangConfirmed();          // Fix 60: nur Probe (nicht „luckyLang2“ – sonst engl. Name als 'de' gespeichert)
            if (!lang.empty()) { SaveEggNameSetting(s.goodsId, lang, s.name); s.stored = true; s.lang = lang; }
        }
        for (auto u = g_eggUnnamed.begin(); u != g_eggUnnamed.end(); ) {
            if (u->gid == s.goodsId) { PostEggRelabel(u->uuid, s.name); u = g_eggUnnamed.erase(u); }
            else ++u;
        }
    }
    size_t rel = 0;                                            // Fix 49: nur von vorn, in Reihenfolge (erstes nicht fertiges Ei hält den Rest)
    for (; rel < g_eggHeld.size(); ++rel) {
        const EggHeld& h = g_eggHeld[rel];
        const EggNameSlot* ns = EggNameFind(h.gid);
        const bool named = !ns || ns->done;
        const bool timeUp = fullScan && g_eggNamePassNo > h.pass;   // ein ganzer voller Durchlauf nach dem Sehen hat gesucht
        if (!named && !timeUp) break;
        EggReportNow(h);
    }
    g_eggHeld.erase(g_eggHeld.begin(), g_eggHeld.begin() + (std::ptrdiff_t)rel);
    g_eggNameHoldOpen = !g_eggHeld.empty();
}
// ===== Fix 63: Ei-Post ohne senderInfo (nur „sender“:uid, z. B. 'hasRob':true-Kopie) – Name aus dem Abhol-Banner derselben uuid =====
struct EggOrphan { std::string att, room, seq; int claims = -1; long long ts = 0; uintptr_t region = 0; };
static std::unordered_map<std::string, EggOrphan> g_eggOrphans;
static std::unordered_map<std::string, std::string> g_eggBannerNames;
static std::deque<std::string> g_eggOrphanOrder, g_eggBannerNameOrder;
static bool EggOnChatPost(std::string_view m, const LuckyChatPost& cp, uintptr_t regionBase, bool quiet);
static void EggOrphanReport(const std::string& uuid, const EggOrphan& o, const std::string& sender, bool quiet) {
    LuckyChatPost cp;
    cp.uuid = uuid; cp.sender = sender; cp.roomId = o.room; cp.seqId = o.seq; cp.claims = o.claims; cp.claimTs = o.ts;
    cp.attBody = 0; cp.attLen = o.att.size();
    EggOnChatPost(std::string_view(o.att), cp, o.region, quiet);
}
static void EggBannerSender(const std::string& uuid, const std::string& sender, bool quiet) {
    auto o = g_eggOrphans.find(uuid);
    if (o != g_eggOrphans.end()) { EggOrphan e = o->second; g_eggOrphans.erase(o); EggOrphanReport(uuid, e, sender, quiet); return; }
    if (g_eggBannerNames.count(uuid)) return;
    if (g_eggBannerNameOrder.size() >= 400) { g_eggBannerNames.erase(g_eggBannerNameOrder.front()); g_eggBannerNameOrder.pop_front(); }
    g_eggBannerNameOrder.push_back(uuid);
    g_eggBannerNames[uuid] = sender;
}
static void EggOrphanSeen(std::string_view m, const LuckyChatPost& cp, uintptr_t regionBase, bool quiet) {
    if (cp.uuid.empty() || !cp.why || std::string(cp.why) != "rpFields-without-senderInfo") return;
    const std::string_view att = m.substr(std::min(cp.attBody, m.size()), cp.attLen);
    if (GiftPostKind(att) != GIFT_EGG || EggIsBanner(att) || EggAttValue(att, "goodsId").empty()) return;
    if (g_eggSeenHex.count(cp.uuid) || g_eggOrphans.count(cp.uuid)) return;
    EggOrphan e; e.att = std::string(att); e.room = cp.roomId; e.seq = cp.seqId; e.claims = cp.claims; e.ts = cp.claimTs; e.region = regionBase;
    auto b = g_eggBannerNames.find(cp.uuid);
    if (b != g_eggBannerNames.end()) { const std::string n = b->second; EggOrphanReport(cp.uuid, e, n, quiet); return; }
    if (g_eggOrphanOrder.size() >= 200) { g_eggOrphans.erase(g_eggOrphanOrder.front()); g_eggOrphanOrder.pop_front(); }
    g_eggOrphanOrder.push_back(cp.uuid);
    g_eggOrphans[cp.uuid] = std::move(e);
}
// true = Post gehört zu einem Ei (Fix 47: jede packetId != 502 mit Geschenk-Merkmal; dann nie Lucky Gift).
static bool EggOnChatPost(std::string_view m, const LuckyChatPost& cp, uintptr_t regionBase, bool quiet) {
    const std::string_view att = m.substr(std::min(cp.attBody, m.size()), cp.attLen);
    if (GiftPostKind(att) != GIFT_EGG) return false;           // Fix 47: Familie (packetId != 502), nicht nur bekannte goodsIds
    const EggIdRule* r = EggMatchRule(att);
    const std::string kind = "packetId=" + LuckySafe(EggAttValue(att, "packetId"), 12) + " goodsId=" + LuckySafe(EggAttValue(att, "goodsId"), 12);
    if (EggIsBanner(att)) {                                    // Abhol-Banner: kein neues Ei
        MarkEggBanner(cp.uuid);
        if (!cp.sender.empty()) EggBannerSender(cp.uuid, cp.sender, quiet);   // Fix 63: Absender für Ei-Post ohne Namen
        auto bt = g_eggClaims.find(cp.uuid);                   // Fix 49: gemeldetes Ei ohne Gesamtzahl -> Zahl = Abholungen
        if (bt != g_eggClaims.end() && bt->second.total <= 0) {
            bt->second.bannerTotal = true;
            if (bt->second.n > 0) {
                bt->second.total = bt->second.n;
                PostLuckyCount(cp.uuid, bt->second.n, bt->second.total);
            }
        }
        return true;
    }
    const char* src = "unknown";
    const int total = EggTotalFromData(att, r, &src);
    if (cp.claims >= 0) EggClaimsSeen(cp.uuid, cp.claims, cp.claimTs, total, "ascii", cp.mine);
    if (g_eggSeenHex.count(cp.uuid)) return true;
    MarkEggSeen(cp.uuid);
    g_hotRegions.insert(regionBase);
    if (quiet) return true;
    if (!g_eggClaims.count(cp.uuid)) {
        if (g_eggClaimOrder.size() >= LUCKY_CLAIMS_CAP) { g_eggClaims.erase(g_eggClaimOrder.front()); g_eggClaimOrder.pop_front(); }
        g_eggClaimOrder.push_back(cp.uuid);
    }
    LuckyClaimState& cs = g_eggClaims[cp.uuid];
    cs.n = cp.claims; cs.ts = cp.claims >= 0 ? cp.claimTs : 0; cs.total = total; cs.tick = GetTickCount64();
    if (cp.mine && !cs.mine) { cs.mine = true; PostLuckyMine(cp.uuid, true); }   // Fix 114: schon beim Melden abgeholt
    cs.bannerTotal = total <= 0 && g_eggBanners.count(cp.uuid) > 0;
    if (cs.bannerTotal && cs.n > 0) { cs.total = cs.n; src = "banner"; }   // Fix 49: Banner schon gesehen -> Ei ist leer
    EggHeld h;                                                 // Fix 47/48: voller Ei-Name aus dem Spiel, sonst leer -> Wort „Ei“
    h.uuid = cp.uuid; h.gid = EggAttValue(att, "goodsId"); h.time = now_time_hms(); h.sender = LuckySenderName(cp.sender);
    h.desc = kind + (r ? std::string(" rule=") + r->key + ":" + r->value : std::string(" rule=none"));
    h.src = src; h.room = LuckySafe(cp.roomId, 80); h.seqId = cp.seqId; h.att = LuckySafe(att, 1500); h.pass = g_eggNamePassNo;
    EggNameSlot* ns = EggNameSlotFor(h.gid);
    if (ns) ns->seen = true;
    // Fix 49: Reihenfolge = Reihenfolge des Sehens (FIFO). Wartet schon ein Ei, stellt sich auch ein Ei mit bekanntem Namen hinten an;
    // volle Warteschlange -> das ÄLTESTE wird gemeldet (früher: das neue sofort, vor älteren -> Zeiten im Log durcheinander).
    const bool waitName = ns && !ns->done;
    if (g_eggNamePassNo > 0 && (waitName || !g_eggHeld.empty())) {
        if (g_eggHeld.size() >= EGG_HELD_MAX) {
            EggReportNow(g_eggHeld.front());
            g_eggHeld.erase(g_eggHeld.begin());
        }
        g_eggHeld.push_back(std::move(h));                     // Fix 48: kurz auf den Namen warten (EggNameFinishPass)
        g_eggNameHoldOpen = true;
        if (waitName) g_eggNameScanPass = true;                // Rest dieses Durchlaufs sucht schon mit
        return true;
    }
    EggReportNow(h);
    return true;
}
// ===== Fix 48: Feuerwerk-Erkennung (Chat-Post) =====
// Ein Feuerwerk ist ein Chat-Post mit extra.post == 693 („<Name> hat ein Feuerwerk gezündet“); customJsonParam enthält
// sendName, configId, ownerUid und eine rein numerische uuid (z. B. 1432630065933585601). Die Dankes-Karte („Danke für die
// Feuerwerkstruhe von …“) ist ein EIGENER Post 694 mit DERSELBEN uuid -> nie ein zweites Feuerwerk. Kein packetId/goodsId,
// daher nie Lucky Gift oder Ei (LuckyParseChatPost lehnt mit „no-packetId“ ab). Ein Ereignis = eine uuid: Merkliste für die
// ganze Bot-Sitzung wie bei Ei/Lucky (Spiel-Neustart, Scrollen, Kopien, 693 + 694 -> einmal). Gemeldet wird beim ersten
// gesehenen Post 693 oder 694 der uuid (694 nur als Ersatz, falls 693 nicht im Speicher liegt). Start-Verzögerung: alt, nur merken.
static const size_t FW_SEEN_CAP = 2000;
static std::unordered_set<std::string> g_fwSeen;
static std::deque<std::string> g_fwSeenOrder;
static void MarkFireworkSeen(const std::string& uuid) {
    if (!g_fwSeen.insert(uuid).second) return;
    g_fwSeenOrder.push_back(uuid);
    if (g_fwSeenOrder.size() > FW_SEEN_CAP) { g_fwSeen.erase(g_fwSeenOrder.front()); g_fwSeenOrder.pop_front(); }
}
// Liefert die Post-Art (693/694) aus dem extra-Objekt direkt nach dem Anhang, sonst 0
static int FireworkPostKind(std::string_view m, const LuckyChatPost& cp) {
    const size_t a = std::min(m.size(), cp.attBody + cp.attLen);
    std::string_view w = m.substr(a, std::min<size_t>(300, m.size() - a));
    const size_t close = w.find('}');
    if (close != std::string_view::npos) w = w.substr(0, close);
    const std::string p = EggAttValue(w, "post");
    if (p == "693") return 693;
    if (p == "694") return 694;
    return 0;
}
// Fix 118: Abholer-Liste des Feuerwerks = clientUpdateExtra derselben Nachricht: "<uid>|<uid>|…" (nur uids, kein Zeitstempel,
// keine Gesamtzahl; leer = 0). Felder alphabetisch -> zwischen appId und customJsonParam (vor dem Anhang). n = verschiedene uids.
static bool FireworkParseClaims(std::string_view m, size_t attBody, int& n, bool& mine) {
    const size_t lo = attBody > 6000 ? attBody - 6000 : 0;
    const std::string_view back = m.substr(lo, attBody - lo);
    for (const char* oqc : { "\"", "\\\"" }) {
        const std::string oq = oqc;
        const size_t ap = back.rfind(oq + "appId" + oq);
        if (ap == std::string_view::npos) continue;
        const std::string_view bw = back.substr(ap);
        if (bw.find('\0') != std::string_view::npos) continue;
        const std::string nk = oq + "clientUpdateExtra" + oq + ":" + oq;
        const size_t q = bw.find(nk);
        if (q == std::string_view::npos) continue;
        const size_t vs = q + nk.size(), ve = bw.find(oq, vs);
        if (ve == std::string_view::npos || ve - vs > 5000) return false;
        const std::string_view v = bw.substr(vs, ve - vs);
        std::vector<std::string_view> ids;
        size_t a = 0;
        while (!v.empty() && a <= v.size()) {
            size_t e = v.find('|', a);
            if (e == std::string_view::npos) e = v.size();
            const std::string_view id = v.substr(a, e - a);
            if (id.size() < 5 || id.size() > 20 || id.find_first_not_of("0123456789") != std::string_view::npos || ids.size() >= 300) return false;
            if (std::find(ids.begin(), ids.end(), id) == ids.end()) ids.push_back(id);
            a = e + 1;
        }
        n = (int)ids.size();
        mine = !g_ownUid.empty() && std::find(ids.begin(), ids.end(), std::string_view(g_ownUid)) != ids.end();
        return true;
    }
    return false;
}
struct FwClaimState { int n = -1; bool mine = false; };
static std::unordered_map<std::string, FwClaimState> g_fwClaims;   // Fix 118: nur gemeldete Feuerwerke (Scan-Thread), höchstens FW_SEEN_CAP
static std::deque<std::string> g_fwClaimsOrder;
// true = Feuerwerk-Post (693/694) erkannt (gemeldet oder schon bekannt)
static bool FireworkOnChatPost(std::string_view m, const LuckyChatPost& cp, uintptr_t regionBase, bool quiet) {
    if (cp.attLen < 20 || cp.attBody >= m.size()) return false;
    const std::string_view att = m.substr(cp.attBody, cp.attLen);
    if (att.find("sendName") == std::string_view::npos || att.find("configId") == std::string_view::npos) return false;
    auto digits = [](const std::string& d, size_t lo, size_t hi) {
        return d.size() >= lo && d.size() <= hi && d.find_first_not_of("0123456789") == std::string::npos; };
    const std::string uuid = EggAttValue(att, "uuid"), configId = EggAttValue(att, "configId");
    if (!digits(uuid, 10, 24) || !digits(configId, 1, 12)) return false;
    const int kind = FireworkPostKind(m, cp);
    if (kind == 0) return false;
    // Familie = Post 693/694 (jede Feuerwerk-Art: Standard, Deluxe, Premium, VS …); configId = Art. Jede configId wird gemeldet.
    // Fix 118: Abholer-Liste nur aus dem Feuerwerk-Post 693 (694 = Dankes-Karte eines Abholers, eigene Nachricht)
    int cn = -1; bool cm = false;
    const bool hasCl = kind == 693 && FireworkParseClaims(m, cp.attBody, cn, cm);
    if (g_fwSeen.count(uuid)) {
        auto it = g_fwClaims.find(uuid);
        if (hasCl && it != g_fwClaims.end()) {   // gemeldetes Feuerwerk: Zahl steigt nur, Haken nur setzen
            if (cn > it->second.n) { it->second.n = cn; PostLuckyCount(uuid, cn, 0); }
            if (cm && !it->second.mine) { it->second.mine = true; PostLuckyMine(uuid); }
        }
        return true;
    }
    MarkFireworkSeen(uuid);
    g_hotRegions.insert(regionBase);
    if (quiet) return true;
    if (g_fwClaimsOrder.size() >= FW_SEEN_CAP) { g_fwClaims.erase(g_fwClaimsOrder.front()); g_fwClaimsOrder.pop_front(); }
    g_fwClaimsOrder.push_back(uuid);
    FwClaimState& st = g_fwClaims[uuid];
    st.n = hasCl ? cn : -1; st.mine = hasCl && cm;
    const std::string t = now_time_hms();
    AddFireworkLog(std::wstring(t.begin(), t.end()), std::wstring(), uuid, st.n);   // Wort der Spielsprache im UI-Thread; kein Absender, kein Discord
    if (st.mine) PostLuckyMine(uuid, true);   // schon beim Melden abgeholt -> Haken ohne Animation
    return true;
}
// ===== Ende Fix 48 =====
template <class AddrFn>
static void LuckyScanChatPosts(std::string_view memStr, const AddrFn& origAddr, uintptr_t regionBase, bool quiet) {
    static const std::string N_CJP = "customJsonParam";
    static const std::boyer_moore_horspool_searcher<std::string::const_iterator> sC(N_CJP.begin(), N_CJP.end());
    for (auto it = std::search(memStr.begin(), memStr.end(), sC); it != memStr.end(); it = std::search(it + 1, memStr.end(), sC)) {
        LuckyChatPost cp;
        if (!LuckyParseChatPost(memStr, (size_t)(it - memStr.begin()), cp)) {
            if (cp.attLen > 0 && FireworkOnChatPost(memStr, cp, regionBase, quiet)) continue;   // Fix 48: Feuerwerk (Post 693/694)
            if (cp.claims >= 0 && !cp.uuid.empty()) LuckyClaimsSeen(cp.uuid, cp.claims, cp.claimTs, cp.claimTotal, origAddr(cp.start), "ascii", cp.mine);   // Fix 29
            if (cp.claims >= 0 && !cp.uuid.empty()) EggClaimsSeen(cp.uuid, cp.claims, cp.claimTs, 0, "ascii", cp.mine);   // Fix 44: nur gemeldete Eier
            if (cp.attLen > 0) EggOrphanSeen(memStr, cp, regionBase, quiet);   // Fix 63
            continue;
        }
        if (EggOnChatPost(memStr, cp, regionBase, quiet)) continue;   // Fix 44/47: Ei-Post (packetId != 502) -> nie Lucky Gift
        if (GiftPostKind(memStr.substr(std::min(cp.attBody, memStr.size()), cp.attLen)) != GIFT_LUCKY) continue;   // Fix 47: weder Lucky noch Ei
        const uintptr_t addr = origAddr(cp.start);
        if (cp.claims >= 0) LuckyClaimsSeen(cp.uuid, cp.claims, cp.claimTs, cp.claimTotal, addr, "ascii", cp.mine);   // Fix 29: nur bekannte uuids
        if (g_luckySeenHex.count(cp.uuid)) continue;
        if (quiet) {
            MarkLuckySeenHex(cp.uuid);
            g_hotRegions.insert(regionBase);
            continue;
        }
        MarkLuckySeenHex(cp.uuid);
        g_hotRegions.insert(regionBase);
        LuckyReport(cp.uuid, "chat-post sender=" + cp.sender + " room=" + cp.roomId + " seqId=" + cp.seqId, cp.sender, cp.claims, cp.claimTs, cp.claimTotal, cp.mine);
    }
    // Fix 29: UTF-16LE-Kopien der Chat-Posts (Il2Cpp-Strings) – NUR für den Abhol-Zähler bereits gemeldeter Geschenke, nie
    // eine neue Meldung. „customJsonParam“ als UTF-16LE suchen, Fenster (3100 Zeichen davor, 4000 danach) nach UTF-8 umwandeln
    // und mit demselben Parser lesen. Nur solange ein gemeldetes Geschenk noch nicht voll ist (sonst keine Suche).
    // Puffer wird wiederverwendet (kein RAM-Zuwachs).
    if (!LuckyClaimsOpen() && !EggClaimsOpen()) return;   // Fix 44: + offene Ei-Zähler
    static const std::string N_CJP16 = [] { std::string r; for (char c : std::string("customJsonParam")) { r += c; r += '\0'; } return r; }();
    static const size_t J_OFF = 12;                            // Byte-Position des seltenen 'J' im UTF-16-Muster (memchr statt BMH:
    static std::string win;                                    // bei UTF-16 begrenzen die vielen 0-Bytes sonst die Sprungweite)
    for (size_t j = memStr.find('J', J_OFF); j != std::string_view::npos; j = memStr.find('J', j + 1)) {
        if (j + 1 >= memStr.size() || memStr[j + 1] != '\0' || memStr.compare(j - J_OFF, N_CJP16.size(), N_CJP16) != 0) continue;
        const size_t p = j - J_OFF;
        const size_t a = p - 2 * std::min<size_t>(p / 2, 3100);
        const size_t b = std::min(memStr.size(), p + 2 * 4000);
        win.clear();
        size_t key = std::string::npos;
        for (size_t i = a; i + 1 < b; i += 2) {
            if (i == p) key = win.size();
            unsigned c = (unsigned char)memStr[i] | ((unsigned)(unsigned char)memStr[i + 1] << 8);
            if (c >= 0xD800 && c <= 0xDBFF && i + 3 < b) {
                const unsigned d = (unsigned char)memStr[i + 2] | ((unsigned)(unsigned char)memStr[i + 3] << 8);
                if (d >= 0xDC00 && d <= 0xDFFF) { c = 0x10000 + ((c - 0xD800) << 10) + (d - 0xDC00); i += 2; }
            }
            if (c >= 0xD800 && c <= 0xDFFF) c = 0xFFFD;
            if (c < 0x80) win += (char)c;
            else if (c < 0x800) { win += (char)(0xC0 | (c >> 6)); win += (char)(0x80 | (c & 0x3F)); }
            else if (c < 0x10000) { win += (char)(0xE0 | (c >> 12)); win += (char)(0x80 | ((c >> 6) & 0x3F)); win += (char)(0x80 | (c & 0x3F)); }
            else { win += (char)(0xF0 | (c >> 18)); win += (char)(0x80 | ((c >> 12) & 0x3F)); win += (char)(0x80 | ((c >> 6) & 0x3F)); win += (char)(0x80 | (c & 0x3F)); }
        }
        if (key == std::string::npos) continue;
        LuckyChatPost cp;
        LuckyParseChatPost(win, key, cp);
        if (cp.claims >= 0 && !cp.uuid.empty()) LuckyClaimsSeen(cp.uuid, cp.claims, cp.claimTs, cp.claimTotal, origAddr(p), "utf16", cp.mine);
        if (cp.claims >= 0 && !cp.uuid.empty()) EggClaimsSeen(cp.uuid, cp.claims, cp.claimTs, 0, "utf16", cp.mine);   // Fix 44
    }
}
// Worker (aus LuckyScanChunk/LuckyFinishPass): Probe-Thread einmal starten, Ergebnis übernehmen
static void LuckyProbeWorkerTick() {
    static bool started = false;
    if (!started) {
        started = true;
        g_luckyProbeHoldUntil = GetTickCount64() + LUCKY_PROBE_HOLD_MS;
        g_luckyProbeBusy = true;                               // erste Geschenke dieses Durchlaufs schon zurückhalten
        try { std::thread(LuckyProbeThread).detach(); }
        catch (...) { g_luckyProbeBusy = false; }
    }
    if (!g_luckyProbeNews.exchange(false)) return;           // Fix 44: statt Log-Zeile nur das Signal der Probe
    LuckyDetectLang();                                         // neue Sprache aus der Probe -> „luckyLang2“ speichern
}
// Lucky-Gift-Suche in einem gelesenen Block (läuft im selben Durchlauf wie die Dig-Suche).
// Je Block nur EIN Suchlauf: „customJsonParam“ (Chat-Post = einzige Meldequelle).
// Die Dig-Daten werden nicht berührt.
// Fix 114: eigene uid aus dem Client-Log des Spiels: "uid":"<10–20 Ziffern>","sid":"APS… (Chat-Nutzer-JSON hat danach
// kein „sid“). Nur im schon gelesenen Puffer und nur, bis sie gefunden ist (danach kein Aufwand); je Spielprozess neu.
static void OwnUidScanChunk(std::string_view m) {
    if (!g_ownUid.empty()) return;
    static const std::string A = "\",\"sid\":\"APS";
    static const std::boyer_moore_horspool_searcher<std::string::const_iterator> sA(A.begin(), A.end());
    for (auto it = std::search(m.begin(), m.end(), sA); it != m.end(); it = std::search(it + 1, m.end(), sA)) {
        const size_t p = (size_t)(it - m.begin());
        size_t k = p;
        while (k > 0 && p - k <= 20 && m[k - 1] >= '0' && m[k - 1] <= '9') --k;
        const size_t nd = p - k;
        if (nd < 10 || nd > 20 || k < 7 || m.substr(k - 7, 7) != "\"uid\":\"") continue;
        g_ownUid.assign(m.data() + k, nd);
        return;
    }
}
template <class AddrFn>
static void LuckyScanChunk(std::string_view memStr, const AddrFn& origAddr, uintptr_t regionBase, bool quiet) {
    // (Spielsprache: keine eigene Suche hier; LuckyDetectLang nutzt Probe, gespeicherte Sprache bzw. Standard „en“ – Fix 57: nie Dig-Slots)
    // Fix 27: Sprach-Probe läuft im eigenen Thread (LuckyProbeThread); hier nur starten / Ergebnis übernehmen
    LuckyProbeWorkerTick();
    OwnUidScanChunk(memStr);   // Fix 114: vor den Chat-Posts, damit schon dieser Block den Haken bekommt
    LuckyScanChatPosts(memStr, origAddr, regionBase, quiet);
    EggNameScanChunk(memStr);   // Fix 47: nur solange ein Ei-Name fehlt
    EggNameScanChunk16(memStr, origAddr);   // Fix 49: UTF-16-String-Objekte (beim Start vorhanden)
    EggNameDirectKeyScan(memStr, origAddr); // Fix 57: Schlüssel ohne „item_name“ (653074: zone_war_government_12)
    EggNameRefScan(memStr, origAddr);       // Fix 61: Wert über den Dictionary-Eintrag (Schlüssel-Objekt ohne Wert darunter)
    EggNameSiblingScan(memStr, origAddr);   // Fix 55: Steuer-Eier 660100–660103 aus dem Spieltext von 650049 (Stufe)
}
// Ende eines Durchlaufs: Text-Slots mit schwachen uuids paaren, Wartezeiten/Größen begrenzen
static void LuckyFinishPass(bool quiet, bool fullScan) {
    (void)quiet;
    EggNameFinishPass(fullScan);   // Fix 47/48: Ei-Name, wartende Eier, Umbenennen
    LuckyProbeWorkerTick();   // Fix 27
    LuckyCheckRelabel();   // Fix 25: Sprache jetzt bekannt (Fix 57: nur Probe)? -> Ersatzwort-Zeilen umbenennen
    // Text-Slots sind nur noch Info (Meldung kommt allein aus dem Rotpaket-JSON): veraltete Slots entfernen
    for (auto it = g_luckyTexts.begin(); it != g_luckyTexts.end(); ) {
        if (it->second.lastPass != g_digPass) it = g_luckyTexts.erase(it);
        else ++it;
    }
}

// ===== Speicher-Scan (WorkerThread) =====
// Hauptschleife: findet LastWar.exe, durchsucht dessen Speicher nach Digs und meldet Funde
void WorkerThread() {
    // Discord-Gateway starten (nicht im Nur-Benachrichtigungs-Modus)
    std::wstring BOT_TOKEN;
    {
        std::lock_guard<std::mutex> lock(g_discordCfgMutex);
        BOT_TOKEN = g_discordToken;
    }
    if (!g_notiOnlyMode) {
        std::thread([BOT_TOKEN]() { StartDiscordGateway(BOT_TOKEN); }).detach();
    }
    // Failsafe-Thread starten
    std::thread(FailsafeThread).detach();
    // Ziel-Texte je Sprache: „Schatz ausgraben“ und „Testflugstörung“ (16 Sprachen)
    std::vector<std::string> baseTargets = {
        "Dig Up Treasure", "Test Flight Failure",
        "Grabe einen Schatz aus", "Testflugstörung",
        "Creuser le trésor", "Échec Test de Vol",
        "Выкопать сокровище", "Неудача испытательного полета",
        "보물 채굴", "시험 비행 오류",
        "ขุดสมบัติ", "ทดลองบินขัดข้อง",
        "地中の財宝", "試験飛行失敗",
        "Escavar o Tesouro", "Falha no voo de teste",
        "Excavar Tesoro", "Fallo de Prueba de Vuelo",
        "Hazineyi kaz", "Test Uçuşu Arızası",
        "挖掘寶藏", "試飛故障",
        "Scava Il Tesoro", "Malfunzionamento del volo di prova",
        "حفر الكنز", "عطل التجربة",
        "Đào Kho Báu", "Sự Cố Bay Thử",
        "Gali Harta Karun", "Uji Penerbangan Gagal",
        "Wykop skarb", "Niepowodzenie lotu testowego"
    };
    // Start-Verzögerung (Fix 51: kein Discord-Ping-Cooldown mehr)
    auto programStart = std::chrono::steady_clock::time_point{};
    bool cooldownActive = false;
    bool quietFirstPass = false;   // Fix 68: erster (voller) Durchlauf je Prozess immer still = Grundbestand, auch ohne „Start in“
    // Blacklist: Wörter von Fehler- und Warte-Meldungen (kein echter Dig)
    static const std::vector<std::string> CTX_BLACKLIST = {
        "Fehler beim", "waiting for", "<u>", "</u>",
        "Error while", "Error on", "Failed to", "Waiting for",
        "Warte auf", "Warten auf", "Fehler bei",
        "Erreur lors", "Erreur pendant", "En attente de", "en attente",
        "Ошибка при", "Ожидание", "ожидание",
        "오류", "대기 중",
        "เกิดข้อผิดพลาด", "กำลังรอ",
        "エラー", "待機中",
        "Erro ao", "Aguardando", "aguardando",
        "Error al", "Esperando", "esperando",
        "Hata", "Bekleniyor", "bekleniyor",
        "錯誤", "等待中",
        "Errore durante", "In attesa", "in attente",
        "خطأ", "في انتظار",
        "Lỗi", "Đang chờ", "đang chờ",
        "Kesalahan", "Menunggu", "menunggu",
        "Błąd podczas", "Oczekiwanie", "oczekiwanie"
    };
    // Warzone-Marker je Sprache ohne Nummer, z. B. „(Warzone #“; Fix 43: dahinter muss eine gültige Warzone-Nummer
    // (1–6 Ziffern) stehen – jede Warzone, keine Server-Einstellung mehr (Digs kommen nur aus dem Allianz-Chat)
    std::vector<std::string> requiredContexts = {
        "(Warzone #",
        "(Kriegszone #",
        "(Zone de Guerre #",
        "(БЗ #",
        "(서버 #",
        "(เซิร์ฟเวอร์ #",
        "(戦域#",
        "(Zona de Guerra #",
        "(Servidor #",
        "(Savaş Alanı #",
        "(Zona di guerra #",
        "(戰區 #",
        "(Chiến Khu #",
        "(Strefa wojny #"
    };
    const std::string hashMarker = "#";
    // Vorfilter für die Suche: Bitmaske der Ziel-Texte je erstem bzw. zweitem Byte (max. 64 Ziel-Texte, alle >= 2 Bytes)
    unsigned long long targetFirst[256] = {};
    unsigned long long targetSecond[256] = {};
    for (size_t ti = 0; ti < baseTargets.size() && ti < 64; ++ti) {
        const std::string& t = baseTargets[ti];
        if (t.size() < 2) continue;
        targetFirst[(unsigned char)t[0]] |= (1ULL << ti);
        targetSecond[(unsigned char)t[1]] |= (1ULL << ti);
    }
    // Fund melden: Log, Blase/Tray (UI-Thread), Discord-Ping (Fix 51: ohne Cooldown)
    auto reportDig = [&](const DigSlot& vd) {
        std::string timeStr = now_time_hms();
        AddDigLog(
            std::wstring(timeStr.begin(), timeStr.end()),
            vd.sid,   // Fix 43: Warzone aus dem Dig-Text
            std::wstring(vd.xs.begin(), vd.xs.end()),
            std::wstring(vd.ys.begin(), vd.ys.end()),
            StrictUtf8ToWide(vd.pattern),
            StrictUtf8ToWide(StrictStripBidi(vd.zoneWord)),  // BiDi-Zeichen nur für die Anzeige entfernt
            vd.zoneWordOk,
            vd.type == 'F'   // Fix 120: Testflugdrohne (Slot-Art aus dem geprüften Ziel-Text, gepaart mit oname des JSON)
        );
        // Discord-Ping für jeden gemeldeten Dig (nicht im Nur-Benachrichtigungs-Modus); Fix 51: kein Cooldown
        if (!g_notiOnlyMode) sendDiscordPing();
        };
    // Ende eines Durchlaufs: verschwundene Slots entfernen, neue uuids 1:1 mit freien Slots paaren und melden,
    // nach Ablauf der Wartezeit uuids ohne Slot bzw. Slots ohne uuid still verwerfen.
    auto finishDigPass = [&](bool quiet, bool fullScan) {
        // 1) Slot in diesem Durchlauf nicht mehr gefunden -> Nachricht entladen (alle Slot-Bereiche sind Hot-Regions
        //    und werden in jedem Durchlauf gelesen)
        for (auto it = g_digSlots.begin(); it != g_digSlots.end(); ) {
            if (it->second.lastPass != g_digPass) it = g_digSlots.erase(it);
            else ++it;
        }
        // 2) Start-Verzögerung: alle vorhandenen Slots gehören zu alten Posts
        if (quiet) {
            for (auto& kv : g_digSlots) kv.second.consumed = true;
        }
        // 3) Freie Slots, die schon durch bekannte uuids erklärt sind (so viele bekannte uuids dieser Dig-Art/Koordinaten
        //    in diesem Durchlauf wie Slots): neu geladene Kopie eines alten Posts -> still verbrauchen
        for (auto& kv : g_digSlots) {
            DigSlot& sl = kv.second;
            if (sl.consumed) continue;
            size_t nSlots = 0;
            for (const auto& o : g_digSlots) if (o.second.type == sl.type && o.second.x == sl.x && o.second.y == sl.y && o.second.sid == sl.sid) ++nSlots;
            std::vector<unsigned long long> known;
            for (const auto& ls : g_liveSeen)
                if (ls.type == sl.type && ls.x == sl.x && ls.y == sl.y && ls.sid == sl.sid && std::find(known.begin(), known.end(), ls.uuid) == known.end()) known.push_back(ls.uuid);
            if (known.size() < nSlots) continue;
            sl.consumed = true;
        }
        // 4) Paarung 1:1 (gierig): bekannte Dig-Art zuerst, dann Paare, deren erste Funde zeitlich am nächsten liegen
        //    (JSON und eigener fulltext stehen in derselben Tabelle und tauchen zusammen auf), dann kleinere uuid, älterer Slot
        for (int unknownPass = 0; unknownPass < 2; ++unknownPass) {
            struct Cand { unsigned long long dist, uuid; unsigned ff; uintptr_t addr; };
            std::vector<Cand> cands;
            for (const auto& pk : g_pendingMsgs) {
                const PendingMsg& pm = pk.second;
                if ((pm.type == '?') != (unknownPass == 1)) continue;
                if (g_seenMsgIds.count(pk.first)) continue;
                bool freeT = false, freeF = false;
                for (const auto& kv : g_digSlots) {
                    const DigSlot& sl = kv.second;
                    if (sl.consumed || sl.x != pm.x || sl.y != pm.y || sl.sid != pm.sid) continue;
                    if (sl.type == 'T') freeT = true; else freeF = true;
                }
                // Unbekanntes „oname“: nur wenn an den Koordinaten genau eine Dig-Art freie Slots hat
                if (pm.type == '?' && freeT == freeF) continue;
                const char want = (pm.type != '?') ? pm.type : (freeT ? 'T' : 'F');
                for (const auto& kv : g_digSlots) {
                    const DigSlot& sl = kv.second;
                    if (sl.consumed || sl.type != want || sl.x != pm.x || sl.y != pm.y || sl.sid != pm.sid) continue;
                    const unsigned long long d = (pm.firstPass > sl.firstPass) ? pm.firstPass - sl.firstPass : sl.firstPass - pm.firstPass;
                    cands.push_back({ d, pk.first, sl.firstFull, kv.first });
                }
            }
            std::sort(cands.begin(), cands.end(), [](const Cand& a, const Cand& b) {
                if (a.dist != b.dist) return a.dist < b.dist;
                if (a.uuid != b.uuid) return a.uuid < b.uuid;
                if (a.ff != b.ff) return a.ff < b.ff;
                return a.addr < b.addr;
                });
            for (const Cand& c : cands) {
                auto pIt = g_pendingMsgs.find(c.uuid);
                auto sIt = g_digSlots.find(c.addr);
                if (pIt == g_pendingMsgs.end() || sIt == g_digSlots.end() || sIt->second.consumed) continue;
                DigSlot& sl = sIt->second;
                sl.consumed = true;
                sl.boundUuid = c.uuid;
                MarkMsgSeen(c.uuid);
                g_pendingMsgs.erase(pIt);
                reportDig(sl);
            }
        }
        for (auto it = g_pendingMsgs.begin(); it != g_pendingMsgs.end(); )
            it = g_seenMsgIds.count(it->first) ? g_pendingMsgs.erase(it) : std::next(it);
        // 5) Ungemeldete uuids warten bis DIG_PENDING_TTL_MS auf ihren fulltext; danach nur vergessen (NICHT als bekannt
        //    merken – taucht das JSON wieder auf, wartet es erneut)
        {
            const ULONGLONG nowTick = GetTickCount64();
            for (auto it = g_pendingMsgs.begin(); it != g_pendingMsgs.end(); ) {
                if (nowTick - it->second.firstTick >= DIG_PENDING_TTL_MS) it = g_pendingMsgs.erase(it);
                else ++it;
            }
        }
        // Voller Scan beendet: freie Slots ohne wartende uuid nach Wartezeit still verbrauchen
        if (fullScan) {
            ++g_fullScans;
            for (auto& kv : g_digSlots) {
                DigSlot& sl = kv.second;
                if (sl.consumed || g_fullScans - sl.firstFull < DIG_GRACE_FULL_SCANS) continue;
                bool waiting = false;
                for (const auto& pk : g_pendingMsgs)
                    if (pk.second.x == sl.x && pk.second.y == sl.y && pk.second.sid == sl.sid && (pk.second.type == sl.type || pk.second.type == '?')) { waiting = true; break; }
                if (waiting) continue;
                sl.consumed = true;
            }
        }
        // 6) Größe begrenzen (RAM bleibt konstant)
        while (g_pendingMsgs.size() > PENDING_MSG_CAP) {
            auto oldest = g_pendingMsgs.begin();
            for (auto it = g_pendingMsgs.begin(); it != g_pendingMsgs.end(); ++it)
                if (it->second.firstTick < oldest->second.firstTick) oldest = it;
            g_pendingMsgs.erase(oldest);
        }
        };
    // Suche nach dem Anhang-JSON geteilter Digs (Boyer-Moore-Horspool, einmal erstellt)
    static const std::string JSON_NEEDLE = "\"shareType\":27";
    static const std::boyer_moore_horspool_searcher<std::string::const_iterator> jsonSearcher(JSON_NEEDLE.begin(), JSON_NEEDLE.end());
    // Handle und PID des überwachten Last-War-Prozesses
    HANDLE hProcess = nullptr;
    DWORD currentPid = 0;
    // PID, bei der OpenProcess fehlgeschlagen ist (kein Zugriff), und Zeitpunkt des letzten Versuchs
    DWORD deniedPid = 0;
    ULONGLONG deniedTick = 0;
    while (true) {
        // Auto Refresh Game (nur mit Häkchen): LastWar.exe beenden und neu starten. Die Start-Verzögerung läuft danach
        // über den neu erkannten Prozess (waiting -> searching); kein Reset ohne Spiel-Neustart mehr.
        if (g_resetRequested.exchange(false)) {
            if (AutoRefreshActive()) {
                g_hotRegions.clear();
                DWORD pid = GetPIDByName(L"LastWar.exe");
                if (pid) {
                    if (hProcess) {
                        CloseHandle(hProcess);
                        hProcess = nullptr;
                    }
                    terminateProcessAndWait(pid, 5000);
                    currentPid = 0;
                    Sleep(100);
                }
                StartLastWarGame();
            }
        }
        // Läuft Last War? Neuer Prozess: Handle öffnen, Hot-Regions leeren, Start-Verzögerung starten
        // (gemeldete uuids bleiben erhalten – die uuids sind nach einem Spiel-Neustart dieselben)
        DWORD pid = GetPIDByName(L"LastWar.exe");
        bool running = (pid != 0);
        g_lastWarRunning = running;
        // Kein Zugriff auf dieselbe PID: nur alle 5 s erneut versuchen, ohne jedes Mal Duplikatschutz und Start-Verzögerung neu zu starten
        bool deniedRetry = running && hProcess == nullptr && pid == deniedPid;
        if (running && (hProcess == nullptr || currentPid != pid) && (!deniedRetry || GetTickCount64() - deniedTick >= 5000)) {
            if (hProcess) CloseHandle(hProcess);
            hProcess = OpenProcess(PROCESS_VM_READ | PROCESS_QUERY_INFORMATION, FALSE, pid);
            currentPid = pid;
            if (hProcess) { deniedPid = 0; g_lastWarNoAccess = false; }
            else { deniedPid = pid; deniedTick = GetTickCount64(); g_lastWarNoAccess = true; }
            if (hProcess || !deniedRetry) {
                g_hotRegions.clear();
                g_digSlots.clear();          // Slots (Adressen) gehören zum alten Prozess
                g_luckyTexts.clear();        // Lucky-Gift-Text-Slots ebenso
                g_ownUid.clear();            // Fix 114: eigene uid je Prozess neu suchen
                programStart = std::chrono::steady_clock::now();
                g_cooldownStart = TimePointToTicks(programStart);
                cooldownActive = true;
                quietFirstPass = true;
            }
        }
        if (!running) { deniedPid = 0; g_lastWarNoAccess = false; }
        // Last War beendet: Handle schließen
        if (!running && hProcess) {
            CloseHandle(hProcess);
            hProcess = nullptr;
            currentPid = 0;
            cooldownActive = false;
        }

        // Speicher von Last War durchsuchen
        if (running && hProcess) {
            // Durchlauf beginnt in der Start-Verzögerung: alle jetzt im Speicher vorhandenen Dig-Nachrichten
            // gelten als alt (uuid als bekannt merken, nicht melden)
            // Fix 68: mit Discord wie bisher bis „Start in“ abgelaufen ist; ohne Discord (StartInSeconds() = 0) nur der erste Durchlauf
            const bool passQuiet = cooldownActive && (quietFirstPass ||
                std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() - programStart).count() < StartInSeconds());
            quietFirstPass = false;
            ++g_digPass;
            g_liveSeen.clear();
            bool fullScan = false;
            SYSTEM_INFO sys; GetSystemInfo(&sys);
            LPCVOID start = sys.lpMinimumApplicationAddress;
            LPCVOID end = sys.lpMaximumApplicationAddress;
            SIZE_T bytesRead;
            static std::vector<char> buffer;
            MEMORY_BASIC_INFORMATION mbi;

            // Bevorzugt nur Hot-Regions (Bereiche mit früheren Funden) scannen
            std::vector<LPCVOID> regionsToScan;
            if (!g_hotRegions.empty()) {
                for (uintptr_t base : g_hotRegions) {
                    if (VirtualQueryEx(hProcess, (LPCVOID)base, &mbi, sizeof(mbi)) &&
                        mbi.State == MEM_COMMIT && mbi.Type == MEM_PRIVATE &&
                        (mbi.Protect & 0xFF) == PAGE_READWRITE &&
                        !(mbi.Protect & PAGE_GUARD)) {
                        regionsToScan.push_back((LPCVOID)base);
                    }
                }
                // Jeder 10. Durchlauf: voller Scan, um neue Bereiche zu finden
                static int scanCounter = 0;
                if (++scanCounter >= 10 || EggNameWantsFullScan()) {   // Fix 48: Ei wartet auf seinen Namen -> voll
                    scanCounter = 0;
                    regionsToScan.clear();
                }
            }

            // Voller Scan: alle privaten, beschreibbaren Speicherbereiche sammeln
            if (regionsToScan.empty()) {
                fullScan = true;
                LPCVOID addr = start;
                while (addr < end) {
                    if (VirtualQueryEx(hProcess, addr, &mbi, sizeof(mbi)) == 0) break;
                    bool readable = (mbi.State == MEM_COMMIT) &&
                        (mbi.Type == MEM_PRIVATE) &&
                        ((mbi.Protect & 0xFF) == PAGE_READWRITE) &&
                        !(mbi.Protect & PAGE_GUARD);
                    if (readable && mbi.RegionSize > 0) {
                        regionsToScan.push_back(mbi.BaseAddress);
                    }
                    addr = (LPCVOID)((uintptr_t)mbi.BaseAddress + mbi.RegionSize);
                }
            }

            EggNameBeginPass(fullScan);   // Fix 48: sucht dieser Durchlauf Ei-Namen?
            // In 1-MB-Blöcken lesen (begrenzt den RAM-Verbrauch); Blöcke überlappen um CHUNK_OVERLAP Bytes
            constexpr SIZE_T MAX_CHUNK = 1 * 1024 * 1024;
            constexpr SIZE_T CHUNK_OVERLAP = 4096;
            static_assert(CHUNK_OVERLAP > STRICT_MAX_STRING + 8 + 2 * 80 + 64, "Ueberlappung zu klein");
            // Wiederverwendete Hilfspuffer (Treffer: Ziel-Index + Position; U+200B-Verschiebungen)
            static std::vector<std::pair<size_t, size_t>> hits;
            static std::vector<std::pair<size_t, size_t>> zwsShifts;

            for (LPCVOID regionBase : regionsToScan) {
                if (VirtualQueryEx(hProcess, regionBase, &mbi, sizeof(mbi)) == 0) continue;
                if (mbi.State != MEM_COMMIT || mbi.Type != MEM_PRIVATE ||
                    (mbi.Protect & 0xFF) != PAGE_READWRITE || (mbi.Protect & PAGE_GUARD)) continue;

                SIZE_T remaining = mbi.RegionSize;
                LPCVOID chunkAddr = mbi.BaseAddress;

                while (remaining > 0) {
                    SIZE_T chunkSize = std::min(remaining, MAX_CHUNK);
                    buffer.resize(chunkSize);
                    bytesRead = 0;
                    BOOL readOk = ReadProcessMemory(hProcess, chunkAddr, buffer.data(), chunkSize, &bytesRead);
                    // Teilweise lesbarer Block: den gelesenen Anfang trotzdem auswerten
                    if (!readOk && GetLastError() == ERROR_PARTIAL_COPY && bytesRead > 0) readOk = TRUE;
                    if (readOk && bytesRead > 0) {
                        char* data = buffer.data();
                        size_t dataLen = (size_t)bytesRead;
                        // Zero-Width-Spaces (U+200B) in einem Durchgang direkt im Puffer entfernen
                        // (Ergebnis wie beim wiederholten Entfernen, auch neu entstehende Folgen).
                        // zwsShifts merkt sich, ab welcher Position im bereinigten Block wie viele Bytes
                        // davor entfernt wurden -> Adressen werden auf den Originalspeicher zurückgerechnet.
                        zwsShifts.clear();
                        size_t firstZws = std::string_view(data, dataLen).find("\xE2\x80\x8B");
                        if (firstZws != std::string_view::npos) {
                            size_t w = firstZws;
                            for (size_t i = firstZws; i < dataLen; ++i) {
                                size_t delta = i - w;
                                while (!zwsShifts.empty() && zwsShifts.back().first >= w) zwsShifts.pop_back();
                                if (delta != (zwsShifts.empty() ? 0 : zwsShifts.back().second))
                                    zwsShifts.emplace_back(w, delta);
                                data[w++] = data[i];
                                if (w >= 3 && (unsigned char)data[w - 3] == 0xE2 && (unsigned char)data[w - 2] == 0x80 && (unsigned char)data[w - 1] == 0x8B)
                                    w -= 3;
                            }
                            while (!zwsShifts.empty() && zwsShifts.back().first >= w) zwsShifts.pop_back();
                            dataLen = w;
                        }
                        const std::string_view memStr(data, dataLen);
                        // Adresse im Originalspeicher (vor dem Entfernen der U+200B) zu einer Position im Puffer
                        auto origAddr = [&](size_t p) -> uintptr_t {
                            size_t shift = 0;
                            if (!zwsShifts.empty()) {
                                auto it = std::upper_bound(zwsShifts.begin(), zwsShifts.end(), p,
                                    [](size_t v, const std::pair<size_t, size_t>& e) { return v < e.first; });
                                if (it != zwsShifts.begin()) shift = std::prev(it)->second;
                            }
                            return (uintptr_t)chunkAddr + p + shift;
                            };
                        // Alle Ziel-Texte in einem Durchgang suchen (Vorfilter über die ersten zwei Bytes),
                        // danach wie bisher Ziel-Text für Ziel-Text in aufsteigender Position auswerten
                        hits.clear();
                        if (dataLen >= 2) {
                            const unsigned char* u = (const unsigned char*)data;
                            for (size_t p = 0; p + 1 < dataLen; ++p) {
                                unsigned long long cand = targetFirst[u[p]] & targetSecond[u[p + 1]];
                                for (size_t ti = 0; cand; ++ti, cand >>= 1) {
                                    if (!(cand & 1ULL)) continue;
                                    const std::string& pat = baseTargets[ti];
                                    if (pat.size() <= dataLen - p && memcmp(data + p, pat.data(), pat.size()) == 0)
                                        hits.emplace_back(ti, p);
                                }
                            }
                            std::sort(hits.begin(), hits.end());
                        }
                        for (const auto& hit : hits) {
                            const std::string& pattern = baseTargets[hit.first];
                            const size_t pos = hit.second;
                            const uintptr_t addrFound = origAddr(pos);
                            // Vorprüfung: Warzone-Marker im ±80-Byte-Fenster um den Treffer
                            bool contextOk = false;
                            size_t checkStart = (pos > 80) ? pos - 80 : 0;
                            size_t checkEnd = std::min(memStr.size(), pos + pattern.size() + 80);
                            std::string_view rawContext = memStr.substr(checkStart, checkEnd - checkStart);
                            for (const auto& ctx : requiredContexts) {
                                if (DigHasMarker(rawContext, ctx)) {
                                    contextOk = true;
                                    break;
                                }
                            }
                            // Sprachen ohne eigenen Marker (z. B. Arabisch): „#<Warzone>“ (gültige Nummer) genügt
                            if (!contextOk && DigHasMarker(rawContext, hashMarker))
                                contextOk = true;
                            if (!contextOk) continue;
                            size_t posTag;
                            // Strenge Prüfung: Koordinaten nur aus demselben String, nach dem Ziel-Text
                            StrictDigResult strict = StrictDigCheck(memStr, pos, pattern, requiredContexts);
                            if (!strict.ok) continue;
                            // Blacklist nur auf den Teil nach dem Ziel-Text (ohne <u></u>) – manche Ziel-Texte
                            // enthalten selbst ein Blacklist-Wort (Koreanisch „시험 비행 오류“ enthält „오류“)
                            std::string strForBlacklist = strict.str.substr(pattern.size());
                            while ((posTag = strForBlacklist.find("<u>")) != std::string::npos)
                                strForBlacklist.erase(posTag, 3);
                            while ((posTag = strForBlacklist.find("</u>")) != std::string::npos)
                                strForBlacklist.erase(posTag, 4);
                            bool blocked = false;
                            for (const auto& bad : CTX_BLACKLIST)
                                if (strForBlacklist.find(bad) != std::string::npos) { blocked = true; break; }
                            if (blocked) continue;
                            // Dig-Art aus dem Ziel-Text (baseTargets: gerader Index = „Schatz ausgraben“, ungerader = „Testflugstörung“)
                            const char digType = (hit.first % 2 == 0) ? 'T' : 'F';
                            const int digX = std::stoi(strict.x), digY = std::stoi(strict.y);
                            // Bereich als Hot-Region merken
                            g_hotRegions.insert((uintptr_t)mbi.BaseAddress);
                            // Warzone-Wort wie im Spiel (Text zwischen „(“ und „#“, ohne <u>) – nur für die Log-Anzeige
                            std::string zoneWord;
                            bool zoneWordOk = false;
                            {
                                size_t zp = strict.str.find('(', pattern.size());
                                size_t zh = (zp != std::string::npos) ? strict.str.find('#', zp) : std::string::npos;
                                if (zh != std::string::npos) {
                                    zoneWord = strict.str.substr(zp + 1, zh - zp - 1);
                                    while ((posTag = zoneWord.find("<u>")) != std::string::npos) zoneWord.erase(posTag, 3);
                                    zoneWordOk = true;
                                }
                            }
                            // Klartext-fulltext (ohne <u>) = Slot dieses Posts; Anzeige-Kopien mit <u> sind keine Slots
                            if (strict.str.find("<u>") == std::string::npos && strict.str.find("</u>") == std::string::npos) {
                                auto sIt = g_digSlots.find(addrFound);
                                if (sIt != g_digSlots.end() && (sIt->second.type != digType || sIt->second.text != strict.str)) {
                                    g_digSlots.erase(sIt);
                                    sIt = g_digSlots.end();
                                }
                                if (sIt != g_digSlots.end()) sIt->second.lastPass = g_digPass;
                                else if (g_digSlots.size() < DIG_SLOT_CAP) {
                                    DigSlot sl;
                                    sl.type = digType; sl.x = digX; sl.y = digY; sl.sid = std::stoi(strict.server);
                                    sl.pattern = pattern; sl.xs = strict.x; sl.ys = strict.y; sl.text = strict.str;
                                    sl.zoneWord = zoneWord; sl.zoneWordOk = zoneWordOk;
                                    sl.consumed = passQuiet;
                                    sl.firstFull = g_fullScans;
                                    sl.lastPass = g_digPass;
                                    sl.firstPass = g_digPass;
                                    g_digSlots.emplace(addrFound, std::move(sl));
                                }
                            }
                        }
                        // Anhang-JSON geteilter Digs im selben Puffer suchen: "shareType":27 -> {…} -> uuid, x, y, sid, oname
                        for (auto jt = std::search(memStr.begin(), memStr.end(), jsonSearcher); jt != memStr.end();
                            jt = std::search(jt + 1, memStr.end(), jsonSearcher)) {
                            const size_t q = (size_t)(jt - memStr.begin());
                            std::string_view json;
                            DigJsonInfo ji;
                            if (!ExtractDigJson(memStr, q, json) || !ParseDigJson(json, ji)) continue;
                            if (ji.sid <= 0) continue;   // Fix 43: jede Warzone (ParseDigJson: 1–6 Ziffern)
                            g_hotRegions.insert((uintptr_t)mbi.BaseAddress);
                            if (g_seenMsgIds.count(ji.uuid)) {
                                if (g_liveSeen.size() < LIVE_SEEN_CAP) g_liveSeen.push_back({ ji.uuid, ji.type, ji.x, ji.y, ji.sid });
                                continue;
                            }
                            if (g_pendingMsgs.count(ji.uuid)) continue;
                            // In der Start-Verzögerung vorhandene Nachrichten: als bekannt merken, nicht melden
                            if (passQuiet) {
                                MarkMsgSeen(ji.uuid);
                                continue;
                            }
                            PendingMsg pm;
                            pm.x = ji.x; pm.y = ji.y; pm.sid = ji.sid; pm.type = ji.type; pm.firstFull = g_fullScans; pm.firstPass = g_digPass; pm.firstTick = GetTickCount64();
                            g_pendingMsgs[ji.uuid] = pm;
                        }
                        // Lucky Gift: im selben Puffer, eigener Duplikatschutz, berührt die Dig-Daten nicht
                        LuckyScanChunk(memStr, origAddr, (uintptr_t)mbi.BaseAddress, passQuiet);
                    }
                    // Nächster Block überlappt um CHUNK_OVERLAP Bytes, damit Strings an Blockgrenzen
                    // (inkl. Längenfeld und ±80-Byte-Fenster) vollständig in einem Block liegen
                    if (remaining <= chunkSize) break;
                    SIZE_T step = chunkSize - CHUNK_OVERLAP;
                    chunkAddr = (LPCVOID)((uintptr_t)chunkAddr + step);
                    remaining -= step;
                }
            }
            // Ende des Durchlaufs: neue uuids mit ihren eigenen fulltexts paaren und melden
            finishDigPass(passQuiet, fullScan);
            LuckyFinishPass(passQuiet, fullScan);
        }
        // Pause zwischen den Durchläufen (spart CPU)
        Sleep(250);
    }
}

// ===== Einstellungsfenster: Prüfung der Eingaben =====
// Nur Ziffern?
static bool IsDigitsOnly(const std::wstring& s) {
    if (s.empty()) return false;
    for (wchar_t c : s) if (!iswdigit(c)) return false;
    return true;
}
// Ergebnis der Online-Prüfung von Token und Channel
static std::atomic<bool> g_tokenValid{ false };
static std::atomic<bool> g_channelValid{ false };
static std::wstring g_lastCheckedToken;
static std::wstring g_lastCheckedChannel;
// Prüfungen laufen erst 500 ms nach der letzten Eingabe (statt ein Thread pro Tastendruck);
// die Generationszähler verwerfen Ergebnisse veralteter Prüfungen
#define TIMER_TOKEN_CHECK   41
#define TIMER_CHANNEL_CHECK 42
static const UINT CHECK_DEBOUNCE_MS = 500;
static std::mutex g_checkMutex;
static unsigned g_tokenCheckGen = 0;
static unsigned g_channelCheckGen = 0;
static std::wstring g_pendingTokenCheck;
static std::wstring g_pendingChannelToken;
static std::wstring g_pendingChannelCheck;
// GET-Anfrage an die Discord-API mit Bot-Token; liefert den HTTP-Status (0 = keine Antwort)
// Fix 95: optional den Antworttext (nur bei 200, höchstens 64 KB) für den Namen des Bots/Channels
static DWORD DiscordApiGetStatus(const wchar_t* agent, const std::wstring& path, const std::wstring& token, std::string* body = nullptr) {
    HINTERNET s = WinHttpOpen(agent, WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, 0, 0, 0);
    if (!s) return 0;
    WinHttpSetTimeouts(s, 5000, 5000, 5000, 5000);
    HINTERNET c = WinHttpConnect(s, L"discord.com", INTERNET_DEFAULT_HTTPS_PORT, 0);
    if (!c) { WinHttpCloseHandle(s); return 0; }
    HINTERNET r = WinHttpOpenRequest(c, L"GET", path.c_str(), 0, 0, 0, WINHTTP_FLAG_SECURE);
    if (!r) { WinHttpCloseHandle(c); WinHttpCloseHandle(s); return 0; }
    std::wstring headers = L"Authorization: Bot " + token;
    DWORD status = 0, size = sizeof(status);
    if (WinHttpSendRequest(r, headers.c_str(), (DWORD)headers.length(), 0, 0, 0, 0) &&
        WinHttpReceiveResponse(r, 0)) {
        if (!WinHttpQueryHeaders(r, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, 0, &status, &size, 0)) status = 0;
        if (body && status == 200) {
            for (;;) {
                DWORD avail = 0, got = 0;
                if (!WinHttpQueryDataAvailable(r, &avail) || avail == 0 || body->size() + avail > 64 * 1024) break;
                const size_t old = body->size();
                body->resize(old + avail);
                if (!WinHttpReadData(r, &(*body)[old], avail, &got)) { body->resize(old); break; }
                body->resize(old + got);
                if (got == 0) break;
            }
        }
    }
    WinHttpCloseHandle(r); WinHttpCloseHandle(c); WinHttpCloseHandle(s);
    return status;
}
// Fix 95: ersten String-Wert zu „key“ aus einer JSON-Antwort lesen (Escapes, \uXXXX); ohne Steuerzeichen, max. 100 Zeichen
static std::wstring JsonFirstStringField(const std::string& j, const char* key) {
    const std::string pat = std::string("\"") + key + "\"";
    for (size_t p = j.find(pat); p != std::string::npos; p = j.find(pat, p + 1)) {
        size_t q = p + pat.size();
        while (q < j.size() && (j[q] == ' ' || j[q] == '\t' || j[q] == '\r' || j[q] == '\n')) ++q;
        if (q >= j.size() || j[q] != ':') continue;
        ++q;
        while (q < j.size() && (j[q] == ' ' || j[q] == '\t' || j[q] == '\r' || j[q] == '\n')) ++q;
        if (q >= j.size() || j[q] != '"') return std::wstring();   // null o. ä.
        std::wstring out;
        std::string raw;
        auto flush = [&]() { if (!raw.empty()) { out += StrictUtf8ToWide(raw); raw.clear(); } };
        for (size_t i = q + 1; i < j.size(); ++i) {
            const char ch = j[i];
            if (ch == '"') {
                flush();
                std::wstring clean;
                for (wchar_t w : out) if (w >= 32 && w != 127) clean += w;
                while (!clean.empty() && clean.back() == L' ') clean.pop_back();
                while (!clean.empty() && clean.front() == L' ') clean.erase(clean.begin());
                if (clean.size() > 100) clean.resize(100);
                return clean;
            }
            if (ch != '\\') { raw += ch; continue; }
            if (++i >= j.size()) break;
            const char e = j[i];
            if (e == 'u') {
                if (i + 4 >= j.size()) break;
                unsigned v = 0;
                bool ok = true;
                for (int k = 1; k <= 4; ++k) {
                    const char h = j[i + k];
                    v <<= 4;
                    if (h >= '0' && h <= '9') v |= (unsigned)(h - '0');
                    else if (h >= 'a' && h <= 'f') v |= (unsigned)(h - 'a' + 10);
                    else if (h >= 'A' && h <= 'F') v |= (unsigned)(h - 'A' + 10);
                    else ok = false;
                }
                if (!ok) break;
                flush();
                out += (wchar_t)v;
                i += 4;
            }
            else if (e == 'n' || e == 'r' || e == 't') { flush(); out += L' '; }
            else if (e == 'b' || e == 'f') {}
            else raw += e;   // \" \\ \/
        }
        return std::wstring();
    }
    return std::wstring();
}
// Fix 95: Ergebnis der letzten Prüfung samt Namen (unter g_checkMutex): zu welchem Token/Channel gehört der Name
static std::wstring g_tokenLookupFor, g_tokenLookupName;
static std::wstring g_channelLookupFor, g_channelLookupTok, g_channelLookupName;
static std::wstring g_lastCheckedChannelToken;
// Prüft den Bot-Token asynchron über die Discord-API (/users/@me)
static void CheckTokenAsync(const std::wstring& token) {
    if (token == g_lastCheckedToken) return;
    g_lastCheckedToken = token;
    {
        std::lock_guard<std::mutex> lock(g_checkMutex);
        ++g_tokenCheckGen;
        g_tokenValid = false;
    }
    g_pendingTokenCheck = token;
    if (g_hConfigWnd) SetTimer(g_hConfigWnd, TIMER_TOKEN_CHECK, CHECK_DEBOUNCE_MS, nullptr);
}
// Startet die zuletzt angeforderte Token-Prüfung (nach Ablauf der Wartezeit)
static void StartTokenCheck() {
    std::wstring token = g_pendingTokenCheck;
    unsigned gen;
    {
        std::lock_guard<std::mutex> lock(g_checkMutex);
        gen = g_tokenCheckGen;
    }
    try {
        std::thread([token, gen]() {
            std::string body;
            DWORD status = DiscordApiGetStatus(L"TokenCheck/1.0", L"/api/v10/users/@me", token, &body);
            const std::wstring name = (status == 200) ? JsonFirstStringField(body, "username") : std::wstring();
            {
                std::lock_guard<std::mutex> lock(g_checkMutex);
                if (gen != g_tokenCheckGen) return;
                g_tokenValid = (status == 200);
                g_tokenLookupFor = token;
                g_tokenLookupName = name;
            }
            PostMessageW(g_hConfigWnd, WM_APP + 1, 0, 0);
            }).detach();
    }
    catch (...) {}
}
// Prüft die Channel-ID asynchron über die Discord-API
static void CheckChannelAsync(const std::wstring& token, const std::wstring& channel) {
    if (channel == g_lastCheckedChannel && token == g_lastCheckedChannelToken) return;   // Fix 95: anderer Bot -> neu prüfen
    g_lastCheckedChannel = channel;
    g_lastCheckedChannelToken = token;
    {
        std::lock_guard<std::mutex> lock(g_checkMutex);
        ++g_channelCheckGen;
        g_channelValid = false;
    }
    g_pendingChannelToken = token;
    g_pendingChannelCheck = channel;
    if (g_hConfigWnd) SetTimer(g_hConfigWnd, TIMER_CHANNEL_CHECK, CHECK_DEBOUNCE_MS, nullptr);
}
// Startet die zuletzt angeforderte Channel-Prüfung (nach Ablauf der Wartezeit)
static void StartChannelCheck() {
    std::wstring token = g_pendingChannelToken;
    std::wstring channel = g_pendingChannelCheck;
    unsigned gen;
    {
        std::lock_guard<std::mutex> lock(g_checkMutex);
        gen = g_channelCheckGen;
    }
    try {
        std::thread([token, channel, gen]() {
            std::string body;
            DWORD status = DiscordApiGetStatus(L"ChannelCheck/1.0", L"/api/v10/channels/" + channel, token, &body);
            const std::wstring name = (status == 200) ? JsonFirstStringField(body, "name") : std::wstring();
            {
                std::lock_guard<std::mutex> lock(g_checkMutex);
                if (gen != g_channelCheckGen) return;
                g_channelValid = (status == 200);
                g_channelLookupFor = channel;
                g_channelLookupTok = token;
                g_channelLookupName = name;
            }
            PostMessageW(g_hConfigWnd, WM_APP + 1, 0, 0);
            }).detach();
    }
    catch (...) {}
}
// ===== Fix 95: Dropdowns „Bot Token“ / „Discord Channel ID“ =====
// Im Feld steht der Name eines gemerkten Eintrags (g_*ShownIdx) oder roher Text (Eingabe). Wirksam ist der gespeicherte
// Token/die ID, solange der Feldtext genau dem Namen entspricht, sonst der rohe Text.
static int g_tokenShownIdx = -1;
static int g_channelShownIdx = -1;
static bool g_fieldTextQuiet = false;     // eigenes SetWindowText -> kein EN_CHANGE/CBN_EDITCHANGE auswerten
static bool g_forceResolve = false;       // Enter im Feld: Namen übernehmen, sobald die Prüfung fertig ist (auch mit Fokus)
static std::wstring SettingsFieldText(HWND h) {
    wchar_t b[512] = {};
    if (h) GetWindowTextW(h, b, 512);
    return b;
}
static bool TokenShowsName() {
    return g_tokenShownIdx >= 0 && g_tokenShownIdx < (int)g_botHistory.size() && SettingsFieldText(g_hEditToken) == g_botHistory[g_tokenShownIdx].name;
}
static bool ChannelShowsName() {
    return g_channelShownIdx >= 0 && g_channelShownIdx < (int)g_channelHistory.size() &&
        SettingsFieldText(g_hEditChannel) == L"#" + g_channelHistory[g_channelShownIdx].name;
}
static std::wstring EffectiveToken() { return TokenShowsName() ? g_botHistory[g_tokenShownIdx].token : SettingsFieldText(g_hEditToken); }
static std::wstring EffectiveChannel() { return ChannelShowsName() ? g_channelHistory[g_channelShownIdx].id : SettingsFieldText(g_hEditChannel); }
static void SetFieldTextQuiet(HWND h, const std::wstring& t) {
    if (!h) return;
    g_fieldTextQuiet = true;
    SetWindowTextW(h, t.c_str());
    g_fieldTextQuiet = false;
}
// ===== Fix 96: Vorschlagsliste unter „Bot Token“ / „Discord Channel ID“ / „Discord Message“ =====
// Die Felder sind wieder normale Eingabefelder (kein Dropdown-Pfeil). Klick ins Feld öffnet direkt darunter eine Liste der
// gemerkten Einträge (gleiche Breite, schwarz, markierter Eintrag grün): Bot-Namen, „#channel“ bzw. Nachrichten.
// Klick auf einen Eintrag übernimmt ihn (gespeicherter Token/ID), Tippen bleibt frei (schließt die Liste),
// Esc / Klick daneben / Fokuswechsel schließt sie, Entf löscht den markierten Eintrag, Pfeil hoch/runter + Enter wählen.
// Ohne gemerkte Einträge erscheint keine Liste. Eigenes WS_POPUP-Fenster (aktiviert sich nie, Fokus bleibt im Feld),
// gemalt in EINEM BitBlt aus einem Speicherbild -> kein Flackern. Kein Thread, kein Timer; existiert nur mit dem Einstellungsfenster.
static HWND g_hSuggest = nullptr;      // die Liste (lazy erzeugt, gehört dem Einstellungsfenster)
static HWND g_suggestEdit = nullptr;   // Feld, zu dem die offene Liste gehört (nullptr = zu)
static int g_suggestHot = -1;          // markierter Eintrag (-1 = keiner -> Entf/Enter wirken normal im Feld)
static int g_suggestTop = 0;           // erster sichtbarer Eintrag (Scrollen per Mausrad/Pfeiltasten)
static const int SUGGEST_ROW_H = 22, SUGGEST_MAX_ROWS = 8;
// Fix 97: Liste filtert beim Tippen (Anfang des Namens, Groß/klein egal; bei Channels zählt ein führendes „#“ nicht)
static std::vector<int> g_suggestIdx;   // sichtbare Zeilen -> Index in der jeweiligen Historie
static std::wstring g_suggestFilter;    // aktueller Filter (leer = alle)
static int SuggestTotalFor(HWND e) {
    if (!e) return 0;
    if (e == g_hEditToken) return (int)g_botHistory.size();
    if (e == g_hEditChannel) return (int)g_channelHistory.size();
    if (e == g_hEditMessage) return (int)g_messageHistory.size() + 1;   // Fix 99: + eingebaute Standardnachricht
    return 0;
}
static int SuggestCountFor(HWND e) { return (e && e == g_suggestEdit) ? (int)g_suggestIdx.size() : 0; }
static std::wstring SuggestNameAt(HWND e, int h) {   // Name zum Vergleichen (ohne „#“), nie ein Token
    if (e == g_hEditToken) return g_botHistory[h].name;
    if (e == g_hEditChannel) return g_channelHistory[h].name;
    return h < 0 ? std::wstring(BUILTIN_MESSAGE) : g_messageHistory[h];   // Fix 99: -1 = eingebaute
}
static void SuggestBuild(HWND e) {
    g_suggestIdx.clear();
    std::wstring f = g_suggestFilter;
    if (e == g_hEditChannel) {
        while (!f.empty() && f[0] == L'#') f.erase(0, 1);
    }
    const int first = (e == g_hEditMessage) ? -1 : 0;   // Fix 99: Nachrichten beginnen mit der eingebauten (-1)
    const int total = first + SuggestTotalFor(e);
    for (int h = first; h < total; ++h) {
        if (!f.empty()) {
            std::wstring name = SuggestNameAt(e, h);
            if (e == g_hEditChannel) while (!name.empty() && name[0] == L'#') name.erase(0, 1);
            if (name.size() < f.size() ||
                CompareStringOrdinal(name.c_str(), (int)f.size(), f.c_str(), (int)f.size(), TRUE) != CSTR_EQUAL) continue;
        }
        g_suggestIdx.push_back(h);
    }
}
static std::wstring SuggestText(int i) {   // nur Namen/Nachrichten, nie ein Token
    if (i < 0 || i >= SuggestCountFor(g_suggestEdit)) return std::wstring();
    const int h = g_suggestIdx[i];
    if (g_suggestEdit == g_hEditToken) return g_botHistory[h].name;
    if (g_suggestEdit == g_hEditChannel) return L"#" + g_channelHistory[h].name;
    return h < 0 ? std::wstring(BUILTIN_MESSAGE) : g_messageHistory[h];   // Fix 99
}
static bool SuggestOpen() { return g_hSuggest && g_suggestEdit && IsWindowVisible(g_hSuggest); }
static void SuggestHide() {
    g_suggestEdit = nullptr;
    g_suggestHot = -1;
    if (g_hSuggest && IsWindowVisible(g_hSuggest))
        SetWindowPos(g_hSuggest, nullptr, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_HIDEWINDOW);
}
static void SuggestEnsureVisible() {
    const int n = SuggestCountFor(g_suggestEdit);
    const int rows = n < SUGGEST_MAX_ROWS ? n : SUGGEST_MAX_ROWS;
    if (g_suggestHot >= 0) {
        if (g_suggestHot < g_suggestTop) g_suggestTop = g_suggestHot;
        if (g_suggestHot >= g_suggestTop + rows) g_suggestTop = g_suggestHot - rows + 1;
    }
    if (g_suggestTop > n - rows) g_suggestTop = n - rows;
    if (g_suggestTop < 0) g_suggestTop = 0;
}
// Liste unter das Feld legen (gleiche Breite), Höhe nach Anzahl; ohne Einträge zu
static void SuggestLayout() {
    if (!g_hSuggest || !g_suggestEdit) return;
    const int n = SuggestCountFor(g_suggestEdit);
    if (n <= 0 || !g_discordEnabled || !IsWindowVisible(g_suggestEdit)) { SuggestHide(); return; }
    if (g_suggestHot >= n) g_suggestHot = n - 1;
    SuggestEnsureVisible();
    const int rows = n < SUGGEST_MAX_ROWS ? n : SUGGEST_MAX_ROWS;
    RECT er = {};
    GetWindowRect(g_suggestEdit, &er);
    const int w = er.right - er.left, h = rows * SUGGEST_ROW_H + 2;
    int y = er.bottom;
    MONITORINFO mi = { sizeof(mi) };
    if (GetMonitorInfoW(MonitorFromWindow(g_suggestEdit, MONITOR_DEFAULTTONEAREST), &mi) && y + h > mi.rcWork.bottom)
        y = er.top - h;   // unten kein Platz -> über dem Feld
    SetWindowPos(g_hSuggest, HWND_TOP, er.left, y, w, h, SWP_NOACTIVATE | SWP_SHOWWINDOW);
    InvalidateRect(g_hSuggest, nullptr, FALSE);
}
static LRESULT CALLBACK SuggestWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam);
// Fix 106: markierte Zeile in allen Listen (3 Vorschlagslisten + „Start in“/„Refresh“) dezent hellgrau, Text schwarz
static const COLORREF SETTINGS_LIST_HOT = RGB(255, 255, 255);   // Fix 109: dezenter Schleier, ~18 % Weiß über Schwarz -> RGB(45,45,45)
static const BYTE SETTINGS_LIST_HOT_ALPHA = 45;
// Fix 108: legt SETTINGS_LIST_HOT mit 50 % Deckkraft (echtes AlphaBlend) über das, was schon in rc steht.
// Liefert die Textfarbe passend zur Mischfarbe (dunkel auf hell, weiß auf dunkel).
static COLORREF SettingsBlendHotRow(HDC hdc, const RECT& rc, COLORREF under) {
    const int a = SETTINGS_LIST_HOT_ALPHA;
    const int r = (GetRValue(SETTINGS_LIST_HOT) * a + GetRValue(under) * (255 - a) + 127) / 255;
    const int g = (GetGValue(SETTINGS_LIST_HOT) * a + GetGValue(under) * (255 - a) + 127) / 255;
    const int b = (GetBValue(SETTINGS_LIST_HOT) * a + GetBValue(under) * (255 - a) + 127) / 255;
    bool done = false;
    if (rc.right > rc.left && rc.bottom > rc.top) {
        BITMAPINFO bi = {};
        bi.bmiHeader.biSize = sizeof(bi.bmiHeader);
        bi.bmiHeader.biWidth = 1; bi.bmiHeader.biHeight = 1;
        bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
        void* bits = nullptr;
        HBITMAP px = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, &bits, nullptr, 0);
        HDC src = px ? CreateCompatibleDC(hdc) : nullptr;
        if (px && src && bits) {
            *(DWORD*)bits = ((DWORD)GetRValue(SETTINGS_LIST_HOT) << 16) | ((DWORD)GetGValue(SETTINGS_LIST_HOT) << 8) | GetBValue(SETTINGS_LIST_HOT);
            HGDIOBJ old = SelectObject(src, px);
            BLENDFUNCTION bf = { AC_SRC_OVER, 0, (BYTE)a, 0 };
            done = AlphaBlend(hdc, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top, src, 0, 0, 1, 1, bf) != FALSE;
            SelectObject(src, old);
        }
        if (src) DeleteDC(src);
        if (px) DeleteObject(px);
        if (!done) {
            HBRUSH br = CreateSolidBrush(RGB(r, g, b));
            if (br) { FillRect(hdc, &rc, br); DeleteObject(br); }
        }
    }
    return (r * 299 + g * 587 + b * 114) / 1000 >= 140 ? RGB(0, 0, 0) : RGB(255, 255, 255);
}
static void SuggestShow(HWND edit, const std::wstring& filter = std::wstring()) {
    if (!edit || !g_hConfigWnd || !g_discordEnabled || SuggestTotalFor(edit) <= 0) { SuggestHide(); return; }
    if (!g_hSuggest) {
        static bool registered = false;
        if (!registered) {
            WNDCLASSW wc = {};
            wc.lpfnWndProc = SuggestWndProc;
            wc.hInstance = GetModuleHandleW(nullptr);
            wc.lpszClassName = L"LastWarDigSuggest";
            wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
            wc.hbrBackground = nullptr;   // malt selbst (kein Löschen -> kein Flackern)
            registered = RegisterClassW(&wc) != 0;
        }
        g_hSuggest = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE, L"LastWarDigSuggest", L"", WS_POPUP,
            0, 0, 0, 0, g_hConfigWnd, nullptr, GetModuleHandleW(nullptr), nullptr);
        if (!g_hSuggest) return;
    }
    if (g_suggestEdit != edit || g_suggestFilter != filter) { g_suggestHot = -1; g_suggestTop = 0; }
    g_suggestEdit = edit;
    g_suggestFilter = filter;
    SuggestBuild(edit);
    SuggestLayout();   // keine Treffer -> zu
}
// Eintrag übernehmen: Bot/Channel -> gespeicherter Token/ID (Feld zeigt den Namen), Nachricht -> Text
static void SuggestPick(int i) {
    HWND edit = g_suggestEdit;
    if (!edit || i < 0 || i >= SuggestCountFor(edit)) return;
    const std::wstring text = SuggestText(i);
    const int h = g_suggestIdx[i];   // Fix 97: Zeile -> Eintrag (Liste kann gefiltert sein)
    SuggestHide();
    if (edit == g_hEditToken) { g_tokenShownIdx = h; g_forceResolve = false; }
    else if (edit == g_hEditChannel) { g_channelShownIdx = h; g_forceResolve = false; }
    // Fix 104: Text per EM_REPLACESEL (rückgängig machbar) statt SetWindowText (leert den Undo-Puffer)
    g_fieldTextQuiet = true;
    SendMessageW(edit, EM_SETSEL, 0, -1);
    SendMessageW(edit, EM_REPLACESEL, TRUE, (LPARAM)text.c_str());
    g_fieldTextQuiet = false;
    SendMessageW(edit, EM_SETSEL, (WPARAM)text.size(), (LPARAM)text.size());
    if (GetFocus() != edit) SetFocus(edit);
    if (g_hConfigWnd) PostMessageW(g_hConfigWnd, WM_APP + 1, 0, 0);
}
// Entf: markierten Eintrag aus der Liste löschen (gespeichert nur, wenn „save“ an ist und schon gespeichert wurde)
static void SuggestDeleteHot() {
    HWND edit = g_suggestEdit;
    const int row = g_suggestHot;
    if (!edit || row < 0 || row >= SuggestCountFor(edit)) return;
    const int sel = g_suggestIdx[row];   // Fix 97: Index in der Historie
    if (sel < 0) return;                 // Fix 99: eingebaute Standardnachricht ist nicht löschbar
    if (edit == g_hEditMessage) {
        g_messageHistory.erase(g_messageHistory.begin() + sel);
        PersistMessageHistoryIfSaved();
    }
    else {
        const bool isTok = (edit == g_hEditToken);
        int& shown = isTok ? g_tokenShownIdx : g_channelShownIdx;
        const bool wasShown = isTok ? TokenShowsName() : ChannelShowsName();
        if (isTok) g_botHistory.erase(g_botHistory.begin() + sel);
        else g_channelHistory.erase(g_channelHistory.begin() + sel);
        if (shown == sel) {
            shown = -1;
            if (wasShown) SetFieldTextQuiet(edit, L"");   // gelöschter Eintrag stand im Feld -> leeren
        }
        else if (shown > sel) --shown;
        PersistBotChannelHistoryIfSaved();
    }
    SuggestBuild(edit);   // Fix 97: Filter bleibt
    const int n = SuggestCountFor(edit);
    g_suggestHot = (row < n) ? row : n - 1;
    SuggestLayout();   // leer -> zu
    if (g_hConfigWnd) PostMessageW(g_hConfigWnd, WM_APP + 1, 0, 0);
}
static void SuggestMoveHot(int delta) {
    const int n = SuggestCountFor(g_suggestEdit);
    if (n <= 0) return;
    int h = (g_suggestHot < 0) ? (delta > 0 ? 0 : n - 1) : g_suggestHot + delta;
    if (h < 0) h = 0;
    if (h > n - 1) h = n - 1;
    g_suggestHot = h;
    SuggestEnsureVisible();
    if (g_hSuggest) InvalidateRect(g_hSuggest, nullptr, FALSE);
}
static LRESULT CALLBACK SuggestWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
    case WM_MOUSEACTIVATE: return MA_NOACTIVATE;   // Fokus bleibt im Feld
    case WM_ERASEBKGND: return 1;
    case WM_PAINT: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hwnd, &ps);
        RECT rc; GetClientRect(hwnd, &rc);
        const int w = rc.right, h = rc.bottom;
        HDC mem = CreateCompatibleDC(hdc);
        HBITMAP bmp = mem ? CreateCompatibleBitmap(hdc, w > 0 ? w : 1, h > 0 ? h : 1) : nullptr;
        if (mem && bmp) {
            HGDIOBJ oldBmp = SelectObject(mem, bmp);
            HBRUSH black = (HBRUSH)GetStockObject(BLACK_BRUSH);
            FillRect(mem, &rc, black);
            const int n = SuggestCountFor(g_suggestEdit);
            const int rows = n < SUGGEST_MAX_ROWS ? n : SUGGEST_MAX_ROWS;
            const bool scroll = n > SUGGEST_MAX_ROWS;
            const int textRight = w - 1 - (scroll ? 6 : 0);
            SetBkMode(mem, TRANSPARENT);
            HGDIOBJ oldFont = SelectObject(mem, g_hSettingsFont ? g_hSettingsFont : (HFONT)GetStockObject(DEFAULT_GUI_FONT));
            for (int r = 0; r < rows; ++r) {
                const int i = g_suggestTop + r;
                if (i >= n) break;
                RECT row = { 1, 1 + r * SUGGEST_ROW_H, textRight, 1 + (r + 1) * SUGGEST_ROW_H };
                const bool hot = (i == g_suggestHot);
                COLORREF txt = RGB(255, 255, 255);
                if (hot) txt = SettingsBlendHotRow(mem, row, RGB(0, 0, 0));   // Fix 108: 50 % Grau über schwarzem Zeilenhintergrund
                SetTextColor(mem, txt);
                const std::wstring t = SuggestText(i);
                RECT tr = row;
                tr.left += 7;    // Text bündig mit dem Text im Feld (Rand 2 + Innenabstand 6, Liste 1 px Rahmen)
                tr.right -= 4;
                DrawTextW(mem, t.c_str(), (int)t.size(), &tr, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS | DT_NOPREFIX);
            }
            SelectObject(mem, oldFont);
            if (scroll) {   // schmale dunkle Scrollbar wie bei den anderen Listen
                RECT sb = { w - 7, 1, w - 1, h - 1 };
                HBRUSH sbBg = CreateSolidBrush(RGB(20, 20, 20));
                if (sbBg) { FillRect(mem, &sb, sbBg); DeleteObject(sbBg); }
                const int trackH = h - 2;
                int thumbH = trackH * rows / n;
                if (thumbH < 12) thumbH = 12;
                const int maxTop = n - rows;
                const int thumbY = 1 + (maxTop > 0 ? (trackH - thumbH) * g_suggestTop / maxTop : 0);
                RECT th = { w - 6, thumbY, w - 2, thumbY + thumbH };
                HBRUSH tb = CreateSolidBrush(RGB(60, 60, 60));
                if (tb) { FillRect(mem, &th, tb); DeleteObject(tb); }
            }
            HBRUSH frame = CreateSolidBrush(RGB(60, 60, 60));   // 1 px Rahmen gegen den schwarzen Fensterhintergrund
            if (frame) { FrameRect(mem, &rc, frame); DeleteObject(frame); }
            BitBlt(hdc, 0, 0, w, h, mem, 0, 0, SRCCOPY);
            SelectObject(mem, oldBmp);
        }
        if (bmp) DeleteObject(bmp);
        if (mem) DeleteDC(mem);
        EndPaint(hwnd, &ps);
        return 0;
    }
    case WM_MOUSEMOVE: {
        const int y = GET_Y_LPARAM(lParam) - 1;
        const int n = SuggestCountFor(g_suggestEdit);
        const int i = (y >= 0) ? g_suggestTop + y / SUGGEST_ROW_H : -1;
        if (i >= 0 && i < n && i != g_suggestHot) { g_suggestHot = i; InvalidateRect(hwnd, nullptr, FALSE); }
        return 0;
    }
    case WM_LBUTTONDOWN: {
        const int y = GET_Y_LPARAM(lParam) - 1;
        const int i = (y >= 0) ? g_suggestTop + y / SUGGEST_ROW_H : -1;
        if (i >= 0 && i < SuggestCountFor(g_suggestEdit)) SuggestPick(i);
        return 0;
    }
    case WM_MOUSEWHEEL: {
        const int n = SuggestCountFor(g_suggestEdit);
        g_suggestTop += (GET_WHEEL_DELTA_WPARAM(wParam) > 0) ? -1 : 1;
        if (g_suggestTop > n - SUGGEST_MAX_ROWS) g_suggestTop = n - SUGGEST_MAX_ROWS;
        if (g_suggestTop < 0) g_suggestTop = 0;
        InvalidateRect(hwnd, nullptr, FALSE);
        return 0;
    }
    case WM_DESTROY:
        if (hwnd == g_hSuggest) { g_hSuggest = nullptr; g_suggestEdit = nullptr; g_suggestHot = -1; }
        return 0;
    }
    return DefWindowProcW(hwnd, msg, wParam, lParam);
}
// Fix 96: gemerkte Bots/Channels geändert -> offene Liste anpassen (Feldtext bleibt)
static void FillBotChannelCombos() {
    if (SuggestOpen()) { SuggestBuild(g_suggestEdit); SuggestLayout(); }   // Fix 97: Filter neu anwenden
}
// Einen Token anzeigen: gemerkt -> Name, sonst roh (bis die Prüfung den Namen liefert)
static void ShowTokenValue(const std::wstring& token) {
    g_tokenShownIdx = -1;
    for (size_t i = 0; i < g_botHistory.size(); ++i)
        if (g_botHistory[i].token == token) { g_tokenShownIdx = (int)i; SetFieldTextQuiet(g_hEditToken, g_botHistory[i].name); return; }
    SetFieldTextQuiet(g_hEditToken, token);
}
static void ShowChannelValue(const std::wstring& id) {
    g_channelShownIdx = -1;
    for (size_t i = 0; i < g_channelHistory.size(); ++i)
        if (g_channelHistory[i].id == id) { g_channelShownIdx = (int)i; SetFieldTextQuiet(g_hEditChannel, L"#" + g_channelHistory[i].name); return; }
    SetFieldTextQuiet(g_hEditChannel, id);
}
// Rohen, erfolgreich geprüften Token/Channel merken und durch den Namen ersetzen (bei Fokusverlust, Enter oder START)
static void ResolveBotChannelNames(bool force) {
    if (!g_hEditToken || !g_hEditChannel) return;
    force = force || g_forceResolve;
    bool changed = false;
    if (!TokenShowsName() && (force || GetFocus() != g_hEditToken)) {
        const std::wstring tok = SettingsFieldText(g_hEditToken);
        std::wstring name;
        {
            std::lock_guard<std::mutex> lock(g_checkMutex);
            if (g_tokenValid.load() && !tok.empty() && g_tokenLookupFor == tok) name = g_tokenLookupName;
        }
        if (!name.empty()) {
            g_botHistory.erase(std::remove_if(g_botHistory.begin(), g_botHistory.end(), [&](const SavedBot& b) { return b.token == tok; }), g_botHistory.end());
            g_botHistory.insert(g_botHistory.begin(), SavedBot{ name, tok });
            if (g_botHistory.size() > BOT_HISTORY_MAX) g_botHistory.resize(BOT_HISTORY_MAX);
            g_tokenShownIdx = 0;
            SetFieldTextQuiet(g_hEditToken, name);
            changed = true;
        }
    }
    if (!ChannelShowsName() && (force || GetFocus() != g_hEditChannel)) {
        const std::wstring id = SettingsFieldText(g_hEditChannel);
        const std::wstring tok = EffectiveToken();
        std::wstring name;
        {
            std::lock_guard<std::mutex> lock(g_checkMutex);
            if (g_channelValid.load() && !id.empty() && g_channelLookupFor == id && g_channelLookupTok == tok) name = g_channelLookupName;
        }
        if (!name.empty()) {
            g_channelHistory.erase(std::remove_if(g_channelHistory.begin(), g_channelHistory.end(), [&](const SavedChannel& c) { return c.id == id; }), g_channelHistory.end());
            g_channelHistory.insert(g_channelHistory.begin(), SavedChannel{ name, id });
            if (g_channelHistory.size() > BOT_HISTORY_MAX) g_channelHistory.resize(BOT_HISTORY_MAX);
            g_channelShownIdx = 0;
            SetFieldTextQuiet(g_hEditChannel, L"#" + name);
            changed = true;
        }
    }
    if (changed) FillBotChannelCombos();
}
// Prüft alle Felder, färbt sie ein und schaltet die START-Buttons frei
static void UpdateAllStates() {
    if (!g_hEditToken || !g_hEditChannel) return;
    ResolveBotChannelNames(false);   // Fix 95
    wchar_t buf[512] = {};
    std::wstring tokenText = EffectiveToken();       // Fix 95: gespeicherter Token, wenn ein Bot-Name angezeigt wird
    std::wstring channelText = EffectiveChannel();   // Fix 95: gespeicherte ID, wenn „#name“ angezeigt wird
    GetWindowTextW(g_hEditMessage, buf, 512);
    std::wstring messageText = buf;

    // Token: Länge 59–80 + Online-Prüfung; Channel: 18/19 Ziffern + Online-Prüfung
    bool tokenLengthOk = !tokenText.empty() && tokenText.length() >= 59 && tokenText.length() <= 80;
    if (tokenLengthOk && g_discordEnabled) CheckTokenAsync(tokenText);   // Fix 68: Online-Prüfung nur mit Discord
    bool tokenValid = tokenLengthOk && g_tokenValid.load();
    bool channelLengthOk = IsDigitsOnly(channelText) && (channelText.length() == 18 || channelText.length() == 19);
    if (channelLengthOk && tokenValid && g_discordEnabled) CheckChannelAsync(tokenText, channelText);
    bool channelValid = channelLengthOk && g_channelValid.load();
    g_tokenValidUI = tokenValid;
    g_channelValidUI = channelValid;
    bool messageValid = !messageText.empty();
    g_messageValidUI = messageValid;
    // Feldfarbe setzen: grün = gültig, rot = ungültig, weiß = leer
    auto setState = [](HWND h, bool valid, bool empty) {
        EditState* st = (EditState*)GetWindowLongPtrW(h, GWLP_USERDATA);
        if (!st) return;
        st->state = valid ? BorderState::Valid : (empty ? BorderState::Normal : BorderState::Invalid);
        InvalidateRect(h, nullptr, TRUE);
        };
    setState(g_hEditToken, tokenValid, tokenText.empty());
    setState(g_hEditChannel, channelValid, channelText.empty());
    setState(g_hEditMessage, messageValid, messageText.empty());
    // Fix 68: ein START-Button. Mit Discord braucht er alle Pflichtfelder (sonst rot und gesperrt), ohne Discord immer grün
    bool allOk = tokenValid && channelValid && messageValid;
    g_allFieldsValid = allOk;
    if (g_hBtnOk) {
        EnableWindow(g_hBtnOk, (allOk || !g_discordEnabled) ? TRUE : FALSE);
        InvalidateRect(g_hBtnOk, nullptr, TRUE);
    }
    if (g_hLabelToken)   InvalidateRect(g_hLabelToken, nullptr, TRUE);
    if (g_hLabelChannel) InvalidateRect(g_hLabelChannel, nullptr, TRUE);
    if (g_hLabelMessage) InvalidateRect(g_hLabelMessage, nullptr, TRUE);
    if (g_hCheckSave)    InvalidateRect(g_hCheckSave, nullptr, TRUE);
}

// ===== Einstellungsfenster: Subclasses für Dropdowns und Eingabefelder =====
// Dropdown-Liste mit schmaler, dunkler Scrollbar
// Fix 113: der Thumb stand fest in der Mitte (thumbY = (h - thumbH) / 2) und erst die System-Scrollbar beim Scrollen
// zeichnete die echte Position darüber. Jetzt Lage und Größe aus GetScrollInfo (oberste Zeile / sichtbare Zeilen /
// Anzahl), und nach jeder Änderung der Scrollposition (Rad, Tasten, Ziehen, Auto-Scroll) sofort neu – kein Timer, kein Thread.
static HWND g_dropSbHwnd = nullptr;   // zuletzt gezeichnete Liste (es ist immer nur eine offen)
static int  g_dropSbPos = -1;         // dort zuletzt gezeichnete Scrollposition
static void DropdownPaintNc(HWND hwnd) {
    HDC hdc = GetWindowDC(hwnd);
    if (!hdc) return;
    RECT rc; GetWindowRect(hwnd, &rc);
    const int w = rc.right - rc.left;
    const int h = rc.bottom - rc.top;

    // Nur den Rahmenbereich schwarz füllen (Client bleibt unangetastet = kein Flackern)
    RECT cl; GetClientRect(hwnd, &cl);
    POINT co = { 0, 0 }; ClientToScreen(hwnd, &co);
    const int cx = co.x - rc.left, cy = co.y - rc.top;
    ExcludeClipRect(hdc, cx, cy, cx + cl.right, cy + cl.bottom);
    RECT full = { 0, 0, w, h };
    FillRect(hdc, &full, (HBRUSH)GetStockObject(BLACK_BRUSH));

    // Schmale Scrollbar rechts (8 px); Thumb nach der echten Scrollposition
    const int sbW = 8;
    RECT sb = { w - sbW, 0, w, h };
    HBRUSH sbBg = CreateSolidBrush(RGB(20, 20, 20));
    if (sbBg) { FillRect(hdc, &sb, sbBg); DeleteObject(sbBg); }

    SCROLLINFO si = { sizeof(si) };
    si.fMask = SIF_RANGE | SIF_PAGE | SIF_POS;
    int pos = 0;
    if ((GetWindowLongPtrW(hwnd, GWL_STYLE) & WS_VSCROLL) && GetScrollInfo(hwnd, SB_VERT, &si)) {
        const int range = si.nMax - si.nMin + 1;
        const int page = (int)si.nPage;
        pos = si.nPos - si.nMin;
        if (page > 0 && range > page) {
            const int trackH = h - 2;
            int thumbH = trackH * page / range;
            if (thumbH < 12) thumbH = 12;
            if (thumbH > trackH) thumbH = trackH;
            const int maxPos = range - page;
            if (pos < 0) pos = 0;
            if (pos > maxPos) pos = maxPos;
            const int thumbY = 1 + (trackH - thumbH) * pos / maxPos;
            RECT thumb = { w - sbW + 1, thumbY, w - 1, thumbY + thumbH };
            HBRUSH thumbBrush = CreateSolidBrush(RGB(60, 60, 60));
            if (thumbBrush) { FillRect(hdc, &thumb, thumbBrush); DeleteObject(thumbBrush); }
        }
    }
    g_dropSbHwnd = hwnd;
    g_dropSbPos = GetScrollPos(hwnd, SB_VERT);   // Rohwert, wie im Vergleich nach DefSubclassProc
    ReleaseDC(hwnd, hdc);
}
static LRESULT CALLBACK DropdownListSubclass(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam, UINT_PTR, DWORD_PTR) {
    switch (msg) {
    case WM_NCPAINT:
        DropdownPaintNc(hwnd);
        return 0;
    case WM_APP + 113:   // Fix 113: einmal nach dem Aufklappen (falls das System seine Scrollbar danach noch zeichnet)
        if (IsWindowVisible(hwnd)) DropdownPaintNc(hwnd);
        return 0;
    case WM_SHOWWINDOW:
        if (wParam) PostMessageW(hwnd, WM_APP + 113, 0, 0);
        break;
    case WM_NCCALCSIZE:
        // Scrollbar-Bereich schmaler machen
        if (wParam) {
            NCCALCSIZE_PARAMS* p = (NCCALCSIZE_PARAMS*)lParam;
            p->rgrc[0].right -= 4;
        }
        return DefSubclassProc(hwnd, msg, wParam, lParam);
    case WM_NCDESTROY:
        if (g_dropSbHwnd == hwnd) { g_dropSbHwnd = nullptr; g_dropSbPos = -1; }
        return DefSubclassProc(hwnd, msg, wParam, lParam);
    }
    const LRESULT res = DefSubclassProc(hwnd, msg, wParam, lParam);
    // Fix 113: Scrollposition geändert, oder das System hat seine eigene Scrollbar gezeichnet (Maus über dem
    // Scrollbereich / Klick dort) -> eigene schmale Scrollbar sofort wieder darüber
    if (IsWindowVisible(hwnd) && (GetWindowLongPtrW(hwnd, GWL_STYLE) & WS_VSCROLL)) {
        const bool ncMouse = (msg >= WM_NCMOUSEMOVE && msg <= WM_NCXBUTTONDBLCLK) || msg == WM_NCMOUSELEAVE ||
                             msg == WM_CAPTURECHANGED || msg == WM_VSCROLL || msg == WM_SHOWWINDOW;
        if (ncMouse || hwnd != g_dropSbHwnd || GetScrollPos(hwnd, SB_VERT) != g_dropSbPos)
            DropdownPaintNc(hwnd);
    }
    return res;
}
// Fix 104: Strg+Z wirkte doppelt (WM_KEYDOWN schickte WM_UNDO, danach machte das EDIT beim Zeichen 0x1A selbst noch
// einmal Undo = zurück zum Anfang). Die Steuerzeichen der selbst behandelten Kürzel werden jetzt verschluckt.
// Strg+Y = Wiederherstellen (das EDIT hat eine Undo-Stufe; Undo des Undo), Strg+Rück / Strg+Entf = Wort löschen.
static HWND g_editUndone = nullptr;   // Feld, in dem zuletzt Strg+Z rückgängig gemacht hat (für Strg+Y)
static bool g_editInUndo = false;
static void EditUndo(HWND hwnd) {
    g_editInUndo = true;
    SendMessageW(hwnd, WM_UNDO, 0, 0);
    g_editInUndo = false;
}
static void EditDeleteWord(HWND hwnd, bool back) {
    DWORD s = 0, e = 0;
    SendMessageW(hwnd, EM_GETSEL, (WPARAM)&s, (LPARAM)&e);
    if (s == e) {
        const int len = GetWindowTextLengthW(hwnd);
        if (len <= 0) return;
        std::wstring t((size_t)len + 1, L'\0');
        GetWindowTextW(hwnd, &t[0], len + 1);
        t.resize((size_t)len);
        if (back) { DWORD i = s; while (i > 0 && iswspace(t[i - 1])) --i; while (i > 0 && !iswspace(t[i - 1])) --i; s = i; }
        else { DWORD i = e; while (i < (DWORD)len && !iswspace(t[i])) ++i; while (i < (DWORD)len && iswspace(t[i])) ++i; e = i; }
        SecureZeroMemory(&t[0], t.size() * sizeof(wchar_t));
        if (s == e) return;
        SendMessageW(hwnd, EM_SETSEL, s, e);
    }
    SendMessageW(hwnd, EM_REPLACESEL, TRUE, (LPARAM)L"");
}
// Eingabefelder: Strg+A/C/X/Z/Y, Strg+Rück/Entf, keine Zeilenumbrüche, optional nur Ziffern
static LRESULT CALLBACK EditSubclassProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam, UINT_PTR, DWORD_PTR) {
    switch (msg) {
    case WM_KEYDOWN:
        // Fix 96: Tasten für die Vorschlagsliste (nur wenn sie zu diesem Feld offen ist)
        if (g_suggestEdit == hwnd && SuggestOpen()) {
            if (wParam == VK_ESCAPE) { SuggestHide(); return 0; }
            if (wParam == VK_DOWN) { SuggestMoveHot(1); return 0; }
            if (wParam == VK_UP) { SuggestMoveHot(-1); return 0; }
            if (wParam == VK_RETURN && g_suggestHot >= 0) { SuggestPick(g_suggestHot); return 0; }
            if (wParam == VK_DELETE && g_suggestHot >= 0) { SuggestDeleteHot(); return 0; }   // markierten Eintrag löschen
        }
        else if (wParam == VK_DOWN && (hwnd == g_hEditToken || hwnd == g_hEditChannel || hwnd == g_hEditMessage)) {
            SuggestShow(hwnd);   // Pfeil runter öffnet die Liste auch per Tastatur
            return 0;
        }
        // Fix 95: Enter im Token-/Channel-Feld übernimmt den Namen (sobald die Prüfung ihn geliefert hat)
        if ((hwnd == g_hEditToken || hwnd == g_hEditChannel) && wParam == VK_RETURN) {
            g_forceResolve = true;
            if (g_hConfigWnd) PostMessageW(g_hConfigWnd, WM_APP + 1, 0, 0);
        }
        if (GetKeyState(VK_CONTROL) & 0x8000) {
            switch (wParam) {
            case 'A':
                SendMessageW(hwnd, EM_SETSEL, 0, -1);
                return 0;
            case 'C':
                SendMessageW(hwnd, WM_COPY, 0, 0);
                return 0;
            case 'X':
                SendMessageW(hwnd, WM_CUT, 0, 0);
                return 0;
            case 'Z':
                EditUndo(hwnd);
                g_editUndone = hwnd;
                return 0;
            case 'Y':   // Fix 104: Wiederherstellen nur direkt nach einem Strg+Z in diesem Feld
                if (g_editUndone == hwnd) { EditUndo(hwnd); g_editUndone = nullptr; }
                return 0;
            case VK_BACK:
                EditDeleteWord(hwnd, true);
                return 0;
            case VK_DELETE:
                EditDeleteWord(hwnd, false);
                return 0;
            case VK_INSERT:
                SendMessageW(hwnd, WM_COPY, 0, 0);
                return 0;
            }
        }
        break;
    case WM_LBUTTONDOWN: {   // Fix 96: Klick ins Feld öffnet die Liste der gemerkten Einträge (falls vorhanden)
        const LRESULT r = DefSubclassProc(hwnd, msg, wParam, lParam);
        if ((hwnd == g_hEditToken || hwnd == g_hEditChannel || hwnd == g_hEditMessage) && g_suggestEdit != hwnd) SuggestShow(hwnd);
        return r;
    }
    case WM_KILLFOCUS:   // Fix 96: Fokus woandershin -> Liste zu
        if (g_suggestEdit == hwnd && (HWND)wParam != g_hSuggest) SuggestHide();
        break;
    case WM_MOUSEWHEEL:   // Fix 96: Mausrad scrollt die offene Liste
        if (g_suggestEdit == hwnd && SuggestOpen()) { SendMessageW(g_hSuggest, WM_MOUSEWHEEL, wParam, lParam); return 0; }
        break;
    case WM_CHAR:
        // Fix 104: Steuerzeichen von Strg+A/C/X/Z/Y und Strg+Rück (0x7F) nicht noch einmal ans EDIT (siehe oben)
        if (wParam == 0x01 || wParam == 0x03 || wParam == 0x18 || wParam == 0x1A || wParam == 0x19 || wParam == 0x7F) return 0;
        if (wParam == 27 && (hwnd == g_hEditToken || hwnd == g_hEditChannel || hwnd == g_hEditMessage)) return 0;   // Fix 96: Esc
        // Keine Zeilenumbrüche in Channel und Nachricht
        if ((hwnd == g_hEditChannel || hwnd == g_hEditMessage) && (wParam == L'\r' || wParam == L'\n'))
            return 0;
        // Fix 53/95: kein Enter/Tab im Token-Feld
        if (hwnd == g_hEditToken && (wParam == L'\r' || wParam == L'\n' || wParam == L'\t'))
            return 0;
        // Felder, die nur Ziffern erlauben
        if (EditState* state = (EditState*)GetWindowLongPtrW(hwnd, GWLP_USERDATA); state && state->numberOnly) {
            if (wParam < 32 || wParam == 127) break;
            // Fix 97: mit gemerkten Channels darf man auch den Namen tippen (z. B. „g“ / „#gen“) -> Liste filtert;
            // eine getippte Nicht-ID bleibt ungültig (rot/Warnung wie bisher), bis ein Eintrag gewählt wird
            if (hwnd == g_hEditChannel && !g_channelHistory.empty() && !iswspace((wchar_t)wParam)) break;
            if (!iswdigit((wchar_t)wParam)) return 0;
        }
        break;
    case WM_PASTE:
        // Fix 53: Token einfügen ohne Leerraum/Zeilenumbrüche (Feld ist mehrzeilig wegen der vertikalen Zentrierung)
        if (hwnd == g_hEditToken) {
            if (!OpenClipboard(hwnd)) return 0;
            std::wstring t;
            if (HANDLE h = GetClipboardData(CF_UNICODETEXT)) {
                if (const wchar_t* p = (const wchar_t*)GlobalLock(h)) {
                    for (; *p; ++p) if (!iswspace(*p)) t += *p;
                    GlobalUnlock(h);
                }
            }
            CloseClipboard();
            SendMessageW(hwnd, EM_REPLACESEL, TRUE, (LPARAM)t.c_str());
            return 0;
        }
        break;
    case WM_DESTROY:
        // Zusatzdaten freigeben
        if (EditState* state = (EditState*)GetWindowLongPtrW(hwnd, GWLP_USERDATA))
            delete state;
        break;
    }
    return DefSubclassProc(hwnd, msg, wParam, lParam);
}

// ===== Einstellungsfenster (ConfigWndProc) =====
// Fensterprozedur des Einstellungsfensters
// Fix 44: „Refresh“ (Wort + Auswahl) nur mit Häkchen „auto refresh game“ änderbar; sonst grau und gesperrt.
// Der gespeicherte Wert (g_refreshDuration / Registry) bleibt unverändert.
static const COLORREF SETTINGS_DISABLED_FIELD = RGB(60, 60, 60);
static const COLORREF SETTINGS_DISABLED_FIELD_TEXT = RGB(140, 140, 140);
static void UpdateRefreshEnabled() {
    const bool on = true;   // Fix 111: „auto refresh game“ entfällt; Refresh ist immer bedienbar („off“ = aus)
    if (g_hComboRefresh) {
        if (!on) SendMessageW(g_hComboRefresh, CB_SHOWDROPDOWN, FALSE, 0);
        EnableWindow(g_hComboRefresh, on ? TRUE : FALSE);
        InvalidateRect(g_hComboRefresh, nullptr, TRUE);
    }
    if (g_hLabelRefresh) {   // Wort transparent gemalt: Hintergrund darunter mit neu zeichnen
        HWND par = GetParent(g_hLabelRefresh);
        RECT r; GetWindowRect(g_hLabelRefresh, &r);
        if (par) { MapWindowPoints(nullptr, par, (POINT*)&r, 2); RedrawWindow(par, &r, nullptr, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN); }
        else InvalidateRect(g_hLabelRefresh, nullptr, TRUE);
    }
}
// Fix 68/69/70/73: Layout. Höhe in beiden Zuständen gleich; ohne Discord kompakt, mit Discord nach links erweitert:
// links Token (Reihe 1, ganze Breite) und Channel ID | Message | Start in | Refresh | [auto refresh game] (Reihe 2),
// daneben START (groß), rechts die Häkchen save / start game / dig message.
// Ohne Häkchen „dig message“ sind die Discord-Einstellungen (inkl. Wörter und „auto refresh game“) versteckt.
static const int SETTINGS_CLIENT_H = 116;          // Felder y 5..108 + 8 px Rand
static const int SETTINGS_BTN_W = 140, SETTINGS_BTN_H = 76;   // START so hoch wie die Häkchen-Spalte
static const int SETTINGS_CHECK_STEP = 28;         // 3 Häkchen je 20 hoch, 8 px dazwischen (zusammen 76 = START-Höhe)
static int g_settingsCheckColW = 133;              // Breite der Häkchen-Spalte (in WM_CREATE aus „dig message“ + Icon)
// Fix 73: kompakt ohne Discord, nach links wachsend mit Discord.
// Ohne „dig message“: nur START + Häkchen-Spalte (keine leere Fläche). Mit: das Fenster wächst nach LINKS um die
// Discord-Felder; rechte Kante, Höhe und Bildschirmposition von START/Häkchen bleiben exakt gleich (kein Springen).
// Fix 84: Die Felder bleiben am Bildschirmplatz; beim Zuklappen werden sie links aus dem Fenster geschoben (Client-x negativ, versteckt).
static const int SETTINGS_GRID_L = 13;   // Fix 110: linker Rand der Discord-Felder = Rand unten (116 - 103)
static const int SETTINGS_FIELDS_GAP = 8;   // Fix 78: Abstand rechte Feldkante -> START (wie andere Lücken)
// Fix 92 (ersetzt Fix 86 Verhüllen/Layered): Umschalten OHNE Verschieben und OHNE Größenänderung.
// Das Fenster ist immer so groß wie mit Discord. Ohne „dig message“ lässt eine Fensterregion (SetWindowRgn) nur den rechten
// Teil sichtbar (START + Häkchen, START wie bisher 12 px vom linken Rand). START/Häkchen bewegen sich nie und werden beim
// Umschalten nicht neu gezeichnet; aufgedeckt bzw. abgedeckt wird nur die Discord-Fläche -> kein Flackern.
// Weil Windows bei einer Fensterregion den Standard-Rahmen nicht mehr zeichnet (DWM-Rahmen aus), hat das Fenster eine eigene
// Titelleiste: WS_POPUP, oben ein Nicht-Client-Bereich (Höhe SETTINGS_CAPTION_H), gemalt im Stil von Windows 11
// (Icon, „Settings“, Schließen-Knopf rechts, rot beim Überfahren), Ecken rund ab Windows 11. Kein Timer, kein Thread.
static const int SETTINGS_CAPTION_H = 30;   // eigene Titelleiste (wie Windows 11 bei 100 %)
static const int SETTINGS_CLOSE_W = 46;     // Schließen-Knopf (wie Windows 11)
static int g_settingsVisibleLeft = 0;       // linke Kante des sichtbaren Teils (Fenster-x); 0 = alles sichtbar
static bool g_settingsActive = true, g_settingsCloseHot = false, g_settingsClosePressed = false;
static COLORREF g_settingsCaptionBg = RGB(255, 255, 255);   // aktive Titelleiste (Akzentfarbe, falls in Windows eingeschaltet)
static bool g_settingsCaptionDarkText = true;
static HFONT g_settingsCaptionFont = nullptr;
// Fix 123: Discord-Felder klappen UNTER START/Häkchen auf (statt links). Breite immer = kompakte Breite (START + Häkchen-Spalte),
// sie ändert sich nie; mit „dig message“ wächst nur die sichtbare Höhe (Fensterregion, wie Fix 92 – nur senkrecht).
// 4 Reihen, Label über dem Feld (Label 19 hoch, Feld 21 px unter dem Label, 24 hoch), zwischen den Reihen 3 px
// (3 px enger als früher 6): 1 Bot Token, 2 Channel ID, 3 Message (alle drei volle Inhaltsbreite), 4 Refresh | Start in
// (gleich breit, zusammen genau die Inhaltsbreite, 10 px Lücke). Inhalt x 12 .. Breite - 12 (wie START/Häkchen).
// Erstes Label 8 px unter START (SETTINGS_FIELDS_GAP), unten 13 px Rand (SETTINGS_GRID_L, wie bisher unter den Feldern).
static const int SETTINGS_ROW_LABEL_H = 19, SETTINGS_ROW_FIELD_DY = 21, SETTINGS_ROW_FIELD_H = 24, SETTINGS_ROW_GAP = 3;
static const int SETTINGS_ROW_STEP = SETTINGS_ROW_FIELD_DY + SETTINGS_ROW_FIELD_H + SETTINGS_ROW_GAP;   // 48
static const int SETTINGS_BLOCK_TOP = (SETTINGS_CLIENT_H - SETTINGS_BTN_H) / 2;                      // START y 20..96
static const int SETTINGS_ROWS_TOP = SETTINGS_BLOCK_TOP + SETTINGS_BTN_H + SETTINGS_FIELDS_GAP;      // erstes Label y 104
static const int SETTINGS_CLIENT_H_FULL = SETTINGS_ROWS_TOP + 3 * SETTINGS_ROW_STEP + SETTINGS_ROW_FIELD_DY + SETTINGS_ROW_FIELD_H + SETTINGS_GRID_L;   // 306
static int g_settingsVisibleBottom = 0;     // Fix 123: untere Kante des sichtbaren Teils (Fenster-y)
static int SettingsContentW() { return SETTINGS_BTN_W + 12 + g_settingsCheckColW; }
static SIZE SettingsWindowSize() {   // immer die volle Größe (mit Discord), Breite = kompakte Breite
    const int clientW = 12 + SettingsContentW() + 12;
    return SIZE{ clientW, SETTINGS_CLIENT_H_FULL + SETTINGS_CAPTION_H };
}
static int SettingsVisibleBottomFor(bool on) { return SETTINGS_CAPTION_H + (on ? SETTINGS_CLIENT_H_FULL : SETTINGS_CLIENT_H); }
static RECT SettingsWorkArea(HWND hwnd) {
    MONITORINFO mi = { sizeof(mi) };
    RECT work = { 0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN) };
    if (GetMonitorInfoW(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST), &mi)) work = mi.rcWork;
    return work;
}
static bool SettingsRoundCorners() {   // Windows 11 (Build >= 22000): runde Ecken wie die anderen Fenster
    static int v = -1;
    if (v < 0) {
        v = 0;
        typedef LONG(WINAPI* RtlGetVersionFn)(OSVERSIONINFOW*);
        HMODULE nt = GetModuleHandleW(L"ntdll.dll");
        RtlGetVersionFn fn = nt ? reinterpret_cast<RtlGetVersionFn>(reinterpret_cast<void*>(GetProcAddress(nt, "RtlGetVersion"))) : nullptr;
        OSVERSIONINFOW vi = {};
        vi.dwOSVersionInfoSize = sizeof(vi);
        if (fn && fn(&vi) == 0 && vi.dwMajorVersion >= 10 && vi.dwBuildNumber >= 22000) v = 1;
    }
    return v == 1;
}
static void SettingsApplyRegion(HWND hwnd) {
    const SIZE sz = SettingsWindowSize();
    const int vb = (g_settingsVisibleBottom > 0) ? g_settingsVisibleBottom : sz.cy;   // Fix 123: sichtbarer Teil oben
    HRGN rgn = SettingsRoundCorners() ? CreateRoundRectRgn(g_settingsVisibleLeft, 0, sz.cx + 1, vb + 1, 16, 16)
                                      : CreateRectRgn(g_settingsVisibleLeft, 0, sz.cx, vb);
    if (rgn && !SetWindowRgn(hwnd, rgn, FALSE)) DeleteObject(rgn);   // FALSE: nichts neu zeichnen (macht der Aufrufer gezielt)
}
// Fix 107: helle Pixel an den runden Ecken (Win11). Das Programm ist nicht DPI-bewusst -> DWM skaliert das Fensterbild
// (z. B. 150 %) und mischt dabei an der Regionskante die Pixel direkt AUSSERHALB der Region mit ein. Dort wurde nie gemalt
// (GDI malt nur innerhalb der Region), der Inhalt ist weiß -> heller Treppen-Saum an allen runden Ecken.
// Lösung: Fenster beim Öffnen verhüllt (DWMWA_CLOAK) erzeugen, einmal OHNE Region alles malen (Client schwarz, Titelleiste
// über die volle Breite), dann die Region setzen und erst danach zeigen. Die Pixel außerhalb behalten diese Farben
// (das Fenster ändert nie seine Größe), der Saum hat so dieselbe Farbe wie der Rand innen. Kein Flackern (verhüllt).
// DWM-eigene Ecken/Rahmen aus, damit nichts mit der eigenen Region kollidiert.
static bool g_settingsCloaked = false;
static void SettingsDwmSetup(HWND hwnd) {
    if (!SettingsRoundCorners()) return;
    const DWORD noRound = 1;                // DWMWCP_DONOTROUND
    DwmSetWindowAttribute(hwnd, 33, &noRound, sizeof(noRound));   // DWMWA_WINDOW_CORNER_PREFERENCE
    const DWORD noBorder = 0xFFFFFFFE;      // DWMWA_COLOR_NONE
    DwmSetWindowAttribute(hwnd, 34, &noBorder, sizeof(noBorder)); // DWMWA_BORDER_COLOR
    const BOOL cloak = TRUE;
    g_settingsCloaked = SUCCEEDED(DwmSetWindowAttribute(hwnd, 13, &cloak, sizeof(cloak)));   // DWMWA_CLOAK
}
static void SettingsPaintCaption(HWND hwnd);
static void SettingsFinishOpen(HWND hwnd) {   // nach CreateWindow: Fläche außerhalb der Region einmal malen, dann zeigen
    if (!g_settingsCloaked) return;
    const SIZE sz = SettingsWindowSize();
    SetWindowRgn(hwnd, nullptr, FALSE);
    HDC dc = GetDC(hwnd);
    if (dc) {
        RECT rc = { 0, 0, sz.cx, SETTINGS_CLIENT_H_FULL };
        FillRect(dc, &rc, (HBRUSH)GetStockObject(BLACK_BRUSH));
        ReleaseDC(hwnd, dc);
    }
    SettingsPaintCaption(hwnd);
    SettingsApplyRegion(hwnd);
    RedrawWindow(hwnd, nullptr, nullptr, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN | RDW_UPDATENOW);
    const BOOL cloak = FALSE;
    DwmSetWindowAttribute(hwnd, 13, &cloak, sizeof(cloak));
    g_settingsCloaked = false;
}
static void SettingsReadCaptionColors() {   // Windows-Einstellung „Akzentfarbe auf Titelleisten“
    g_settingsCaptionBg = RGB(255, 255, 255);
    g_settingsCaptionDarkText = true;
    DWORD prev = 0, accent = 0, sz = sizeof(prev);
    if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"ColorPrevalence", RRF_RT_REG_DWORD, nullptr, &prev, &sz) == ERROR_SUCCESS && prev == 1) {
        sz = sizeof(accent);
        if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\DWM", L"AccentColor", RRF_RT_REG_DWORD, nullptr, &accent, &sz) == ERROR_SUCCESS) {
            g_settingsCaptionBg = RGB(accent & 0xFF, (accent >> 8) & 0xFF, (accent >> 16) & 0xFF);
            g_settingsCaptionDarkText = (GetRValue(g_settingsCaptionBg) * 299 + GetGValue(g_settingsCaptionBg) * 587 + GetBValue(g_settingsCaptionBg) * 114) / 1000 > 150;
        }
    }
}
// Titelleiste in ein Speicherbild malen und in EINEM BitBlt zeigen (nur der sichtbare Teil kommt durch die Region)
static void SettingsPaintCaption(HWND hwnd) {
    HDC wdc = GetWindowDC(hwnd);
    if (!wdc) return;
    RECT wr = {};
    GetWindowRect(hwnd, &wr);
    const int w = wr.right - wr.left, h = SETTINGS_CAPTION_H;
    HDC mem = CreateCompatibleDC(wdc);
    HBITMAP bmp = mem ? CreateCompatibleBitmap(wdc, w, h) : nullptr;
    if (!mem || !bmp) { if (bmp) DeleteObject(bmp); if (mem) DeleteDC(mem); ReleaseDC(hwnd, wdc); return; }
    HGDIOBJ oldBmp = SelectObject(mem, bmp);
    const COLORREF bg = g_settingsActive ? g_settingsCaptionBg : RGB(255, 255, 255);
    const bool darkText = g_settingsActive ? g_settingsCaptionDarkText : true;
    const COLORREF fg = !g_settingsActive ? RGB(150, 150, 150) : (darkText ? RGB(0, 0, 0) : RGB(255, 255, 255));
    RECT all = { 0, 0, w, h };
    HBRUSH bgBrush = CreateSolidBrush(bg);
    FillRect(mem, &all, bgBrush);
    DeleteObject(bgBrush);
    const int left = g_settingsVisibleLeft;
    HICON ic = (HICON)SendMessageW(hwnd, WM_GETICON, ICON_SMALL, 0);
    if (!ic) ic = LoadIcon(nullptr, IDI_APPLICATION);
    int tx = left + 10;
    if (ic) { DrawIconEx(mem, left + 10, (h - 16) / 2, ic, 16, 16, 0, nullptr, DI_NORMAL); tx = left + 10 + 16 + 8; }
    wchar_t title[64] = {};
    GetWindowTextW(hwnd, title, 64);
    SetBkMode(mem, TRANSPARENT);
    SetTextColor(mem, fg);
    HGDIOBJ oldFont = SelectObject(mem, g_settingsCaptionFont ? g_settingsCaptionFont : (HFONT)GetStockObject(DEFAULT_GUI_FONT));
    RECT trc = { tx, 0, w - SETTINGS_CLOSE_W - 4, h };
    DrawTextW(mem, title, -1, &trc, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS | DT_NOPREFIX);
    SelectObject(mem, oldFont);
    // Schließen-Knopf: rot beim Überfahren, etwas heller beim Drücken, Kreuz dann weiß
    RECT cr = { w - SETTINGS_CLOSE_W, 0, w, h };
    COLORREF glyph = fg;
    if (g_settingsCloseHot) {
        HBRUSH hb = CreateSolidBrush(g_settingsClosePressed ? RGB(200, 64, 50) : RGB(196, 43, 28));
        FillRect(mem, &cr, hb);
        DeleteObject(hb);
        glyph = RGB(255, 255, 255);
    }
    const int cx = cr.left + SETTINGS_CLOSE_W / 2, cy = h / 2;
    if (g_gdiplusToken) {
        Gdiplus::Graphics g(mem);
        g.SetSmoothingMode(Gdiplus::SmoothingModeAntiAlias);
        Gdiplus::Pen pen(Gdiplus::Color(255, GetRValue(glyph), GetGValue(glyph), GetBValue(glyph)), 1.0f);
        g.DrawLine(&pen, (Gdiplus::REAL)cx - 5.0f, (Gdiplus::REAL)cy - 5.0f, (Gdiplus::REAL)cx + 5.0f, (Gdiplus::REAL)cy + 5.0f);
        g.DrawLine(&pen, (Gdiplus::REAL)cx - 5.0f, (Gdiplus::REAL)cy + 5.0f, (Gdiplus::REAL)cx + 5.0f, (Gdiplus::REAL)cy - 5.0f);
    }
    else {
        HPEN pen = CreatePen(PS_SOLID, 1, glyph);
        HGDIOBJ op = SelectObject(mem, pen);
        MoveToEx(mem, cx - 5, cy - 5, nullptr); LineTo(mem, cx + 6, cy + 6);
        MoveToEx(mem, cx - 5, cy + 5, nullptr); LineTo(mem, cx + 6, cy - 6);
        SelectObject(mem, op);
        DeleteObject(pen);
    }
    BitBlt(wdc, 0, 0, w, h, mem, 0, 0, SRCCOPY);
    SelectObject(mem, oldBmp);
    DeleteObject(bmp);
    DeleteDC(mem);
    ReleaseDC(hwnd, wdc);
}
static LRESULT SettingsHitTest(HWND hwnd, int sx, int sy) {
    RECT wr = {};
    GetWindowRect(hwnd, &wr);
    const int x = sx - wr.left, y = sy - wr.top;
    const int vb = (g_settingsVisibleBottom > 0) ? g_settingsVisibleBottom : (int)(wr.bottom - wr.top);   // Fix 123
    if (x < g_settingsVisibleLeft || x >= wr.right - wr.left || y < 0 || y >= vb) return HTNOWHERE;
    if (y < SETTINGS_CAPTION_H) return (x >= wr.right - wr.left - SETTINGS_CLOSE_W) ? HTCLOSE : HTCAPTION;
    return HTCLIENT;
}
static bool SettingsCursorOnClose(HWND hwnd) {
    POINT p = {};
    GetCursorPos(&p);
    return SettingsHitTest(hwnd, p.x, p.y) == HTCLOSE;
}
// Discord-Felder ein-/ausblenden (ohne Zeichnen; ausgeblendet sind sie per Tab nicht erreichbar)
// Fix 100: Versteckt rücken alle Felder zusätzlich 32 px nach links. Token-Feld und „auto refresh game“ enden sonst genau bei
// g_settingsFieldsRight, also 4 px IN der kompakten Region (sie beginnt bei g_settingsFieldsRight - 4). So liegt kein Teil
// eines Discord-Felds in der Region oder direkt daneben (DWM-Skalierung bei 125/150 % mischt Randpixel mit ein).
static const int SETTINGS_HIDDEN_SHIFT = 32;
static bool g_settingsFieldsShifted = false;
static void SettingsShowFields(bool show) {
    const HWND fields[] = { g_hLabelToken, g_hEditToken, g_hLabelChannel, g_hEditChannel, g_hLabelMessage, g_hEditMessage,
        g_hLabelWait, g_hComboWait, g_hLabelRefresh, g_hComboRefresh };
    // Fix 123: versteckt 32 px nach UNTEN (weg von der unteren Kante der kompakten Region; Label 1 liegt sonst bei y 104 in ihr)
    const int dy = (show == g_settingsFieldsShifted) ? (show ? -SETTINGS_HIDDEN_SHIFT : SETTINGS_HIDDEN_SHIFT) : 0;
    g_settingsFieldsShifted = !show;
    for (HWND f : fields) {
        if (!f) continue;
        UINT fl = SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOREDRAW | (show ? SWP_SHOWWINDOW : SWP_HIDEWINDOW);
        int x = 0, y = 0;
        if (dy != 0) {
            RECT r = {};
            GetWindowRect(f, &r);
            MapWindowPoints(nullptr, GetParent(f), (POINT*)&r, 2);
            x = r.left; y = r.top + dy;
        }
        else fl |= SWP_NOMOVE;
        SetWindowPos(f, nullptr, x, y, 0, 0, fl);
    }
}
// initial: Steuerelemente platzieren, Region setzen, sichtbaren Teil mittig auf den Bildschirm.
// Sonst: nur die Region umschalten (Fenster bleibt, wo es ist) und die aufgedeckte Fläche bzw. die Titelleiste zeichnen.
static void ApplySettingsLayout(HWND hwnd, bool initial) {
    // Fix 123: senkrecht statt waagerecht. Breite fest; ohne „dig message“ schneidet die Region unterhalb von START/Häkchen ab.
    const bool on = g_discordEnabled;
    const int vb = SettingsVisibleBottomFor(on);
    if (!on) {
        if (g_hComboWait) SendMessageW(g_hComboWait, CB_SHOWDROPDOWN, FALSE, 0);
        if (g_hComboRefresh) SendMessageW(g_hComboRefresh, CB_SHOWDROPDOWN, FALSE, 0);
        SuggestHide();   // Fix 96
    }
    if (initial) {
        g_settingsVisibleLeft = 0;
        g_settingsVisibleBottom = vb;
        const int top = SETTINGS_BLOCK_TOP;   // START und Häkchen-Spalte (y 20..96)
        const int btnX = 12;
        const int checkX = btnX + SETTINGS_BTN_W + 12;
        const UINT q = SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE;
        if (g_hBtnOk) SetWindowPos(g_hBtnOk, nullptr, btnX, top, 0, 0, q);
        const HWND checks[] = { g_hCheckSave, g_hCheckStartGame, g_hCheckDiscord };
        for (int i = 0; i < 3; ++i) if (checks[i]) SetWindowPos(checks[i], nullptr, checkX, top + i * SETTINGS_CHECK_STEP, 0, 0, q);
        SettingsShowFields(on);
        const SIZE sz = SettingsWindowSize();
        const RECT work = SettingsWorkArea(hwnd);
        const int x = work.left + ((work.right - work.left) - sz.cx) / 2;
        int y = work.top + ((work.bottom - work.top) - vb) / 2;   // sichtbarer Teil mittig
        if (y + sz.cy > work.bottom) y = work.bottom - sz.cy;     // aufgeklappt ganz auf dem Bildschirm
        if (y < work.top) y = work.top;
        SettingsApplyRegion(hwnd);
        SetWindowPos(hwnd, nullptr, x, y, sz.cx, sz.cy, SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
        return;
    }
    if (vb == g_settingsVisibleBottom) return;
    if (on) {
        // Nur falls der aufgeklappte Teil sonst unten aus dem Bildschirm ragen würde: einmal nach oben schieben (Ausnahme)
        RECT wr = {};
        GetWindowRect(hwnd, &wr);
        const RECT work = SettingsWorkArea(hwnd);
        if (wr.top + vb > work.bottom) {
            int ny = work.bottom - vb;
            if (ny < work.top) ny = work.top;
            SetWindowPos(hwnd, nullptr, wr.left, ny, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
        }
        SettingsShowFields(true);
    }
    g_settingsVisibleBottom = vb;
    BOOL comp = FALSE;
    if (SUCCEEDED(DwmIsCompositionEnabled(&comp)) && comp) DwmFlush();   // direkt nach einem DWM-Bild umschalten
    const int blockBottom = SETTINGS_BLOCK_TOP + SETTINGS_BTN_H;   // unter START/Häkchen (y 96)
    if (!on) {
        // wie Fix 100, nur unten: Felder verstecken/wegrücken, solange die Region noch groß ist, und den Streifen unter
        // START bis 16 px unter die neue Unterkante schwarz malen (inkl. Label 1, das mit SWP_NOREDRAW stehen bliebe)
        SettingsShowFields(false);
        HDC dc = GetDC(hwnd);
        if (dc) {
            RECT apron = { 0, blockBottom, SettingsWindowSize().cx, SETTINGS_CLIENT_H + 16 };
            FillRect(dc, &apron, (HBRUSH)GetStockObject(BLACK_BRUSH));
            ReleaseDC(hwnd, dc);
        }
    }
    SettingsApplyRegion(hwnd);
    if (on) {   // nur die aufgedeckte Fläche unter START/Häkchen zeichnen (inkl. der früheren runden Ecken unten); START bleibt unangetastet
        RECT r = { 0, blockBottom, SettingsWindowSize().cx, SETTINGS_CLIENT_H_FULL };
        RedrawWindow(hwnd, &r, nullptr, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN | RDW_UPDATENOW);
    }
    else {
        RECT r = { 0, blockBottom, SettingsWindowSize().cx, SETTINGS_CLIENT_H };
        RedrawWindow(hwnd, &r, nullptr, RDW_INVALIDATE | RDW_ERASE | RDW_UPDATENOW);
    }
}
// Fix 105: Tab / Umschalt+Tab im Einstellungsfenster (feste Reihenfolge, nur sichtbare und aktive Elemente).
// Bewusst kein IsDialogMessage: das würde Enter als IDOK (= START, Id 1) und Esc als IDCANCEL (= „save“, Id 2) auslösen.
// Wird in der Nachrichtenschleife VOR TranslateMessage geprüft -> kein Tab-Zeichen im Feld. Felder: Text ganz markiert.
static bool SettingsHandleTab(const MSG& m) {
    if (m.message != WM_KEYDOWN || m.wParam != VK_TAB || !g_hConfigWnd) return false;
    if (m.hwnd != g_hConfigWnd && !IsChild(g_hConfigWnd, m.hwnd)) return false;
    if ((GetKeyState(VK_CONTROL) & 0x8000) || (GetKeyState(VK_MENU) & 0x8000)) return false;
    const HWND order[] = { g_hEditToken, g_hEditChannel, g_hEditMessage, g_hComboRefresh, g_hComboWait,   // Fix 123: Reihen von oben
        g_hCheckSave, g_hCheckStartGame, g_hCheckDiscord, g_hBtnOk };
    const int n = (int)(sizeof(order) / sizeof(order[0]));
    const bool back = (GetKeyState(VK_SHIFT) & 0x8000) != 0;
    const HWND cur = GetFocus();
    int idx = -1;
    for (int i = 0; i < n; ++i) if (order[i] && (order[i] == cur || IsChild(order[i], cur))) idx = i;
    SuggestHide();
    if (g_hComboWait) SendMessageW(g_hComboWait, CB_SHOWDROPDOWN, FALSE, 0);
    if (g_hComboRefresh) SendMessageW(g_hComboRefresh, CB_SHOWDROPDOWN, FALSE, 0);
    for (int k = 1; k <= n; ++k) {
        const int i = (idx < 0) ? (back ? n - k : k - 1) : (((idx + (back ? -k : k)) % n) + n) % n;
        const HWND h = order[i];
        if (!h || !IsWindowVisible(h) || !IsWindowEnabled(h)) continue;
        SetFocus(h);
        if (h == g_hEditToken || h == g_hEditChannel || h == g_hEditMessage) SendMessageW(h, EM_SETSEL, 0, -1);
        return true;
    }
    return true;
}
static LRESULT CALLBACK ConfigWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
    case WM_CREATE: {
        // Handle schon hier setzen (Timer der Online-Prüfung laufen bereits während WM_CREATE an)
        g_hConfigWnd = hwnd;
        // Pinsel und Schriften
        g_hBrushNormal = CreateSolidBrush(RGB(255, 255, 255));
        g_hBrushValid = CreateSolidBrush(RGB(165, 240, 165));
        g_hBrushInvalid = CreateSolidBrush(RGB(255, 165, 165));

        g_hSettingsFont = CreateFontW(18, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
            DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
            CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE, L"Calibri");
        // Fix 72: START in Poppins SemiBold (eingebettet) statt Segoe Print; GDI+ für die geglättete Form
        g_hButtonFont = CreateStartButtonFont(22);
        {   // Fix 92: Schrift und Farbe der eigenen Titelleiste wie Windows
            NONCLIENTMETRICSW ncm = {};
            ncm.cbSize = sizeof(ncm);
            if (!g_settingsCaptionFont && SystemParametersInfoW(SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0))
                g_settingsCaptionFont = CreateFontIndirectW(&ncm.lfCaptionFont);
            SettingsReadCaptionColors();
        }
        if (!g_gdiplusToken) {
            Gdiplus::GdiplusStartupInput gsi;
            if (Gdiplus::GdiplusStartup(&g_gdiplusToken, &gsi, nullptr) != Gdiplus::Ok) g_gdiplusToken = 0;
        }

        // Icons (Glocke, Discord)
        g_hIconDiscord = (HICON)LoadImageW(GetModuleHandleW(nullptr), MAKEINTRESOURCEW(103), IMAGE_ICON, 16, 16, LR_DEFAULTCOLOR);

        // Labels und Felder: Discord-Token
        // Fix 68: Discord-Icon nur noch einmal am Häkchen „dig message“ (nicht mehr an den Feldern)
        // Fix 110: schmaleres Raster (Felder zeigen nur noch Namen). Rand links = Rand unten = 13 px, alle Lücken 10 px:
        //   Reihe 1: Bot Token 13..343 (rechts bündig mit Message) | Refresh 353..429
        //   Reihe 2: Channel ID 13..163 | Message 173..343 | Start in 353..429 | auto refresh game ab 439
        //   Refresh und Start in: eine Spalte, gleich breit, linksbündig.
        // y-Werte (Labels 7 / 58, Felder 28 / 79, Label->Feld 21 px) unverändert.
        // Fix 112: Breite des Message-Felds zur Laufzeit aus der echten Schrift: „DIG @everyone !“ passt genau hinein
        // (Rahmen + Innenabstand 6 px links wie rechts + 1 px Luft je Seite / Caret). Nie schmaler als das Wort „Discord Message:“.
        // Fix 114: Raster  Reihe 1: Token | Refresh | Start in   Reihe 2: Channel ID | Message.
        // Token und Channel gleich breit = breiteres der Labels „Discord Bot Token:“ / „Discord Channel ID:“ (Feld endet am Doppelpunkt).
        // Refresh / Start in direkt über Message (Refresh bündig links, Start in bündig rechts), Breite aus dem breitesten
        // Eintrag + Pfeil + Rand, nie schmaler als ihr Label. START 8 px rechts von Message.
        int msgW = 170;
        int leftW = 150;
        int labelLW = 155;   // Breite der Labels Token / Channel ID (ganzer Text)
        {
            HDC mdc = GetDC(hwnd);
            if (mdc) {
                HFONT oldF = (HFONT)SelectObject(mdc, g_hSettingsFont ? g_hSettingsFont : (HFONT)GetStockObject(DEFAULT_GUI_FONT));
                SIZE ts = {}, ls = {};
                if (GetTextExtentPoint32W(mdc, L"DIG @everyone !", 15, &ts) && ts.cx > 0) {
                    const int edge = GetSystemMetrics(SM_CXEDGE);
                    msgW = ts.cx + 2 * ((edge > 0 ? edge : 2) + 6 + 1);
                    if (GetTextExtentPoint32W(mdc, L"Discord Message:", 16, &ls) && ls.cx + 2 > msgW) msgW = ls.cx + 2;
                }
                // Feld endet genau an der Tinte des Doppelpunkts: Breite des Textes ohne „:“ + sichtbarer Teil des „:“
                // (Ursprung + Glyphenbreite aus GGO_METRICS). Das Label selbst bleibt so breit wie sein ganzer Text (kein Umbruch).
                SIZE a = {}, b = {}, fa = {}, fb = {};
                if (GetTextExtentPoint32W(mdc, L"Discord Bot Token", 17, &a) && GetTextExtentPoint32W(mdc, L"Discord Channel ID", 18, &b) &&
                    GetTextExtentPoint32W(mdc, L"Discord Bot Token:", 18, &fa) && GetTextExtentPoint32W(mdc, L"Discord Channel ID:", 19, &fb)) {
                    labelLW = (fa.cx > fb.cx ? fa.cx : fb.cx) + 2;
                    int colonInk = 0;
                    GLYPHMETRICS gm = {};
                    const MAT2 m2 = { {0, 1}, {0, 0}, {0, 0}, {0, 1} };
                    if (GetGlyphOutlineW(mdc, L':', GGO_METRICS, &gm, 0, nullptr, &m2) != GDI_ERROR)
                        colonInk = gm.gmptGlyphOrigin.x + (int)gm.gmBlackBoxX;
                    if (colonInk <= 0) { SIZE c = {}; GetTextExtentPoint32W(mdc, L":", 1, &c); colonInk = c.cx; }
                    leftW = (a.cx > b.cx ? a.cx : b.cx) + colonInk;
                }
                SelectObject(mdc, oldF);
                ReleaseDC(hwnd, mdc);
            }
        }
        const int msgX = SETTINGS_GRID_L + leftW + 10;   // Message (Reihe 2) bzw. Refresh / Start in (Reihe 1)
        const int colX = msgX;                            // vorläufig; endgültig nach dem Messen der Combos (unten)
        g_hLabelToken = CreateWindowW(L"STATIC", L"Discord Bot Token:", WS_CHILD | WS_VISIBLE, SETTINGS_GRID_L, 7, labelLW, 19, hwnd, nullptr, nullptr, nullptr);
        // Fix 76-81 (aktuell): alle Discord-Felder 24 hoch; Token-Label y 7 (h 19), Feld y 28..52; Reihe 2 Labels y 58 (h 19), Felder y 79..103 (Fix 91: Raster 7|21+24|6|21+24|13) (Fix 82/83/85: beide Reihen 3 px tiefer, unten 15 px Rand)
        // (Mitte 86 = Zeile „dig message“ der Häkchen-Spalte, „auto refresh game“ ebenso), unten 18 px Rand;
        // Channel ID 16..166 | Message 176..376 | Start in 386..462 | Refresh 472..548 | auto refresh game ab 558.
        // (Ältere Angaben darunter zur Historie.)
        // Fix 51: genau 2 Reihen. Fix 53: alle Felder 28 hoch, Label→Feld je 21 px, Feld→nächstes Label 5 px:
        // Reihe 1: Token (Label y 5, Feld y 26..54, bis x 576). Reihe 2 (Label y 59, Felder y 80..108),
        // 10 px Abstand: Channel ID 16..166 | Message 176..376 | Start in 386..476 | Refresh 486..576 (beide 90 breit wie
        // früher „Cooldown“). Rechts daneben (10 px) die zwei START-Buttons, exakt bündig mit den Feldern
        // (Fix 54: 586..690, je 44 hoch, 12 px Abstand: y 8..52 und 64..108 – von der Label-Zeile bis zum Ende von Reihe 2),
        // ganz rechts (10 px) die Häkchen save / start game / auto refresh game (700..833, y 8 / 48 / 88, je 20 hoch,
        // 20 px Abstand, über dieselbe Spanne). Ränder: links/rechts/unten 16 px. Client 849 x 124.
        // Fix 55: Buttons und Häkchen zusammen 5 px tiefer (Buttons y 13..57 / 69..113, Häkchen y 13 / 53 / 93) -> Client 849 x 129.
        // Fix 57: Buttons 1 px nach rechts (x 587..691) und je 4 px niedriger (104 x 40): y 13..53 / 73..113 (Außenkanten bleiben
        //   bündig mit den Häkchen 13..113, Abstand 20 px wie zwischen den Häkchen); Client 5 px niedriger -> 849 x 124 (Rand unten 11).
        // Fix 96: „Bot Token“ wieder ein normales Feld (wie vor Fix 95); gemerkte Bots zeigt die Vorschlagsliste (nur Namen)
        g_hEditToken = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", L"", WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL | ES_MULTILINE, SETTINGS_GRID_L, 28, leftW, 24, hwnd, nullptr, nullptr, nullptr);
        SendMessageW(g_hEditToken, EM_SETLIMITTEXT, 200, 0);
        // Start-Verzögerung „Start in“ (30–120 s)
        g_hLabelWait = CreateWindowW(L"STATIC", L"Start in:", WS_CHILD | WS_VISIBLE, colX, 58, 76, 19, hwnd, nullptr, nullptr, nullptr);
        g_hComboWait = CreateWindowW(L"COMBOBOX", L"",
            WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED,
            colX, 79, 76, 200, hwnd, nullptr, nullptr, nullptr);
        SetWindowTheme(g_hComboWait, L"", L"");
        const int waitOptions[] = { 30, 40, 50, 60, 70, 80, 90, 100, 110, 120 };
        for (int w : waitOptions) {
            wchar_t buf[16];
            swprintf_s(buf, L"%ds", w);
            SendMessageW(g_hComboWait, CB_ADDSTRING, 0, (LPARAM)buf);
        }
        SendMessageW(g_hComboWait, CB_SETCURSEL, 0, 0);
        g_startupCooldown = 30;
        SendMessageW(g_hLabelWait, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hComboWait, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);

        // Refresh-Intervall für den Failsafe (15 min – 8 h)
        g_hLabelRefresh = CreateWindowW(L"STATIC", L"Refresh:", WS_CHILD | WS_VISIBLE, colX, 7, 76, 19, hwnd, nullptr, nullptr, nullptr);
        g_hComboRefresh = CreateWindowW(L"COMBOBOX", L"",
            WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL | CBS_HASSTRINGS | CBS_OWNERDRAWFIXED,
            colX, 28, 76, 200, hwnd, nullptr, nullptr, nullptr);
        SetWindowTheme(g_hComboRefresh, L"", L"");
        // Fix 111: erster Eintrag „off“ = auto refresh aus (ersetzt das Häkchen „auto refresh game“); Standard „off“
        SendMessageW(g_hComboRefresh, CB_ADDSTRING, 0, (LPARAM)L"off");
        const int refreshOptions[] = { 15, 30, 60, 120, 240, 480 };
        for (int r : refreshOptions) {
            wchar_t buf[16];
            swprintf_s(buf, L"%dm", r);
            SendMessageW(g_hComboRefresh, CB_ADDSTRING, 0, (LPARAM)buf);
        }
        SendMessageW(g_hComboRefresh, CB_SETCURSEL, 0, 0);   // „off“
        g_refreshDuration = 30;                              // gemerktes Intervall (wird wie bisher mitgespeichert)
        g_autoRefreshEnabled = false;
        SendMessageW(g_hLabelRefresh, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hComboRefresh, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);

        // Fix 114: Breite der beiden Combos = breitester Eintrag (+ 4 px Text links wie in WM_DRAWITEM, + 4 px rechts)
        // + Pfeil und Rahmen (aus GetComboBoxInfo), nie schmaler als „Refresh:“ / „Start in:“; beide gleich breit.
        int comboW = 76;
        {
            int textW = 0, labW = 0;
            HDC cdc = GetDC(hwnd);
            if (cdc) {
                HFONT oldF = (HFONT)SelectObject(cdc, g_hSettingsFont ? g_hSettingsFont : (HFONT)GetStockObject(DEFAULT_GUI_FONT));
                const HWND combos[] = { g_hComboWait, g_hComboRefresh };
                for (HWND c : combos) {
                    const int cnt = (int)SendMessageW(c, CB_GETCOUNT, 0, 0);
                    for (int i = 0; i < cnt; ++i) {
                        wchar_t t[32] = {};
                        if (SendMessageW(c, CB_GETLBTEXTLEN, i, 0) >= 31) continue;
                        const int len = (int)SendMessageW(c, CB_GETLBTEXT, i, (LPARAM)t);
                        SIZE s = {};
                        if (len > 0 && GetTextExtentPoint32W(cdc, t, len, &s) && s.cx > textW) textW = s.cx;
                    }
                }
                SIZE s1 = {}, s2 = {};
                GetTextExtentPoint32W(cdc, L"Refresh:", 8, &s1);
                GetTextExtentPoint32W(cdc, L"Start in:", 9, &s2);
                labW = s1.cx > s2.cx ? s1.cx : s2.cx;
                SelectObject(cdc, oldF);
                ReleaseDC(hwnd, cdc);
            }
            COMBOBOXINFO ci = { sizeof(ci) };
            int extra = 2 + GetSystemMetrics(SM_CXVSCROLL) + 2;   // Ersatz, falls GetComboBoxInfo fehlschlägt
            if (GetComboBoxInfo(g_hComboRefresh, &ci) && ci.rcItem.right > ci.rcItem.left) {
                RECT wr; GetWindowRect(g_hComboRefresh, &wr);
                extra = (wr.right - wr.left) - (ci.rcItem.right - ci.rcItem.left);
            }
            if (textW > 0) comboW = textW + 4 + 4 + extra;
            if (comboW < labW) comboW = labW;
        }
        if (2 * comboW + 10 > msgW) msgW = 2 * comboW + 10;   // nur falls die Combos sonst nicht passen
        const int refreshX = msgX;                   // bündig links mit Message
        const int waitX = msgX + msgW - comboW;      // bündig rechts mit Message
        SetWindowPos(g_hLabelRefresh, nullptr, refreshX, 7, comboW, 19, SWP_NOZORDER | SWP_NOACTIVATE);
        SetWindowPos(g_hComboRefresh, nullptr, refreshX, 28, comboW, 200, SWP_NOZORDER | SWP_NOACTIVATE);
        SetWindowPos(g_hLabelWait, nullptr, waitX, 7, comboW, 19, SWP_NOZORDER | SWP_NOACTIVATE);
        SetWindowPos(g_hComboWait, nullptr, waitX, 28, comboW, 200, SWP_NOZORDER | SWP_NOACTIVATE);

        // Discord-Channel-ID und Discord-Nachricht
        // Fix 51: Channel ID ganz links (früher Platz von „Cooldown“), Message direkt rechts daneben
        g_hLabelChannel = CreateWindowW(L"STATIC", L"Discord Channel ID:", WS_CHILD | WS_VISIBLE, SETTINGS_GRID_L, 58, labelLW, 19, hwnd, nullptr, nullptr, nullptr);
        // Fix 96: normale Felder (wie vor Fix 94/95); gemerkte Channels („#name“) / Nachrichten zeigt die Vorschlagsliste
        g_hEditChannel = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", L"", WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL | ES_MULTILINE, SETTINGS_GRID_L, 79, leftW, 24, hwnd, nullptr, nullptr, nullptr);
        SendMessageW(g_hEditChannel, EM_SETLIMITTEXT, 120, 0);
        g_hLabelMessage = CreateWindowW(L"STATIC", L"Discord Message:", WS_CHILD | WS_VISIBLE, msgX, 58, msgW, 19, hwnd, nullptr, nullptr, nullptr);
        g_hEditMessage = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", L"", WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL | ES_MULTILINE, msgX, 79, msgW, 24, hwnd, nullptr, nullptr, nullptr);
        SendMessageW(g_hEditMessage, EM_SETLIMITTEXT, 500, 0);
        SetWindowTextW(g_hEditMessage, L"DIG @everyone !");

        // Checkboxen (owner-drawn). Rechts von START: save / start game / dig message (mit Discord-Icon).
        // Fix 69: „auto refresh game“ gehört zu den Discord-Einstellungen: Reihe 2 direkt rechts neben Refresh, mittig zum Feld.
        // Breiten aus den Texten; Positionen von START und Spalte setzt ApplySettingsLayout.
        {
            int discordW = 0;
            HDC dc = GetDC(hwnd);
            if (dc) {
                HFONT oldF = (HFONT)SelectObject(dc, g_hSettingsFont ? g_hSettingsFont : (HFONT)GetStockObject(DEFAULT_GUI_FONT));
                SIZE sz = {};
                if (GetTextExtentPoint32W(dc, L"dig message", 11, &sz)) discordW = sz.cx;
                SelectObject(dc, oldF);
                ReleaseDC(hwnd, dc);
            }
            g_settingsCheckColW = 20 + (discordW > 0 ? discordW : 130) + 6 + 16 + 2;   // Kästchen+Abstand, Text, Abstand, Icon
        }
        g_hCheckSave = CreateWindowW(L"BUTTON", L"save", WS_CHILD | WS_VISIBLE | BS_OWNERDRAW, 0, 0, g_settingsCheckColW, 20, hwnd, (HMENU)2, nullptr, nullptr);
        g_hCheckStartGame = CreateWindowW(L"BUTTON", L"start game", WS_CHILD | WS_VISIBLE | BS_OWNERDRAW, 0, 0, g_settingsCheckColW, 20, hwnd, (HMENU)6, nullptr, nullptr);
        g_hCheckStartGameCopy = nullptr;   // Fix 111: Häkchen „auto refresh game“ entfernt (Refresh „off“ statt dessen)
        g_hCheckDiscord = CreateWindowW(L"BUTTON", L"dig message", WS_CHILD | WS_VISIBLE | BS_OWNERDRAW, 0, 0, g_settingsCheckColW, 20, hwnd, (HMENU)9, nullptr, nullptr);

        // Fix 68/69: nur noch EIN START-Button (runde Ecken), so hoch wie die Häkchen-Spalte (76 px)
        g_hBtnOk = CreateWindowW(L"BUTTON", L"START", WS_CHILD | WS_VISIBLE | BS_OWNERDRAW | BS_DEFPUSHBUTTON, 0, 0, SETTINGS_BTN_W, SETTINGS_BTN_H, hwnd, (HMENU)1, nullptr, nullptr);
        // Fix 72: keine Fensterregion mehr (zackige Kanten) – die Rundung zeichnet WM_DRAWITEM geglättet auf Schwarz

        // Fix 123: Discord-Felder in 4 Reihen unter START/Häkchen, alle auf der Inhaltsbreite (x 12 .. Breite - 12).
        // Vor EM_SETMARGINS/EM_SETRECT, weil eine Größenänderung das Text-Rechteck der Felder zurücksetzt.
        {
            const int cx0 = 12, cw = SettingsContentW();
            const UINT f = SWP_NOZORDER | SWP_NOACTIVATE;
            const int yL[4] = { SETTINGS_ROWS_TOP, SETTINGS_ROWS_TOP + SETTINGS_ROW_STEP, SETTINGS_ROWS_TOP + 2 * SETTINGS_ROW_STEP, SETTINGS_ROWS_TOP + 3 * SETTINGS_ROW_STEP };
            const HWND labs[3] = { g_hLabelToken, g_hLabelChannel, g_hLabelMessage }, eds[3] = { g_hEditToken, g_hEditChannel, g_hEditMessage };
            for (int r = 0; r < 3; ++r) {
                if (labs[r]) SetWindowPos(labs[r], nullptr, cx0, yL[r], cw, SETTINGS_ROW_LABEL_H, f);
                if (eds[r]) SetWindowPos(eds[r], nullptr, cx0, yL[r] + SETTINGS_ROW_FIELD_DY, cw, SETTINGS_ROW_FIELD_H, f);
            }
            const int halfW = (cw - 10) / 2;          // zwei gleich breite Dropdowns
            const int waitX2 = cx0 + cw - halfW;      // Start in bündig rechts (Lücke 10, bei ungerader Breite 11)
            const int comboH = 200;                    // Höhe inkl. Liste wie bisher
            if (g_hLabelRefresh) SetWindowPos(g_hLabelRefresh, nullptr, cx0, yL[3], halfW, SETTINGS_ROW_LABEL_H, f);
            if (g_hComboRefresh) SetWindowPos(g_hComboRefresh, nullptr, cx0, yL[3] + SETTINGS_ROW_FIELD_DY, halfW, comboH, f);
            if (g_hLabelWait) SetWindowPos(g_hLabelWait, nullptr, waitX2, yL[3], halfW, SETTINGS_ROW_LABEL_H, f);
            if (g_hComboWait) SetWindowPos(g_hComboWait, nullptr, waitX2, yL[3] + SETTINGS_ROW_FIELD_DY, halfW, comboH, f);
        }
        // Innenabstände der Eingabefelder
        SendMessageW(g_hEditToken, EM_SETMARGINS, EC_LEFTMARGIN | EC_RIGHTMARGIN, MAKELONG(6, 6));
        SendMessageW(g_hEditChannel, EM_SETMARGINS, EC_LEFTMARGIN | EC_RIGHTMARGIN, MAKELONG(6, 6));
        SendMessageW(g_hEditMessage, EM_SETMARGINS, EC_LEFTMARGIN | EC_RIGHTMARGIN, MAKELONG(6, 6));

        // Schriften zuweisen
        SendMessageW(g_hLabelToken, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hLabelChannel, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hLabelMessage, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hEditMessage, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hEditToken, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hEditChannel, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        // Fix 53/76: Text im Token-Feld vertikal zentrieren (Feld 24 hoch wie Reihe 2)
        {
            RECT rc;
            GetClientRect(g_hEditToken, &rc);
            int fontHeight = 18;
            int topMargin = (rc.bottom - fontHeight) / 2;
            if (topMargin < 0) topMargin = 0;
            rc.top += topMargin;
            rc.bottom = rc.top + fontHeight;
            SendMessageW(g_hEditToken, EM_SETRECT, 0, (LPARAM)&rc);
        }
        // Text im Channel-Feld vertikal zentrieren
        {
            RECT rc;
            GetClientRect(g_hEditChannel, &rc);
            int fontHeight = 18;
            int topMargin = (rc.bottom - fontHeight) / 2;
            if (topMargin < 0) topMargin = 0;
            rc.top += topMargin;
            rc.bottom = rc.top + fontHeight;
            SendMessageW(g_hEditChannel, EM_SETRECT, 0, (LPARAM)&rc);
        }
        // Text im Nachrichten-Feld vertikal zentrieren
        {
            RECT rc;
            GetClientRect(g_hEditMessage, &rc);
            int fontHeight = 18;
            int topMargin = (rc.bottom - fontHeight) / 2;
            if (topMargin < 0) topMargin = 0;
            rc.top += topMargin;
            rc.bottom = rc.top + fontHeight;
            SendMessageW(g_hEditMessage, EM_SETRECT, 0, (LPARAM)&rc);
        }
        SendMessageW(g_hBtnOk, WM_SETFONT, (WPARAM)g_hButtonFont, TRUE);
        SendMessageW(g_hCheckSave, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hCheckStartGame, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);
        SendMessageW(g_hCheckDiscord, WM_SETFONT, (WPARAM)g_hSettingsFont, TRUE);

        // Hover-Subclass für Buttons und Checkboxen
        SetWindowSubclass(g_hBtnOk, ButtonHoverSubclass, 10, 0);
        SetWindowSubclass(g_hCheckSave, ButtonHoverSubclass, 12, 0);
        SetWindowSubclass(g_hCheckStartGame, ButtonHoverSubclass, 15, 0);
        SetWindowSubclass(g_hCheckDiscord, ButtonHoverSubclass, 18, 0);

        // Zusatzdaten (EditState) und Subclass für die Eingabefelder
        EditState* s2 = new EditState{ BorderState::Normal, false, 0 };
        EditState* s3 = new EditState{ BorderState::Normal, true, 0 };
        EditState* s4 = new EditState{ BorderState::Normal, false, 0 };
        SetWindowLongPtrW(g_hEditToken, GWLP_USERDATA, (LONG_PTR)s2);
        SetWindowLongPtrW(g_hEditChannel, GWLP_USERDATA, (LONG_PTR)s3);
        SetWindowLongPtrW(g_hEditMessage, GWLP_USERDATA, (LONG_PTR)s4);
        SetWindowSubclass(g_hEditToken, EditSubclassProc, 2, 0);
        SetWindowSubclass(g_hEditChannel, EditSubclassProc, 3, 0);
        SetWindowSubclass(g_hEditMessage, EditSubclassProc, 4, 0);

        // Bereits bekannte Werte eintragen
        if (!g_discordToken.empty()) {
            SetWindowTextW(g_hEditToken, g_discordToken.c_str());
        }
        if (!g_channelId.empty()) {
            SetWindowTextW(g_hEditChannel, g_channelId.c_str());
        }
        // Gespeicherte Einstellungen laden und in die Steuerelemente übernehmen
        g_saveChecked = true;
        std::wstring tok, ch;
        int loadedRefresh = 30;
        bool loadedStartGame = false;
        int loadedStartIn = 30;
        std::wstring loadedMessage = L"DIG @everyone !";
        bool loadedAutoRefresh = false;
        bool loadedDiscord = false;
        g_discordEnabled = false;   // Fix 68: Standard aus (erster Start / nichts gespeichert)
        if (LoadSettings(tok, ch, loadedRefresh, loadedStartGame, loadedStartIn, loadedMessage, loadedAutoRefresh, loadedDiscord)) {
            if (g_discordToken.empty()) SetWindowTextW(g_hEditToken, tok.c_str());
            if (g_channelId.empty()) SetWindowTextW(g_hEditChannel, ch.c_str());
            g_saveChecked = true;
            // Passende Einträge in den ComboBoxen auswählen (Werte, die nicht in der Liste stehen, werden ignoriert -> Standard bleibt)
            wchar_t rbuf[16];
            swprintf_s(rbuf, L"%dm", loadedRefresh);
            int ridx = (int)SendMessageW(g_hComboRefresh, CB_FINDSTRINGEXACT, (WPARAM)-1, (LPARAM)rbuf);
            if (ridx != CB_ERR) g_refreshDuration = loadedRefresh;
            // Fix 111: gespeichert „aus“ (autorefresh 0) -> „off“, sonst das gespeicherte Intervall (unbekannt -> 30m)
            if (!loadedAutoRefresh) SendMessageW(g_hComboRefresh, CB_SETCURSEL, 0, 0);
            else if (ridx != CB_ERR) SendMessageW(g_hComboRefresh, CB_SETCURSEL, ridx, 0);
            else SendMessageW(g_hComboRefresh, CB_SETCURSEL, 2, 0);
            g_startGameEnabled = loadedStartGame;
            g_autoRefreshEnabled = loadedAutoRefresh;
            g_discordEnabled = loadedDiscord;
            if (g_hCheckStartGame) InvalidateRect(g_hCheckStartGame, nullptr, TRUE);
            wchar_t sbuf[16];
            swprintf_s(sbuf, L"%ds", loadedStartIn);
            int sidx = (int)SendMessageW(g_hComboWait, CB_FINDSTRINGEXACT, (WPARAM)-1, (LPARAM)sbuf);
            if (sidx != CB_ERR) { SendMessageW(g_hComboWait, CB_SETCURSEL, sidx, 0); g_startupCooldown = loadedStartIn; }
            {
                std::lock_guard<std::mutex> lock(g_discordCfgMutex);
                g_discordMessage = loadedMessage;
            }
            SetWindowTextW(g_hEditMessage, loadedMessage.c_str());
        }
        // Fix 94/96: gemerkte Nachrichten (nur vorhanden, wenn mit „save“ gespeichert) -> Vorschlagsliste; ohne: keine Liste
        LoadMessageHistory();
        // Fix 95: gemerkte Bots/Channels; ein bekannter Token/Channel wird sofort als Name angezeigt
        LoadBotChannelHistory();
        FillBotChannelCombos();
        ShowTokenValue(SettingsFieldText(g_hEditToken));
        ShowChannelValue(SettingsFieldText(g_hEditChannel));
        UpdateRefreshEnabled();   // Fix 44: Refresh grau/gesperrt ohne „auto refresh game“ (gilt auch ohne gespeicherte Einstellungen)
        UpdateAllStates();
        ApplySettingsLayout(hwnd, true);   // Fix 73: kompakt ohne Discord, gleiche Höhe in beiden Zuständen
        SettingsDwmSetup(hwnd);            // Fix 107: verhüllt bis SettingsFinishOpen

        // Fenster-Icon
        if (HICON hs = AppIcon(true)) SendMessageW(hwnd, WM_SETICON, ICON_SMALL, (LPARAM)hs);   // Fix 124: klein (Titelleiste) und groß (Alt+Tab) getrennt
        if (HICON hb = AppIcon(false)) SendMessageW(hwnd, WM_SETICON, ICON_BIG, (LPARAM)hb);
        return 0;
    }
                  // Ergebnis der Online-Prüfung (Token/Channel) ist da
    case WM_APP + 1: UpdateAllStates(); return 0;
    case WM_TIMER:
        // Wartezeit nach der letzten Eingabe abgelaufen: Online-Prüfung starten
        if (wParam == TIMER_TOKEN_CHECK) { KillTimer(hwnd, TIMER_TOKEN_CHECK); StartTokenCheck(); return 0; }
        if (wParam == TIMER_CHANNEL_CHECK) { KillTimer(hwnd, TIMER_CHANNEL_CHECK); StartChannelCheck(); return 0; }
        break;
    case WM_CTLCOLORSTATIC: {
        // Label-Farben: grün bei gültigem Feld, sonst hellgrau
        HDC hdc = (HDC)wParam;
        HWND hCtrl = (HWND)lParam;
        SetBkMode(hdc, TRANSPARENT);
        bool green = false;
        if (hCtrl == g_hLabelToken && g_tokenValidUI) green = true;
        else if (hCtrl == g_hLabelChannel && g_channelValidUI) green = true;
        else if (hCtrl == g_hLabelMessage && g_messageValidUI) green = true;
        else if (hCtrl == g_hLabelWait) green = true;
        else if (hCtrl == g_hLabelRefresh) green = true;

        COLORREF col = green ? RGB(100, 220, 100) : RGB(220, 220, 220);
        if (hCtrl == g_hLabelWait || hCtrl == g_hLabelRefresh)
            col = RGB(120, 255, 120);
        SetTextColor(hdc, col);
        return (LRESULT)GetStockObject(BLACK_BRUSH);   // Fix 81: Label füllt seinen schwarzen Hintergrund selbst (WS_CLIPCHILDREN)
    }
    case WM_CTLCOLOREDIT: {
        HDC hdc = (HDC)wParam;
        HWND hEdit = (HWND)lParam;

        // Normale Eingabefelder: Farbe aus EditState
        EditState* st = (EditState*)GetWindowLongPtrW(hEdit, GWLP_USERDATA);
        COLORREF bg = RGB(255, 255, 255);
        HBRUSH brush = g_hBrushNormal;
        if (st) {
            if (st->state == BorderState::Valid) { bg = RGB(165, 240, 165); brush = g_hBrushValid; }
            else if (st->state == BorderState::Invalid) { bg = RGB(255, 165, 165); brush = g_hBrushInvalid; }
        }
        SetTextColor(hdc, RGB(0, 0, 0));
        SetBkColor(hdc, bg);
        return (LRESULT)brush;
    }
    case WM_MEASUREITEM: {
        // Zeilenhöhe der owner-drawn ComboBoxen
        MEASUREITEMSTRUCT* mis = (MEASUREITEMSTRUCT*)lParam;
        if (mis->CtlType == ODT_COMBOBOX) {
            mis->itemHeight = (mis->itemID == (UINT)-1) ? 18 : 22;   // Fix 76: geschlossenes Feld 24 hoch wie die Edit-Felder, Liste unverändert
            return TRUE;
        }
        break;
    }
    case WM_DRAWITEM: {
        DRAWITEMSTRUCT* dis = (DRAWITEMSTRUCT*)lParam;

        // ComboBoxen „Start in“, „Refresh“: Liste schwarz, Auswahl grün, geschlossen immer grün
        if (dis->CtlType == ODT_COMBOBOX && (dis->hwndItem == g_hComboWait || dis->hwndItem == g_hComboRefresh)) {
            HDC hdc = dis->hDC;
            RECT rc = dis->rcItem;
            bool isClosed = (dis->itemState & ODS_COMBOBOXEDIT) != 0;
            bool selected = (dis->itemState & ODS_SELECTED) != 0;

            wchar_t buf[512] = {};   // Fix 94: auch lange Nachrichten
            if (dis->itemID != (UINT)-1 && SendMessageW(dis->hwndItem, CB_GETLBTEXTLEN, dis->itemID, 0) < 511)
                SendMessageW(dis->hwndItem, CB_GETLBTEXT, dis->itemID, (LPARAM)buf);

            COLORREF bg;
            COLORREF textCol;
            if (isClosed && (!IsWindowEnabled(dis->hwndItem) || (dis->itemState & ODS_DISABLED))) {   // Fix 44: gesperrt -> graues Feld
                bg = SETTINGS_DISABLED_FIELD;
                textCol = SETTINGS_DISABLED_FIELD_TEXT;
            }
            else if (isClosed) {
                bg = RGB(165, 240, 165);
                textCol = RGB(0, 0, 0);
            }
            else {
                bg = RGB(0, 0, 0);   // Fix 108: Auswahl = 50 % Grau über dem schwarzen Listenhintergrund (siehe unten)
                textCol = RGB(255, 255, 255);
            }

            HBRUSH brush = CreateSolidBrush(bg);
            FillRect(hdc, &rc, brush);
            DeleteObject(brush);
            if (!isClosed && selected) textCol = SettingsBlendHotRow(hdc, rc, bg);

            if (dis->itemID != (UINT)-1) {
                SetBkMode(hdc, TRANSPARENT);
                SetTextColor(hdc, textCol);
                HFONT old = (HFONT)SelectObject(hdc, g_hSettingsFont ? g_hSettingsFont : (HFONT)GetStockObject(DEFAULT_GUI_FONT));
                RECT textRc = rc;
                textRc.left += 4;
                DrawTextW(hdc, buf, -1, &textRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS | DT_NOPREFIX);
                SelectObject(hdc, old);
            }
            return TRUE;
        }

        // Owner-drawn Buttons und Checkboxen
        if (dis->CtlType != ODT_BUTTON) break;

        HDC hdc = dis->hDC;
        RECT rc = dis->rcItem;
        bool isOk = (dis->hwndItem == g_hBtnOk);
        bool isSave = (dis->hwndItem == g_hCheckSave);
        bool isStartGame = (dis->hwndItem == g_hCheckStartGame);
        bool isStartGameCopy = (dis->hwndItem == g_hCheckStartGameCopy);
        bool isDiscord = (dis->hwndItem == g_hCheckDiscord);
        bool pressed = (dis->itemState & ODS_SELECTED) != 0;
        bool hover = isOk ? g_hoverOk : (isSave ? g_hoverSave : (isStartGame ? g_hoverStartGame : (isDiscord ? g_hoverDiscord : g_hoverAutoRefresh)));

        // Checkbox: Kästchen mit Haken, Text grün wenn aktiv, heller bei Hover
        if (isSave || isStartGame || isStartGameCopy || isDiscord) {
            FillRect(hdc, &rc, (HBRUSH)GetStockObject(BLACK_BRUSH));   // Fix 81: eigener Hintergrund (Fenster hat WS_CLIPCHILDREN)
            RECT box = { rc.left + 1, rc.top + 3, rc.left + 15, rc.top + 17 };   // Fix 81: alle Häkchen gleich groß
            bool checked = isSave ? g_saveChecked : (isStartGame ? g_startGameEnabled : (isDiscord ? g_discordEnabled : g_autoRefreshEnabled.load()));

            HBRUSH boxBrush = CreateSolidBrush(checked ? (pressed ? RGB(80, 180, 80) : RGB(100, 220, 100)) : (pressed ? RGB(75, 75, 75) : RGB(40, 40, 40)));   // Fix 122: gedrückt (Maus gehalten) etwas anders
            FillRect(hdc, &box, boxBrush);
            DeleteObject(boxBrush);
            FrameRect(hdc, &box, (HBRUSH)GetStockObject(WHITE_BRUSH));

            if (checked) {
                HPEN pen = CreatePen(PS_SOLID, 2, RGB(0, 0, 0));
                HPEN old = (HPEN)SelectObject(hdc, pen);
                MoveToEx(hdc, box.left + 3, box.top + 7, nullptr);
                LineTo(hdc, box.left + 6, box.top + 10);
                LineTo(hdc, box.left + 12, box.top + 3);
                SelectObject(hdc, old);
                DeleteObject(pen);
            }

            SetBkMode(hdc, TRANSPARENT);
            COLORREF textCol = checked ? RGB(100, 220, 100) : RGB(220, 220, 220);
            if (hover) {
                int r = std::min(255, GetRValue(textCol) + 50);
                int g = std::min(255, GetGValue(textCol) + 50);
                int b = std::min(255, GetBValue(textCol) + 50);
                textCol = RGB(r, g, b);
            }
            SetTextColor(hdc, textCol);
            HFONT oldFont = (HFONT)SelectObject(hdc, g_hSettingsFont);
            RECT textRc = rc;
            textRc.left += 20;
            const wchar_t* label = isSave ? L"save" : (isStartGame ? L"start game" : (isDiscord ? L"dig message" : L"auto refresh game"));
            DrawTextW(hdc, label, -1, &textRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
            if (isDiscord && g_hIconDiscord) {   // Fix 68: das eine Discord-Icon, direkt hinter dem Text
                SIZE ts = {};
                GetTextExtentPoint32W(hdc, label, (int)wcslen(label), &ts);
                const int ix = textRc.left + ts.cx + 6;
                const int iy = rc.top + (rc.bottom - rc.top - 16) / 2;
                DrawIconEx(hdc, ix, iy, g_hIconDiscord, 16, 16, 0, nullptr, DI_NORMAL);
            }
            SelectObject(hdc, oldFont);
            return TRUE;
        }

        // Fix 72: START neu gestaltet: weich abgerundet (GDI+ geglättet), dezenter senkrechter Verlauf, weißes Play-Dreieck
        // + „START“ (Poppins SemiBold), Hover etwas heller, gedrückt etwas dunkler und 1 px tiefer, keine harten Rahmen.
        // Zustandslogik unverändert: ohne Discord immer grün; mit Discord rot, bis alle Discord-Felder gültig (grün) sind.
        // Gezeichnet wird nur bei Bedarf (Hover/Klick/Zustandswechsel) in ein kleines Speicherbild -> kein Flackern.
        const bool green = (!isOk || !g_discordEnabled || g_allFieldsValid);
        int c[6] = { 52, 199, 110, 24, 150, 80 };            // oben R,G,B / unten R,G,B (grün)
        if (!green) { c[0] = 240; c[1] = 90; c[2] = 90; c[3] = 200; c[4] = 48; c[5] = 52; }   // rot
        for (int i = 0; i < 6; ++i) {
            if (pressed) c[i] = c[i] * 84 / 100;
            else if (hover) c[i] = c[i] + (255 - c[i]) * 12 / 100;
        }
        const int bw = rc.right - rc.left, bh = rc.bottom - rc.top;
        HDC mem = CreateCompatibleDC(hdc);
        HBITMAP bmp = mem ? CreateCompatibleBitmap(hdc, bw, bh) : nullptr;
        HDC dc = (mem && bmp) ? mem : hdc;
        HGDIOBJ oldBmp = (mem && bmp) ? SelectObject(mem, bmp) : nullptr;
        const int ox = (dc == hdc) ? rc.left : 0, oy = (dc == hdc) ? rc.top : 0;
        RECT full = { ox, oy, ox + bw, oy + bh };
        FillRect(dc, &full, (HBRUSH)GetStockObject(BLACK_BRUSH));   // Fensterhintergrund (Schwarz) hinter den Rundungen

        wchar_t text[32] = {};
        GetWindowTextW(dis->hwndItem, text, 32);
        HFONT oldFont = (HFONT)SelectObject(dc, g_hButtonFont ? g_hButtonFont : (g_hSettingsFont ? g_hSettingsFont : (HFONT)GetStockObject(DEFAULT_GUI_FONT)));
        const int oldExtra = SetTextCharacterExtra(dc, 1);   // etwas Buchstabenabstand
        SIZE ts = {};
        GetTextExtentPoint32W(dc, text, (int)wcslen(text), &ts);
        TEXTMETRICW tm = {};
        GetTextMetricsW(dc, &tm);
        const int triW = 12, triH = 14, gap = 9;
        const int contentW = triW + gap + ts.cx - 1;
        const int press = pressed ? 1 : 0;
        const int sx = ox + (bw - contentW) / 2;
        const int cy = oy + bh / 2 + press;

        if (g_gdiplusToken) {
            Gdiplus::Graphics g(dc);
            g.SetSmoothingMode(Gdiplus::SmoothingModeAntiAlias);
            g.SetPixelOffsetMode(Gdiplus::PixelOffsetModeHalf);
            const Gdiplus::REAL d = 22.0f;                  // Eckenradius 11 px
            const Gdiplus::REAL x0 = (Gdiplus::REAL)ox, y0 = (Gdiplus::REAL)oy;
            const Gdiplus::REAL x1 = x0 + bw, y1 = y0 + bh;
            Gdiplus::GraphicsPath path;
            path.AddArc(x0, y0, d, d, 180.0f, 90.0f);
            path.AddArc(x1 - d, y0, d, d, 270.0f, 90.0f);
            path.AddArc(x1 - d, y1 - d, d, d, 0.0f, 90.0f);
            path.AddArc(x0, y1 - d, d, d, 90.0f, 90.0f);
            path.CloseFigure();
            Gdiplus::LinearGradientBrush fill(Gdiplus::PointF(0.0f, y0), Gdiplus::PointF(0.0f, y1),
                Gdiplus::Color(255, (BYTE)c[0], (BYTE)c[1], (BYTE)c[2]), Gdiplus::Color(255, (BYTE)c[3], (BYTE)c[4], (BYTE)c[5]));
            g.FillPath(&fill, &path);
            // sehr dezentes Glanzlicht an der Oberkante
            Gdiplus::Pen shine(Gdiplus::Color(pressed ? 20 : 55, 255, 255, 255), 1.0f);
            g.DrawLine(&shine, x0 + d / 2, y0 + 1.0f, x1 - d / 2, y0 + 1.0f);
            // Play-Dreieck (weiß, leicht gerundet)
            Gdiplus::PointF tri[3] = {
                Gdiplus::PointF((Gdiplus::REAL)sx, (Gdiplus::REAL)(cy - triH / 2)),
                Gdiplus::PointF((Gdiplus::REAL)sx, (Gdiplus::REAL)(cy + triH / 2)),
                Gdiplus::PointF((Gdiplus::REAL)(sx + triW), (Gdiplus::REAL)cy) };
            Gdiplus::SolidBrush white(Gdiplus::Color(255, 255, 255, 255));
            Gdiplus::Pen round(Gdiplus::Color(255, 255, 255, 255), 2.0f);
            round.SetLineJoin(Gdiplus::LineJoinRound);
            g.FillPolygon(&white, tri, 3);
            g.DrawPolygon(&round, tri, 3);
        }
        else {
            // Ersatz ohne GDI+: flach gerundet
            HBRUSH brush = CreateSolidBrush(RGB(c[3], c[4], c[5]));
            HGDIOBJ ob = SelectObject(dc, brush);
            HGDIOBJ op = SelectObject(dc, GetStockObject(NULL_PEN));
            RoundRect(dc, full.left, full.top, full.right + 1, full.bottom + 1, 22, 22);
            SelectObject(dc, op); SelectObject(dc, ob);
            DeleteObject(brush);
            POINT tri[3] = { { sx, cy - triH / 2 }, { sx, cy + triH / 2 }, { sx + triW, cy } };
            HGDIOBJ ob2 = SelectObject(dc, GetStockObject(WHITE_BRUSH));
            HGDIOBJ op2 = SelectObject(dc, GetStockObject(WHITE_PEN));
            Polygon(dc, tri, 3);
            SelectObject(dc, op2); SelectObject(dc, ob2);
        }

        // „START“ weiß, senkrecht nach Großbuchstaben-Höhe zentriert
        SetBkMode(dc, TRANSPARENT);
        SetTextColor(dc, RGB(255, 255, 255));
        // Fix 93: senkrecht nach der echten Tinte der Buchstaben zentriert (Glyphen-Maße von S/T/A/R/T, nicht Zeilenhöhe):
        // Oberkante = höchster Glyphenpunkt über der Grundlinie, Unterkante = tiefster (Überhang des „S“ inklusive).
        // Mitte der Tinte = Mitte des Buttons (wie das Dreieck, dessen Mitte cy ist).
        int inkTop = 0, inkBottom = 0;
        bool haveInk = false;
        const MAT2 ident = { { 0, 1 }, { 0, 0 }, { 0, 0 }, { 0, 1 } };
        for (const wchar_t* p = text; *p; ++p) {
            if (*p == L' ') continue;
            GLYPHMETRICS gm = {};
            if (GetGlyphOutlineW(dc, *p, GGO_METRICS, &gm, 0, nullptr, &ident) == GDI_ERROR || gm.gmBlackBoxY == 0) continue;
            const int top = gm.gmptGlyphOrigin.y, bottom = gm.gmptGlyphOrigin.y - (int)gm.gmBlackBoxY;
            if (!haveInk) { inkTop = top; inkBottom = bottom; haveInk = true; }
            else { inkTop = std::max(inkTop, top); inkBottom = std::min(inkBottom, bottom); }
        }
        if (!haveInk) { inkTop = (tm.tmHeight - tm.tmInternalLeading) * 70 / 100; inkBottom = 0; }   // Ersatz: ca. Großbuchstaben-Höhe
        // Tinte belegt die Zeilen baseline-inkTop .. baseline-inkBottom-1 -> Mitte = baseline - (inkTop + inkBottom) / 2 = cy
        const int baseline = cy + (inkTop + inkBottom + 1) / 2;
        SetTextAlign(dc, TA_LEFT | TA_BASELINE);
        TextOutW(dc, sx + triW + gap, baseline, text, (int)wcslen(text));
        SetTextAlign(dc, TA_LEFT | TA_TOP);
        SetTextCharacterExtra(dc, oldExtra);
        SelectObject(dc, oldFont);

        if (dc == mem) {
            BitBlt(hdc, rc.left, rc.top, bw, bh, mem, 0, 0, SRCCOPY);
            SelectObject(mem, oldBmp);
        }
        if (bmp) DeleteObject(bmp);
        if (mem) DeleteDC(mem);
        return TRUE;
    }
    // Fix 92: eigene Titelleiste (Nicht-Client-Bereich oben), Ziehen, Schließen-Knopf
    case WM_NCCALCSIZE: {
        RECT* r = (RECT*)lParam;   // bei wParam TRUE ist rgrc[0] das erste Feld von NCCALCSIZE_PARAMS
        r->top += SETTINGS_CAPTION_H;
        return 0;
    }
    case WM_NCPAINT: SettingsPaintCaption(hwnd); return 0;
    case WM_ACTIVATE:   // Fix 96: anderes Fenster aktiv -> Vorschlagsliste zu
        if (LOWORD(wParam) == WA_INACTIVE && (HWND)lParam != g_hSuggest) SuggestHide();
        break;
    case WM_NCACTIVATE:
        g_settingsActive = wParam != FALSE;
        SettingsPaintCaption(hwnd);
        return TRUE;
    case WM_NCHITTEST: return SettingsHitTest(hwnd, GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam));
    case WM_NCMOUSEMOVE: {
        const bool hot = (wParam == HTCLOSE);
        if (hot != g_settingsCloseHot) { g_settingsCloseHot = hot; SettingsPaintCaption(hwnd); }
        if (hot) { TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE | TME_NONCLIENT, hwnd, 0 }; TrackMouseEvent(&tme); return 0; }
        break;
    }
    case WM_NCMOUSELEAVE:
        if (g_settingsCloseHot && !g_settingsClosePressed) { g_settingsCloseHot = false; SettingsPaintCaption(hwnd); }
        break;
    case WM_NCLBUTTONDOWN:
    case WM_NCLBUTTONDBLCLK:
        if (g_hComboWait) SendMessageW(g_hComboWait, CB_SHOWDROPDOWN, FALSE, 0);
        if (g_hComboRefresh) SendMessageW(g_hComboRefresh, CB_SHOWDROPDOWN, FALSE, 0);
        SuggestHide();   // Fix 96
        if (wParam == HTCLOSE) {
            g_settingsClosePressed = true;
            g_settingsCloseHot = true;
            SetCapture(hwnd);
            SettingsPaintCaption(hwnd);
            return 0;
        }
        if (msg == WM_NCLBUTTONDBLCLK) return 0;   // kein Maximieren o. Ä. per Doppelklick
        break;
    case WM_MOUSEMOVE:
        if (g_settingsClosePressed) {
            const bool hot = SettingsCursorOnClose(hwnd);
            if (hot != g_settingsCloseHot) { g_settingsCloseHot = hot; SettingsPaintCaption(hwnd); }
            return 0;
        }
        break;
    case WM_LBUTTONUP:
        if (g_settingsClosePressed) {
            const bool onClose = SettingsCursorOnClose(hwnd);
            g_settingsClosePressed = false;
            ReleaseCapture();
            g_settingsCloseHot = onClose;
            SettingsPaintCaption(hwnd);
            if (onClose) PostMessageW(hwnd, WM_CLOSE, 0, 0);
            return 0;
        }
        break;
    case WM_CAPTURECHANGED:
        if (g_settingsClosePressed) {
            g_settingsClosePressed = false;
            g_settingsCloseHot = SettingsCursorOnClose(hwnd);
            SettingsPaintCaption(hwnd);
        }
        break;
    case WM_SETTINGCHANGE:
    case WM_DWMCOLORIZATIONCOLORCHANGED:
        SettingsReadCaptionColors();
        SettingsPaintCaption(hwnd);
        break;
    case WM_LBUTTONDOWN:
    case WM_LBUTTONDBLCLK:
        // Klick ins Fenster schließt offene Dropdowns (Fix 96: auch die Vorschlagsliste)
        SuggestHide();
        if (g_hComboWait) SendMessageW(g_hComboWait, CB_SHOWDROPDOWN, FALSE, 0);
        if (g_hComboRefresh) SendMessageW(g_hComboRefresh, CB_SHOWDROPDOWN, FALSE, 0);
        return DefWindowProcW(hwnd, msg, wParam, lParam);
    case WM_COMMAND:
    {
        // Checkboxen umschalten (2 = save, 6 = start game, 8 = auto refresh game, 9 = dig message; Fix 51: sound/logging/SUPPORT entfernt)
        // Fix 122: nur BN_CLICKED (kommt erst beim Loslassen bzw. bei Leertaste beim Loslassen der Taste). BN_DOUBLECLICKED kam beim
        // 2. schnellen Drücken und hat schon beim Drücken umgeschaltet (Fix 101 ersetzt: Doppelklick wird im Subclass zu normalem Drücken).
        // Häkchen sofort neu zeichnen (UpdateWindow) statt erst beim nächsten WM_PAINT.
        if (LOWORD(wParam) == 2 && HIWORD(wParam) == BN_CLICKED) {
            g_saveChecked = !g_saveChecked;
            InvalidateRect(g_hCheckSave, nullptr, TRUE);
            UpdateWindow(g_hCheckSave);
        }
        if (LOWORD(wParam) == 6 && HIWORD(wParam) == BN_CLICKED) {
            g_startGameEnabled = !g_startGameEnabled;
            InvalidateRect(g_hCheckStartGame, nullptr, TRUE);
            UpdateWindow(g_hCheckStartGame);
        }
        if (LOWORD(wParam) == 9 && HIWORD(wParam) == BN_CLICKED) {   // Fix 68: Discord-Felder zeigen/verstecken
            g_discordEnabled = !g_discordEnabled;
            InvalidateRect(g_hCheckDiscord, nullptr, TRUE);
            UpdateWindow(g_hCheckDiscord);
            ApplySettingsLayout(hwnd, false);   // Fix 92: nur die Fensterregion wechselt; Fenster, START und Häkchen bleiben stehen
            UpdateRefreshEnabled();
            UpdateAllStates();
        }
        // Auswahl in den ComboBoxen übernehmen
        if (HIWORD(wParam) == CBN_SELCHANGE && (HWND)lParam == g_hComboWait) {
            int sel = (int)SendMessageW(g_hComboWait, CB_GETCURSEL, 0, 0);
            if (sel != CB_ERR) {
                wchar_t buf[8] = {};
                SendMessageW(g_hComboWait, CB_GETLBTEXT, sel, (LPARAM)buf);
                g_startupCooldown = _wtoi(buf);
            }
        }
        if (HIWORD(wParam) == CBN_SELCHANGE && (HWND)lParam == g_hComboRefresh) {
            int sel = (int)SendMessageW(g_hComboRefresh, CB_GETCURSEL, 0, 0);
            if (sel == 0) g_autoRefreshEnabled = false;   // Fix 111: „off“ = wie früher Häkchen aus (Intervall bleibt gemerkt)
            else if (sel != CB_ERR) {
                wchar_t buf[8] = {};
                SendMessageW(g_hComboRefresh, CB_GETLBTEXT, sel, (LPARAM)buf);
                g_refreshDuration = _wtoi(buf);
                g_autoRefreshEnabled = true;
            }
        }
        // Nur echte Änderungen der relevanten Felder auswerten
        // (BN_DBLCLK == 5 == CBN_EDITCHANGE, daher auch das Fenster-Handle prüfen)
        HWND src = (HWND)lParam;
        if (src && HIWORD(wParam) == EN_CHANGE && !g_editInUndo && src == g_editUndone) g_editUndone = nullptr;   // Fix 104: neue Eingabe -> kein Strg+Y mehr
        // Fix 95/96: Fokusverlust im Token-/Channel-Feld -> geprüften Namen übernehmen; eigene Eingabe -> Liste zu
        if (src && (src == g_hEditToken || src == g_hEditChannel)) {
            if (HIWORD(wParam) == EN_KILLFOCUS) PostMessageW(hwnd, WM_APP + 1, 0, 0);
            if (HIWORD(wParam) == EN_CHANGE && !g_fieldTextQuiet) g_forceResolve = false;   // neue Eingabe
        }
        // Fix 97: Tippen filtert die Liste (nur passende Einträge; leer = alle; keine Treffer -> zu). Fokus bleibt im Feld.
        if (src && HIWORD(wParam) == EN_CHANGE && !g_fieldTextQuiet && GetFocus() == src &&
            (src == g_hEditToken || src == g_hEditChannel || src == g_hEditMessage)) {
            wchar_t fbuf[512] = {};
            GetWindowTextW(src, fbuf, 512);
            SuggestShow(src, fbuf);
            SecureZeroMemory(fbuf, sizeof(fbuf));
        }
        if (g_fieldTextQuiet && src && (src == g_hEditToken || src == g_hEditChannel)) return 0;
        if ((HIWORD(wParam) == EN_CHANGE && (src == g_hEditToken || src == g_hEditChannel || src == g_hEditMessage)) ||
            (HIWORD(wParam) == CBN_SELCHANGE && (src == g_hComboWait || src == g_hComboRefresh))) {
            UpdateAllStates();
            if (g_hBtnOk) InvalidateRect(g_hBtnOk, nullptr, TRUE);
        }
        // Dropdown-Listen beim Öffnen dunkel einfärben
        if (HIWORD(wParam) == CBN_DROPDOWN && (HWND)lParam == g_hComboWait) {
            COMBOBOXINFO cbi = { sizeof(cbi) };
            if (GetComboBoxInfo(g_hComboWait, &cbi) && cbi.hwndList) {
                SetWindowTheme(cbi.hwndList, L"DarkMode_Explorer", nullptr);
                SetWindowSubclass(cbi.hwndList, DropdownListSubclass, 31, 0);
            }
        }
        if (HIWORD(wParam) == CBN_DROPDOWN && (HWND)lParam == g_hComboRefresh) {
            COMBOBOXINFO cbi = { sizeof(cbi) };
            if (GetComboBoxInfo(g_hComboRefresh, &cbi) && cbi.hwndList) {
                SetWindowTheme(cbi.hwndList, L"DarkMode_Explorer", nullptr);
                SetWindowSubclass(cbi.hwndList, DropdownListSubclass, 32, 0);
            }
        }
        // START (Fix 68: nur noch ein Button): Werte übernehmen, speichern, ggf. Spiel starten, Fenster schließen.
        // Mit „dig message“ wie früher START (Discord): Gateway, Ping je Dig, „Start in“-Wartezeit.
        // Ohne: wie früher START ohne Discord, aber ohne „Start in“ (Suche beginnt sofort).
        if (LOWORD(wParam) == 1 && HIWORD(wParam) == BN_CLICKED) {
            if (g_discordEnabled && !g_allFieldsValid) return 0;   // Discord-Felder noch nicht gültig (Button ist rot/gesperrt)
            // Fix 94: START ohne „save“ löscht alles Gespeicherte – vorher fragen (nur wenn wirklich etwas gespeichert ist)
            const bool saveNow = g_saveChecked;
            ResolveBotChannelNames(true);   // Fix 95: geprüften neuen Token/Channel jetzt merken (Name statt Rohwert)
            const std::wstring effToken = EffectiveToken(), effChannel = EffectiveChannel();   // vor dem evtl. Löschen der Listen
            if (!saveNow && HasSavedSettings()) {
                if (MessageBoxW(hwnd, L"All saved data (bot tokens, channel IDs and messages) will be deleted.", APP_TITLE.c_str(),
                    MB_OKCANCEL | MB_ICONWARNING | MB_DEFBUTTON2) != IDOK) return 0;   // Abbrechen: nichts löschen, nicht starten
                g_messageHistory.clear();
                g_botHistory.clear();       // Fix 95: auch gemerkte Bots und Channels
                g_channelHistory.clear();
                g_tokenShownIdx = g_channelShownIdx = -1;
                SuggestHide();              // Fix 96
            }
            wchar_t buf[512] = {};
            {
                // Discord-Werte werden auch vom Gateway-/Ping-Thread gelesen
                std::lock_guard<std::mutex> lock(g_discordCfgMutex);
                g_discordToken = effToken;    // Fix 95: gespeicherter Token des gewählten Bots (Feld zeigt nur den Namen)
                g_channelId = effChannel;     // Fix 95: gespeicherte ID des gewählten Channels
                GetWindowTextW(g_hEditMessage, buf, 512); g_discordMessage = buf;
            }
            if (g_discordEnabled && saveNow) RememberMessage(g_discordMessage);   // Fix 94: benutzte Nachricht merken (nur mit „save“)

            bool save = saveNow;
            SaveSettings(save, g_discordToken, g_channelId, g_refreshDuration, g_startGameEnabled, g_startupCooldown, g_discordMessage, g_autoRefreshEnabled, g_discordEnabled);
            g_notiOnlyMode = !g_discordEnabled;
            g_configConfirmed = true;
            if (g_startGameEnabled) StartLastWarGame();
            DestroyWindow(hwnd);
        }
        return 0;
    }

    // Schließen ohne START = Abbruch
    case WM_CLOSE: g_configConfirmed = false; DestroyWindow(hwnd); return 0;
    case WM_DESTROY:
        // Ressourcen freigeben, eigene Nachrichtenschleife beenden
        if (g_hBrushNormal) DeleteObject(g_hBrushNormal);
        if (g_hBrushValid) DeleteObject(g_hBrushValid);
        if (g_hBrushInvalid) DeleteObject(g_hBrushInvalid);
        if (g_hSettingsFont) DeleteObject(g_hSettingsFont);
        if (g_hButtonFont) { DeleteObject(g_hButtonFont); g_hButtonFont = nullptr; }
        if (g_settingsCaptionFont) { DeleteObject(g_settingsCaptionFont); g_settingsCaptionFont = nullptr; }   // Fix 92
        SuggestHide();                                                     // Fix 96: Vorschlagsliste mit dem Fenster weg
        if (g_hSuggest) { DestroyWindow(g_hSuggest); g_hSuggest = nullptr; }
        if (g_gdiplusToken) { Gdiplus::GdiplusShutdown(g_gdiplusToken); g_gdiplusToken = 0; }   // Fix 72
        if (g_hIconDiscord) { DestroyIcon(g_hIconDiscord); g_hIconDiscord = nullptr; }
        g_hConfigWnd = nullptr;
        if (g_configRunningLoop) PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcW(hwnd, msg, wParam, lParam);
}

// ===== Einstellungsfenster öffnen =====
// Öffnet das Einstellungsfenster (oder holt es nach vorne); true, wenn START gedrückt wurde
static bool ShowConfigDialog(HINSTANCE hInst, bool runMessageLoop) {
    if (g_hConfigWnd && IsWindow(g_hConfigWnd)) {
        ShowWindow(g_hConfigWnd, SW_SHOW);
        ShowWindow(g_hConfigWnd, SW_RESTORE);
        SetForegroundWindow(g_hConfigWnd);
        BringWindowToTop(g_hConfigWnd);
        return true;
    }

    // Fensterklasse registrieren und Fenster zentriert erzeugen
    INITCOMMONCONTROLSEX icc = { sizeof(icc), ICC_STANDARD_CLASSES };
    InitCommonControlsEx(&icc);
    WNDCLASSEXW wc = { sizeof(wc) };
    wc.lpfnWndProc = ConfigWndProc;
    wc.hInstance = hInst;
    wc.lpszClassName = L"ConfigWndClass";
    wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hIcon = AppIcon(false);     // Fix 124
    wc.hIconSm = AppIcon(true);
    RegisterClassExW(&wc);
    // Fix 36: Client 733 x 174 – breiter, Ränder links/rechts 16, unterste Reihe endet bei y = 160 -> 14 px Rand unten;
    // Fix 39: 6 px schmaler -> 727 x 174 (Token-Feld 695 breit, Rand rechts weiter 16; Checkboxen enden bei 711)
    // Fix 40: weitere 11 px schmaler -> 716 x 174 (Token-Feld 684 breit, endet bei 700; "auto refresh game" endet bei 700)
    // zwischen den Reihen 6 px, zwischen den Spalten 10 px
    // Fix 51: 2 Reihen -> 832 x 119 (Felder bis y 105, 14 px Rand unten; Häkchen enden bei x 816, 16 px Rand rechts)
    // Fix 53: Felder/Buttons/Häkchen enden alle bei y 108 -> 832 x 124 (16 px Rand unten = links = rechts)
    // Fix 54: START-Buttons 104 breit -> Häkchen x 700..833 -> 849 x 124
    // Fix 55: Buttons/Häkchen enden bei y 113 -> 16 px Rand unten -> 849 x 129
    // Fix 57: Fenster 5 px niedriger (Breite gleich) -> 849 x 124, Rand unten 11 px
    // Fix 58: Fenster 1 px niedriger -> 849 x 123; START-Buttons je 3 px zueinander (y 16..56 / 70..110, Abstand 14); Häkchen x 701
    // Fix 73: endgültige Größe/Position setzt ApplySettingsLayout in WM_CREATE
    RECT wndRc = { 0, 0, 849, 123 };
    AdjustWindowRect(&wndRc, WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU, FALSE);
    const int windowWidth = wndRc.right - wndRc.left;
    const int windowHeight = wndRc.bottom - wndRc.top;
    int screenWidth = GetSystemMetrics(SM_CXSCREEN);
    int screenHeight = GetSystemMetrics(SM_CYSCREEN);
    int x = (screenWidth - windowWidth) / 2;
    int y = (screenHeight - windowHeight) / 2;
    // Fix 92: WS_POPUP mit eigener Titelleiste (Fensterregion für den kompakten Zustand); Größe/Position setzt WM_CREATE
    g_hConfigWnd = CreateWindowExW(WS_EX_APPWINDOW, L"ConfigWndClass", (APP_TITLE + L" Settings").c_str(),   // Fix 124
        WS_POPUP | WS_SYSMENU | WS_VISIBLE | WS_CLIPCHILDREN,   // Fix 81: kein Überzeichnen der Kinder
        x, y, windowWidth, windowHeight, nullptr, nullptr, hInst, nullptr);
    if (!g_hConfigWnd) return false;
    SettingsFinishOpen(g_hConfigWnd);   // Fix 107
    // Eigene Nachrichtenschleife, bis das Fenster geschlossen wird
    if (runMessageLoop) {
        g_configRunningLoop = true;
        MSG msg;
        while (GetMessageW(&msg, nullptr, 0, 0)) { if (SettingsHandleTab(msg)) continue; TranslateMessage(&msg); DispatchMessageW(&msg); }   // Fix 105
        g_configRunningLoop = false;
        g_hConfigWnd = nullptr;
    }
    return g_configConfirmed;
}

// ===== Programmstart (wWinMain) =====
#pragma warning(push)
#pragma warning(disable: 28251)
// Einstiegspunkt: Einstellungen abfragen, Hauptfenster + Tray-Icon anlegen, WorkerThread starten
int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE, LPWSTR, int) {
    // Nur eine Instanz erlauben
    HANDLE hMutex = CreateMutexW(nullptr, TRUE, L"LastWarDigBot_SingleInstance");
    if (hMutex == nullptr || GetLastError() == ERROR_ALREADY_EXISTS) {
        if (hMutex) CloseHandle(hMutex);
        return 0;
    }

    // Schrift laden und Einstellungsfenster anzeigen (Abbruch beendet das Programm)
    g_hFont = LoadEmbeddedFont();
    if (!ShowConfigDialog(hInst, true)) ExitProcess(0);   // ExitProcess: laufende Hintergrund-Threads werden zuerst beendet

    // Icons laden, falls noch nicht geschehen
    if (!g_hIconDiscord)
        g_hIconDiscord = (HICON)LoadImageW(hInst, MAKEINTRESOURCEW(103), IMAGE_ICON, 20, 20, LR_DEFAULTCOLOR);
    // Hauptfenster anlegen (zentriert, ohne Maximieren)
    WNDCLASSEXW wc = { sizeof(wc) };
    wc.lpfnWndProc = WndProc;
    wc.hInstance = hInst;
    wc.lpszClassName = L"LastWarBotWnd";
    wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
    wc.hIcon = AppIcon(false);     // Fix 124
    wc.hIconSm = AppIcon(true);
    RegisterClassExW(&wc);
    DWORD style = WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME;
    const int mainWidth = 664;   // Fix 121: schmaler (680 -> 664) nach Tobis Vorgabe: bei 0/0 ca. 21 px frei hinter „Eggs: 0 / 0“ bis zum Ende der Trennlinie; größere Werte fängt LayoutCounters ab (Abstände 32 -> min. 12 px)
    const int mainHeight = 400;
    int screenW = GetSystemMetrics(SM_CXSCREEN);
    int screenH = GetSystemMetrics(SM_CYSCREEN);
    int mainX = (screenW - mainWidth) / 2;
    int mainY = (screenH - mainHeight) / 2;
    g_hWnd = CreateWindowW(L"LastWarBotWnd", APP_TITLE.c_str(), style,
        mainX, mainY, mainWidth, mainHeight, nullptr, nullptr, hInst, nullptr);
    style = GetWindowLongW(g_hWnd, GWL_STYLE);
    style &= ~WS_MAXIMIZEBOX;
    SetWindowLongW(g_hWnd, GWL_STYLE, style);
    HMENU hSysMenu = GetSystemMenu(g_hWnd, FALSE);
    if (hSysMenu) {
        DeleteMenu(hSysMenu, SC_MAXIMIZE, MF_BYCOMMAND);
        DeleteMenu(hSysMenu, SC_RESTORE, MF_BYCOMMAND);
    }
    SetWindowPos(g_hWnd, nullptr, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_FRAMECHANGED);
    HICON hIcon = AppIcon(true);   // Fix 124: kleines App-Icon (Titelleiste, Tray, Tray-Menü)
    if (hIcon) SendMessageW(g_hWnd, WM_SETICON, ICON_SMALL, (LPARAM)hIcon);
    if (HICON hb = AppIcon(false)) SendMessageW(g_hWnd, WM_SETICON, ICON_BIG, (LPARAM)hb);
    ShowWindow(g_hWnd, SW_SHOWNORMAL);
    SetForegroundWindow(g_hWnd);
    BringWindowToTop(g_hWnd);
    g_windowVisible = true;
    // Tray-Icon anlegen
    g_nid.cbSize = sizeof(g_nid);
    g_nid.hWnd = g_hWnd;
    g_nid.uID = 1;
    g_nid.uFlags = NIF_ICON | NIF_MESSAGE | NIF_TIP;
    g_nid.uCallbackMessage = WM_TRAYICON;
    g_nid.hIcon = hIcon ? hIcon : LoadIconW(nullptr, IDI_APPLICATION);
    wcscpy_s(g_nid.szTip, APP_TITLE.c_str());
    Shell_NotifyIconW(NIM_ADD, &g_nid);
    // Nach einem Explorer-Neustart das Tray-Icon neu anlegen (auch erlauben, wenn der Bot als Admin läuft)
    g_msgTaskbarCreated = RegisterWindowMessageW(L"TaskbarCreated");
    if (g_msgTaskbarCreated) ChangeWindowMessageFilterEx(g_hWnd, g_msgTaskbarCreated, MSGFLT_ALLOW, nullptr);
    // Scan starten und Nachrichtenschleife
    std::thread(WorkerThread).detach();
    MSG msg;
    while (GetMessageW(&msg, nullptr, 0, 0)) { if (SettingsHandleTab(msg)) continue; TranslateMessage(&msg); DispatchMessageW(&msg); }   // Fix 105
    // Sauber beenden: ExitProcess beendet zuerst alle Hintergrund-Threads (Scan, Gateway, Pings),
    // erst danach werden statische Objekte aufgeräumt -> kein Absturz beim Schließen
    Shell_NotifyIconW(NIM_DELETE, &g_nid);
    ExitProcess(0);
}
#pragma warning(pop)
